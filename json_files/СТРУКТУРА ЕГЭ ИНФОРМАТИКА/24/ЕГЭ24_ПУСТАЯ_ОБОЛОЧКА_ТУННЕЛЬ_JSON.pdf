<script id="saved-state" type="application/json">{"v": 1, "teacher": {"name": "", "email": "", "tg": "", "pin": "31415", "repAns": false, "realAns": {}, "noFillAsk": true}, "theme": "dark", "teacherUpdated": 1795026097507, "flags": {}, "students": {}, "last": ""}</script>
<script>let CON_READY=false;
const BLANK='          ';
const ref=c=>c.replace(/⟦([^⟧¦]*)(¦[^⟧]*)?⟧/g,'$1');
const tpl=c=>c.replace(/⟦([^⟧¦]*)(¦([^⟧]*))?⟧/g,(m,a,b,c2)=>c2!=null?c2:BLANK);
function tplFields(c){const fields=[];let shift=0;c.replace(/⟦([^⟧¦]*)(¦([^⟧]*))?⟧/g,(m,a,b,c2,at)=>{const out=c2!=null?c2:BLANK;if(c2==null){const start=at+shift;fields.push({start,end:start+BLANK.length,touched:false});}shift+=out.length-m.length;return out;});return fields;}
function savedTemplateFields(template,code){
  const tLines=template.split('\n'),cLines=String(code||'').split('\n');
  const specs=tLines.map(line=>{const base=tpl(line),fields=tplFields(line);return {base,fields};});
  const locate=(spec,candidate)=>{let cursor=0,result=[];for(const f of spec.fields){const before=spec.base.slice(cursor,f.start),p=candidate.indexOf(before,cursor);if(p<0)return null;const start=p+before.length;const next=spec.fields[result.length+1],after=spec.base.slice(f.end,next?next.start:spec.base.length);const end=after?candidate.indexOf(after,start):candidate.length;if(end<start)return null;result.push({start,end,touched:/\S/.test(candidate.slice(start,end))});cursor=end+after.length;}return result;};
  const n=specs.length,m=cLines.length,dp=Array.from({length:n+1},()=>Array(m+1).fill(-1e9)),way=Array.from({length:n+1},()=>Array(m+1).fill(''));
  dp[0][0]=0;for(let j=1;j<=m;j++){dp[0][j]=dp[0][j-1]-1;way[0][j]='c';}for(let i=1;i<=n;i++){dp[i][0]=dp[i-1][0]-2;way[i][0]='t';}
  for(let i=1;i<=n;i++)for(let j=1;j<=m;j++){
    const spec=specs[i-1],candidate=cLines[j-1],mapped=spec.fields.length?locate(spec,candidate):null;
    const score=spec.fields.length?(mapped?5+Math.min(5,spec.base.length/8):-7):(candidate===spec.base?9:-5);
    const opts=[[dp[i-1][j-1]+score,'m'],[dp[i][j-1]-1,'c'],[dp[i-1][j]-2,'t']].sort((a,b)=>b[0]-a[0]);dp[i][j]=opts[0][0];way[i][j]=opts[0][1];
  }
  const fields=[];let i=n,j=m;while(i||j){const w=way[i][j];if(w==='m'){const found=specs[i-1].fields.length?locate(specs[i-1],cLines[j-1]):null;if(found)for(const f of found){const start=cLines.slice(0,j-1).reduce((a,x)=>a+x.length+1,0)+f.start,end=cLines.slice(0,j-1).reduce((a,x)=>a+x.length+1,0)+f.end;fields.push({start,end,touched:f.touched});}i--;j--;}else if(w==='c')j--;else if(w==='t')i--;else break;}
  return fields.sort((a,b)=>a.start-b.start);
}

/* ===== Python в браузере: Pyodide в Worker ===== */
const PY_RUNNER=String.raw`
import sys, io, json, traceback
_out = io.StringIO(); _steps = []
class _Stop(Exception): pass
def _val(v, d=0):
    if isinstance(v, bool): return v
    if isinstance(v, (int, float)): return v
    if isinstance(v, str): return v[:300]
    if isinstance(v, (list, tuple, set)):
        r = repr(v)
        return {'__r': r[:300], 'k': type(v).__name__}
    if isinstance(v, dict): return {'__r': repr(v)[:300], 'k': 'dict'}
    return None
def _snap(fr):
    d = {}
    src = dict(fr.f_globals)
    if fr.f_locals is not fr.f_globals: src.update(fr.f_locals)
    for k, v in src.items():
        if k.startswith('_') or k in _HIDE: continue
        if callable(v) or type(v).__name__ in ('module', 'type'): continue
        x = _val(v)
        if x is not None: d[k] = x
    return d
def _tr(fr, ev, arg):
    if fr.f_code.co_filename != '<user>': return None
    if ev == 'line':
        _steps.append({'l': fr.f_lineno, 'v': _snap(fr), 'o': len(_out.getvalue())})
        if len(_steps) >= _LIM: raise _Stop()
    return _tr
_res = {'ok': True, 'err': None, 'line': None, 'cut': False}
_g = {'__name__': '__main__'}
_old = sys.stdout; sys.stdout = _out
try:
    exec(_PRE, _g)
    _HIDE = set(k for k in _g.keys())
    _c = compile(_CODE, '<user>', 'exec')
    if _TRACE: sys.settrace(_tr)
    exec(_c, _g)
except _Stop:
    _res['cut'] = True
except SyntaxError as e:
    _res['ok'] = False; _res['err'] = 'SyntaxError: ' + str(e.msg); _res['line'] = e.lineno if e.filename == '<user>' else None; _res['etype'] = 'SyntaxError'
except Exception as e:
    _res['ok'] = False
    tb = [f for f in traceback.extract_tb(e.__traceback__) if f.filename == '<user>']
    _res['line'] = tb[-1].lineno if tb else None
    _res['etype'] = type(e).__name__; _res['err'] = type(e).__name__ + ': ' + str(e)
finally:
    sys.settrace(None); sys.stdout = _old
_res['out'] = _out.getvalue()[:80000]
_res['steps'] = _steps
json.dumps(_res, ensure_ascii=False, default=str)
`;
const PY_REPL=String.raw`
import sys, io, json, traceback, ast
if '_NS' not in globals() or _RESET:
    _NS = {'__name__': '__main__'}
    exec(_PRE, _NS)
_out = io.StringIO(); _old = sys.stdout; sys.stdout = _out
_res = {'ok': True, 'val': None}
try:
    _tree = ast.parse(_CODE, filename='<con>', mode='exec')
    if _tree.body and isinstance(_tree.body[-1], ast.Expr):
        _last = _tree.body[-1]
        _head = ast.Module(body=_tree.body[:-1], type_ignores=[])
        if _head.body: exec(compile(_head, '<con>', 'exec'), _NS)
        _v = eval(compile(ast.Expression(_last.value), '<con>', 'eval'), _NS)
        if _v is not None: _res['val'] = repr(_v)[:5000]
    else:
        exec(compile(_tree, '<con>', 'exec'), _NS)
except Exception as e:
    _res['ok'] = False; _res['err'] = type(e).__name__ + ': ' + str(e)
finally:
    sys.stdout = _old
_res['out'] = _out.getvalue()[:20000]
json.dumps(_res, ensure_ascii=False, default=str)
`;
const WORKER_SRC=`let py=null;
self.onmessage=async(e)=>{const m=e.data;
 try{ if(!py){self.postMessage({id:m.id,status:'Загружаю Python (один раз, ~10 с)…'});importScripts('https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js');py=await loadPyodide();}
  py.globals.set('_CODE',m.code);py.globals.set('_PRE',m.pre||'');py.globals.set('_TRACE',!!m.trace);py.globals.set('_LIM',m.limit||600);py.globals.set('_RESET',!!m.reset);
  const r=await py.runPythonAsync(m.runner);self.postMessage({id:m.id,result:r});
 }catch(err){self.postMessage({id:m.id,fatal:String(err&&err.message||err)});}};`;
const PY={w:null,seq:0,pend:{},ready:false,
 make(){if(this.w)return;const url=URL.createObjectURL(new Blob([WORKER_SRC],{type:'text/javascript'}));this.w=new Worker(url);
  this.w.onmessage=e=>{const m=e.data,p=this.pend[m.id];if(!p)return;if(m.status){p.onStatus&&p.onStatus(m.status);return;}
   clearTimeout(p.to);delete this.pend[m.id];this.ready=true;
   if(m.fatal)p.res({ok:false,err:m.fatal,fatal:true,out:'',steps:[]});else{try{p.res(JSON.parse(m.result));}catch(er){p.res({ok:false,err:'Ошибка разбора результата',out:'',steps:[]});}}};},
 kill(){if(this.w){this.w.terminate();this.w=null;this.ready=false;CON_READY=false;}Object.values(this.pend).forEach(p=>{clearTimeout(p.to);p.res({ok:false,err:'Выполнение остановлено',stopped:true,out:'',steps:[]});});this.pend={};},
 call(msg,opt){opt=opt||{};this.make();const id=++this.seq;
  return new Promise(res=>{const ms=(this.ready?0:60000)+(opt.timeout||15000);
   const to=setTimeout(()=>{delete this.pend[id];this.w.terminate();this.w=null;this.ready=false;CON_READY=false;res({ok:false,err:'Превышено время выполнения ('+Math.round((opt.timeout||15000)/1000)+' с). Возможно, слишком большой диапазон range или бесконечный цикл.',timeout:true,out:'',steps:[]});},ms);
   this.pend[id]={res,to,onStatus:opt.onStatus};this.w.postMessage(Object.assign({id},msg));});},
 run(code,opt){opt=opt||{};return this.call({code,pre:opt.pre!=null?opt.pre:preCode(),trace:!!opt.trace,limit:opt.limit||600,runner:PY_RUNNER},opt);},
 repl(code,opt){opt=opt||{};return this.call({code,pre:preCode(),reset:!!opt.reset,runner:PY_REPL},opt);}};
function translatePythonError(err){
  const raw=String(err||'');
  const m=/^([A-Za-z]+Error):?\s*(.*)$/.exec(raw);
  const type=m?m[1]:'';let detail=m?m[2]:raw;
  const labels={SyntaxError:'Ошибка синтаксиса',IndentationError:'Ошибка отступов',NameError:'Неизвестное имя',TypeError:'Несовместимые типы данных',ValueError:'Недопустимое значение',IndexError:'Индекс вне границ строки или списка',ZeroDivisionError:'Деление на ноль',AttributeError:'Не найден метод или свойство',KeyError:'Нет такого ключа',ImportError:'Не удалось импортировать модуль',ModuleNotFoundError:'Модуль не найден',OverflowError:'Слишком большое числовое значение',RecursionError:'Слишком глубокий вызов функции'};
  const translations=[[/invalid syntax/i,'проверь скобки, кавычки и двоеточия'],[/unexpected indent/i,'убери лишний отступ'],[/expected an indented block/i,'добавь отступ в 4 пробела после if, for, while или def'],[/was never closed/i,'закрой незавершённую скобку или кавычку'],[/is not defined/i,'переменная ещё не создана или в имени опечатка'],[/not supported between instances/i,'сравниваются значения разных типов'],[/can only concatenate str/i,'строку и число нельзя складывать напрямую: преобразуй одно из значений'],[/invalid literal for int/i,'строка не является записью числа в указанном основании'],[/string index out of range/i,'строка короче, чем ожидает индекс'],[/list index out of range/i,'список короче, чем ожидает индекс'],[/division by zero/i,'проверь, что делитель не равен нулю'],[/has no attribute/i,'проверь название метода']];
  const found=translations.find(([re])=>re.test(detail));
  const ru=found?found[1]:(detail?detail.replace(/name '([^']+)' is not defined/,'переменная «$1» не определена'):'проверь указанную строку и типы данных');
  return (labels[type]||'Ошибка Python')+': '+ru;
}
function explainErr(r,code){
  if(!r||r.ok||r.timeout)return '';
  const t=r.etype||'';
  if((code||'').includes(BLANK)&&(t==='NameError'||t==='SyntaxError'))return 'Заполни пустое поле: вместо десяти пробелов вставь нужный код (или нажми «✨ Заполнить поля»).';
  const M={SyntaxError:'Синтаксическая ошибка: проверь двоеточие после if/for/else, парные скобки и кавычки.',IndentationError:'Ошибка отступа: строки внутри цикла или if сдвигаются на 4 пробела.',NameError:'Имя не найдено: переменная используется до присваивания или опечатка в названии.',IndexError:'Выход за границы строки: например, s[1] у однозначной записи или s[-2] у короткой.',TypeError:'Несовместимые типы: строку сложили с числом — нужно str(...) или int(...).',ValueError:'Неверное значение: например, int(\'\', 2) от пустой строки или max() от пустого списка.',ZeroDivisionError:'Деление на ноль: проверь, что список не пустой.',AttributeError:'У объекта нет такого метода: проверь название (count, replace, zfill, rfind).'};
  return M[t]||'';
}

/* ===== Редактор ===== */
const PY_KW=/\b(from|import|for|in|while|if|elif|else|break|continue|def|return|and|or|not|True|False|None|print|len|range|max|min|sorted|set|sum|int|str|list|abs|lambda|join|count|replace|split|findall|finditer|search|fullmatch|match|sub|group|start|end|span|any|all|open|read|readline|strip|key)\b/g;
function hlPy(src,fields,activeField){
  fields=fields||[];let base=0;
  return src.split('\n').map(line=>{let out='',i=0;
    while(i<line.length){
      const slot=fields.find(f=>f.start===base+i);
      if(slot){const end=Math.min(line.length,slot.end-base),txt=line.slice(i,end),classes=['hb'];if(slot.touched)classes.push('touched');if(slot.id===activeField)classes.push('active');out+='<span class="'+classes.join(' ')+'">'+esc(txt)+'</span>';i=end;continue;}
      const c=line[i];
      if(c==='#'){out+='<span class="hc">'+esc(line.slice(i))+'</span>';break;}
      if(c==="'"||c==='"'){let j=i+1;while(j<line.length&&line[j]!==c){if(line[j]==='\\')j++;j++;}const fs=fields.find(f=>f.start>base+i&&f.start<=base+j);if(fs){out+='<span class="hs">'+esc(line.slice(i,fs.start-base))+'</span>';i=fs.start-base;continue;}out+='<span class="hs">'+esc(line.slice(i,j+1))+'</span>';i=j+1;continue;}
      let m=/^[A-Za-z_]\w*/.exec(line.slice(i));
      if(m){const w=m[0];PY_KW.lastIndex=0;out+=PY_KW.test(w)?'<span class="hk">'+w+'</span>':esc(w);PY_KW.lastIndex=0;i+=w.length;continue;}
      m=/^\d+/.exec(line.slice(i));if(m){out+='<span class="hn">'+m[0]+'</span>';i+=m[0].length;continue;}
      out+=esc(c);i++;
    }
    base+=line.length+1;return out;
  }).join('\n');
}
function makeEditor(host,code,opt){
  opt=opt||{};
  host.innerHTML='<div class="ed"><div class="ed-gut"></div><div class="ed-box"><pre class="ed-hl" aria-hidden="true"></pre><pre class="ed-mark" aria-hidden="true"></pre><textarea class="ed-ta" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea></div></div>';
  const ta=host.querySelector('.ed-ta'),hl=host.querySelector('.ed-hl'),gut=host.querySelector('.ed-gut'),mk=host.querySelector('.ed-mark');
  let mark=null,errLine=null,activeField=null,pendingInput=false,nextId=1;
  const valid=(opt.initialFields||[]).filter(f=>Number.isInteger(f.start)&&Number.isInteger(f.end)&&f.start>=0&&f.end<=String(code||'').length).map(f=>({id:nextId++,start:f.start,end:f.end,touched:!!f.touched}));
  let fields=valid;
  const cloneFields=a=>a.map(f=>({...f}));
  const state=()=>({value:ta.value,start:ta.selectionStart,end:ta.selectionEnd,fields:cloneFields(fields),activeField});
  let undoStack=[],redoStack=[],lastState=null;
  const publishHistory=()=>opt.onHistory&&opt.onHistory(undoStack.length>0,redoStack.length>0);
  const remember=s=>{if(!s)return;undoStack.push(s);if(undoStack.length>500)undoStack.shift();redoStack=[];publishHistory();};
  const draw=()=>{const v=ta.value;hl.innerHTML=hlPy(v,fields,activeField)+'\n';const n=v.split('\n').length;
    gut.innerHTML=Array.from({length:n},(_,k)=>'<div class="'+(k+1===mark?'on ':'')+(k+1===errLine?'er':'')+'">'+(k+1)+'</div>').join('');
    mk.innerHTML=Array.from({length:n},(_,k)=>'<div class="'+(k+1===mark?'on ':'')+(k+1===errLine?'er':'')+'"> </div>').join('');
    ta.style.height='auto';ta.style.height=Math.max(ta.scrollHeight,(opt.minLines||6)*21+16)+'px';};
  const remapFields=(oldV,newV)=>{let p=0;while(p<oldV.length&&p<newV.length&&oldV[p]===newV[p])p++;let oe=oldV.length,ne=newV.length;while(oe>p&&ne>p&&oldV[oe-1]===newV[ne-1]){oe--;ne--;}const d=ne-oe;
    fields=fields.flatMap(f=>{if(oe<=f.start){f.start+=d;f.end+=d;return [f];}if(p>f.end||(p===f.end&&!(oe===p&&f.id===activeField)))return [f];if(p>=f.start&&oe<=f.end){f.end=Math.max(f.start,f.end+d);return [f];}if(p<=f.start&&oe>=f.end)return [];const map=x=>x<=p?x:x>=oe?x+d:(x===f.start?p:ne);f.start=map(f.start);f.end=map(f.end);return f.end>f.start?[f]:[];});
  };
  const report=()=>{draw();lastState=state();opt.onChange&&opt.onChange(ta.value,fields.map(({start,end,touched})=>({start,end,touched})));};
  const replaceEmptySlot=(f,text)=>{const before=ta.value;remember(lastState);const start=f.start,oldEnd=f.end,delta=text.length-(oldEnd-start);ta.value=before.slice(0,start)+text+before.slice(oldEnd);fields.forEach(q=>{if(q===f){q.end=start+text.length;q.touched=true;}else if(q.start>=oldEnd){q.start+=delta;q.end+=delta;}});activeField=f.id;ta.focus();ta.setSelectionRange(start+text.length,start+text.length);report();};
  ta.value=code||'';lastState=state();
  ta.addEventListener('click',()=>{const p=ta.selectionStart,f=fields.find(q=>p>=q.start&&p<=q.end);activeField=f?f.id:null;if(f)f.touched=true;draw();lastState=state();});
  ta.addEventListener('keyup',()=>{lastState=state();});
  ta.addEventListener('select',()=>{lastState=state();});
  ta.addEventListener('beforeinput',e=>{
    const p=ta.selectionStart,f=fields.find(q=>q.id===activeField&&p>=q.start&&p<=q.end)||fields.find(q=>p>=q.start&&p<=q.end);
    if(f&&ta.value.slice(f.start,f.end)===BLANK&&['insertText','insertFromPaste','insertCompositionText'].includes(e.inputType)){
      let txt=e.data;if(txt==null&&e.dataTransfer)txt=e.dataTransfer.getData('text/plain');if(txt==null&&e.inputType==='insertFromPaste'&&e.clipboardData)txt=e.clipboardData.getData('text/plain');
      if(txt!=null){e.preventDefault();activeField=f.id;replaceEmptySlot(f,String(txt));return;}
    }
    if(!pendingInput){remember(lastState);pendingInput=true;}
  });
  ta.addEventListener('input',()=>{const old=lastState&&lastState.value!=null?lastState.value:ta.value;if(!pendingInput&&old!==ta.value)remember(lastState);pendingInput=false;
    const oldActive=activeField,oldFields=fields;remapFields(old,ta.value);let f=fields.find(q=>q.id===oldActive);
    if(f&&f.start===f.end){const p=f.start,delta=BLANK.length;ta.value=ta.value.slice(0,p)+BLANK+ta.value.slice(p);f.end=p+delta;ta.setSelectionRange(p,p);}
    if(activeField&&!fields.some(q=>q.id===activeField))activeField=null;
    errLine=null;draw();lastState=state();opt.onChange&&opt.onChange(ta.value,fields.map(({start,end,touched})=>({start,end,touched})));publishHistory();});
  ta.addEventListener('keydown',e=>{
    if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='z'){e.preventDefault();e.shiftKey?redo():undo();return;}
    if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='y'){e.preventDefault();redo();return;}
    if(e.key==='Tab'){e.preventDefault();const v=ta.value,p=ta.selectionEnd;
      if(!e.shiftKey){let k=v.indexOf(BLANK,p);if(k<0)k=v.indexOf(BLANK);if(k>=0){const f=fields.find(q=>q.start===k);if(f){f.touched=true;activeField=f.id;}ta.setSelectionRange(k,k);ta.focus();draw();lastState=state();return;}document.execCommand('insertText',false,'    ');}
      else{const ls=v.lastIndexOf('\n',ta.selectionStart-1)+1;if(v.slice(ls,ls+4)==='    '){ta.setSelectionRange(ls,ls+4);document.execCommand('insertText',false,'');}}}
    else if((e.ctrlKey||e.metaKey)&&e.key==='Enter'){e.preventDefault();opt.onRun&&opt.onRun();}
    else if(e.key==='Enter'&&!e.shiftKey){
      const v=ta.value,p=ta.selectionStart,ls=v.lastIndexOf('\n',p-1)+1,le=v.indexOf('\n',p),line=v.slice(ls,le<0?v.length:le),rest=v.slice(le<0?v.length:le).trim();
      if(opt.onRun&&/^print\(/.test(line.trim())&&p>=(le<0?v.length:le)&&!rest){e.preventDefault();opt.onRun();return;}
      e.preventDefault();const head=v.slice(ls,p);let ind=/^\s*/.exec(head)[0];if(/:\s*$/.test(head))ind+='    ';if(/^\s*(break|continue|return|pass)\b/.test(head))ind=ind.slice(4);document.execCommand('insertText',false,'\n'+ind);}
  });
  ta.addEventListener('scroll',()=>{hl.scrollLeft=ta.scrollLeft;mk.scrollLeft=ta.scrollLeft;});
  function restore(from,to){if(!from.length)return;const target=from.pop();to.push(state());ta.value=target.value;fields=cloneFields(target.fields);activeField=target.activeField;ta.setSelectionRange(Math.min(target.start,ta.value.length),Math.min(target.end,ta.value.length));errLine=null;draw();lastState=state();opt.onChange&&opt.onChange(ta.value,fields.map(({start,end,touched})=>({start,end,touched})));publishHistory();}
  function undo(){restore(undoStack,redoStack);}function redo(){restore(redoStack,undoStack);}
  draw();publishHistory();
  return {get:()=>ta.value,set:(v,addedFields,replace)=>{const old=ta.value;if(old===v&&!addedFields)return;remember(lastState);ta.value=v;if(replace)fields.length=0;else remapFields(old,v);(addedFields||[]).forEach(f=>fields.push({id:nextId++,start:f.start,end:f.end,touched:!!f.touched}));fields.sort((a,b)=>a.start-b.start);activeField=null;errLine=null;draw();ta.setSelectionRange(ta.value.length,ta.value.length);lastState=state();opt.onChange&&opt.onChange(ta.value,fields.map(({start,end,touched})=>({start,end,touched})));},
    insert(text){const a=ta.selectionStart,b=ta.selectionEnd,v=ta.value,next=v.slice(0,a)+text+v.slice(b),added=[];let p=0;while((p=text.indexOf(BLANK,p))>=0){added.push({start:a+p,end:a+p+BLANK.length,touched:false});p+=BLANK.length;}this.set(next,added);ta.focus();ta.setSelectionRange(a+text.length,a+text.length);lastState=state();draw();},
    focusAt:p=>{const f=fields.find(q=>p>=q.start&&p<=q.end);if(f){activeField=f.id;f.touched=true;}ta.focus();ta.setSelectionRange(p,p);draw();lastState=state();},
    fields:()=>fields.map(({start,end,touched})=>({start,end,touched})),undo,redo,
    mark:l=>{mark=l;draw();},err:l=>{errLine=l;draw();},ta,
    caretLine:()=>ta.value.slice(0,ta.selectionStart).split('\n').length-1};
}
/* ===== Данные ===== */
let DATA = JSON.parse(document.getElementById('rxdata').textContent);
const SOURCE = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
const APPNAME = 'ЕГЭ 24 · Тренажёр по алгоритмам обработки строк';
const LSKEY = 'ege24_rx_v1', LSCLR = LSKEY + '_clr';
let BLOCKS = DATA.blocks.map(b => ({id: b[0], name: b[1], desc: b[2]}));
let BK = Object.fromEntries(BLOCKS.map(b => [b.id, b]));
let TASKS = DATA.tasks;
let TK = Object.fromEntries(TASKS.map(t => [t.id, t]));
function cleanLegacyTaskData() {
  const valid = new Set(TASKS.map(t => String(t.id)));
  DB.flags = DB.flags || {};
  Object.keys(DB.flags).forEach(id => { if (!valid.has(String(id))) delete DB.flags[id]; });
  Object.values(DB.students || {}).forEach(st => {
    st.tasks = st.tasks || {};
    Object.keys(st.tasks).forEach(id => { if (!valid.has(String(id))) delete st.tasks[id]; });
    // Old task counters and traces must not leak into reports for a new bank.
    st.con = 0; st.dbg = 0;
  });
  DB.teacher.realAns = {};
  DB.teacherUpdated = Date.now();
}

function loadTaskJSON(obj) {
  // Поддерживаются два формата: плоский tasks[] и families[] (основная задача + аналоги).
  if (!obj || typeof obj !== 'object') throw new Error('Ожидается JSON-объект');
  let blocks = Array.isArray(obj.blocks) ? obj.blocks : []; 
  let tasks = Array.isArray(obj.tasks) ? obj.tasks.slice() : [];
  if (Array.isArray(obj.families)) {
    obj.families.forEach((fam, n) => {
      if (!fam || !fam.main) throw new Error('В families['+n+'] нет main');
      const root = Object.assign({}, fam.main, {role:'main', like:''});
      tasks.push(root);
      (fam.analogs || []).forEach(a => tasks.push(Object.assign({}, a, {role:'hw', like:String(root.id)})));
    });
  }
  if (!Array.isArray(blocks) || !blocks.length || !Array.isArray(tasks)) throw new Error('В JSON нужен непустой массив blocks и массив tasks или families');
  const ids = new Set();
  tasks = tasks.map((t,i) => {
    if (!t || t.id == null || !t.real || !t.methods || typeof t.methods !== 'object') throw new Error('Задача '+(i+1)+': обязательны id, real и methods');
    t = Object.assign({blk: blocks[0]?.[0] || '', role:'main', like:'', title:'', idea:'', note:'', ask:'', s:'', ans:'', tpl:'', methods:{}, final:'', flags:'', tree:[], groups:0, main:'prefix', norx:false, d:2, alias:'', realAns:'', src2:'', src:'', lvl:'', file:'', alts:[]},t);
    t.id=String(t.id); if(ids.has(t.id)) throw new Error('Повторяется id задачи '+t.id); ids.add(t.id);
    if(!['main','hw'].includes(t.role)) throw new Error('У задачи '+t.id+' role должен быть main или hw');
    if (!blocks.some(b => String(b[0]) === String(t.blk))) throw new Error('У задачи '+t.id+' неизвестный раздел blk: '+t.blk);
    return t;
  });
  const map=new Set(tasks.map(t=>t.id));
  tasks.forEach(t=>{ if(t.role==='hw') { const parent=tasks.find(x=>x.id===String(t.like)); if(!parent || parent.role!=='main') throw new Error('У аналога '+t.id+' поле like должно указывать на id основной задачи'); } });
  DATA={blocks,tasks}; BLOCKS=blocks.map(b=>({id:b[0],name:b[1],desc:b[2]||''})); BK=Object.fromEntries(BLOCKS.map(b=>[b.id,b])); TASKS=tasks; TK=Object.fromEntries(tasks.map(t=>[t.id,t]));
  cleanLegacyTaskData();
  cur.id=null; cur.view='home'; viewHome(); toast('Загружено задач: '+tasks.length+' · основных: '+tasks.filter(t=>t.role==='main').length+' · аналогов: '+tasks.filter(t=>t.role==='hw').length,4500);
}
const byD = (a, b) => (a.d || 2) - (b.d || 2);
const MAINS = b => TASKS.filter(t => t.blk === b && t.role === 'main').sort(byD);
const HWS = b => { const M = MAINS(b).map(t => t.id); return TASKS.filter(t => t.blk === b && t.role === 'hw').sort((x, y) => (M.indexOf(x.like) - M.indexOf(y.like)) || byD(x, y)); };
const ANALOGS = id => TASKS.filter(t => t.like === id).sort(byD);
const MLAB = {prefix: '📊 Префиксные суммы', two: '↔️ Два указателя', window: '🪟 Скользящее окно', loops: '🔁 Один проход / циклы', split: '✂ split / replace'};
const MK = t => t.main || 'prefix';
const mainLabel = t => (MLAB[MK(t)] || MK(t)) + ' — заготовка с полями';
const REAL = id => ((DB.teacher.realAns || {})[id]) || (TK[id] && TK[id].realAns) || '';
const DSTARS = t => '●'.repeat(Math.min(5, t.d || 2));
const ORDER = BLOCKS.flatMap(b => MAINS(b.id).flatMap(m => [m.id]).concat(HWS(b.id).map(t => t.id)));
function preCode() { return ''; }
const esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

/* ===== Хранилище ===== */
function blankDB() { return {v: 1, teacher: {name: '', email: '', tg: '', pin: '31415', repAns: false, realAns: {}, noFillAsk: false, noMethAsk: true}, flags: {}, students: {}, last: '', theme: 'light', teacherUpdated: 0}; }
function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
function normX(x) { x.st = x.st || 'new'; x.wrong = x.wrong || []; ['tries', 'hint', 't', 'runs', 'dbg'].forEach(k => { if (x[k] == null) x[k] = 0; }); return x; }
function loadDB() {
  let saved = null, local = null;
  try { const el = document.getElementById('saved-state'); const t = el && el.textContent.trim(); if (t && t !== '{}') saved = JSON.parse(t); } catch (e) {}
  try { const t = lsGet(LSKEY); if (t) local = JSON.parse(t); } catch (e) {}
  const clr = +(lsGet(LSCLR) || 0), db = blankDB(); let tu = -1;
  [saved, local].forEach(src => {
    if (!src) return;
    if (src.teacher && (src.teacherUpdated || 0) >= tu) { db.teacher = Object.assign(blankDB().teacher, src.teacher); db.flags = src.flags || {}; tu = src.teacherUpdated || 0; }
    Object.values(src.students || {}).forEach(s => { if (src === saved && (s.updated || 0) <= clr) return; const c = db.students[s.name]; if (!c || (s.updated || 0) > (c.updated || 0)) db.students[s.name] = s; });
    if (src.last) db.last = src.last; if (src.theme) db.theme = src.theme;
  });
  db.teacherUpdated = Math.max(0, tu);
  Object.values(db.students).forEach(s => { s.tasks = s.tasks || {}; Object.values(s.tasks).forEach(normX); s.days = s.days || []; s.totalMs = s.totalMs || 0; });
  return db;
}
let DB = loadDB(), dirty = false, saveT = null, lsWarned = false;
function persist() { dirty = true; clearTimeout(saveT); saveT = setTimeout(writeLS, 300); }
function compactDB() {
  const d = JSON.parse(JSON.stringify(DB));
  Object.values(d.students).forEach(s => {
    Object.keys(s.tasks).forEach(n => { const x = s.tasks[n];
      if (x.wrong && x.wrong.length > 8) x.wrong = x.wrong.slice(-8);
      if (x.code && x.code.length > 4000) x.code = x.code.slice(0, 4000);
      if (x.t) x.t = Math.round(x.t / 1000) * 1000;
      if (x.st === 'new' && !(x.wrong || []).length && !x.tries && !x.hint && !x.code && !x.real && !x.runs) { delete s.tasks[n]; return; }
      ['tries', 'hint', 't', 'runs', 'dbg'].forEach(k => { if (!x[k]) delete x[k]; }); if (x.wrong && !x.wrong.length) delete x.wrong; });
    if (s.days.length > 90) s.days = s.days.slice(-90);
  });
  Object.keys(d.flags).forEach(k => { const f = d.flags[k]; if (!f.hw && !f.fav) delete d.flags[k]; });
  return d;
}
function writeLS() { clearTimeout(saveT);
  try { localStorage.setItem(LSKEY, JSON.stringify(compactDB())); lsWarned = false; }
  catch (e) { if (!lsWarned) { lsWarned = true; toast('⚠️ Память браузера переполнена. Сохрани файл (💾), затем «🧹 Очистить прогресс» у учителя.', 6000); } } }
function lsUsage() { let all = 0, mine = 0; try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i), v = localStorage.getItem(k) || ''; all += (k.length + v.length) * 2; if (k.startsWith(LSKEY)) mine += (k.length + v.length) * 2; } } catch (e) {} return {all, mine}; }
const kb = b => b < 1024 ? b + ' Б' : b < 1048576 ? (b / 1024).toFixed(1).replace('.', ',') + ' КБ' : (b / 1048576).toFixed(2).replace('.', ',') + ' МБ';
function storeBox() { const u = lsUsage(); return `<div class="store">💽 Тренажёр занимает в браузере <b>${kb(u.mine)}</b> · все сайты этого адреса: ${kb(u.all)} из ~5 МБ<i><b style="width:${Math.min(100, u.all / 5242880 * 100).toFixed(1)}%"></b></i></div>`; }
function clearAll() { DB.students = {}; DB.last = ''; try { localStorage.setItem(LSCLR, String(Date.now())); } catch (e) {} writeLS(); }
const cur = {name: '', id: null, blk: null, since: 0, timer: null, view: 'home', filter: 'all', teach: false, open: {}};
function stu() { return DB.students[cur.name]; }
function newStudent(name) { return {name, created: Date.now(), updated: Date.now(), tasks: {}, totalMs: 0, days: [], cur: null, con: 0, sand: 0, dbg: 0, theory: {}}; }
function X(id, s) { s = s || stu(); if (!s.tasks[id]) s.tasks[id] = {st: 'new', wrong: [], tries: 0, hint: 0, t: 0, runs: 0, dbg: 0}; return normX(s.tasks[id]); }
const solved = x => !!(x && x.st && x.st !== 'new');
const ST_LABEL = {ok: 'Сам, с первой попытки', err: 'Сам, после ошибок', hint: 'С подсказкой', fill: 'После «Заполнить поля» / готового кода', mark: 'Отмечено учителем', new: 'Не решено'};
function bump() { const s = stu(); if (s) { s.updated = Date.now(); persist(); } }
function tickTime() { if (cur.name && cur.id && cur.since && stu()) { const d = Math.min(Date.now() - cur.since, 5 * 60000); X(cur.id).t += d; stu().totalMs += d; cur.since = Date.now(); } }
function dstamp() { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
function fmtT(ms) { const m = Math.round(ms / 60000); if (m < 1) return '<1 мин'; const h = Math.floor(m / 60); return h ? h + ' ч ' + (m % 60) + ' мин' : m + ' мин'; }
const FL = id => DB.flags[id] || {};
function setFlag(id, k, v) { DB.flags[id] = Object.assign({}, DB.flags[id], {[k]: v}); DB.teacherUpdated = Date.now(); persist(); }

/* сохранение файла приложения */
let DLNS = null; try { if (window.claude && typeof claude.use === 'function') claude.use('downloads').then(x => { DLNS = x; }).catch(() => {}); } catch (e) {}
async function download(blob, name) {
  if (DLNS) { try { await DLNS.save({filename: name, data: blob}); return; } catch (e) { if (e && (e.code === 'declined' || e.code === 'rate_limited')) return; } }
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 4000);
}
function saveApp(only) {
  if (typeof only !== 'string') only = null; tickTime(); writeLS();
  let data = compactDB(); if (only === '__none__') { data.students = {}; data.last = ''; only = null; } else if (only) { data.students = {[only]: data.students[only]}; data.last = only; }
  const json = JSON.stringify(data).replace(/</g, '\\u003c');
  const open = '<script id="saved-state" type="application/json">';
  const i = SOURCE.indexOf(open), j = SOURCE.indexOf('<\/script>', i);
  let html = SOURCE.slice(0, i + open.length) + json + SOURCE.slice(j);
  const dopen='<script id="rxdata" type="application/json">', di=html.indexOf(dopen), dj=html.indexOf('</scr'+'ipt>',di);
  if(di>=0&&dj>di) html=html.slice(0,di+dopen.length)+JSON.stringify(DATA).replace(/</g,'\\u003c')+html.slice(dj);
  download(new Blob([html], {type: 'text/html'}), (only ? only.replace(/[^\wА-Яа-яЁё-]+/g, '_') + '_' : '') + 'алгоритмы_строк_ЕГЭ24_' + dstamp() + '.html');
  dirty = false; toast('💾 Файл сохранён. В следующий раз открывай именно его — прогресс внутри!', 3500);
}
window.addEventListener('beforeunload', e => { tickTime(); writeLS(); if (dirty && cur.name) { e.preventDefault(); e.returnValue = ''; } });

/* ===== UI-утилиты ===== */
const $ = s => document.querySelector(s);
const app = () => document.getElementById('app');
function toast(m, ms) { document.querySelectorAll('.toast').forEach(z => z.remove()); const d = document.createElement('div'); d.className = 'toast'; d.innerHTML = m; document.body.appendChild(d); setTimeout(() => d.remove(), ms || 2800); }
let MCLEAN = null;
function modal(html, cls) { closeModal(); const m = document.createElement('div'); m.className = 'mbg'; m.id = 'mbg'; m.innerHTML = `<div class="mdl ${cls || ''}">${html}</div>`; m.addEventListener('mousedown', e => { if (e.target === m) closeModal(); }); document.body.appendChild(m); return m; }
function closeModal() { const f = MCLEAN; MCLEAN = null; if (f) f(); const m = document.getElementById('mbg'); if (m) m.remove(); closeMenu(); }
function confirmBox(q, yes, y) { modal(`<h2 style="font-size:19px">${q}</h2><div class="row"><button class="btn pri" id="cy">${y || 'Да'}</button><button class="btn ghost" id="cn">Отмена</button></div>`); $('#cy').onclick = () => { closeModal(); yes(); }; $('#cn').onclick = closeModal; }
function applyTheme() { document.documentElement.setAttribute('data-theme', DB.theme === 'dark' ? 'dark' : 'light'); }
function lastLine(o) { const L = String(o || '').replace(/\s+$/, '').split('\n'); return (L[L.length - 1] || '').trim(); }
const normA = v => String(v == null ? '' : v).trim().replace(/\s+/g, ' ').replace(/^['"]|['"]$/g, '').toUpperCase();
function closeMenu() { document.querySelectorAll('.menu').forEach(m => m.remove()); }
function popMenu(anchor, items, title) { if (anchor._menu && document.body.contains(anchor._menu)) { closeMenu(); anchor._menu = null; return; } closeMenu(); const r = anchor.getBoundingClientRect(); const m = document.createElement('div'); m.className = 'menu';
  m.innerHTML = (title ? `<small>${title}</small>` : '') + items.map((it, i) => `<button data-i="${i}">${esc(it[0])}</button>`).join('');
  m.style.left = Math.min(r.left + window.scrollX, window.innerWidth - 300) + 'px'; m.style.top = (r.bottom + window.scrollY + 4) + 'px'; document.body.appendChild(m); anchor._menu = m;
  m.addEventListener('click', e => e.stopPropagation());
  m.querySelectorAll('button').forEach(b => b.onclick = e => { e.stopPropagation(); closeMenu(); items[+b.dataset.i][1](); });
  const off = e => { if (anchor.contains(e.target)) { document.addEventListener('click', off, {once: true}); return; } closeMenu(); };
  setTimeout(() => document.addEventListener('click', off, {once: true}), 0); }
function askPin(then) {
  if (cur.teach) { then(); return; }
  modal(`<h2>👩‍🏫 Вход для учителя</h2><p style="color:var(--mut)">Введите PIN (по умолчанию 31415).</p><div class="row"><input class="inp" id="pin" type="password" inputmode="numeric" style="width:160px"><button class="btn pri" id="pok">Войти</button></div><div class="fb bad" id="pfb">Неверный PIN</div>`);
  const go = () => { if ($('#pin').value.trim() === String(DB.teacher.pin)) { cur.teach = true; closeModal(); then(); } else $('#pfb').classList.add('show'); };
  $('#pok').onclick = go; $('#pin').onkeydown = e => { if (e.key === 'Enter') go(); }; setTimeout(() => { const p = $('#pin'); if (p) p.focus(); }, 50);
}
function confetti() {
  const c = document.createElement('canvas'); c.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:300'; c.width = innerWidth; c.height = innerHeight; document.body.appendChild(c);
  const g = c.getContext('2d'), P = Array.from({length: 110}, () => ({x: innerWidth / 2, y: innerHeight / 3, vx: (Math.random() - .5) * 16, vy: Math.random() * -12 - 3, c: ['#4f6bff', '#7b5cff', '#16a36a', '#ffd666', '#ff8a00', '#e5484d'][Math.random() * 6 | 0], r: Math.random() * 6 + 3}));
  let k = 0; (function f() { g.clearRect(0, 0, c.width, c.height); P.forEach(p => { p.x += p.vx; p.y += p.vy; p.vy += .45; g.fillStyle = p.c; g.fillRect(p.x, p.y, p.r, p.r * .6); }); if (++k < 90) requestAnimationFrame(f); else c.remove(); })();
}

/* ===== Списки задач и фильтры ===== */
function counts(s, list) { s = s || stu(); const L = list || ORDER; const c = {ok: 0, err: 0, hint: 0, fill: 0, mark: 0, new: 0, total: L.length}; L.forEach(id => { const x = s.tasks[id]; c[x && x.st ? x.st : 'new']++; }); c.done = c.total - c.new; return c; }
const hwList = () => ORDER.filter(id => FL(id).hw);
function filterIds(ids) {
  const s = stu();
  if (cur.filter === 'hw') return ids.filter(id => FL(id).hw);
  if (cur.filter === 'fav') return ids.filter(id => FL(id).fav);
  if (cur.filter === 'new') return ids.filter(id => !solved(s.tasks[id]));
  return ids;
}
function navList() {
  const s = stu();
  if (cur.filter === 'hw') return hwList();
  if (cur.filter === 'fav') return ORDER.filter(id => FL(id).fav);
  if (cur.filter === 'new') return ORDER.filter(id => !solved(s.tasks[id]));
  return ORDER;
}
function nextUnsolved(from) { const s = stu(), L = navList(), i = Math.max(0, L.indexOf(from)); for (let k = 1; k <= L.length; k++) { const id = L[(i + k) % L.length]; if (!solved(s.tasks[id])) return id; } return null; }

/* ===== Вход и главная ===== */
function viewLogin() {
  cur.name = ''; cur.id = null;
  const names = Object.keys(DB.students).sort((a, b) => (DB.students[b].updated || 0) - (DB.students[a].updated || 0));
  app().innerHTML = `<div class="login"><div class="hero"><h1>ЕГЭ · Задание 24</h1><p>Алгоритмы обработки строк на Python: префиксные суммы, два указателя и скользящее окно.</p>
  <div class="code-deco">p = [0] * (len(s) + 1)\nfor i in range(len(s)):\n    p[i + 1] = p[i] + int(s[i])\n\n# два указателя / скользящее окно</div></div>
  <div class="card"><h3 style="margin:0 0 8px">Как тебя зовут?</h3>
  <div class="row"><input class="inp" id="nm" placeholder="Фамилия и имя" style="flex:1;min-width:200px" value="${esc(DB.last)}"><button class="btn pri" id="go">Начать →</button></div>
  ${names.length ? `<div style="margin-top:12px;color:var(--mut);font-size:13px">Уже занимались на этом устройстве:</div><div class="slist">${names.map(n => `<button data-n="${esc(n)}">${esc(n)}</button>`).join('')}</div>` : ''}
  <div class="row" style="margin-top:16px;justify-content:flex-end"><button class="ib" id="th">🌓</button><button class="ib" id="tch">👩‍🏫 Учитель</button></div></div></div>`;
  const go = n => { n = (n || '').trim().replace(/\s+/g, ' '); if (!n) { $('#nm').focus(); return; } enter(n); };
  $('#go').onclick = () => go($('#nm').value); $('#nm').onkeydown = e => { if (e.key === 'Enter') go($('#nm').value); };
  document.querySelectorAll('.slist button').forEach(b => b.onclick = () => go(b.dataset.n));
  $('#th').onclick = () => { DB.theme = DB.theme === 'dark' ? 'light' : 'dark'; applyTheme(); persist(); };
  $('#tch').onclick = () => askPin(() => viewTeacher());
}
function enter(name) {
  cur.name = name; DB.last = name; if (!DB.students[name]) DB.students[name] = newStudent(name);
  const s = stu(), d = dstamp(); if (!s.days.includes(d)) s.days.push(d);
  clearInterval(cur.timer); cur.timer = setInterval(tickTime, 20000); persist(); viewHome();
}
function topbar() {
  return `<div class="top"><div class="logo" id="lg"><i>.*</i><span>ЕГЭ 24 · Алгоритмы строк</span></div><div class="sp"></div>
  <button class="ib" id="tSand" title="Пошаговое исследование строки и алгоритмов">🧪 Тренажёр-туннель</button><button class="ib" id="tCheat" title="Памятка по алгоритмам обработки строк">📘 Памятка по алгоритмам</button><button class="ib" id="tJSON" title="Загрузить банк задач из JSON">📥 Загрузить JSON</button><input id="jsonFile" type="file" accept=".json,application/json" hidden>
  <button class="ib" id="tRep">📄 Отчёт</button><button class="ib" id="tSave" title="Сохранить файл с прогрессом">💾</button><button class="ib" id="tTheme">🌓</button><button class="ib" id="tTch" title="Учитель">👩‍🏫</button>
  <span class="who">🙂 ${esc(cur.name)}</span><button class="ib" id="tOut" title="Выйти">⎋</button></div>`;
}
function bindTop() {
  const on = (id, f) => { const e = document.getElementById(id); if (e) e.onclick = f; };
  on('lg', () => { tickTime(); viewHome(); });
  on('tSand', () => openTunnel());
  on('tJSON', () => $('#jsonFile').click());
  const jf = $('#jsonFile'); if (jf) jf.onchange = async () => { const f=jf.files&&jf.files[0]; if(!f)return; try { const obj=JSON.parse(await f.text()); loadTaskJSON(obj); } catch(e) { toast('Не удалось загрузить JSON: '+esc(e.message),5000); } jf.value=''; }; on('tCheat', () => openMethodsGuide());
  on('tRep', () => { tickTime(); reportDialog(cur.name, cur.teach); }); on('tSave', () => saveApp(cur.name));
  on('tTheme', () => { DB.theme = DB.theme === 'dark' ? 'light' : 'dark'; applyTheme(); persist(); });
  on('tTch', () => { tickTime(); askPin(() => viewTeacher()); }); on('tOut', () => { tickTime(); persist(); cur.teach = false; viewLogin(); });
}
function viewHome() {
  cur.view = 'home'; cur.id = null; const s = stu(), c = counts(s), hw = hwList(), ch = counts(s, hw);
  app().innerHTML = topbar() + `<div class="home2">
   <div class="hcol">
    <h2 style="margin:4px 0 10px">Банк задач</h2>${TASKS.length ? '<p class="vhint">Выбери раздел, чтобы открыть задачи.</p>' : '<div class="card"><b>Банк задач пока пуст.</b><p>Загрузи JSON с задачами и их аналогами кнопкой «📥 Загрузить JSON». Связи между основной задачей и аналогами будут построены по полю <code>like</code>.</p></div>'}
    ${TASKS.length ? BLOCKS.map((b, i) => { const ids = MAINS(b.id).map(t => t.id).concat(HWS(b.id).map(t => t.id)), cc = counts(s, ids);
      return `<button class="bline" data-b="${b.id}"><span class="bn">${b.id === 'RS' ? '★' : i + 1}</span><span class="bt"><b>${esc(b.name)}</b><small>${esc(b.desc)}</small></span><span class="bp"><b>${cc.done}/${cc.total}</b><i><em style="width:${cc.total ? cc.done / cc.total * 100 : 0}%"></em></i></span></button>`; }).join('') : ''}
   </div>
   <div class="hcol">
    ${hw.length ? `<button class="hmc hwc" id="hHW"><div class="big">🏠</div><h2>Домашнее задание</h2><div>Учитель отметил ${hw.length} задач. Решено ${ch.done} из ${ch.total}.</div><div class="pb"><i style="width:${ch.total ? ch.done / ch.total * 100 : 0}%"></i></div></button>` : ''}
    ${TASKS.length ? `<button class="hmc" id="hGo"><div class="big">🧩</div><h2>Продолжить</h2><div>Всего задач: ${c.total}. Решено ${c.done}.</div><div class="pb"><i style="width:${c.total ? c.done / c.total * 100 : 0}%"></i></div></button>` : ''}
    <button class="hmc" id="hMethods"><div class="big">📘</div><h2>Методы обработки строк</h2><div>Префиксные суммы, два указателя и скользящее окно: идеи, схемы и шаблоны кода.</div></button>
    <div class="row"><button class="btn" id="hSand">🧪 Тренажёр-туннель</button><button class="btn" id="hCheat">📘 Памятка по алгоритмам</button></div>
   </div></div>`;
  bindTop();
  document.querySelectorAll('.bline').forEach(b => b.onclick = () => openBlock(b.dataset.b));
  if ($('#hHW')) $('#hHW').onclick = () => { cur.filter = 'hw'; const L = hwList(); openTask(L.find(id => !solved(s.tasks[id])) || L[0]); };
  if ($('#hGo')) $('#hGo').onclick = () => { cur.filter = 'all'; if (s.cur && TK[s.cur]) openTask(s.cur); else if (BLOCKS.length) openBlock(BLOCKS[0].id); };
  $('#hMethods').onclick = () => openMethodsGuide(); $('#hSand').onclick = () => openTunnel(); $('#hCheat').onclick = () => openMethodsGuide();
}

/* ===== Боковая панель ===== */
function stClass(x) { return x && x.st && x.st !== 'new' ? x.st : (x && x.wrong && x.wrong.length ? 'tried' : ''); }
function chip(id) {
  const s = stu(), x = s.tasks[id], t = TK[id], f = FL(id);
  return `<button class="it ${stClass(x)} ${id === cur.id ? 'cur' : ''} ${t.role === 'hw' ? 'hwt' : ''}" data-id="${id}" title="${esc((t.real || '').slice(0, 140))}">${esc(id)}${f.hw ? '<sup class="fh">Д</sup>' : ''}${f.fav ? '<sup class="ff">★</sup>' : ''}</button>`;
}
function sidebar() {
  const s = stu(), c = counts(s);
  const pr = ['ok', 'err', 'hint', 'fill', 'mark'].map(k => `<i style="width:${c.total ? c[k] / c.total * 100 : 0}%;background:${{ok: '#16a36a', err: '#7bd3a7', hint: '#ffd666', fill: '#ffb27a', mark: '#9aa6ff'}[k]}"></i>`).join('');
  const nhw = hwList().length, nfav = ORDER.filter(id => FL(id).fav).length;
  let h = `<div class="filt">${[['all', 'Все'], ['hw', '🏠 ДЗ' + (nhw ? ' ' + nhw : '')], ['fav', '★' + (nfav ? ' ' + nfav : '')], ['new', 'Не решено']].map(([k, n]) => `<button data-f="${k}" class="${cur.filter === k ? 'on' : ''}">${n}</button>`).join('')}</div>
   <div style="font-weight:800;margin-top:6px">Решено: ${c.done} / ${c.total}</div><div class="prog">${pr}</div>`;
  if (cur.filter !== 'all') {
    const L = navList();
    if (!L.length) h += `<p class="vhint">${cur.filter === 'hw' ? 'Учитель пока не отметил задачи для домашней работы.' : cur.filter === 'fav' ? 'Избранных задач пока нет.' : 'Всё решено! 🎉'}</p>`;
    BLOCKS.forEach(b => { const ids = L.filter(id => TK[id].blk === b.id); if (!ids.length) return;
      h += `<div class="sec"><div class="sech"><span class="bid">${b.id === 'RS' ? '★' : b.id}</span>${esc(b.name)}</div><div class="its">${ids.map(chip).join('')}</div></div>`; });
  } else {
    BLOCKS.forEach(b => {
      const mains = MAINS(b.id), hws = HWS(b.id), all = mains.concat(hws).map(t => t.id), dn = all.filter(id => solved(s.tasks[id])).length;
      const open = cur.open[b.id];
      h += `<div class="sec ${cur.blk === b.id && cur.view === 'block' ? 'cur' : ''}"><button class="sech sb" data-b="${b.id}"><span class="bid">${b.id === 'RS' ? '★' : b.id}</span>${esc(b.name)}<small>${dn}/${all.length}</small></button>
       <div class="its">${mains.map(t => chip(t.id)).join('')}</div>
       ${hws.length ? `<button class="hwbtn" data-o="${b.id}">${open ? '▾' : '▸'} Для самостоятельной работы · ${hws.filter(t => solved(s.tasks[t.id])).length}/${hws.length}</button>${open ? `<div class="hwbox">${mains.map(m => { const a = hws.filter(t => t.like === m.id); return a.length ? `<div class="hwg"><span>аналоги ${esc(m.id)}:</span>${a.map(t => chip(t.id)).join('')}</div>` : ''; }).join('')}${(() => { const rest = hws.filter(t => !mains.some(m => m.id === t.like)); return rest.length ? `<div class="hwg">${rest.map(t => chip(t.id)).join('')}</div>` : ''; })()}</div>` : ''}` : ''}</div>`;
    });
  }
  h += `<div class="legend"><span><i style="background:#16a36a"></i>сам</span><span><i style="background:#7bd3a7"></i>после ошибок</span><span><i style="background:#ffd666"></i>с подсказкой</span><span><i style="background:#ffb27a"></i>заполнил поля</span><span><i style="background:#9aa6ff"></i>отметил учитель</span><span><i style="background:var(--err);border-radius:50%"></i>были ошибки</span></div>
   <div class="legend">Номера — задачи с kompege.ru (К. Ю. Кабанов). <sup class="fh">Д</sup> — домашнее задание, <sup class="ff">★</sup> — избранное.</div>`;
  return `<aside class="side" id="side">${h}</aside>`;
}
function bindSide() {
  document.querySelectorAll('#side .it').forEach(b => b.onclick = () => { tickTime(); openTask(b.dataset.id); });
  document.querySelectorAll('#side .sb').forEach(b => b.onclick = () => { tickTime(); openBlock(b.dataset.b); });
  document.querySelectorAll('#side .hwbtn').forEach(b => b.onclick = () => { cur.open[b.dataset.o] = !cur.open[b.dataset.o]; refreshSide(); });
  document.querySelectorAll('#side [data-f]').forEach(b => b.onclick = () => { cur.filter = b.dataset.f; refreshSide(); });
  const c = document.querySelector('#side .it.cur'); if (c) c.scrollIntoView({block: 'nearest'});
}
function refreshSide() { const o = $('#side'); if (!o) return; const t = o.scrollTop; o.outerHTML = sidebar(); bindSide(); $('#side').scrollTop = t; }

/* ===== Теория блоков ===== */
const BTH = {};

/* ===== Страница блока ===== */
function hlText(text, spans) {
  const cls = Array(text.length).fill(-1);
  spans.forEach((sp, k) => { for (let i = sp[0]; i < sp[1]; i++) cls[i] = k; });
  let h = '', i = 0;
  while (i < text.length) {
    let j = i; while (j < text.length && cls[j] === cls[i]) j++;
    const piece = esc(text.slice(i, j)).replace(/\n/g, '<span class="nl">↵</span>\n');
    h += cls[i] >= 0 ? `<mark class="m${cls[i] % 2}">${piece}</mark>` : piece; i = j;
  }
  return h;
}
function exCard(e) {
  return `<div class="excard"><div class="exl">текст</div><pre class="ext">${hlText(e.text, e.spans)}</pre><div class="exl">шаблон</div><code class="exp2">${esc(e.pat)}</code>${e.mode === 'M' ? ' <span class="tag">флаг M</span>' : ''}
   <div class="exr mono">${esc(e.res)}</div><div class="exc">${esc(e.cmt)}</div></div>`;
}
function openBlock(bid) {
  tickTime(); cur.view = 'block'; cur.blk = bid; cur.id = null; cur.filter = 'all';
  const b = BK[bid], s = stu(), mains = MAINS(bid), hws = HWS(bid);
  const tcard = t => { const x = s.tasks[t.id]; return `<button class="tcard ${stClass(x)}" data-id="${t.id}"><b>№ ${esc(t.id)}</b>${solved(x) ? ' ✅' : ''}${FL(t.id).hw ? ' <sup class="fh">Д</sup>' : ''}<span>${esc(qtext(t).slice(0, 170))}${qtext(t).length > 170 ? '…' : ''}</span></button>`; };
  app().innerHTML = topbar() + `<div class="lay">${sidebar()}<main class="main">
   <div class="card"><div class="th"><h2>${bid === 'RS' ? '★' : 'Блок ' + (BLOCKS.indexOf(b) + 1)}. ${esc(b.name)}</h2></div><p style="margin:6px 0 0">${esc(b.desc)}</p></div>
   <div class="card"><h3 style="margin:0 0 8px">📚 Что нужно знать</h3><table class="bth">${(BTH[bid] || []).map(([a, d]) => `<tr><td><code>${esc(a)}</code></td><td>${esc(d)}</td></tr>`).join('')}</table></div>
   ${(DATA.examples[bid] || []).length ? `<div class="card"><h3 style="margin:0 0 8px">👀 Готовые примеры</h3><div class="exgrid">${DATA.examples[bid].map(exCard).join('')}</div></div>` : ''}
   <div class="card"><div class="row" style="justify-content:space-between"><h3 style="margin:0 0 8px">🧩 Основные задачи блока</h3>${mains.length ? `<button class="btn pri" id="bStart">▶ ${mains.some(t => solved(s.tasks[t.id])) ? 'Продолжить' : 'Начать'}</button>` : ''}</div><div class="tgrid">${mains.map(tcard).join('')}</div></div>
   ${hws.length ? `<details class="card hwd"><summary><b>🏠 Для самостоятельной работы (${hws.filter(t => solved(s.tasks[t.id])).length}/${hws.length})</b> <span class="vhint">— реальные задачи с файлами; каждую можно решить и здесь, на учебной строке</span></summary>
     ${mains.map(m => { const a = hws.filter(t => t.like === m.id); return a.length ? `<div class="hwgrp"><div class="vhint">похожие на № ${esc(m.id)}</div><div class="tgrid">${a.map(tcard).join('')}</div></div>` : ''; }).join('')}</details>` : ''}
   </main></div>`;
  bindTop(); bindSide();
  document.querySelectorAll('.tcard').forEach(c => c.onclick = () => openTask(c.dataset.id));
  if ($('#bStart')) $('#bStart').onclick = () => { const f = mains.find(t => !solved(s.tasks[t.id])) || mains[0]; openTask(f.id); };
  window.scrollTo(0, 0);
}

/* ===== Условие ===== */
function condHTML(t) {
  const raw = String(t.real || '');
  return esc(raw).replace(/(Определите|Найдите|Сколько|Укажите|Необходимо указать|Требуется найти)([^.?]*[.?]?)/, '<span class="q">$1$2</span>')
    .replace(/\b(\d+)\b/g, '<strong class="cnum">$1</strong>');
}
function sOf(code) { const m = /^s\s*=\s*'((?:[^'\\]|\\.)*)'/m.exec(code || ''); return m ? m[1].replace(/\\n/g, '\n').replace(/\\'/g, "'").replace(/\\\\/g, '\\') : null; }

/* ===== Пояснения к строкам кода ===== */
function lineNotes(code, t) {
  const ng = t ? t.groups : 0;
  return code.split('\n').map(line => {
    const L = line.trim(); let d = '';
    if (/^from re import \*/.test(L)) d = 'подключаем все функции модуля re: findall, finditer, search, fullmatch, split, sub';
    else if (/^s = '/.test(L)) d = /\\n/.test(L) ? 'учебный текст из нескольких строк (\\n — перевод строки). На экзамене: s = open(\'24.txt\').read()' : 'учебная строка. На экзамене: s = open(\'24.txt\').readline().strip()';
    else if (/^print\(len\(s\), set\(s\)/.test(L)) d = 'проверка: длина строки, какие символы в ней есть, начало строки';
    else if (/^num = r'/.test(L)) d = 'кусок шаблона «одно число» — подставим его в выражение через f-строку';
    else if (/^pattern = rf'/.test(L)) d = 'f-строка: вместо {num} Python подставит шаблон числа';
    else if (/^pattern = r'/.test(L)) d = 'сама регулярка. r перед кавычкой — «сырая» строка: \\d, \\1 остаются как есть';
    else if (/^pattern = f'\(\?=\(\{pattern\}\)\)'/.test(L)) d = 'обёртка: просмотр вперёд — поиск с КАЖДОЙ позиции (с перекрытиями). Весь кусок попадает в группу 1, группы внутри шаблона сдвигаются: начинаются с 2';
    else if (/^l = findall\(pattern, s, M\)/.test(L)) d = 'findall с флагом M: ^ и $ — начало и конец каждой строки; одно совпадение — одна строка';
    else if (/^l = findall\(pattern, s\)/.test(L)) d = ng === 0 ? 'findall — список всех найденных кусков (без перекрытий: поиск продолжается с конца найденного)' : ng === 1 ? 'в шаблоне одна группа — findall вернёт список её содержимого' : 'в шаблоне ' + ng + ' групп(ы) — findall вернёт список кортежей (группа1, группа2, …)';
    else if (/^l = \[c\[0\] for c in l\]/.test(L)) d = 'из каждого кортежа берём c[0] — группу 1, то есть весь найденный кусок';
    else if (/^l = \[m\.group\(\) for m in finditer/.test(L)) d = 'finditer выдаёт объекты-совпадения; m.group() — весь найденный кусок, даже если в шаблоне есть группы';
    else if (/^maxs = max\(l, key=len\)/.test(L)) d = 'самый длинный элемент списка (key=len — сравниваем по длине, а не по алфавиту)';
    else if (/^mins = min\(l, key=len\)/.test(L)) d = 'самый короткий элемент списка';
    else if (/^print\(len\(maxs\) \/\/ (\d)\)/.test(L)) d = 'длина куска, делённая на ' + /\/\/ (\d)/.exec(L)[1] + ' — количество блоков; это ответ';
    else if (/^print\(len\((maxs|mins)\)\)/.test(L)) d = 'длина найденного куска — ответ';
    else if (/^print\(len\(l\)\)/.test(L)) d = 'сколько найдено — длина списка; это ответ';
    else if (/^print\((maxs|mins), l\)/.test(L)) d = 'проверка глазами: сам кусок и весь список найденного';
    else if (/^print\(l\)/.test(L)) d = 'весь список найденного — для проверки';
    else if (/^l = \[c\[1\] for c in l\]/.test(L)) d = 'из каждого кортежа берём c[1] — группу 2 (букву в середине)';
    else if (/^l = \[\(l\.count\(c\), c\)/.test(L)) d = 'для каждой буквы — пара (сколько раз встретилась, буква)';
    else if (/^k, c = max\(l\)/.test(L)) d = 'самая частая буква: max сравнивает пары сначала по количеству';
    else if (/eval\(ss, \{"__builtins__": \{\}\}\)/.test(L)) d = 'fullmatch пропускает только цифры и знаки, а eval без встроенных функций ({"__builtins__": {}}) не может вызвать ничего постороннего — считаем значение выражения безопасно';
    else if (/^def calc\(/.test(L)) d = 'своя функция вместо eval: делим по + на слагаемые, каждое по * на множители — так соблюдается приоритет умножения';
    else if (/^p = \[-1\] \+ p \+/.test(L)) d = '«пустые» соседи за краями строки: тогда начало и конец строки работают как обычная середина — одна формула без if';
    else if (/^l = s\.split\(w\)/.test(L)) d = 'режем строку по слову: между соседними кусками стоит ровно одно слово';
    else if (/^for (part|x) in /.test(L) && /split/.test(L)) d = 'перебираем куски после разрезания';
    else if (/#/.test(L)) d = L.slice(L.indexOf('#') + 1).trim();
    return {line, d};
  });
}
function treeHTML(nodes) {
  if (!nodes || !nodes.length) return '';
  return '<ul class="tree">' + nodes.map(n => `<li><code class="${n.g ? 'gc g' + ((n.g - 1) % 6 + 1) : ''}">${esc(n.t)}</code> <span>${esc(n.d)}</span>${treeHTML(n.c)}</li>`).join('') + '</ul>';
}

/* ===== Задача ===== */
let ED = null;
function openTask(id) {
  tickTime(); closeModal();
  const s = stu(), t = TK[id]; if (!t) { viewHome(); return; }
  cur.id = id; cur.view = 'task'; cur.blk = t.blk; cur.since = Date.now(); s.cur = id; if (t.role === 'hw') cur.open[t.blk] = true; bump();
  const x = X(id), L = navList(), idx = L.indexOf(id);
  const an = ANALOGS(id), f = FL(id), b = BK[t.blk];
  const mk = MK(t);
  const methods = [[mk, mainLabel(t)]].concat(Object.keys(t.methods).filter(k => k !== mk).map(k => [k, (MLAB[k] || k) + ' — готовое решение']));
  app().innerHTML = topbar() + `<div class="lay">${sidebar()}<main class="main">
   <div class="card ${solved(x) ? 'solved' : ''}" id="tc"><div class="th"><h2>№ ${esc(id)}</h2>${t.file ? '<span class="tag k" title="Задача с сайта К. Ю. Кабанова kompege.ru">к · kompege.ru</span>' : ''}<span class="tag">${esc(b.id === 'RS' ? '★' : b.id)} · ${esc(b.name)}</span>${t.role === 'hw' ? '<span class="tag hwtag">для самостоятельной работы</span>' : ''}${t.star ? '<span class="tag z">★ со звёздочкой</span>' : ''}<span class="tag dd" title="Сложность">${DSTARS(t)}</span>${t.alias ? `<span class="tag" title="Та же задача под другим номером">= № ${esc(t.alias)}</span>` : ''}${t.src ? `<span class="tag">${esc(t.src)}</span>` : ''}${t.lvl ? `<span class="tag">${esc(t.lvl)}</span>` : ''}
     <span style="flex:1"></span>${idx >= 0 ? `<span class="tag">${idx + 1} из ${L.length}</span>` : ''}
     <span class="flags"><button class="flag ${f.hw ? 'on' : ''}" data-fl="hw" title="Домашнее задание (ставит учитель)">🏠 ДЗ</button><button class="flag ${f.fav ? 'on' : ''}" data-fl="fav" title="Избранное (ставит учитель)">★</button><button class="flag ${solved(x) ? 'on' : ''}" data-fl="done" title="Решено (ставится автоматически при верном ответе; учитель может отметить вручную)">✓ решено</button></span></div>
    ${t.title ? `<div class="vhint">${esc(t.title)}</div>` : ''}
    <div class="cond">${condHTML(t)}</div>
    <div class="row" style="margin-top:8px">${t.file ? `<a class="btn sm" href="${esc(t.file)}" target="_blank" rel="noopener">📥 Файл к задаче</a>` : ''}${t.like ? `<button class="btn sm ghost" id="goLike">↖ основная задача № ${esc(t.like)}</button>` : ''}
     <span class="trn">📌 Учебная строка — в коде (s = '…'), ответ проверяется для неё.${t.tr ? ' <b>Внимание: ' + esc(t.tr) + '.</b>' : ''}</span></div></div>
   <div class="card">
    <div class="bar"><button class="btn pri sm" id="bRun" title="Ctrl+Enter">▶ Выполнить</button><button class="btn sm" id="bStop" disabled>⏹</button>
     <button class="btn sm" id="bMeth" title="Другие способы решения">Способ: ${esc((methods.find(m => m[0] === (x.meth || mk)) || methods[0])[1])} ▾</button>
     
     <span class="sp"></span><button class="btn sm" id="bUndo" disabled title="Ctrl+Z">↶</button><button class="btn sm" id="bRedo" disabled title="Ctrl+Y">↷</button><button class="btn sm ghost" id="bReset" title="Вернуть заготовку">↺ Заготовка</button></div>
    <div id="edh"></div>
    <div class="status" id="st">Python работает прямо в браузере. Первый запуск загружает интерпретатор (~10 с, нужен интернет). Пустые жёлтые поля — их заполняешь ты.</div>
    <div class="out" id="out"><span class="m">Здесь появится вывод. Последняя строка подсвечивается — это ответ.</span></div><div id="exp"></div>
    <div class="ans"><b>Ответ:</b><input class="inp" id="ansIn" autocomplete="off" ${solved(x) ? `value="${esc(x.ans || t.ans)}"` : ''}><button class="btn pri" id="ansBtn">Проверить</button><button class="btn ghost sm" id="takeLast">⇩ последняя строка</button>
     <span class="sp"></span><span class="vhint">ответ по файлу:</span><input class="inp" id="realIn" style="width:130px;font-size:14px;padding:6px 8px" value="${esc(x.real || '')}" placeholder="для учителя"><button class="btn sm ghost" id="realBtn">сохранить</button></div>
    <div class="fb" id="fb"></div>
    <div class="row" style="margin-top:12px"><b>Помощь:</b><button class="btn sm" id="hIdea">💡 Подсказка</button><button class="btn sm" id="hTh">📖 Разбор задачи</button><button class="btn sm yel" id="hFill">✨ Заполнить поля</button><button class="btn sm ghost" id="hBlk">📚 Теория блока</button></div>
    <div id="hz"></div>
    ${an.length ? `<div class="analogs"><b>Аналоги для самостоятельной работы:</b> ${an.map(a => chip(a.id)).join('')}</div>` : ''}
   </div>
   <div class="row" style="justify-content:space-between"><button class="btn ghost" id="nPrev" ${idx > 0 ? '' : 'disabled'}>← ${idx > 0 ? esc(L[idx - 1]) : ''}</button><button class="btn" id="nNext" ${idx >= 0 && idx < L.length - 1 ? '' : 'disabled'}>${idx >= 0 && idx < L.length - 1 ? esc(L[idx + 1]) : ''} →</button></div>
   </main></div>`;
  bindTop(); bindSide();
  document.querySelectorAll('.analogs .it').forEach(c => c.onclick = () => openTask(c.dataset.id));
  if ($('#goLike')) $('#goLike').onclick = () => openTask(t.like);
  $('#nPrev').onclick = () => openTask(L[idx - 1]); $('#nNext').onclick = () => openTask(L[idx + 1]);
  let saveC = null;
  const fields0 = x.code ? (x.fields || savedTemplateFields(t.tpl, x.code)) : tplFields(t.tpl);
  ED = makeEditor($('#edh'), x.code || tpl(t.tpl), {minLines: 9, initialFields: fields0, onRun: () => runMain(),
    onHistory: (u, r) => { $('#bUndo').disabled = !u; $('#bRedo').disabled = !r; },
    onChange: (v, fl) => { ffUpdate(); clearTimeout(saveC); saveC = setTimeout(() => { X(id).code = v; X(id).fields = fl; bump(); }, 500); }});
  $('#bRun').onclick = () => runMain(); $('#bStop').onclick = () => PY.kill();
  $('#bUndo').onclick = () => ED.undo(); $('#bRedo').onclick = () => ED.redo();
  $('#bReset').onclick = () => { ED.set(tpl(t.tpl), tplFields(t.tpl), true); x.code = ED.get(); x.fields = tplFields(t.tpl); x.meth = mk; bump(); const bm = $('#bMeth'); if (bm) bm.textContent = 'Способ: ' + mainLabel(t) + ' ▾'; toast('↺ Заготовка возвращена. Передумал — Ctrl+Z.'); };
  $('#bMeth').onclick = e => popMenu(e.currentTarget, methods.map(m => [m[1], () => setMethod(t, m[0])]), 'Вставить в редактор решение другим способом:');
  $('#takeLast').onclick = () => { const o = $('#out').dataset.last; if (!o) { toast('Сначала выполни программу ▶'); return; } $('#ansIn').value = o; $('#ansIn').focus(); };
  $('#ansBtn').onclick = () => checkAns(t); $('#ansIn').onkeydown = e => { if (e.key === 'Enter') checkAns(t); };
  $('#realBtn').onclick = () => { x.real = $('#realIn').value.trim(); const ex = REAL(id); x.realOk = x.real && ex ? normA(x.real) === normA(ex) : null; bump(); toast(x.realOk === true ? '✅ Совпадает с ответом учителя' : x.realOk === false ? '❌ Не совпадает с ответом учителя' : 'Ответ по файлу сохранён — учитель проверит'); };
  $('#hIdea').onclick = () => { if (!solved(x)) x.hint = Math.max(x.hint, 1); x.sIdea = 1; bump(); renderHelp(t); };
  $('#hTh').onclick = () => { if (!solved(x)) x.hint = Math.max(x.hint, 2); x.sTh = 1; bump(); renderHelp(t); };
  $('#hFill').onclick = () => DB.teacher.noFillAsk ? fillFields(t) : confirmBox('Заполнить поля готовым ответом? Задача засчитается как «после заполнения полей».', () => fillFields(t));
  $('#hBlk').onclick = () => openBlock(t.blk);
  document.querySelectorAll('[data-fl]').forEach(bt => bt.onclick = () => askPin(() => {
    const k = bt.dataset.fl;
    if (k === 'done') { if (solved(x)) { x.st = 'new'; } else { x.st = 'mark'; } bump(); }
    else setFlag(id, k, !FL(id)[k]);
    openTask(id);
  }));
  renderHelp(t); ffBind(t);
  window.scrollTo(0, 0);
}
function renderHelp(t) {
  const x = X(t.id); let h = '';
  if (x.sIdea) h += `<div class="hcard"><b>💡 Подсказка.</b> ${esc(t.idea || 'Опиши словами, какой кусок строки подходит, и переведи каждое слово в элемент регулярки — памятка по алгоритмам обработки строк 📘 в помощь.')}</div>`;
  if (x.sTh) {
    const notes = lineNotes(t.methods[MK(t)], t).filter(n => n.d);
    h += `<div class="hcard th2"><b>📖 Разбор задачи</b>

      ${t.final ? `<div class="thsec">Итоговое выражение: <code class="big">${esc(t.final)}</code></div>
      <div class="thsec"><b>По частям:</b>${treeHTML(t.tree)}</div>` : ''}
      <div class="thsec"><b>Строка за строкой:</b><table class="ln">${notes.map(n => `<tr><td><code>${esc(n.line.replace(/\s+#.*$/, ''))}</code></td><td>${esc(n.d)}</td></tr>`).join('')}</table></div>
      ${t.note ? `<div class="thsec warnbox">⚠ ${esc(t.note)}</div>` : ''}
      ${t.final ? '<div class="row"><button class="btn sm" id="thDbg">🔎 Открыть эталонную регулярку в отладчике</button></div>' : ''}</div>`;
  }
  $('#hz').innerHTML = h;

}
function setMethod(t, k) {
  const x = X(t.id);
  const doit = () => {
    if (k === MK(t)) { x.code = tpl(t.tpl); x.fields = tplFields(t.tpl); }
    else { if (!solved(x)) x.hint = Math.max(x.hint, 3); x.code = t.methods[k]; x.fields = []; }
    x.meth = k; bump(); openTask(t.id);
  };
  if (k !== MK(t) && !solved(x)) confirmBox('Это готовое решение другим способом. Задача засчитается как «после готового кода». Вставить?', doit, 'Вставить');
  else doit();
}
function fillFields(t) {
  const x = X(t.id); if (!solved(x)) x.hint = Math.max(x.hint, 3); x.meth = MK(t);
  ED.set(ref(t.tpl), []); X(t.id).code = ED.get(); X(t.id).fields = []; bump(); const bm = $('#bMeth'); if (bm) bm.textContent = 'Способ: ' + mainLabel(t) + ' ▾';
  toast('✨ Поля заполнены. Запусти ▶ и посмотри, что получилось' + (t.final ? '; в отладчике — как работает шаблон.' : '.'));
}
function setBusy(b) { const r = $('#bRun'), s = $('#bStop'); if (r) r.disabled = b; if (s) s.disabled = !b; }
function showOut(r, el, stEl) {
  el = el || $('#out'); if (!el) return;
  const o = (r.out || '').replace(/\s+$/, ''); const L = o ? o.split('\n') : [];
  let html = L.map((l, i) => i === L.length - 1 && r.ok ? `<span class="last">${esc(l)}</span>` : esc(l)).join('\n');
  if (!r.ok) html += (html ? '\n' : '') + `<span class="e">${esc(r.err || 'Ошибка')}${r.line ? ' (строка ' + r.line + ')' : ''}\n↳ ${esc(translatePythonError(r.err))}</span>`;
  el.innerHTML = html || '<span class="m">(программа ничего не вывела)</span>';
  el.dataset.last = r.ok ? lastLine(r.out) : '';
}
async function runMain() {
  const t = TK[cur.id]; if (!t || !ED) return; const x = X(t.id);
  const code = ED.get();
  const pl = code.split('\n').find(l => /^pattern\s*=\s*r'/.test(l.trim()));
  if (pl && /r'\s*'/.test(pl)) { $('#exp').innerHTML = '<div class="exp">Поле с регуляркой пустое — впиши шаблон (или нажми «✨ Заполнить поля»).</div>'; return; }
  if (pl && /r' {6,}/.test(pl)) { $('#exp').innerHTML = '<div class="exp">В поле с регуляркой остались пробелы-заглушки — впиши шаблон вместо них.</div>'; }
  else $('#exp').innerHTML = '';
  setBusy(true); $('#st').textContent = 'Выполняю…'; const t0 = performance.now();
  const r = await PY.run(code, {onStatus: m => { const e = $('#st'); if (e) e.textContent = m; }});
  setBusy(false); if (!$('#out')) return;
  x.runs++; X(t.id).code = code; bump();
  $('#st').textContent = r.fatal ? '⚠️ Не удалось запустить Python: ' + r.err + '. Нужен интернет при первом запуске.' : `Готово за ${Math.round(performance.now() - t0)} мс.`;
  showOut(r); ED.err(r.ok ? null : r.line);
  const ex = explainErr(r, code); if (ex) $('#exp').innerHTML += `<div class="exp">💬 ${ex}</div>`;
}
function checkAns(t) {
  const x = X(t.id), v = $('#ansIn').value.trim(), fb = $('#fb'); if (!v) { $('#ansIn').focus(); return; }
  x.tries++;
  if (normA(v) === normA(t.ans)) {
    if (!solved(x)) { x.st = x.hint >= 3 ? 'fill' : x.hint >= 1 ? 'hint' : x.wrong.length ? 'err' : 'ok'; x.md = dstamp(); x.ans = v; x.code = ED.get(); }
    bump(); refreshSide();
    fb.className = 'fb show good'; fb.innerHTML = '✅ Верно! ' + (x.st === 'ok' ? 'Сам и с первой попытки — отлично!' : '') + ' Флаг «решено» поставлен.';
    if (x.st === 'ok') confetti();
    const an = ANALOGS(t.id).filter(a => !solved(stu().tasks[a.id]));
    if (an.length) fb.innerHTML += ` <span style="font-weight:600">Закрепи на аналоге:</span> ${an.slice(0, 4).map(a => `<button class="btn sm" data-go="${a.id}">№ ${esc(a.id)}</button>`).join(' ')}`;
    const nx = nextUnsolved(t.id); if (nx) fb.innerHTML += ` <button class="btn sm pri" data-go="${nx}">Дальше → ${esc(nx)}</button>`;
    fb.querySelectorAll('[data-go]').forEach(b => b.onclick = () => openTask(b.dataset.go));
    const fl = document.querySelector('[data-fl="done"]'); if (fl) fl.classList.add('on');
  } else {
    if (!solved(x) && !x.wrong.includes(v)) x.wrong.push(v); bump(); refreshSide();
    const o = $('#out').dataset.last;
    let tip = o && normA(o) === normA(v) ? 'Программа выводит именно это — значит, ошибка в шаблоне. Открой 🔎 отладчик и посмотри, какие куски он находит и каких не хватает.' : !o ? 'Выполни программу ▶ и возьми последнюю строку вывода.' : '';
    if (x.wrong.length >= 2 && x.hint < 1) tip += ' Можно взять 💡 подсказку.';
    fb.className = 'fb show bad'; fb.innerHTML = '❌ Неверно. ' + tip;
  }
}

function openMethodsGuide() {
  modal(`<div class="mhead"><h2>📘 Памятка: алгоритмы обработки строк</h2><span class="sp"></span><button class="btn ghost" id="mgX">✕</button></div>
  <div class="cheat" style="max-height:76vh;overflow:auto">
   <div class="chg"><b>1. Префиксные суммы</b><p>Идея: заранее посчитать накопленную сумму. Тогда сумму на отрезке [l; r) можно получить за O(1): <code>p[r] - p[l]</code>.</p>
   <pre>s = [int(x) for x in input().split()]
p = [0] * (len(s) + 1)
for i in range(len(s)):
    p[i + 1] = p[i] + s[i]
# сумма элементов с l по r включительно
ans = p[r + 1] - p[l]</pre>
   <p><b>Когда применять:</b> много запросов о сумме на отрезках; подсчёт количества символов/событий на отрезке (в префикс кладём 1 или 0).</p></div>
   <div class="chg"><b>2. Два указателя</b><p>Идея: два индекса <code>l</code> и <code>r</code> обозначают границы рассматриваемого участка. Указатели двигаются по условию, не возвращаясь назад.</p>
   <pre>l = 0
for r in range(len(s)):
    # добавили s[r] в текущий участок
    while условие_нарушено:
        # убрали s[l] из участка
        l += 1
    # обработали участок [l; r]</pre>
   <p><b>Когда применять:</b> поиск пары в отсортированном массиве; сравнение частей строки; поиск участка с нужным свойством.</p></div>
   <div class="chg"><b>3. Скользящее окно</b><p>Частный случай двух указателей: окно <code>[l; r]</code> расширяется вправо, а когда условие нарушается — сдвигается слева.</p>
   <pre>l = 0
best = 0
for r in range(len(s)):
    # включаем новый символ s[r]
    while окно_неподходящее:
        # удаляем вклад s[l]
        l += 1
    best = max(best, r - l + 1)</pre>
   <p><b>Когда применять:</b> самый длинный/короткий непрерывный фрагмент, в котором не более K разных символов, сумма не больше K (при неотрицательных элементах), нет запрещённого сочетания.</p></div>
   <div class="chg"><b>Как выбрать метод?</b><ul><li>Нужна сумма/количество на многих отрезках — префиксные суммы.</li><li>Нужно двигать две границы участка — два указателя.</li><li>Ищем непрерывный фрагмент с условием и расширяем/сжимаем его — скользящее окно.</li></ul></div>
   <p class="vhint">Важно: для скользящего окна с условием на сумму обычно требуется неотрицательность элементов. При отрицательных числах стандартное сжатие окна может быть неверным.</p>
  </div>`, 'wide');
  $('#mgX').onclick = closeModal;
}

/* ===== Тренажёр-туннель: постоянный iframe без перезагрузки ===== */
let TUNNEL_FRAME = null;
let TUNNEL_OVERLAY = null;
function ensureTunnel() {
  if (TUNNEL_OVERLAY) return;
  const host = document.createElement('div');
  host.id = 'tunnelPersistentOverlay';
  host.style.cssText = 'display:none;position:fixed;inset:0;z-index:10050;background:#070a10ee;align-items:center;justify-content:center;padding:2vh 2vw;';
  host.innerHTML = '<div style="width:100%;height:96vh;max-width:1800px;background:#0f1420;border:1px solid #30394b;border-radius:14px;overflow:hidden;display:flex;flex-direction:column"><div style="height:48px;flex:none;display:flex;align-items:center;gap:12px;padding:0 14px;background:#18202f;color:#e6eaf3;font:600 15px system-ui"><span>🧪 Тренажёр-туннель</span><span style="opacity:.65;font-size:12px;font-weight:400">Python сохраняет состояние между открытиями</span><span style="flex:1"></span><button id="tunnelClose" style="border:0;border-radius:7px;padding:7px 13px;background:#34415a;color:white;cursor:pointer">Закрыть ✕</button></div><div id="tunnelFrameSlot" style="flex:1;min-height:0"></div></div>';
  document.body.appendChild(host);
  TUNNEL_OVERLAY = host;
  TUNNEL_FRAME = document.createElement('iframe');
  TUNNEL_FRAME.id = 'tunnelFrame';
  TUNNEL_FRAME.title = 'Тренажёр-туннель';
  TUNNEL_FRAME.setAttribute('loading','eager');
  TUNNEL_FRAME.style.cssText = 'width:100%;height:100%;border:0;display:block;background:#0f1420';
  TUNNEL_FRAME.srcdoc = TUNNEL_HTML;
  host.querySelector('#tunnelFrameSlot').appendChild(TUNNEL_FRAME);
  host.querySelector('#tunnelClose').onclick = closeTunnel;
  host.addEventListener('mousedown', e => { if (e.target === host) closeTunnel(); });
}
function closeTunnel() {
  if (TUNNEL_OVERLAY) TUNNEL_OVERLAY.style.display = 'none';
}
function openTunnel() {
  const s = stu(); if (s) { s.tunnel = (s.tunnel || 0) + 1; bump(); }
  ensureTunnel();
  TUNNEL_OVERLAY.style.display = 'flex';
}
const TUNNEL_HTML = "\u003c!DOCTYPE html>\n\u003chtml lang=\"ru\">\u003chead>\u003cmeta charset=\"utf-8\">\u003ctitle>Тренажёр-туннель ЕГЭ 24 — префиксные суммы\u003c/title>\n\u003cstyle>\n*{box-sizing:border-box}body{margin:0;font:14px system-ui,Segoe UI,sans-serif;background:#0f1420;color:#e6eaf3}\nheader{padding:10px 16px;background:#18202f;display:flex;gap:12px;align-items:center;flex-wrap:wrap}\nh1{font-size:17px;margin:0;flex:1}button{background:#3b6cf6;color:#fff;border:0;border-radius:6px;padding:7px 13px;cursor:pointer;font-size:14px}\nbutton.g{background:#2b364d}button:disabled{opacity:.4}\nmain{display:grid;grid-template-columns:minmax(340px,430px) 1fr;gap:12px;padding:12px}\n@media(max-width:900px){main{grid-template-columns:1fr}}\n.card{background:#18202f;border-radius:10px;padding:12px;margin-bottom:12px}\n.card h3{margin:0 0 8px;font-size:13px;color:#8fa3c8;text-transform:uppercase;letter-spacing:.05em}\n#code{font:13px/1.55 Consolas,monospace;white-space:pre}\n.ln{display:flex;cursor:pointer;border-radius:4px;padding:0 4px}.ln:hover{background:#243049}\n.ln .n{width:26px;color:#5c6b8a;flex:none}.ln .t{flex:1;overflow:hidden}.ln .b{color:#8fa3c8;font-size:11px;margin-left:6px}\n.ln.sel{background:#2a3a63}.ln.cur{outline:2px solid #f5b83d;background:#3a3320}\ntextarea{width:100%;height:340px;background:#0b0f19;color:#e6eaf3;border:1px solid #2b364d;border-radius:6px;font:13px/1.5 Consolas,monospace;padding:8px}\n.cells{display:flex;flex-wrap:wrap;gap:0;padding:26px 0 8px;overflow-x:auto}\n.c{width:34px;text-align:center;position:relative;flex:none}\n.c .ch{height:34px;line-height:34px;font:bold 17px Consolas,monospace;background:#243049;border:1px solid #0f1420}\n.c .ix{font-size:10px;color:#5c6b8a;margin-top:2px}.c .pv{font:12px Consolas;color:#7de0b0;margin-top:2px;height:16px}\n.c.seg .ch{background:#3b6cf6}.c.fnd .ch{background:#1f9d62}\n.c.ai::before,.c.aj::before{position:absolute;top:-20px;left:0;right:0;font-size:12px;font-weight:bold}\n.c.ai::before{content:\"i▼\";color:#f5b83d}.c.aj::before{content:\"j▼\";color:#ff7a8a}.c.ai.aj::before{content:\"i,j▼\";color:#fff}\n.run{display:inline-flex;flex-direction:column;align-items:center;margin:3px 4px 3px 0;padding:4px 8px;border-radius:6px;background:#243049}\n.run b{font:bold 16px Consolas}.run span{font-size:11px;color:#8fa3c8}\n.run+.arr{margin:0 2px;color:#5c6b8a}\n.f{padding:5px 8px;border-radius:6px;cursor:pointer;font:13px Consolas;display:flex;gap:8px}.f:hover{background:#243049}.f.on{background:#1b4d38}.f.best{border-left:3px solid #f5b83d}\ntable{border-collapse:collapse;font:13px Consolas}td,th{border:1px solid #2b364d;padding:3px 8px;text-align:left}th{color:#8fa3c8}\n.muted{color:#6f7f9f}.err{color:#ff7a8a;white-space:pre-wrap}\n.note{background:#0b0f19;border-radius:6px;padding:8px 10px;margin-top:8px;line-height:1.6}\n.ok{color:#7de0b0}.bad{color:#ff7a8a}input[type=range]{width:100%}\n.chips{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}.chip{padding:2px 8px;border-radius:12px;background:#2b364d;cursor:pointer;font-size:12px}.chip.on{background:#f5b83d;color:#000}\n\u003c/style>\u003c/head>\u003cbody>\n\u003cheader>\u003ch1>🧪 Тренажёр-туннель: префиксные суммы и найденные строки\u003c/h1>\n\u003cbutton class=\"g\" id=\"bEdit\">✏️ Редактировать код\u003c/button>\u003cbutton id=\"bRun\">▶ Запустить и трассировать\u003c/button>\u003cspan id=\"status\" class=\"muted\">Загрузка Python…\u003c/span>\u003c/header>\n\u003cmain>\n\u003cdiv>\n \u003cdiv class=\"card\">\u003ch3>Код задачи (кликай по строке)\u003c/h3>\n  \u003cdiv id=\"code\">\u003c/div>\u003ctextarea id=\"ta\" style=\"display:none\">\u003c/textarea>\n  \u003cdiv id=\"chips\" class=\"chips\">\u003c/div>\u003c/div>\n \u003cdiv class=\"card\">\u003ch3>Вывод программы\u003c/h3>\u003cpre id=\"out\" style=\"margin:0;max-height:160px;overflow:auto\">\u003c/pre>\u003c/div>\n\u003c/div>\n\u003cdiv>\n \u003cdiv class=\"card\">\u003ch3>Шаг выполнения\u003c/h3>\n  \u003cdiv style=\"display:flex;gap:6px;align-items:center;flex-wrap:wrap\">\n   \u003cbutton class=\"g\" id=\"b0\">⏮\u003c/button>\u003cbutton class=\"g\" id=\"bP\">◀\u003c/button>\u003cbutton id=\"bN\">▶\u003c/button>\u003cbutton class=\"g\" id=\"bE\">⏭\u003c/button>\n   \u003cbutton class=\"g\" id=\"bPl\">⏯ Авто\u003c/button>\u003cspan id=\"stepInfo\" class=\"muted\">\u003c/span>\u003c/div>\n  \u003cinput type=\"range\" id=\"sl\" min=\"0\" max=\"0\" value=\"0\" style=\"margin-top:8px\">\u003c/div>\n \u003cdiv class=\"card\">\u003ch3>Строка и префиксные суммы смен\u003c/h3>\u003cdiv id=\"cells\" class=\"cells\">\u003c/div>\u003cdiv id=\"note\" class=\"note\">\u003c/div>\u003c/div>\n \u003cdiv class=\"card\">\u003ch3>Во что превратилась рассматриваемая строка (серии одинаковых символов)\u003c/h3>\u003cdiv id=\"runs\">\u003c/div>\u003c/div>\n \u003cdiv class=\"card\">\u003ch3>Найденные строки (клик — показать на исходной)\u003c/h3>\u003cdiv id=\"found\" class=\"muted\">Пока ничего не найдено\u003c/div>\u003c/div>\n \u003cdiv class=\"card\">\u003ch3>Переменные на этом шаге\u003c/h3>\u003cdiv id=\"vars\">\u003c/div>\u003c/div>\n\u003c/div>\u003c/main>\n\u003cscript src=\"https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js\">\u003c/script>\n\u003cscript>\nconst DEFAULT=`s='AAABBBBBCCDDDDDDDAAA'\nK=2   # допустимое число смен символов\n# Префиксные суммы смен символов\npr=[0]*len(s)\nfor k in range(1,len(s)):\n    pr[k]=pr[k-1]+(s[k]!=s[k-1])\nl=0\nfor i in range(len(s)):\n    j=i+l+1\n    while j\u003c=len(s):\n        ss=s[i:j]\n        if pr[j-1]-pr[i]>K: break      # ПЛОХО: смен больше K\n        if pr[j-1]-pr[i]==K:           # ХОРОШО: ровно K смен\n            l=len(ss)\n            print(i,l,ss)\n        j+=1                           # в любом случае расширяем\nprint('Ответ:',l)`;\nconst PYRUN=`\nimport sys, json, io\ndef _ser(v,d=0):\n    if isinstance(v,(bool,int,float)): return v\n    if isinstance(v,str): return v[:300]\n    if isinstance(v,(list,tuple)) and d==0 and len(v)\u003c=300 and all(isinstance(x,(bool,int,float,str)) for x in v): return list(v)\n    return repr(v)[:60]\ndef _snap(g):\n    return {k:_ser(v) for k,v in g.items() if not k.startswith('__') and not callable(v) and not hasattr(v,'__spec__')}\ndef run_user(code):\n    buf=io.StringIO(); steps=[]; g={'__name__':'__main__'}; err=None\n    def tr(frame,ev,arg):\n        if frame.f_code.co_filename!='\u003cuser>': return None\n        if ev=='line' and len(steps)\u003c20000:\n            steps.append([frame.f_lineno,_snap(frame.f_globals),len(buf.getvalue())])\n        return tr\n    old=sys.stdout; sys.stdout=buf\n    try:\n        sys.settrace(tr); exec(compile(code,'\u003cuser>','exec'),g)\n    except BaseException as e: err=repr(e)\n    finally: sys.settrace(None); sys.stdout=old\n    return json.dumps({'steps':steps,'out':buf.getvalue(),'err':err})\n`;\nlet py,code=DEFAULT,T=null,cur=0,selLine=null,focus=null,timer=null,editing=false;\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&\u003c>]/g,c=>({'&':'&amp;','\u003c':'&lt;','>':'&gt;'}[c]));\n$('ta').value=code;\nasync function init(){py=await loadPyodide();py.runPython(PYRUN);$('status').textContent='Python готов';run();}\nfunction run(){\n if(!py)return; if(editing)toggleEdit();\n const r=JSON.parse(py.globals.get('run_user')(code));T=r;T.lines=r.out.split('\\n');\n cur=0;selLine=null;focus=null;$('sl').max=Math.max(0,r.steps.length-1);$('sl').value=0;\n $('out').innerHTML=esc(r.out)+(r.err?'\u003cdiv class=\"err\">'+esc(r.err)+'\u003c/div>':'');\n $('status').textContent='Шагов: '+r.steps.length;render();\n}\nfunction toggleEdit(){editing=!editing;if(!editing)code=$('ta').value;\n $('ta').style.display=editing?'block':'none';$('code').style.display=editing?'none':'block';\n $('bEdit').textContent=editing?'✔ Готово':'✏️ Редактировать код';if(!editing)run();}\n// какие значения были найдены к шагу k\nfunction foundUpTo(k){\n const n=T.steps.length?(k+1\u003cT.steps.length?T.steps[k+1][2]:T.out.length):0;\n const txt=T.out.slice(0,n);const res=[];\n for(const ln of txt.split('\\n')){const m=ln.match(/^(\\d+)\\s+(\\d+)\\s+(\\S+)$/);if(m)res.push({i:+m[1],l:+m[2],ss:m[3]});}\n return res;\n}\nfunction render(){\n // код\n const L=code.split('\\n'),cnt={};T.steps.forEach(s=>cnt[s[0]]=(cnt[s[0]]||0)+1);\n const curL=T.steps[cur]?T.steps[cur][0]:-1;\n $('code').innerHTML=L.map((t,i)=>`\u003cdiv class=\"ln ${selLine==i+1?'sel':''} ${curL==i+1?'cur':''}\" data-l=\"${i+1}\">\u003cspan class=\"n\">${i+1}\u003c/span>\u003cspan class=\"t\">${esc(t)||' '}\u003c/span>${cnt[i+1]?`\u003cspan class=\"b\">×${cnt[i+1]}\u003c/span>`:''}\u003c/div>`).join('');\n document.querySelectorAll('.ln').forEach(e=>e.onclick=()=>{selLine=+e.dataset.l;const f=T.steps.findIndex(s=>s[0]==selLine);if(f>=0)cur=f;focus=null;$('sl').value=cur;render();});\n // чипы выполнений выбранной строки\n let ch='';if(selLine){const ids=[];T.steps.forEach((s,k)=>{if(s[0]==selLine)ids.push(k)});\n  if(!ids.length)ch='\u003cspan class=\"muted\">Эта строка не выполнялась\u003c/span>';\n  else{ch=`\u003cspan class=\"muted\">Строка ${selLine}, выполнений: ${ids.length}. Выбери:\u003c/span> `;\n   const show=ids.length>80?ids.filter((_,q)=>q\u003c80):ids;ch+=show.map((k,q)=>`\u003cspan class=\"chip ${k==cur?'on':''}\" data-k=\"${k}\">#${q+1}\u003c/span>`).join('');if(ids.length>80)ch+=' …';}}\n $('chips').innerHTML=ch;document.querySelectorAll('.chip[data-k]').forEach(e=>e.onclick=()=>{cur=+e.dataset.k;$('sl').value=cur;focus=null;render();});\n if(!T.steps.length){$('cells').innerHTML='\u003cspan class=\"err\">'+esc(T.err||'Нет шагов')+'\u003c/span>';return;}\n const st=T.steps[cur],V=st[1];\n $('stepInfo').textContent=`шаг ${cur+1} из ${T.steps.length} · строка ${st[0]}`;\n // авто-определение главной строки и префиксов\n let sName=('s' in V&&typeof V.s=='string')?'s':Object.keys(V).filter(k=>typeof V[k]=='string').sort((a,b)=>V[b].length-V[a].length)[0];\n const S=V[sName]||'';\n let pName=Object.keys(V).find(k=>Array.isArray(V[k])&&V[k].length==S.length&&V[k].every(x=>typeof x=='number'));\n const P=pName?V[pName]:null;\n const i=Number.isInteger(V.i)?V.i:null,j=Number.isInteger(V.j)?V.j:null;\n const F=foundUpTo(cur);const fo=focus!=null?F[focus]:null;\n let h='';\n for(let c=0;c\u003cS.length;c++){\n  let cl='c';\n  if(fo&&c>=fo.i&&c\u003cfo.i+fo.l)cl+=' fnd';\n  else if(!fo&&i!=null&&j!=null&&c>=i&&c\u003cj)cl+=' seg';\n  if(!fo&&i==c)cl+=' ai';if(!fo&&j!=null&&j==c)cl+=' aj';\n  h+=`\u003cdiv class=\"${cl}\">\u003cdiv class=\"ch\">${esc(S[c])}\u003c/div>\u003cdiv class=\"ix\">${c}\u003c/div>\u003cdiv class=\"pv\">${P?P[c]:''}\u003c/div>\u003c/div>`;}\n if(!fo&&j!=null&&j==S.length)h+=`\u003cdiv class=\"c aj\">\u003cdiv class=\"ch\" style=\"background:none;border:0\">\u003c/div>\u003c/div>`;\n $('cells').innerHTML=h;\n // пояснение\n let n='';\n if(P)n+=`\u003cdiv>Нижняя строка — \u003cb>${pName}[k]\u003c/b>: сколько раз символ сменился на отрезке от 0 до k.\u003c/div>`;\n if(fo){const a=fo.i,b=fo.i+fo.l-1;n+=`\u003cdiv>Выбрана найденная строка \u003cb>${esc(fo.ss)}\u003c/b>: позиции \u003cb>${a}…${b}\u003c/b>, длина \u003cb>${fo.l}\u003c/b>.`+(P?` Смен внутри: \u003cb>${P[b]}−${P[a]} = ${P[b]-P[a]}\u003c/b>`:'')+`\u003c/div>`;}\n else if(i!=null&&j!=null&&P&&j-1>=i&&j-1\u003cS.length){const d=P[j-1]-P[i];\n  n+=`\u003cdiv>Отрезок \u003cb>s[${i}:${j}]\u003c/b> = \u003cb>${esc(S.slice(i,j))}\u003c/b> (длина ${j-i}). Смен внутри: \u003cb>${P[j-1]} − ${P[i]} = ${d}\u003c/b>`+(Number.isInteger(V.K)?` — при K=${V.K} это \u003cb class=\"${d>V.K?'bad':d==V.K?'ok':''}\">${d>V.K?'ПЛОХО (больше K, break)':d==V.K?'ХОРОШО (ровно K)':'пока меньше K, расширяем'}\u003c/b>`:'')+`\u003c/div>`;}\n else if(i!=null)n+=`\u003cdiv>i = ${i}${j!=null?', j = '+j:''}\u003c/div>`;\n if(Number.isInteger(V.l))n+=`\u003cdiv>Лучшая длина на сейчас: \u003cb>l = ${V.l}\u003c/b>\u003c/div>`;\n $('note').innerHTML=n||'\u003cspan class=\"muted\">Нет данных для визуализации\u003c/span>';\n // серии\n let target=fo?fo.ss:(typeof V.ss=='string'&&V.ss?V.ss:(i!=null&&j!=null?S.slice(i,j):''));\n const runs=[];for(const ch of target){if(runs.length&&runs[runs.length-1][0]==ch)runs[runs.length-1][1]++;else runs.push([ch,1]);}\n $('runs').innerHTML=runs.length?`\u003cdiv class=\"muted\" style=\"margin-bottom:4px\">${esc(target)}\u003c/div>`+runs.map((r,q)=>(q?'\u003cspan class=\"arr\">→\u003c/span>':'')+`\u003cspan class=\"run\">\u003cb>${esc(r[0])}\u003c/b>\u003cspan>×${r[1]}\u003c/span>\u003c/span>`).join('')+`\u003cdiv class=\"note\">Серий: \u003cb>${runs.length}\u003c/b>, смен символов: \u003cb>${Math.max(0,runs.length-1)}\u003c/b> (между соседними сериями).\u003c/div>`:'\u003cspan class=\"muted\">Пустая строка\u003c/span>';\n // найденные\n const best=F.reduce((m,x)=>Math.max(m,x.l),0);\n $('found').innerHTML=F.length?F.map((x,q)=>`\u003cdiv class=\"f ${focus==q?'on':''} ${x.l==best?'best':''}\" data-q=\"${q}\">\u003cspan>#${q+1}\u003c/span>\u003cspan>i=${x.i}\u003c/span>\u003cspan>l=${x.l}\u003c/span>\u003cspan>${esc(x.ss)}\u003c/span>\u003c/div>`).join('')+'\u003cdiv class=\"muted\" style=\"margin-top:6px\">Золотая полоска — самая длинная на данный момент. Клик ещё раз — снять выделение.\u003c/div>':'\u003cspan class=\"muted\">Пока ничего не найдено\u003c/span>';\n document.querySelectorAll('.f').forEach(e=>e.onclick=()=>{const q=+e.dataset.q;focus=focus==q?null:q;render();});\n // переменные\n $('vars').innerHTML='\u003ctable>\u003ctr>\u003cth>Имя\u003c/th>\u003cth>Значение\u003c/th>\u003c/tr>'+Object.keys(V).map(k=>`\u003ctr>\u003ctd>${esc(k)}\u003c/td>\u003ctd>${esc(Array.isArray(V[k])?'['+V[k].join(', ')+']':V[k])}\u003c/td>\u003c/tr>`).join('')+'\u003c/table>\u003cdiv class=\"muted\" style=\"margin-top:4px\">Значения — до выполнения выделенной строки.\u003c/div>';\n}\nfunction go(k){if(!T||!T.steps.length)return;cur=Math.max(0,Math.min(T.steps.length-1,k));$('sl').value=cur;focus=null;render();}\n$('bRun').onclick=()=>{code=editing?$('ta').value:code;if(editing)toggleEdit();else run();};\n$('bEdit').onclick=toggleEdit;\n$('b0').onclick=()=>go(0);$('bE').onclick=()=>go(1e9);$('bP').onclick=()=>go(cur-1);$('bN').onclick=()=>go(cur+1);\n$('sl').oninput=e=>go(+e.target.value);\n$('bPl').onclick=()=>{if(timer){clearInterval(timer);timer=null;$('bPl').textContent='⏯ Авто';return}\n $('bPl').textContent='⏸ Стоп';timer=setInterval(()=>{if(cur>=T.steps.length-1){$('bPl').click();return}go(cur+1)},350);};\ndocument.addEventListener('keydown',e=>{if(editing)return;if(e.key=='ArrowRight')go(cur+1);if(e.key=='ArrowLeft')go(cur-1);});\ninit();\n\u003c/script>\u003c/body>\u003c/html>\n";

/* ===== Учитель ===== */
let TTAB = 'flags';
function viewTeacher(tab) {
  if (tab) TTAB = tab; cur.view = 'teacher';
  app().innerHTML = `<div class="top"><div class="logo"><i>.*</i><span>Кабинет учителя · ЕГЭ 24</span></div><div class="sp"></div><button class="ib" id="tTheme">🌓</button>${cur.name ? '<button class="ib" id="tBackS">← к ученику</button>' : ''}<button class="ib" id="tBack">⎋ Выйти</button></div>
   <div style="max-width:1300px;margin:16px auto;padding:0 16px"><div class="card"><div class="tabs">${[['flags', '🏠 ДЗ и избранное'], ['students', '👥 Ученики'], ['answers', '🔑 Ответы к файлам'], ['settings', '⚙ Настройки']].map(([k, n]) => `<button data-t="${k}" class="${TTAB === k ? 'on' : ''}">${n}</button>`).join('')}</div><div id="tBody"></div></div></div>`;
  $('#tTheme').onclick = () => { DB.theme = DB.theme === 'dark' ? 'light' : 'dark'; applyTheme(); persist(); };
  $('#tBack').onclick = () => { writeLS(); cur.teach = false; viewLogin(); };
  if ($('#tBackS')) $('#tBackS').onclick = () => viewHome();
  document.querySelectorAll('[data-t]').forEach(b => b.onclick = () => viewTeacher(b.dataset.t));
  ({flags: tFlags, students: tStudents, answers: tAnswers, settings: tSettings})[TTAB]();
}
function tFlags() {
  const row = t => { const f = FL(t.id); return `<tr><td class="mono"><b>${esc(t.id)}</b>${t.role === 'main' ? ' <span class="tag k">осн.</span>' : t.like ? ' <span class="vhint">≈ ' + esc(t.like) + '</span>' : ''}</td><td>${esc((t.real || t.title).slice(0, 120))}${(t.real || '').length > 120 ? '…' : ''}</td>
    <td><label class="chk"><input type="checkbox" data-hw="${t.id}" ${f.hw ? 'checked' : ''}> ДЗ</label></td><td><label class="chk"><input type="checkbox" data-fv="${t.id}" ${f.fav ? 'checked' : ''}> ★</label></td></tr>`; };
  $('#tBody').innerHTML = `<p class="vhint" style="margin-top:0">Отмеченные «ДЗ» задачи ученик увидит в фильтре «🏠 ДЗ» (основные, аналоги — неважно, где они лежат) и на главной. «Решено» ставится автоматически при верном ответе; вручную — кнопкой «✓ решено» в карточке задачи (после входа учителя). Флаги хранятся в файле: после изменений сохраните файл и отправьте ученику.</p>
   <div class="row"><button class="btn sm" id="fNone">снять все ДЗ</button><span class="vhint">Быстро: в блоке кнопки «осн.» — все основные, «сам.» — все для самостоятельной работы.</span></div>
   ${TASKS.length ? BLOCKS.filter(b => MAINS(b.id).length || HWS(b.id).length).map(b => `<h3 style="margin:16px 0 6px">${esc(b.name)} <button class="btn sm" data-bm="${b.id}">ДЗ: осн.</button> <button class="btn sm" data-bh="${b.id}">ДЗ: аналоги</button></h3><table class="st">${MAINS(b.id).concat(HWS(b.id)).map(row).join('')}</table>`).join('') : '<div class="card"><b>Банк задач пока пуст.</b><p>Загрузите JSON через кнопку «Загрузить JSON» в основном окне. Старые задачи в кабинете учителя не используются.</p></div>'}
   <div class="row" style="margin-top:12px"><button class="btn pri" id="fSave">💾 Сохранить файл тренажёра с флагами (без учеников)</button></div>`;
  document.querySelectorAll('[data-hw]').forEach(c => c.onchange = () => setFlag(c.dataset.hw, 'hw', c.checked));
  document.querySelectorAll('[data-fv]').forEach(c => c.onchange = () => setFlag(c.dataset.fv, 'fav', c.checked));
  document.querySelectorAll('[data-bm]').forEach(b => b.onclick = () => { MAINS(b.dataset.bm).forEach(t => setFlag(t.id, 'hw', true)); tFlags(); });
  document.querySelectorAll('[data-bh]').forEach(b => b.onclick = () => { HWS(b.dataset.bh).forEach(t => setFlag(t.id, 'hw', true)); tFlags(); });
  $('#fNone').onclick = () => confirmBox('Снять отметку ДЗ со всех задач?', () => { Object.keys(DB.flags).forEach(k => { DB.flags[k].hw = false; }); DB.teacherUpdated = Date.now(); persist(); tFlags(); });
  $('#fSave').onclick = () => saveApp('__none__');
}
function tStudents() {
  const L = Object.values(DB.students).sort((a, b) => (b.updated || 0) - (a.updated || 0));
  $('#tBody').innerHTML = storeBox() + (L.length ? `<table class="st"><tr><th>Ученик</th><th>Решено</th><th>Сам / с помощью</th><th>ДЗ</th><th>Ошибок</th><th>Время</th><th>Был</th><th></th></tr>${L.map(s => { const c = counts(s), hw = hwList(), ch = counts(s, hw); const wr = Object.entries(s.tasks || {}).filter(([id]) => !!TK[id]).reduce((a, [, x]) => a + (x.wrong || []).length, 0);
    return `<tr><td><b>${esc(s.name)}</b></td><td>${c.done}/${c.total}</td><td>${c.ok + c.err} / ${c.hint + c.fill}</td><td>${hw.length ? ch.done + '/' + ch.total : '—'}</td><td>${wr}</td><td>${fmtT(s.totalMs || 0)}</td><td>${s.updated ? new Date(s.updated).toLocaleDateString('ru-RU') : ''}</td>
     <td><div class="row"><button class="btn sm" data-r="${esc(s.name)}">📄 Отчёт</button><button class="btn sm ghost" data-f="${esc(s.name)}" title="Сохранить файл только с этим учеником">💾</button><button class="btn sm ghost" data-del="${esc(s.name)}">🗑</button></div></td></tr>`; }).join('')}</table>`
    : '<p class="vhint">Пока никто не занимался на этом устройстве. Ученик присылает файл тренажёра (💾) — откройте его здесь.</p>') + `<div class="row" style="margin-top:12px"><button class="btn red" id="clrAll">🧹 Очистить прогресс всех</button></div>`;
  document.querySelectorAll('[data-r]').forEach(b => b.onclick = () => reportDialog(b.dataset.r, true));
  document.querySelectorAll('[data-f]').forEach(b => b.onclick = () => saveApp(b.dataset.f));
  document.querySelectorAll('[data-del]').forEach(b => b.onclick = () => confirmBox('Удалить прогресс ученика ' + esc(b.dataset.del) + '?', () => { delete DB.students[b.dataset.del]; writeLS(); tStudents(); }));
  $('#clrAll').onclick = () => confirmBox('Удалить прогресс ВСЕХ учеников на этом устройстве? Сначала сохраните файл, если он нужен.', () => { clearAll(); tStudents(); });
}
function tAnswers() {
  const tc = DB.teacher; tc.realAns = tc.realAns || {};
  $('#tBody').innerHTML = `<p class="vhint" style="margin-top:0">Ответы к реальным задачам (по файлам). Если ответ внесён (или есть в сборнике — показан серым), ответ ученика «по файлу» проверяется автоматически; иначе он попадает в отчёт «на проверку». Свой ответ заменяет ответ из сборника.</p>
   <table class="st"><tr><th>Задача</th><th>Блок</th><th>Файл</th><th>Ответ по файлу</th><th>Из сборника</th></tr>${TASKS.map(t => `<tr><td class="mono">${esc(t.id)}</td><td>${esc(t.blk)}</td><td>${t.file ? `<a href="${esc(t.file)}" target="_blank" rel="noopener">файл</a>` : '—'}</td><td><input class="inp mono" style="width:140px;padding:4px 8px" data-ra="${esc(t.id)}" value="${esc(tc.realAns[t.id] || '')}" placeholder="${esc(t.realAns || '')}"></td><td class="vhint">${t.realAns ? 'по умолчанию: ' + esc(t.realAns) : ''}${t.alias ? ' · = № ' + esc(t.alias) : ''}</td></tr>`).join('')}</table>`;
  document.querySelectorAll('[data-ra]').forEach(i => i.onchange = () => { const v = i.value.trim(); if (v) tc.realAns[i.dataset.ra] = v; else delete tc.realAns[i.dataset.ra]; DB.teacherUpdated = Date.now(); persist(); });
}
function tSettings() {
  const tc = DB.teacher;
  $('#tBody').innerHTML = `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px">
   <label>Имя учителя<br><input class="inp" id="sN" style="width:100%" value="${esc(tc.name)}"></label><label>E-mail для отчётов<br><input class="inp" id="sE" style="width:100%" value="${esc(tc.email)}"></label>
   <label>Telegram (без @)<br><input class="inp" id="sT" style="width:100%" value="${esc(tc.tg)}"></label><label>PIN учителя<br><input class="inp" id="sP" style="width:100%" value="${esc(tc.pin)}"></label></div>
   <label class="chk" style="margin-top:10px"><input type="checkbox" id="sAns" ${tc.repAns ? 'checked' : ''}> показывать верные ответы в отчёте ученика</label>
   <label class="chk" style="margin-top:6px"><input type="checkbox" id="sFill" ${tc.noFillAsk ? 'checked' : ''}> «✨ Заполнить поля» без подтверждения (удобно на уроке)</label>
   <div class="row" style="margin-top:12px"><button class="btn pri" id="sSave">Сохранить</button><button class="btn" id="sFile">💾 Сохранить файл тренажёра (с прогрессом всех)</button></div>${storeBox()}`;
  $('#sSave').onclick = () => { tc.name = $('#sN').value.trim(); tc.email = $('#sE').value.trim(); tc.tg = $('#sT').value.trim().replace(/^@/, ''); tc.pin = $('#sP').value.trim() || '31415'; tc.repAns = $('#sAns').checked; tc.noFillAsk = $('#sFill').checked; DB.teacherUpdated = Date.now(); writeLS(); toast('Сохранено'); };
  $('#sFile').onclick = () => saveApp();
}

/* ===== Отчёт ===== */
function hintStr(x) { const h = []; if (x.hint >= 1) h.push('подсказка'); if (x.hint >= 2) h.push('разбор'); if (x.hint >= 3) h.push('заполнил поля / готовый код'); return h.join(', '); }
function calcReport(name) {
  const s = DB.students[name];
  const ids = ORDER.filter(id => !!TK[id] && (s.tasks[id] && (solved(s.tasks[id]) || s.tasks[id].tries || s.tasks[id].runs) || FL(id).hw));
  const rows = ids.filter(id => TK[id]).map(id => ({id, t: TK[id], x: normX(Object.assign({}, s.tasks[id] || {})), hw: !!FL(id).hw}));
  const c = counts(s), hw = hwList(), ch = counts(s, hw);
  const byBlk = BLOCKS.map(b => { const all = ORDER.filter(id => TK[id] && TK[id].blk === b.id), cc = counts(s, all); return {b, total: all.length, done: cc.done, self: cc.ok + cc.err, help: cc.hint + cc.fill, wrong: all.reduce((a, id) => a + ((s.tasks[id] || {}).wrong || []).length, 0)}; });
  return {s, c, ch, hwN: hw.length, rows, byBlk, wrongTotal: rows.reduce((a, r) => a + r.x.wrong.length, 0)};
}
function reportDialog(name, teacher) {
  if (!DB.students[name]) return; tickTime();
  const r = calcReport(name), showAns = teacher || DB.teacher.repAns;
  modal(`<div class="mhead"><h2>📄 Отчёт: ${esc(name)}</h2><span class="sp"></span><button class="btn ghost" id="rX">✕</button></div>
   <div class="stats">${[['Решено', r.c.done + ' / ' + r.c.total], ['ДЗ', r.hwN ? r.ch.done + ' / ' + r.ch.total : '—'], ['Сам, с 1-й', r.c.ok], ['Сам, после ошибок', r.c.err], ['С подсказкой', r.c.hint], ['Заполнил поля', r.c.fill], ['Неверных ответов', r.wrongTotal], ['Время', fmtT(r.s.totalMs || 0)]].map(([a, b]) => `<div class="stat"><b>${b}</b><span>${a}</span></div>`).join('')}</div>
   <table class="st"><tr><th>Блок</th><th>Решено</th><th>Сам</th><th>С помощью</th><th>Ошибок</th></tr>${r.byBlk.map(b => `<tr><td>${b.b.id} · ${esc(b.b.name)}</td><td>${b.done}/${b.total}</td><td>${b.self}</td><td>${b.help}</td><td>${b.wrong}</td></tr>`).join('')}</table>
   <details open><summary style="cursor:pointer;font-weight:800">Задачи, с которыми работал(а), и ДЗ (${r.rows.length})</summary><table class="st"><tr><th>№</th><th>Итог</th><th>Попыток</th><th>Неверные ответы</th><th>Помощь</th><th>Ответ по файлу</th>${showAns ? '<th>Верный ответ (учебная строка)</th>' : ''}</tr>
   ${r.rows.map(w => `<tr><td class="mono">${esc(w.id)}${w.hw ? ' <sup class="fh">Д</sup>' : ''}</td><td>${ST_LABEL[w.x.st]}</td><td>${w.x.tries}</td><td class="mono">${esc(w.x.wrong.join('; ')) || '—'}</td><td>${esc(hintStr(w.x)) || '—'}</td><td class="mono">${w.x.real ? esc(w.x.real) + (w.x.realOk === true ? ' ✅' : w.x.realOk === false ? ' ❌' : ' ⏳') : '—'}</td>${showAns ? `<td class="mono">${esc(w.t.ans)}</td>` : ''}</tr>`).join('')}</table></details>
   <p class="vhint">Тренажёр-туннель: ${r.s.sand || 0} · дни: ${(r.s.days || []).map(d => d.split('-').reverse().slice(0, 2).join('.')).join(', ')}</p>
   <div class="row"><label class="chk"><input type="checkbox" id="rCode" checked> код ученика в PDF (задачи с ошибками и подсказками)</label></div>
   <div class="row" style="margin-top:10px"><button class="btn pri" id="rS">📤 Отправить учителю</button><button class="btn" id="rD">📥 Скачать PDF</button></div><div id="rMsg" style="margin-top:12px"></div>`, 'wide');
  $('#rX').onclick = closeModal;
  $('#rD').onclick = async () => { const f = await makeReportPDF(name, teacher, $('#rCode').checked); download(f, f.name); showSendHelp(name, true); };
  $('#rS').onclick = async () => {
    const f = await makeReportPDF(name, teacher, $('#rCode').checked);
    try { if (navigator.canShare && navigator.canShare({files: [f]})) { await navigator.share({files: [f], title: 'Отчёт: ' + name, text: reportText(name)}); $('#rMsg').innerHTML = '<div class="fb show good">Отчёт передан ✅</div>'; return; } } catch (e) { if (e && e.name === 'AbortError') return; }
    download(f, f.name); showSendHelp(name, false);
  };
}
function reportText(name) { const r = calcReport(name); return `Отчёт тренажёра «${APPNAME}». Ученик: ${name}. Решено ${r.c.done} из ${r.c.total}${r.hwN ? ', ДЗ: ' + r.ch.done + ' из ' + r.ch.total : ''}: сам с 1-й попытки — ${r.c.ok}, сам после ошибок — ${r.c.err}, с подсказкой — ${r.c.hint}, после заполнения полей — ${r.c.fill}. Неверных ответов: ${r.wrongTotal}. Время: ${fmtT(r.s.totalMs || 0)}. PDF во вложении.`; }
function showSendHelp(name, justDl) {
  const tc = DB.teacher, subj = encodeURIComponent('Отчёт по тренажёру ЕГЭ 24: ' + name), body = encodeURIComponent(reportText(name));
  $('#rMsg').innerHTML = `<div class="fb show good" style="font-weight:600">📥 PDF-отчёт скачан в «Загрузки».${justDl ? '' : ' Прямо отсюда отправить файл нельзя — '} Отправь его учителю:<br>
   ${tc.email ? `• e-mail: <b>${esc(tc.email)}</b> — <a href="mailto:${esc(tc.email)}?subject=${subj}&body=${body}">открыть письмо</a> и прикрепить PDF<br>` : ''}${tc.tg ? `• Telegram: <a href="https://t.me/${esc(tc.tg)}" target="_blank">@${esc(tc.tg)}</a><br>` : ''}${!tc.email && !tc.tg ? '• через мессенджер или почту, которые вы используете с учителем.<br>' : ''}Можно отправить и сам файл тренажёра (💾) — в нём сохранён прогресс ученика.</div>`;
}
async function makeReportPDF(name, teacherView, withCode) {
  const mm = document.getElementById('rMsg'); if (mm) mm.innerHTML = '<div class="fb show good">⏳ Формирую PDF…</div>';
  const showAns = !!(DB.teacher.repAns || teacherView);
  const r = calcReport(name), W = 1240, H = 1754, MX = 70, pages = []; let cv, ctx, y;
  const newPage = () => { cv = document.createElement('canvas'); cv.width = W; cv.height = H; ctx = cv.getContext('2d'); ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, W, H); pages.push(cv); y = 70; };
  const F = (sz, b, m) => `${b ? 'bold ' : ''}${sz}px ${m ? 'Consolas,"Courier New",monospace' : '"Segoe UI",Roboto,Arial,sans-serif'}`;
  const text = (s, x, yy, sz, col, b, al, m) => { ctx.font = F(sz, b, m); ctx.fillStyle = col || '#1d2640'; ctx.textAlign = al || 'left'; ctx.fillText(s, x, yy); };
  const fit = (s, w, sz, m) => { ctx.font = F(sz, 0, m); s = String(s); if (ctx.measureText(s).width <= w) return s; while (s.length > 2 && ctx.measureText(s + '…').width > w) s = s.slice(0, -1); return s + '…'; };
  const rr = (x, yy, w, h, rad, fill) => { ctx.beginPath(); ctx.moveTo(x + rad, yy); ctx.arcTo(x + w, yy, x + w, yy + h, rad); ctx.arcTo(x + w, yy + h, x, yy + h, rad); ctx.arcTo(x, yy + h, x, yy, rad); ctx.arcTo(x, yy, x + w, yy, rad); ctx.closePath(); ctx.fillStyle = fill; ctx.fill(); };
  newPage();
  const g = ctx.createLinearGradient(0, 0, W, 0); g.addColorStop(0, '#4f6bff'); g.addColorStop(1, '#7b5cff'); ctx.fillStyle = g; ctx.fillRect(0, 0, W, 190);
  text('Отчёт ученика', MX, 82, 48, '#fff', 1); text('ЕГЭ 24 · Алгоритмы обработки строк', MX, 130, 26, '#e8ebff'); text(new Date().toLocaleString('ru-RU'), W - MX, 82, 24, '#e8ebff', 0, 'right');
  y = 250; text('Ученик: ' + name, MX, y, 36, '#1d2640', 1); y += 46;
  text(`Дни занятий: ${(r.s.days || []).map(d => d.split('-').reverse().join('.')).join(', ') || '—'}`, MX, y, 22, '#555'); y += 32;
  text(`Время: ${fmtT(r.s.totalMs || 0)}  ·  тренажёр-туннель: ${r.s.sand || 0}${DB.teacher.name ? '  ·  учитель: ' + DB.teacher.name : ''}`, MX, y, 22, '#555'); y += 44;
  const tiles = [['Решено', r.c.done + ' / ' + r.c.total, '#e8ecff', '#3b4fd8'], ['ДЗ', r.hwN ? r.ch.done + ' / ' + r.ch.total : '—', '#fff0e0', '#b25e00'], ['Сам, с 1-й', r.c.ok, '#dff6ea', '#0f7a4d'], ['После ошибок', r.c.err, '#e6f7ef', '#2e8a5f'], ['С подсказкой', r.c.hint + r.c.fill, '#fff2cc', '#8a6400'], ['Неверных', r.wrongTotal, '#ffe3e3', '#c0262c']];
  const tw = (W - 2 * MX - 5 * 16) / 6;
  tiles.forEach((t, i) => { const x = MX + i * (tw + 16); rr(x, y, tw, 120, 18, t[2]); text(String(t[1]), x + tw / 2, y + 64, 36, t[3], 1, 'center'); text(t[0], x + tw / 2, y + 100, 17, '#444', 0, 'center'); });
  y += 170; const bw = W - 2 * MX;
  text('По блокам', MX, y, 30, '#1d2640', 1); y += 20;
  const tcol = [MX, MX + 600, MX + 740, MX + 860, MX + 1010];
  rr(MX, y, bw, 44, 10, '#f1f3fa'); ['Блок', 'Решено', 'Сам', 'С помощью', 'Ошибок'].forEach((h, i) => text(h, tcol[i] + 12, y + 30, 20, '#555', 1)); y += 44;
  r.byBlk.forEach((b, i) => { if (i % 2) rr(MX, y, bw, 40, 8, '#fafbfe'); text(fit(b.b.id + ' · ' + b.b.name, 580, 20), tcol[0] + 12, y + 28, 20); text(b.done + ' / ' + b.total, tcol[1] + 12, y + 28, 20, b.done === b.total ? '#0f7a4d' : '#1d2640', 1); text(String(b.self), tcol[2] + 12, y + 28, 20); text(String(b.help), tcol[3] + 12, y + 28, 20); text(String(b.wrong), tcol[4] + 12, y + 28, 20, b.wrong ? '#c0262c' : '#1d2640'); y += 40; });
  const cx = [MX, MX + 130, MX + 420, MX + 500, MX + 720, MX + 920];
  const head = () => { text('Задачи', MX, y, 30, '#1d2640', 1); text('Д — домашнее задание', W - MX, y, 16, '#888', 0, 'right'); y += 18; rr(MX, y, bw, 40, 10, '#f1f3fa'); ['№', 'Итог', 'Поп.', 'Неверные ответы', 'Помощь', showAns ? 'Ответ' : 'По файлу'].forEach((h, i) => text(h, cx[i] + 8, y + 27, 18, '#555', 1)); y += 40; };
  y += 40; if (y > H - 300) newPage(); head();
  const stCol = {ok: ['#dff6ea', '#0f7a4d'], err: ['#e6f7ef', '#2e8a5f'], hint: ['#fff2cc', '#8a6400'], fill: ['#ffe8d6', '#b04e10'], mark: ['#e8ecff', '#3b4fd8'], new: ['#f1f3fa', '#888']};
  r.rows.forEach((w, i) => {
    if (y > H - 110) { newPage(); head(); }
    const x = w.x; if (i % 2) rr(MX, y, bw, 36, 6, '#fafbfe');
    text(w.id + (w.hw ? ' Д' : ''), cx[0] + 4, y + 25, 17, '#1d2640', 1, 'left', 1);
    rr(cx[1] + 4, y + 5, 276, 26, 13, stCol[x.st][0]); text(fit(ST_LABEL[x.st].toLowerCase(), 266, 15), cx[1] + 142, y + 24, 15, stCol[x.st][1], 1, 'center');
    text(String(x.tries || 0), cx[2] + 35, y + 25, 17, '#333', 0, 'center');
    text(fit(x.wrong.join('; ') || '—', 210, 16), cx[3] + 8, y + 25, 16, x.wrong.length ? '#c0262c' : '#999');
    text(fit(hintStr(x) || '—', 190, 15), cx[4] + 8, y + 25, 15, x.hint ? '#8a6400' : '#999');
    text(fit(showAns ? String(w.t.ans) : x.real ? x.real + (x.realOk === true ? ' ✓' : x.realOk === false ? ' ✗' : ' ?') : '—', 160, 16, 1), cx[5] + 8, y + 25, 16, '#333', 0, 'left', 1);
    y += 36;
  });
  if (withCode) {
    const cs = r.rows.filter(w => w.x.code && (w.x.tries || w.x.runs) && (w.x.st !== 'ok' || w.x.wrong.length));
    if (cs.length) {
      newPage(); text('Код ученика (задачи с ошибками и подсказками)', MX, y, 30, '#1d2640', 1); y += 24;
      cs.forEach(w => { const lines = w.x.code.split('\n').slice(0, 22), h = 70 + lines.length * 24; if (y + h > H - 90) newPage();
        rr(MX, y, bw, h, 14, '#f6f7fb'); text(w.id + ' · ' + ST_LABEL[w.x.st].toLowerCase() + (w.x.wrong.length ? ' · ошибки: ' + w.x.wrong.slice(0, 4).join('; ') : ''), MX + 16, y + 34, 20, '#1d2640', 1);
        lines.forEach((l, k) => text(fit(l, bw - 40, 17, 1), MX + 20, y + 64 + k * 24, 17, '#26304f', 0, 'left', 1)); y += h + 16; });
    }
  }
  pages.forEach((p, i) => { const c = p.getContext('2d'); c.font = F(16); c.fillStyle = '#999'; c.textAlign = 'center'; c.fillText(`${APPNAME} · ${name} · стр. ${i + 1} из ${pages.length}`, W / 2, H - 40); });
  const imgs = pages.map(p => { const d = atob(p.toDataURL('image/jpeg', 0.9).split(',')[1]); const u = new Uint8Array(d.length); for (let i = 0; i < d.length; i++) u[i] = d.charCodeAt(i); return u; });
  if (mm) mm.innerHTML = '';
  const blob = pdfFromJpegs(imgs, W, H), fn = 'Отчёт_регулярки_' + name.replace(/[^\wА-Яа-яЁё-]+/g, '_') + '_' + dstamp() + '.pdf';
  try { return new File([blob], fn, {type: 'application/pdf'}); } catch (e) { blob.name = fn; return blob; }
}
function pdfFromJpegs(imgs, w, h) {
  const enc = new TextEncoder(), parts = [], offs = []; let len = 0;
  const add = x => { const b = typeof x === 'string' ? enc.encode(x) : x; parts.push(b); len += b.length; };
  const PW = 595.28, PH = 841.89, n = imgs.length; add('%PDF-1.4\n');
  const obj = (id, body) => { offs[id] = len; add(id + ' 0 obj\n'); body(); add('\nendobj\n'); };
  obj(1, () => add('<< /Type /Catalog /Pages 2 0 R >>'));
  obj(2, () => add(`<< /Type /Pages /Count ${n} /Kids [${imgs.map((_, i) => (3 + i * 3) + ' 0 R').join(' ')}] >>`));
  imgs.forEach((im, i) => { const p = 3 + i * 3, c = p + 1, x = p + 2;
    obj(p, () => add(`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${PW} ${PH}] /Resources << /XObject << /Im${i} ${x} 0 R >> >> /Contents ${c} 0 R >>`));
    const cs = `q ${PW} 0 0 ${PH} 0 0 cm /Im${i} Do Q`; obj(c, () => add(`<< /Length ${cs.length} >>\nstream\n${cs}\nendstream`));
    obj(x, () => { add(`<< /Type /XObject /Subtype /Image /Width ${w} /Height ${h} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${im.length} >>\nstream\n`); add(im); add('\nendstream'); }); });
  const total = 3 + n * 3, xref = len; let x = `xref\n0 ${total}\n0000000000 65535 f \n`; for (let i = 1; i < total; i++) x += String(offs[i]).padStart(10, '0') + ' 00000 n \n';
  add(x); add(`trailer\n<< /Size ${total} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`); return new Blob(parts, {type: 'application/pdf'});
}


/* ================================================================
   ДОПОЛНЕНИЯ 19.11: разбор всех шагов, варианты регулярок, findall ⇄ finditer,
   автопроверка после запуска, сворачивание разделов, шпаргалка-гид, ИИ-помощник
   ================================================================ */
Object.assign(MLAB, {dp: '📈 ДП / подсчёт за один проход', rx2: '🧩 Регулярка: чётность прямо в шаблоне', ev: '🧮 Через eval'});
if (DB.teacher.noMethAsk == null) DB.teacher.noMethAsk = true;
cur.fold = {};
const BIDX = id => { const n = BLOCKS.findIndex(b => b.id === id); return id === 'RS' ? '★' : id; };

/* текст задачи с вопроса: «Определите…» */
function qtext(t) {
  const r = String(t.real || t.title || '').replace(/\s+/g, ' ').trim();
  const m = r.search(/(Определите|Найдите|Найти|Сколько|Укажите|Требуется|Вычислите|Подсчитайте|Запишите|Необходимо)/);
  return m > 0 ? r.slice(m) : r;
}

/* ===== Боковая панель: звёздочки, сворачивание, текущая задача посередине ===== */
function chip(id) {
  const s = stu(), x = s.tasks[id], t = TK[id], f = FL(id);
  return `<button class="it ${stClass(x)} ${id === cur.id ? 'cur' : ''} ${t.role === 'hw' ? 'hwt' : ''} ${t.star ? 'zs' : ''}" data-id="${id}" title="${esc(qtext(t).slice(0, 160))}">${t.star ? '<b class="zst">★</b>' : ''}${esc(id)}${f.hw ? '<sup class="fh">Д</sup>' : ''}${f.fav ? '<sup class="ff">♥</sup>' : ''}</button>`;
}
function sidebar() {
  const s = stu(), c = counts(s);
  const pr = ['ok', 'err', 'hint', 'fill', 'mark'].map(k => `<i style="width:${c.total ? c[k] / c.total * 100 : 0}%;background:${{ok: '#16a36a', err: '#7bd3a7', hint: '#ffd666', fill: '#ffb27a', mark: '#9aa6ff'}[k]}"></i>`).join('');
  const nhw = hwList().length, nfav = ORDER.filter(id => FL(id).fav).length;
  let h = `<div class="filt">${[['all', 'Все'], ['hw', '🏠 ДЗ' + (nhw ? ' ' + nhw : '')], ['fav', '♥' + (nfav ? ' ' + nfav : '')], ['new', 'Не решено']].map(([k, n]) => `<button data-f="${k}" class="${cur.filter === k ? 'on' : ''}">${n}</button>`).join('')}</div>
   <div style="font-weight:800;margin-top:6px">Решено: ${c.done} / ${c.total}</div><div class="prog">${pr}</div>`;
  if (cur.filter !== 'all') {
    const L = navList();
    if (!L.length) h += `<p class="vhint">${cur.filter === 'hw' ? 'Учитель пока не отметил задачи для домашней работы.' : cur.filter === 'fav' ? 'Избранных задач пока нет.' : 'Всё решено! 🎉'}</p>`;
    BLOCKS.forEach(b => { const ids = L.filter(id => TK[id].blk === b.id); if (!ids.length) return;
      h += `<div class="sec"><div class="sech"><span class="bid">${BIDX(b.id)}</span>${esc(b.name)}</div><div class="its">${ids.map(chip).join('')}</div></div>`; });
  } else {
    h += `<div class="foldbar"><button data-fold="fold" title="Свернуть все разделы, кроме того, где текущая задача">⊟ Свернуть</button><button data-fold="open" title="Развернуть все разделы (только основные задачи)">⊞ Развернуть</button><button data-fold="all" title="Развернуть все разделы вместе с задачами для самостоятельной работы">⊞ + аналоги</button></div>`;
    BLOCKS.forEach(b => {
      const mains = MAINS(b.id), hws = HWS(b.id), all = mains.concat(hws).map(t => t.id), dn = all.filter(id => solved(s.tasks[id])).length;
      const folded = cur.fold[b.id] && cur.blk !== b.id, open = cur.open[b.id];
      h += `<div class="sec ${cur.blk === b.id ? 'here' : ''} ${cur.blk === b.id && cur.view === 'block' ? 'cur' : ''} ${folded ? 'folded' : ''}"><div class="sechw"><button class="fo" data-fo="${b.id}" title="${folded ? 'Развернуть' : 'Свернуть'} раздел">${folded ? '▸' : '▾'}</button><button class="sech sb" data-b="${b.id}"><span class="bid">${BIDX(b.id)}</span>${esc(b.name)}<small>${dn}/${all.length}</small></button></div>
       ${folded ? '' : `<div class="its">${mains.map(t => chip(t.id)).join('')}</div>
       ${hws.length ? `<button class="hwbtn" data-o="${b.id}">${open ? '▾' : '▸'} Для самостоятельной работы · ${hws.filter(t => solved(s.tasks[t.id])).length}/${hws.length}</button>${open ? `<div class="hwbox">${mains.map(m => { const a = hws.filter(t => t.like === m.id); return a.length ? `<div class="hwg"><span>аналоги ${esc(m.id)}:</span>${a.map(t => chip(t.id)).join('')}</div>` : ''; }).join('')}${(() => { const rest = hws.filter(t => !mains.some(m => m.id === t.like)); return rest.length ? `<div class="hwg">${rest.map(t => chip(t.id)).join('')}</div>` : ''; })()}</div>` : ''}` : ''}`}</div>`;
    });
  }
  h += `<div class="legend"><span><i style="background:#16a36a"></i>сам</span><span><i style="background:#7bd3a7"></i>после ошибок</span><span><i style="background:#ffd666"></i>с подсказкой</span><span><i style="background:#ffb27a"></i>заполнил поля</span><span><i style="background:#9aa6ff"></i>отметил учитель</span><span><i style="background:var(--err);border-radius:50%"></i>были ошибки</span></div>
   <div class="legend">Номера — задачи с kompege.ru (К. Ю. Кабанов); «а», «б» — учебные аналоги. <b class="zst">★</b> — задача со звёздочкой, <sup class="fh">Д</sup> — домашнее задание, <sup class="ff">♥</sup> — избранное.</div>`;
  return `<aside class="side" id="side">${h}</aside>`;
}
function centerCur() {
  const side = $('#side'), c = document.querySelector('#side .it.cur') || document.querySelector('#side .sec.here');
  if (!side || !c) return;
  const sr = side.getBoundingClientRect(), cr = c.getBoundingClientRect();
  side.scrollTop += (cr.top - sr.top) - side.clientHeight / 2 + cr.height / 2;
}
function bindSide() {
  document.querySelectorAll('#side .it').forEach(b => b.onclick = () => { tickTime(); openTask(b.dataset.id); });
  document.querySelectorAll('#side .sb').forEach(b => b.onclick = () => { tickTime(); openBlock(b.dataset.b); });
  document.querySelectorAll('#side .hwbtn').forEach(b => b.onclick = () => { cur.open[b.dataset.o] = !cur.open[b.dataset.o]; refreshSide(); });
  document.querySelectorAll('#side [data-f]').forEach(b => b.onclick = () => { cur.filter = b.dataset.f; refreshSide(); });
  document.querySelectorAll('#side [data-fo]').forEach(b => b.onclick = () => { const k = b.dataset.fo; if (k === cur.blk) { toast('В этом разделе — текущая задача, он не сворачивается'); return; } cur.fold[k] = !cur.fold[k]; refreshSide(); });
  document.querySelectorAll('#side [data-fold]').forEach(b => b.onclick = () => {
    const m = b.dataset.fold;
    if (m === 'fold') { BLOCKS.forEach(x => { cur.fold[x.id] = x.id !== cur.blk; cur.open[x.id] = x.id === cur.blk && cur.open[x.id]; }); }
    else { cur.fold = {}; BLOCKS.forEach(x => { cur.open[x.id] = m === 'all' ? true : (x.id === cur.blk && TK[cur.id] && TK[cur.id].role === 'hw'); }); }
    refreshSide();
  });
  requestAnimationFrame(centerCur);
}
function refreshSide() { const o = $('#side'); if (!o) return; o.outerHTML = sidebar(); bindSide(); }

/* ===== Пояснения ко ВСЕМ строкам кода ===== */
function noteFor(L, ctx) {
  const ng = ctx.ng; let m;
  const R = (re) => (m = re.exec(L));
  if (R(/^from re import \*/)) return 'подключаем все функции модуля re: findall, finditer, search, fullmatch, split, sub';
  if (R(/^import re/)) return 'подключаем модуль регулярных выражений re';
  if (R(/^s = open\(/)) return 'на экзамене: читаем файл целиком';
  if (R(/^s = '/)) return /\\n/.test(L) ? 'учебный текст из нескольких строк (\\n — перевод строки). На экзамене: s = open(\'24.txt\').read()' : 'учебная строка. На экзамене: s = open(\'24.txt\').readline().strip()';
  if (R(/^print\(len\(s\), set\(s\)/)) return 'проверка данных: длина строки, какие символы в ней есть, её начало';
  if (R(/^num = r'/)) return 'кусок шаблона «одно число» — подставим его в выражение через f-строку';
  if (R(/^(p|w|word) = r'/)) return 'кусок шаблона в отдельной переменной — дальше подставим его через f-строку {' + m[1] + '}';
  if (R(/^w = '/)) return 'слово, по которому работаем';
  if (R(/^pattern = f'\(\?=\(\{pattern\}\)\)'/)) return 'обёртка: просмотр вперёд — поиск с КАЖДОЙ позиции (с перекрытиями). Весь кусок — группа 1, группы внутри шаблона сдвигаются: начинаются с 2';
  if (R(/^pattern\d? = [rf]{1,2}'.*\{/)) return 'f-строка: Python подставит в шаблон готовые куски из переменных в фигурных скобках';
  if (R(/^pattern\d? = r'/)) return 'сама регулярка. r перед кавычкой — «сырая» строка: \\d, \\1 остаются как есть';
  if (R(/^(\w+) = findall\(pattern\d?, s, M\)/)) return 'findall с флагом M: ^ и $ — начало и конец каждой строки текста';
  if (R(/^(\w+) = findall\(f'\(\?=\(\{(\w+)\}\)\)', s\)/)) return 'та же обёртка (?=( … )) прямо внутри findall — с каждой позиции ищем второй шаблон';
  if (R(/^(\w+) = findall\(pattern\d?, s\)/)) return ng === 0 ? 'findall — список всех найденных кусков (без перекрытий: поиск продолжается с конца найденного)' : ng === 1 ? 'в шаблоне одна группа — findall вернёт список её содержимого (строки)' : 'в шаблоне ' + ng + ' групп(ы) — findall вернёт список кортежей (группа1, группа2, …)';
  if (R(/^(\w+) = findall\((r?'.*'), s\)/)) return 'findall по шаблону ' + m[2] + ' — список всех совпадений';
  if (R(/^(\w+) = \[m\.group\(\) for m in finditer/)) return 'finditer выдаёт объекты-совпадения; m.group() — весь найденный кусок, даже если в шаблоне есть группы';
  if (R(/^(\w+) = \[m\.group\((\d)\) for m in finditer/)) return 'finditer: m.group(' + m[2] + ') — содержимое группы №' + m[2] + (m[2] === '1' ? ' (с обёрткой (?=( … )) это весь кусок)' : '');
  if (R(/^(\w+) = \[m\.groups\(\) for m in finditer/)) return 'finditer: m.groups() — кортеж всех групп, как у findall';
  if (R(/^(\w+) = \[m for m in finditer/)) return 'сохраняем сами объекты-совпадения: у каждого есть group(), start(), end()';
  if (R(/^(\w+) = \[m\.start\(\) for m in finditer/)) return 'позиции, где начинается каждое совпадение (m.start()), — номера символов';
  if (R(/^(\w+) = set\(m\.start\(\) for m in finditer/)) return 'множество позиций совпадений: проверка «i in f» работает мгновенно';
  if (R(/^(\w+) = \[\(len\(m\.group/)) return 'для каждого совпадения собираем кортеж-ключ: длина, значение, позиция — потом max выберет лучший';
  if (R(/^for m in findall/)) return 'перебираем все найденные куски';
  if (R(/^for m in finditer/)) return 'перебираем объекты-совпадения: m.group(), m.start(), m.end()';
  if (R(/^(\w+) = split\(r?'(.*)', s\)/)) return 'split из re режет строку по шаблону: куски МЕЖДУ совпадениями';
  if (R(/^s = sub\(/)) return 'sub заменяет каждое совпадение шаблона: здесь вставляем пробел, чтобы потом разрезать строку';
  if (R(/^s = s\.replace\((.+?), (.+)\)/)) return 'replace (без регулярок) — заменяем ' + m[1] + ' на ' + m[2];
  if (R(/^while (.+) in s:/)) return 'повторяем замену, пока такой кусок остаётся: налезающие вхождения replace за один раз не заменяет';
  if (R(/^(\w+) = s\.split\(\)/)) return 'split() без аргумента режет по пробелам и выбрасывает пустые куски';
  if (R(/^(\w+) = s\.split\((.+)\)/)) return 'режем строку по ' + m[2] + ': получаем список кусков между разделителями';
  if (R(/^(\w+) = \[c\[(\d)\] for c in l\]/)) return 'из каждого кортежа берём c[' + m[2] + '] — группу №' + (+m[2] + 1);
  if (R(/^l = \[\(l\.count\(c\), c\)/)) return 'для каждой буквы — пара (сколько раз встретилась, буква)';
  if (R(/^(\w+) = \[(.+) for (\w+) in (\w+) if (.+)\]/)) return 'фильтр: оставляем только элементы, для которых ' + m[5];
  if (R(/^(\w+) = \[int\(x\) for x in l\]/)) return 'строки-числа превращаем в числа int';
  if (R(/^(\w+) = \[(.+) for (\w+) in (\w+)\]/)) return 'для каждого элемента списка ' + m[4] + ' вычисляем ' + m[2];
  if (R(/^maxs = max\(l \+ l2/)) return 'лучший кусок из обоих списков';
  if (R(/^maxs = max\(l, key=len\)/)) return 'самый длинный элемент списка (key=len — сравниваем по длине, а не по алфавиту)';
  if (R(/^mins = min\(l, key=len\)/)) return 'самый короткий элемент списка';
  if (R(/^(\w+) = max\(l, key=lambda/)) return 'лучший элемент по составному ключу: сначала сравниваем первое, при равенстве — второе';
  if (R(/^(\w+) = max\(l\)$/)) return 'max сравнивает кортежи по первому элементу, при равенстве — по следующим';
  if (R(/^k, c = max\(/)) return 'самая частая буква: пары сравниваются сначала по количеству';
  if (R(/^k = max\(x\[0\] for x in l\)/)) return 'наибольшая частота';
  if (R(/^c = min\(.*== k\)/)) return 'среди самых частых — первая по алфавиту (min); «последняя по алфавиту» — max';
  if (R(/^c = max\(.*== k\)/)) return 'среди самых частых — последняя по алфавиту';
  if (R(/^def ok\(ss\):/)) { ctx.fn = 'ok'; return 'функция-проверка: подходит ли подстрока ss под условие задачи (True / False)'; }
  if (R(/^def good\((\w+)\):/)) { ctx.fn = 'good'; return 'функция-проверка для одного числа'; }
  if (R(/^def calc\(/)) { ctx.fn = 'calc'; return 'своя функция вместо eval: делим по + на слагаемые, каждое по * на множители — так соблюдается приоритет умножения'; }
  if (R(/^def (\w+)\(/)) { ctx.fn = m[1]; return 'своя функция ' + m[1] + '(…) — её вызываем ниже'; }
  if (R(/^return (True|False)$/)) return 'функция сразу возвращает ' + m[1];
  if (R(/^return (.+)/)) return ctx.fn === 'ok' ? 'ok вернёт True, только если выполняются все условия задачи в этой строке' : 'результат функции';
  if (R(/^for i in range\(len\(s\)\):/)) return 'i — начало подстроки: перебираем все позиции строки';
  if (R(/^for i in range\(len\(s\) - 1, -1, -1\):/)) return 'идём с КОНЦА строки к началу: ответ для позиции i строится из уже посчитанных правее (ДП)';
  if (R(/^for i in range\(n - 1, -1, -1\):/)) return 'с конца к началу: значения правее уже посчитаны (ДП)';
  if (R(/^for j in range\(len\(s\), i, -1\):/)) return 'конец перебираем с самого дальнего: первая подошедшая подстрока — самая длинная';
  if (R(/^for j in range\(i \+ (\d+), len\(s\) \+ 1\):/)) return 'j — конец среза (символ j уже не входит): подстрока s[i:j] длиной от ' + m[1] + ' и больше';
  if (R(/^for j in range\(i, len\(s\)\):/)) return 'j — правый край: двигаем его от i до конца строки';
  if (R(/^for j in range\(len\(s\)\):/)) return 'j — правый край окна / конец подстроки';
  if (R(/^ss = s\[i:j\]/)) return 'подстрока с символа i по j−1';
  if (R(/^if ok\(ss\) and len\(ss\) > dl:/)) return 'подстрока подходит и длиннее найденной — запоминаем';
  if (R(/^if ok\(ss\) and len\(ss\) < dl:/)) return 'подстрока подходит и короче найденной — запоминаем';
  if (R(/^dl = 0/)) return 'длина лучшего найденного куска — пока 0';
  if (R(/^dl = len\(s\) \+ 1/)) return 'для минимума начинаем с заведомо большого значения';
  if (R(/^dl = len\(ss\)/)) return 'новая лучшая длина';
  if (R(/^dl = max\(dl, (.+)\)/)) return 'обновляем максимум: оставляем большее из старого dl и ' + m[1];
  if (R(/^dl = min\(dl, (.+)\)/)) return 'обновляем минимум';
  if (R(/^(k|K|n|N|d|run|save|r|v|p|best) = (-?\d+|None)$/)) return ({k: 'счётчик', save: 'сэкономленные символы', run: 'длина текущей серии', best: 'лучший результат'}[m[1]] || 'начальное значение ' + m[1]) + ' — пока ' + m[2];
  if (R(/^k \+= 1/)) return 'нашли ещё одну подходящую — счётчик +1';
  if (R(/^k \+= (.+)/)) return 'прибавляем к счётчику ' + m[1];
  if (R(/^(\w+) = \{\}/)) return 'пустой словарь: буква → сколько раз встретилась';
  if (R(/^(\w+)\[(\w+)\] = \1\.get\(\2, 0\) \+ 1/)) return 'счётчик буквы +1 (get даёт 0, если буквы ещё не было)';
  if (R(/^(\w+) = \[0\] \* /)) return 'массив, заполненный нулями: ячейка на каждую позицию строки';
  if (R(/^(\w+) = \[False\] \* /)) return 'массив отметок: какие символы надо вырезать';
  if (R(/^for (\w+) in set\((.+)\):/)) return 'перебираем различные символы ' + m[2] + ' (каждый по одному разу)';
  if (R(/^for (\w+) in (\w+)\.split\((.*)\):/)) return 'перебираем куски ' + m[2] + ', разрезанной по ' + (m[3] || 'пробелам');
  if (R(/^for (\w+) in '(.*)':/)) return 'перебираем символы «' + m[2] + '» по одному';
  if (R(/^for (\w+) in (\w+)\[(.+)\]:/)) return 'перебираем элементы ' + m[2] + ' начиная с ' + m[3];
  if (R(/^for (\w+) in (\w+):/)) return 'перебираем элементы ' + m[2];
  if (R(/^try:/)) return 'пробуем выполнить: если внутри случится ошибка, программа не упадёт';
  if (R(/^except/)) return 'ошибка (например, некорректное выражение) — просто пропускаем';
  if (R(/^pass$/)) return 'ничего не делаем';
  if (R(/^(\w+)\.append\((.+)\)/)) return 'добавляем ' + m[2] + ' в конец списка ' + m[1];
  if (R(/^(\w+)\.add\((.+)\)/)) return 'добавляем ' + m[2] + ' в множество ' + m[1];
  if (R(/^del (.+)/)) return 'удаляем ' + m[1] + ' из словаря';
  if (R(/^(\w+)\[(.+)\] (\+|-)= (.+)/)) return (m[3] === '+' ? 'увеличиваем' : 'уменьшаем') + ' счётчик ' + m[1] + '[' + m[2] + ']';
  if (R(/^for (\w+) in range\((.+)\):/)) return 'цикл: ' + m[1] + ' пробегает значения range(' + m[2] + ')';
  if (R(/^for (\w+), (\w+) in (.+):/)) return 'перебираем пары значений';
  if (R(/^while i < len\(s\):/)) return 'идём по строке, пока не дошли до конца';
  if (R(/^while (.+):/)) return 'цикл «пока»: повторяем, пока условие ' + m[1] + ' верно';
  if (R(/^break/)) return 'выходим из внутреннего цикла: дальше подстроки только хуже';
  if (R(/^continue/)) return 'пропускаем этот шаг цикла';
  if (R(/^else:/)) return 'иначе — если условие выше не выполнилось';
  if (R(/^elif (.+):/)) return 'иначе, если ' + m[1];
  if (R(/^if (.+):/)) return 'проверка условия; строки с отступом ниже выполняются, только если оно верно';
  if (R(/^print\((.+)\)$/)) return ctx.last ? 'последняя строка вывода — это ответ' : 'выводим для проверки глазами';
  if (R(/^(\w+(?:, \w+)*) = (.+)$/)) return 'вычисляем ' + m[1];
  if (R(/^(\w+)\[(.+)\] = (.+)$/)) return 'записываем значение в ячейку ' + m[1] + '[' + m[2] + ']';
  if (R(/^(\w+) (\+|-|\*)= (.+)/)) return 'изменяем ' + m[1] + ' на ' + m[3];
  return '';
}
function lineNotes(code, t) {
  const lines = code.split('\n');
  let lastPrint = -1; lines.forEach((l, i) => { if (/^\s*print\(/.test(l)) lastPrint = i; });
  const ctx = {ng: t ? t.groups : 0, fn: ''};
  return lines.map((line, i) => {
    if (!/^\s/.test(line)) ctx.fn = '';
    ctx.last = i === lastPrint;
    const cm = (/\s#\s*(.*)$/.exec(line) || [])[1];
    const L = line.trim().replace(/\s+#.*$/, '');
    if (!L) return {line, d: ''};
    let d = noteFor(L, ctx);
    if (cm) d = cm + (d && !/^(вычисляем|проверка условия|цикл|перебираем элементы)/.test(d) ? ' · ' + d : '');
    return {line, d};
  });
}

/* ===== Разбор задачи: все шаги текущего способа + варианты регулярки ===== */
function patLines(code) {
  const L = code.split('\n').filter(l => /^(pattern\d?|p|num) = |^l\d? = findall\(f'|^\w+ = sub\(/.test(l.trim()));
  return L.length ? L.map(l => l.trim()).join('   ⏎   ') : code.split('\n').slice(2).join(' ⏎ ').slice(0, 140);
}
function renderHelp(t) {
  const x = X(t.id); let h = '';
  const mk = x.meth && t.methods[x.meth] ? x.meth : MK(t);
  if (x.sIdea) h += `<div class="hcard"><b>💡 Подсказка.</b> ${esc(t.idea || 'Опиши словами, какой кусок строки подходит, и переведи каждое слово в элемент регулярки — памятка по алгоритмам обработки строк 📘 в помощь.')}${t.note && !x.sTh ? `<div class="ideanote">⚠ <b>Обрати внимание:</b> ${esc(t.note)}</div>` : ''}</div>`;
  if (x.sTh) {
    const code = t.methods[mk] || t.methods[MK(t)];
    const notes = lineNotes(code, t);
    const rxShown = /pattern|findall|finditer|sub\(/.test(code) && t.final;
    h += `<div class="hcard th2"><b>📖 Разбор задачи</b> <span class="vhint">— способ: ${esc(mk === MK(t) ? mainLabel(t).replace(' — заготовка с полями', '') : (MLAB[mk] || mk))}</span>
      ${t.norx ? '<div class="thsec warnbox">Регулярки — неподходящий способ для этой задачи: ' + esc(MK(t) === 'split' ? 'режем строку split/replace и считаем по кускам.' : MK(t) === 'pos' ? 'берём позиции вхождений и считаем по ним.' : MK(t) === 'win' ? 'двигаем окно или перебираем с ранним выходом.' : 'считаем прямо по строке: один проход, два цикла или ДП.') + '</div>' : ''}
      ${t.idea ? `<div class="thsec"><b>Идея.</b> ${esc(t.idea)}</div>` : ''}
      <div class="thsec"><b>Алгоритм — шаг за шагом:</b><table class="ln">${notes.filter(n => n.line.trim()).map((n, k) => `<tr><td class="lnn">${k + 1}</td><td><code>${esc(n.line.replace(/\s+#.*$/, ''))}</code></td><td>${esc(n.d)}</td></tr>`).join('')}</table></div>
      ${rxShown ? `<div class="thsec">Регулярка целиком (после всех строк с pattern): <code class="big">${esc(t.final)}</code>${t.flags ? ' <span class="tag">флаг ' + esc(t.flags) + '</span>' : ''}</div>
      <div class="thsec"><b>Регулярка по частям:</b>${treeHTML(t.tree)}</div>` : ''}
      ${t.note ? `<div class="thsec warnbox">⚠ <b>Обрати внимание:</b> ${esc(t.note)}</div>` : ''}
      ${(t.alts || []).length ? `<div class="thsec"><b>🔀 Другие варианты</b> <span class="vhint">— отметь галочкой: вариант встанет в редактор, запусти ▶ и сравни. Сними галочку — вернётся твой код.</span>
        ${t.alts.map((a, k) => `<label class="altv ${x.alt === k ? 'on' : ''}"><input type="checkbox" data-alt="${k}" ${x.alt === k ? 'checked' : ''}><span class="altc"><code>${esc(patLines(a.code))}</code><span>${esc(a.d)}</span><em class="${a.ok ? 'ok' : 'bad'}">${a.ok ? '✔ на учебной строке ответ верный' : '✖ на учебной строке ответ другой'}${a.eq != null ? ' · совпадает с основным решением на ' + Math.round(a.eq * 100) + '% случайных строк' : ''}</em></span></label>`).join('')}</div>` : ''}
      ${t.final ? '<div class="row"><button class="btn sm" id="thDbg">🔎 Открыть эталонную регулярку в отладчике</button></div>' : ''}</div>`;
  }
  $('#hz').innerHTML = h;

  document.querySelectorAll('[data-alt]').forEach(cb => cb.onchange = () => {
    const k = +cb.dataset.alt;
    if (cb.checked) {
      if (x.alt == null) { x.codeOwn = ED.get(); x.fieldsOwn = x.fields || []; }
      if (!solved(x)) x.hint = Math.max(x.hint, 3);
      x.alt = k; ED.set(t.alts[k].code, [], true); x.code = ED.get(); x.fields = [];
      toast('🔀 Вариант ' + (k + 1) + ' в редакторе. Нажми ▶ — посмотри, что он находит.');
    } else {
      x.alt = null; ED.set(x.codeOwn != null ? x.codeOwn : tpl(t.tpl), x.codeOwn != null ? (x.fieldsOwn || []) : tplFields(t.tpl), true); x.code = ED.get();
      toast('↩ Вернулся твой код.');
    }
    bump(); renderHelp(t); ffUpdate();
  });
}

/* ===== findall ⇄ finditer ===== */
function ffMode(code) {
  if (/^\s*\w+ = findall\(pattern\d?, s(, M)?\)/m.test(code)) return 'findall';
  if (/^\s*\w+ = \[m\.(group\(\)|group\(1\)|groups\(\)) for m in finditer\(pattern\d?, s(, M)?\)\]/m.test(code)) return 'finditer';
  return '';
}
function ffConvert(code, to, ng) {
  if (to === 'finditer') return code.replace(/^(\s*)(\w+) = findall\((pattern\d?), s(, M)?\)([^\n]*)$/m, (m0, ind, v, p, fl, rest) => {
    const warn = /⚠/.test(rest); const g = warn || ng === 0 ? 'group()' : ng === 1 ? 'group(1)' : 'groups()';
    return `${ind}${v} = [m.${g} for m in finditer(${p}, s${fl || ''})]`;
  });
  return code.replace(/^(\s*)(\w+) = \[m\.(group\(\)|group\(1\)|groups\(\)) for m in finditer\((pattern\d?), s(, M)?\)\]([^\n]*)$/m, (m0, ind, v, g, p, fl) => {
    const same = (g === 'group()' && ng === 0) || (g === 'group(1)' && ng === 1) || (g === 'groups()' && ng >= 2);
    return `${ind}${v} = findall(${p}, s${fl || ''})` + (same ? '' : '   # ⚠ в шаблоне есть группы: findall вернёт содержимое групп, а не весь кусок!');
  });
}
function ffUpdate() {
  const seg = $('#ffSeg'); if (!seg || !ED) return;
  const md = ffMode(ED.get()); seg.style.display = md ? '' : 'none';
  seg.querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.ff === md));
}
function ffBind(t) {
  const seg = $('#ffSeg'); if (!seg) return;
  seg.querySelectorAll('button').forEach(b => b.onclick = () => {
    const to = b.dataset.ff, code = ED.get(); if (ffMode(code) === to) return;
    const nc = ffConvert(code, to, t.groups || 0); if (nc === code) return;
    ED.set(nc); X(t.id).code = ED.get(); bump(); ffUpdate();
    toast(to === 'finditer' ? '📍 finditer: объекты m — m.group() весь кусок, m.group(N) группа, m.start() позиция. Запусти ▶ и сравни.' : '📋 findall: сразу список строк; если в шаблоне есть группы — их содержимое (кортежи). Запусти ▶ и сравни.', 4500);
  });
  ffUpdate();
}

/* ===== Запуск: ответ подставляется сам, верный — переход дальше ===== */
let AUTO_NEXT = null;
async function runMain() {
  const t = TK[cur.id]; if (!t || !ED) return; const x = X(t.id);
  clearTimeout(AUTO_NEXT);
  const code = ED.get();
  const pl = code.split('\n').find(l => /^pattern\s*=\s*r'/.test(l.trim()));
  if (pl && /r'\s*'/.test(pl)) { $('#exp').innerHTML = '<div class="exp">Поле с регуляркой пустое — впиши шаблон (или нажми «✨ Заполнить поля»).</div>'; return; }
  if (pl && /r' {6,}/.test(pl)) { $('#exp').innerHTML = '<div class="exp">В поле с регуляркой остались пробелы-заглушки — впиши шаблон вместо них.</div>'; }
  else $('#exp').innerHTML = '';
  setBusy(true); $('#st').textContent = 'Выполняю…'; const t0 = performance.now();
  const r = await PY.run(code, {onStatus: m => { const e = $('#st'); if (e) e.textContent = m; }});
  setBusy(false); if (!$('#out') || cur.id !== t.id) return;
  x.runs++; X(t.id).code = code; bump();
  $('#st').textContent = r.fatal ? '⚠️ Не удалось запустить Python: ' + r.err + '. Нужен интернет при первом запуске.' : `Готово за ${Math.round(performance.now() - t0)} мс.`;
  showOut(r); ED.err(r.ok ? null : r.line);
  const ex = explainErr(r, code); if (ex) $('#exp').innerHTML += `<div class="exp">💬 ${ex}</div>`;
  CUR_RUN = {code, out: r.out || '', err: r.ok ? '' : (r.err || '') + (r.line ? ' (строка ' + r.line + ')' : '')};
  if (r.ok) {
    const last = lastLine(r.out);
    if (last) {
      const ai = $('#ansIn'); ai.value = last;
      if (normA(last) === normA(t.ans)) checkAns(t, true);
      else { const fb = $('#fb'); fb.className = 'fb show bad'; fb.innerHTML = `Последняя строка вывода <code>${esc(last)}</code> подставлена в ответ — и это <b>не</b> ответ. Проверь шаблон: открой 🔎 отладчик и посмотри, что он находит.${x.hint < 1 ? ' Можно взять 💡 подсказку.' : ''}`; }
    }
  }
}
let CUR_RUN = null;
function checkAns(t, auto) {
  const x = X(t.id), v = $('#ansIn').value.trim(), fb = $('#fb'); if (!v) { $('#ansIn').focus(); return; }
  x.tries++;
  if (normA(v) === normA(t.ans)) {
    const was = solved(x);
    if (!was) { x.st = x.hint >= 3 ? 'fill' : x.hint >= 1 ? 'hint' : x.wrong.length ? 'err' : 'ok'; x.md = dstamp(); x.ans = v; x.code = ED.get(); }
    bump(); refreshSide();
    const tc = $('#tc'); if (tc) tc.classList.add('solved');
    fb.className = 'fb show good'; fb.innerHTML = '✅ Верно! ' + (x.st === 'ok' && !was ? 'Сам и с первой попытки — отлично!' : '') + (was ? '' : ' Флаг «решено» поставлен.');
    if (x.st === 'ok' && !was) confetti();
    const an = ANALOGS(t.id).filter(a => !solved(stu().tasks[a.id]));
    if (an.length) fb.innerHTML += ` <span style="font-weight:600">Закрепи на аналоге:</span> ${an.slice(0, 4).map(a => `<button class="btn sm" data-go="${a.id}">№ ${esc(a.id)}</button>`).join(' ')}`;
    const nx = nextUnsolved(t.id); if (nx) fb.innerHTML += ` <button class="btn sm pri" data-go="${nx}">Дальше → ${esc(nx)}</button>`;
    if (auto && !was && nx) {
      fb.innerHTML += `<div class="autonx">Переход к № ${esc(nx)} через <b id="anS">3</b> с… <button class="btn sm ghost" id="anStop">остаться здесь</button></div>`;
      let k = 3; const tick = () => { k--; const e = $('#anS'); if (!e || cur.id !== t.id) return; if (k <= 0) { openTask(nx); return; } e.textContent = k; AUTO_NEXT = setTimeout(tick, 1000); };
      AUTO_NEXT = setTimeout(tick, 1000);
      $('#anStop').onclick = () => { clearTimeout(AUTO_NEXT); const a = document.querySelector('.autonx'); if (a) a.remove(); };
    }
    fb.querySelectorAll('[data-go]').forEach(b => b.onclick = () => { clearTimeout(AUTO_NEXT); openTask(b.dataset.go); });
    const fl = document.querySelector('[data-fl="done"]'); if (fl) fl.classList.add('on');
  } else {
    if (!solved(x) && !x.wrong.includes(v)) x.wrong.push(v); bump(); refreshSide();
    const o = $('#out').dataset.last;
    let tip = o && normA(o) === normA(v) ? 'Программа выводит именно это — значит, ошибка в шаблоне. Открой 🔎 отладчик и посмотри, какие куски он находит и каких не хватает.' : !o ? 'Выполни программу ▶ — последняя строка вывода сама встанет в ответ.' : '';
    if (x.wrong.length >= 2 && x.hint < 1) tip += ' Можно взять 💡 подсказку или спросить 🤖 ИИ-помощника.';
    fb.className = 'fb show bad'; fb.innerHTML = '❌ Неверно. ' + tip;
  }
}

/* ===== Смена способа: для учителя без лишних вопросов ===== */
function setMethod(t, k) {
  const x = X(t.id);
  const doit = () => {
    if (k === MK(t)) { x.code = tpl(t.tpl); x.fields = tplFields(t.tpl); }
    else { if (!solved(x)) x.hint = Math.max(x.hint, 3); x.code = t.methods[k]; x.fields = []; }
    x.meth = k; x.alt = null; bump(); openTask(t.id);
  };
  const quiet = cur.teach && DB.teacher.noMethAsk !== false;
  if (k !== MK(t) && !solved(x) && !quiet) confirmBox('Это готовое решение другим способом. Задача засчитается как «после готового кода». Вставить?', doit, 'Вставить');
  else doit();
}
function tSettings() {
  const tc = DB.teacher;
  $('#tBody').innerHTML = `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px">
   <label>Имя учителя<br><input class="inp" id="sN" style="width:100%" value="${esc(tc.name)}"></label><label>E-mail для отчётов<br><input class="inp" id="sE" style="width:100%" value="${esc(tc.email)}"></label>
   <label>Telegram (без @)<br><input class="inp" id="sT" style="width:100%" value="${esc(tc.tg)}"></label><label>PIN учителя<br><input class="inp" id="sP" style="width:100%" value="${esc(tc.pin)}"></label></div>
   <label class="chk" style="margin-top:10px"><input type="checkbox" id="sAns" ${tc.repAns ? 'checked' : ''}> показывать верные ответы в отчёте ученика</label>
   <label class="chk" style="margin-top:6px"><input type="checkbox" id="sFill" ${tc.noFillAsk ? 'checked' : ''}> «✨ Заполнить поля» без подтверждения (удобно на уроке)</label>
   <label class="chk" style="margin-top:6px"><input type="checkbox" id="sMeth" ${tc.noMethAsk !== false ? 'checked' : ''}> когда вошёл учитель — менять способ решения без вопроса «засчитается как готовый код»</label>
   <div class="row" style="margin-top:12px"><button class="btn pri" id="sSave">Сохранить</button><button class="btn" id="sFile">💾 Сохранить файл тренажёра (с прогрессом всех)</button></div>${storeBox()}`;
  $('#sSave').onclick = () => { tc.name = $('#sN').value.trim(); tc.email = $('#sE').value.trim(); tc.tg = $('#sT').value.trim().replace(/^@/, ''); tc.pin = $('#sP').value.trim() || '31415'; tc.repAns = $('#sAns').checked; tc.noFillAsk = $('#sFill').checked; tc.noMethAsk = $('#sMeth').checked; DB.teacherUpdated = Date.now(); writeLS(); toast('Сохранено'); };
  $('#sFile').onclick = () => saveApp();
}

/* ===== Отладчик: подстановка всех кусков {p}, {num}, {w} ===== */
/* ===== Шпаргалка: какую функцию выбрать + синтаксис с примерами ===== */
const FN_GUIDE = [
 ['Нужно… ', 'Бери', 'Почему'],
 ['найти все куски и посчитать их или выбрать самый длинный', 'findall', 'сразу список строк: len(l), max(l, key=len)'],
 ['то же, но куски налезают друг на друга (AAAA → три AA)', "findall + обёртка (?=( … ))", 'просмотр вперёд ничего не забирает — поиск идёт с каждой позиции'],
 ['весь кусок, а в шаблоне есть группы ( … ) или \\1', 'finditer → m.group()', 'findall вернул бы только содержимое групп'],
 ['ГДЕ стоят совпадения: позиции, номер символа, расстояния', 'finditer → m.start(), m.end()', 'findall позиций не знает'],
 ['проверить, подходит ли кусок ЦЕЛИКОМ', 'fullmatch', 'None или совпадение на всю строку'],
 ['есть ли совпадение где-нибудь / первое совпадение', 'search', 'останавливается на первом'],
 ['разрезать строку по разделителю-шаблону', 'split (из re) или s.split', 'куски между совпадениями'],
 ['заменить/разрезать запрещённые места', 'sub или s.replace', 'вставляем пробел и режем'],
 ['текст из нескольких строк, ^ и $ у каждой строки', 'findall(p, s, M)', 'флаг M'],
 ['сумма цифр, коды символов, склейка из слов, «сколько раз» на огромном файле', 'без регулярок: один проход, два цикла, ДП', 'регулярка числа не складывает и не возвращается назад']];
const FN_DOC = [
 ['findall(p, s)', 'Список всех непересекающихся совпадений. Нет групп — строки; одна группа — её содержимое; несколько групп — кортежи.', "findall('AB', 'ABCABXAB')\n→ ['AB', 'AB', 'AB']\nfindall('A(B)', 'ABCAC')\n→ ['B']\nfindall('(A)(.)', 'ABCAC')\n→ [('A', 'B'), ('A', 'C')]\nfindall('(?=(AA))', 'AAAA')\n→ ['AA', 'AA', 'AA']"],
 ['finditer(p, s)', 'Перебор объектов-совпадений m: m.group() — весь кусок, m.group(1) — группа 1, m.groups() — все группы, m.start() / m.end() — где он.', "[m.group() for m in finditer(r'(.)\\1+', 'AABCCCD')]\n→ ['AA', 'CCC']\n[(m.start(), m.end()) for m in finditer('C+', 'AABCCCD')]\n→ [(3, 6)]"],
 ['search(p, s)', 'Первое совпадение где угодно в строке или None. Проверка: if search(p, s):', "search(r'\\d+', 'AB12C345').group()\n→ '12'\nsearch('Z', 'ABC')\n→ None"],
 ['fullmatch(p, ss)', 'Подходит ли ВСЯ строка ss под шаблон (совпадение или None). Удобно в двух циклах: if fullmatch(p, ss).', "fullmatch('[A-F]+', 'ABFE')   → совпадение\nfullmatch('[A-F]+', 'ABFZ')   → None"],
 ['split(p, s)', 'Режет строку по совпадениям шаблона. Подряд идущие разделители дают пустые куски.', "split('D', 'ABDCDDE')\n→ ['AB', 'C', '', 'E']\nsplit('[XY]', 'AXBYC')\n→ ['A', 'B', 'C']"],
 ['sub(p, r, s)', 'Заменяет каждое совпадение на r. В r можно ссылаться на группы: \\1.', "sub('D', ' ', 'ABDCDE')\n→ 'AB C E'\nsub(r'(.)(?=\\1)', r'\\1 ', 'AABCCD')\n→ 'A ABC CD'"],
 ['findall(p, s, M)', 'Флаг M: ^ и $ — начало и конец КАЖДОЙ строки текста.', "findall('^A.*', 'AB\\nCA\\nAC', M)\n→ ['AB', 'AC']"],
 ['max(l, key=len)', 'Самый длинный элемент списка (key=len — сравнение по длине). len(max(...)) — его длина.', "max(['AB', 'ABCD', 'B'], key=len)\n→ 'ABCD'"],
 ['s.split(w), s.replace(a, b), s.count(c)', 'Строковые методы без регулярок: разрезать по слову, заменить, посчитать.', "'AXBXC'.split('X')        → ['A', 'B', 'C']\n'ABDDC'.replace('DD', 'D D') → 'ABD DC'\n'ABCABA'.count('A')      → 3"]];
function cheatHTML(ins) {
  return `<div class="chg"><b>🧭 Какую функцию выбрать</b><table class="bth fng">${FN_GUIDE.map((r, i) => i ? `<tr><td>${esc(r[0])}</td><td><code>${esc(r[1])}</code></td><td>${esc(r[2])}</td></tr>` : `<tr><th>${r[0]}</th><th>${r[1]}</th><th>${r[2]}</th></tr>`).join('')}</table></div>
   <div class="chg"><b>⚙ Функции: синтаксис и примеры</b> <span class="vhint">— нажми, чтобы раскрыть</span>${FN_DOC.map(([a, d, e]) => `<details class="fnd"><summary><code>${esc(a)}</code><span>${esc(d.split('.')[0])}</span></summary><p>${esc(d)}</p><pre class="mono">${esc(e)}</pre></details>`).join('')}</div>` +
   CHEAT.map(([g, L]) => `<div class="chg"><b>${g}</b><div class="chl">${L.map(([a, d]) => ins ? `<button class="chb" data-ins="${esc(a)}" title="вставить в шаблон"><code>${esc(a)}</code><span>${esc(d)}</span></button>` : `<div class="chb"><code>${esc(a)}</code><span>${esc(d)}</span></div>`).join('')}</div></div>`).join('');
}

/* ===== Теория новых блоков ===== */
BTH.RF = [['p = [m.start() for m in finditer(\'A\', s)]', 'позиции всех букв A — дальше считаем по номерам, а не по подстрокам'],
  ['n * (n − 1) // 2', 'число пар из n элементов: каждая пара позиций — одна подстрока'],
  ['pa[i] — префиксная сумма', 'сколько нужных букв среди первых i символов; на отрезке [lo; hi] их pa[hi+1] − pa[lo]'],
  ['почему не findall', 'подстрок может быть миллиарды: перечислять их долго, а посчитать по позициям — быстро'],
  ['«сколько» ≠ «самая длинная»', 'для количества начинать можно с любой позиции — нужно учитывать все начала, а не только самый длинный кусок']];
BTH.RL = [['один проход', 'счётчик k растёт, пока соседняя пара подходит; иначе начинаем заново. dl = max(dl, k)'],
  ['s[j] < s[j-1]', 'символы сравниваются по кодам ASCII: цифры < заглавные < строчные'],
  ['два цикла + break', 'перебираем начало i и конец j, выходим, как только подстрока испортилась'],
  ['ДП с конца', 'best[j] — лучший ответ, если начать с позиции j; считаем справа налево из уже готовых значений'],
  ['почему не регулярка', 'регулярка не складывает числа, не сравнивает коды и выбирает первый подошедший вариант без возврата']];
BTH.R4 = [];
BTH.R4.push(['sub(r\'([ABC])(?=[ABC])\', r\'\\1 \', s)', 'разрезаем запрещённые пары: после символа из набора, если за ним тоже символ из набора, ставим пробел']);

/* ===== ИИ-помощник (работает в опубликованной версии на claude.ai) ===== */
let AIP = null, AINS = null; const AIH = {};
function aiNS() { if (!AIP) AIP = (window.claude && typeof claude.use === 'function' ? claude.use('sample') : Promise.resolve(null)).then(x => (AINS = x)).catch(() => null); return AIP; }
try { setTimeout(aiNS, 50); } catch (e) {}
function aiMd(s) {
  const parts = String(s).split(/```(?:python|py)?\n?/);
  return parts.map((p, i) => i % 2 ? `<pre class="aicode">${esc(p.replace(/\n$/, ''))}</pre>` : esc(p).replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/\n/g, '<br>')).join('');
}
function aiContext() {
  const t = TK[cur.id]; if (!t) return 'Ученик сейчас не в задаче (на главной или в блоке теории).';
  const code = ED ? ED.get() : '';
  const out = CUR_RUN && CUR_RUN.code === code ? CUR_RUN : null;
  return `ЗАДАЧА № ${t.id} (блок «${BK[t.blk].name}»).\nУсловие: ${t.real}\n${t.tr ? 'Учебная строка отличается от файла: ' + t.tr + '\n' : ''}` +
    `Правильный ответ для учебной строки (НЕ называй его ученику, пока он сам не попросит после нескольких попыток): ${t.ans}\n` +
    `Эталонная идея (для тебя): ${t.idea || '—'} ${t.note || ''}\nЭталонное решение (для тебя, целиком не выдавай):\n${t.methods[MK(t)]}\n\n` +
    `КОД УЧЕНИКА СЕЙЧАС:\n${code}\n\n${out ? 'ВЫВОД ПОСЛЕДНЕГО ЗАПУСКА:\n' + (out.out || '(пусто)').slice(-1500) + (out.err ? '\nОШИБКА: ' + out.err : '') : 'Код в этом виде ещё не запускали.'}\nОтвет ученика в поле: ${($('#ansIn') || {}).value || '—'}`;
}
/* ===== Старт ===== */
window.addEventListener('error', e => { const root=document.getElementById('app'); if(root && !root.innerHTML.trim()) root.innerHTML='<div style="max-width:900px;margin:40px auto;padding:24px;border:1px solid #dc7777;border-radius:14px;background:#fff4f4;color:#7f1d1d;font:16px/1.5 Arial"><h2>Не удалось запустить тренажёр</h2><p>Ошибка JavaScript: '+String(e.message||'неизвестная ошибка').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))+'</p><p>Сохраните это сообщение и отправьте разработчику.</p></div>'; });
applyTheme();
document.addEventListener('keydown', e => { if (e.key === 'Escape' && TUNNEL_OVERLAY && TUNNEL_OVERLAY.style.display !== 'none') closeTunnel(); else if (e.key === 'Escape' && document.getElementById('mbg')) closeModal(); });
viewLogin();

</script></body></html>