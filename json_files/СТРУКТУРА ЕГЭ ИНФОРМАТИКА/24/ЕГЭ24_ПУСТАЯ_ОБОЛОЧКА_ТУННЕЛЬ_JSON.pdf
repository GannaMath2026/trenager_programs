<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ЕГЭ 24 · Тренажёр по алгоритмам строк</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&amp;family=JetBrains+Mono:wght@400;700&amp;display=swap" rel="stylesheet">
<style>:root{--bg:#f3f5fb;--card:#fff;--ink:#1d2640;--mut:#6b7491;--line:#e1e5f0;--pri:#4f6bff;--pri2:#7b5cff;--ok:#16a36a;--okl:#dff6ea;--err:#e5484d;--errl:#ffe3e3;--warn:#f0a400;--code:#0f1424;--code2:#161d33;--cink:#e7ecff;--sh:0 6px 22px rgba(30,40,80,.08)}
[data-theme=dark]{--bg:#0f1322;--card:#181e33;--ink:#e6e9f5;--mut:#98a0bf;--line:#2a3150;--okl:#143826;--errl:#3b1518;--code:#0b0f1d;--code2:#131a30;--sh:0 8px 24px rgba(0,0,0,.35)}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 'Nunito','Segoe UI',Roboto,Arial,sans-serif}
button{font:inherit;cursor:pointer}input,select,textarea{font:inherit;color:inherit}
.mono,code,pre{font-family:"JetBrains Mono","Cascadia Code",Consolas,"Courier New",monospace}
.btn{border:0;border-radius:11px;padding:8px 14px;font-weight:700;background:var(--card);color:var(--ink);box-shadow:0 0 0 1.5px var(--line) inset;white-space:nowrap;display:inline-flex;align-items:center;gap:6px;transition:.15s}
.btn:hover{box-shadow:0 0 0 1.5px var(--pri) inset}
.btn.pri{background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;box-shadow:0 6px 16px rgba(79,107,255,.3)}
.btn.ok{background:var(--ok);color:#fff;box-shadow:none}
.btn.yel{background:linear-gradient(135deg,#ffcf4a,#ffb02e);color:#4a3000;box-shadow:none}
.btn.ghost{background:transparent}
.btn.sm{padding:5px 10px;font-size:13px;border-radius:9px}
.btn.on{background:#e6eaff;box-shadow:0 0 0 1.5px var(--pri) inset;color:#2f45c9}[data-theme=dark] .btn.on{background:#262f55;color:#b9c4ff}
.btn:disabled{opacity:.45;cursor:default}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.card{background:var(--card);border-radius:18px;box-shadow:var(--sh);padding:16px 20px;margin-bottom:14px}
.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:#1d2640;color:#fff;padding:11px 18px;border-radius:12px;z-index:300;box-shadow:0 10px 30px rgba(0,0,0,.3);max-width:90vw;font-weight:600}
.mbg{position:fixed;inset:0;background:rgba(15,20,40,.55);display:flex;align-items:center;justify-content:center;z-index:100;padding:12px}
.mdl{background:var(--card);border-radius:20px;padding:20px;max-width:640px;width:100%;max-height:94vh;overflow:auto;box-shadow:0 30px 80px rgba(0,0,0,.35)}
.mdl.wide{max-width:1050px}.mdl.full{max-width:none;width:96vw;height:94vh;max-height:94vh;padding:16px;display:flex;flex-direction:column}
.mdl h2{margin:0 0 10px}
.mhead{display:flex;align-items:center;gap:10px;margin-bottom:10px}.mhead h2{margin:0;flex:1}
.inp{border:1.5px solid var(--line);background:var(--bg);border-radius:11px;padding:8px 12px;outline:none}
.inp:focus{border-color:var(--pri)}
.top{position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:8px;padding:9px 16px;background:var(--card);box-shadow:0 2px 12px rgba(30,40,80,.07);flex-wrap:wrap}
.logo{font-weight:900;font-size:17px;display:flex;align-items:center;gap:8px;white-space:nowrap;cursor:pointer}
.logo i{font-style:normal;width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;font-size:14px}
.top .sp{flex:1}
.ib{border:0;background:var(--bg);color:var(--ink);border-radius:10px;padding:7px 10px;font-weight:700;white-space:nowrap}
.ib:hover{background:#e6eaff}[data-theme=dark] .ib:hover{background:#262f55}
.ib.yel{background:linear-gradient(135deg,#ffcf4a,#ffb02e);color:#4a3000}
.who{font-weight:800;background:var(--bg);border-radius:999px;padding:6px 12px}
.modeb{font-size:12px;font-weight:800;padding:4px 10px;border-radius:999px;background:#e3f6ec;color:#0f7a4d}.modeb.home{background:#fff0e0;color:#b25e00}
.login{max-width:560px;margin:7vh auto;padding:0 14px}
.hero{background:linear-gradient(135deg,#4f6bff,#7b5cff 60%,#b44cff);color:#fff;border-radius:24px;padding:26px;box-shadow:0 20px 50px rgba(79,107,255,.35);position:relative;overflow:hidden;margin-bottom:14px}
.hero h1{margin:0 0 6px;font-size:28px}.hero p{margin:0;opacity:.92}
.hero .code-deco{position:absolute;right:8px;bottom:-6px;font:700 12px/1.35 Consolas,monospace;opacity:.22;white-space:pre;text-align:left}
.slist{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.slist button{border:0;background:var(--bg);color:var(--ink);border-radius:999px;padding:7px 14px;font-weight:700}
.lay{display:grid;grid-template-columns:290px 1fr;gap:16px;padding:16px;max-width:1700px;margin:0 auto}
.side{position:sticky;top:66px;align-self:start;max-height:calc(100vh - 82px);overflow:auto;background:var(--card);border-radius:18px;box-shadow:var(--sh);padding:12px}
.prog{display:flex;height:10px;border-radius:9px;overflow:hidden;background:var(--bg);margin:4px 0 8px}.prog i{display:block;height:100%}
.sbig{width:100%;border:0;border-radius:14px;padding:10px 12px;text-align:left;font-weight:800;display:flex;align-items:center;gap:8px;margin-bottom:6px;background:var(--bg);color:var(--ink)}
.sbig.cons{background:linear-gradient(135deg,#eef1ff,#f6efff)}[data-theme=dark] .sbig.cons{background:#232a4a}
.sbig.cur{outline:2.5px solid var(--pri)}
.sbig small{margin-left:auto;font-weight:700;color:var(--mut)}
.sec{margin-top:10px}.sech{font-weight:900;font-size:13.5px;padding:4px 2px;display:flex;align-items:center;gap:6px}.sech small{margin-left:auto;color:var(--mut)}
.its{display:flex;flex-wrap:wrap;gap:5px;padding:2px 2px 6px}
.it{border:0;border-radius:9px;padding:4px 7px;font:700 12.5px Consolas,monospace;background:var(--bg);color:var(--ink);position:relative;min-width:46px}
.it.z{background:#fff6dc;color:#8a6400}[data-theme=dark] .it.z{background:#3a3010;color:#ffd666}
.it.ok{background:#16a36a;color:#fff}.it.err{background:#7bd3a7;color:#08321f}.it.hint{background:#ffd666;color:#4a3500}.it.fill{background:#ffb27a;color:#4a2000}
.it.cur{outline:2.5px solid var(--pri);outline-offset:1px}
.it.tried::after{content:'';position:absolute;right:2px;top:2px;width:6px;height:6px;border-radius:50%;background:var(--err)}
.legend{font-size:11.5px;color:var(--mut);display:flex;flex-wrap:wrap;gap:6px 10px;margin-top:10px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:4px;vertical-align:-1px}
.main{min-width:0}
.th{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.th h2{margin:0;font-size:21px}
.tag{font-size:12px;font-weight:800;border-radius:999px;padding:3px 10px;background:var(--bg);color:var(--mut);white-space:nowrap}
.tag.z{background:#fff1c7;color:#8a6400}.tag.st{background:#dff6ea;color:#0f7a4d}
.dots{color:#f0a400;letter-spacing:1px}
.cond{white-space:pre-wrap;font-size:16px;line-height:1.55;margin-top:10px}
.cond .q{font-weight:800;background:#fff6dc;border-radius:6px;padding:1px 4px}.cond .cnum{font-weight:850}.cond .example{color:#13734f;background:#eaf8ef;border-radius:5px;padding:1px 3px}[data-theme=dark] .cond .q{background:#3a3010}[data-theme=dark] .cond .example{color:#91e1b6;background:#153a28}
.fold{background:var(--code2);color:#aab4da;border-radius:12px;font:13.5px/20px Consolas,monospace;margin-bottom:8px;overflow:hidden}
.fold>button{border:0;background:transparent;color:inherit;font:inherit;width:100%;text-align:left;padding:7px 12px;display:flex;gap:8px;align-items:center}
.fold>button b{color:#c792ea}.fold>button span.c{color:#69739a;margin-left:auto;font-family:Nunito,sans-serif;font-size:12px}
.fold pre{margin:0;padding:6px 14px 10px;color:var(--cink);border-top:1px solid #253055}
.bar{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:8px}.bar .sp{flex:1}.ed-tools{display:flex;gap:5px;flex-wrap:wrap;align-items:center}.bar button{max-width:100%}.base-vis-frame{width:100%;height:calc(94vh - 64px);min-height:420px;flex:1;border:0;border-radius:12px;background:#0b1018}
.exb{border:0;border-radius:9px;padding:5px 10px;font:700 12.5px Consolas,monospace;background:#e8f7ef;color:#0f7a4d}
[data-theme=dark] .exb{background:#143826;color:#7fe0b0}
.exin{width:84px;padding:5px 8px;font:700 13px Consolas,monospace}
.menu{position:absolute;background:var(--card);border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.2);padding:6px;z-index:150;display:flex;flex-direction:column;min-width:220px;border:1px solid var(--line)}
.menu button{white-space:pre;border:0;background:transparent;color:var(--ink);text-align:left;padding:6px 10px;border-radius:8px;font:13px Consolas,monospace}
.menu button:hover{background:var(--bg)}
.menu small{font-family:Nunito,sans-serif;color:var(--mut);padding:4px 10px}
/* редактор */
.ed{display:flex;background:var(--code);border-radius:14px;overflow:hidden;font:14px/21px "JetBrains Mono","Cascadia Code",Consolas,monospace}
.ed-gut{padding:8px 0;background:var(--code2);color:#5d6890;text-align:right;user-select:none;min-width:38px}
.ed-gut div{padding:0 8px;height:21px}.ed-gut div.on{background:#4f6bff;color:#fff}.ed-gut div.er{background:#e5484d;color:#fff}
.ed-box{position:relative;flex:1;min-width:0;overflow-x:auto}
.ed-hl,.ed-ta,.ed-mark{margin:0;padding:8px 12px;font:inherit;white-space:pre;tab-size:4;border:0}
.ed-hl{position:absolute;inset:0;overflow:hidden;color:var(--cink);pointer-events:none;z-index:1}
.ed-mark{position:absolute;inset:0;overflow:hidden;padding-left:0;padding-right:0;pointer-events:none;z-index:0}
.ed-mark div{height:21px}.ed-mark div.on{background:rgba(79,107,255,.3)}.ed-mark div.er{background:rgba(229,72,77,.32)}
.ed-ta{position:relative;z-index:2;display:block;width:100%;background:transparent;color:transparent;caret-color:#fff;outline:none;resize:none;overflow-x:auto;overflow-y:hidden;min-height:120px}
.ed-ta::selection{background:rgba(123,92,255,.45)}
.hk{color:#c792ea;font-weight:700}.hs{color:#c3e88d}.hn{color:#f78c6c}.hc{color:#69739a;font-style:italic}.hb{display:inline-block;white-space:pre;background:#ffd666;color:#1d2640;border-radius:4px;font-weight:800;min-width:1ch;padding:0 .22em;margin-left:.16em}.hb.touched{opacity:1;background:rgba(255,214,102,.13);color:#e7ecff;box-shadow:0 0 0 1px rgba(255,214,102,.38)}.hb.active{opacity:1;background:rgba(255,214,102,.22)}
.out{background:var(--code);color:#cfe3cf;border-radius:12px;padding:10px 12px;font:13.5px/1.5 Consolas,monospace;white-space:pre-wrap;word-break:break-all;max-height:240px;overflow:auto;min-height:42px;margin-top:8px}
.out .last{background:#2b3a1e;color:#d9ff9e;border-radius:4px;padding:0 3px;font-weight:700}
.out .e{color:#ff9a9a}.out .m{color:#7f8bb8}.out .g{color:#7fe0b0;font-weight:700}
.out.solved{box-shadow:0 0 0 3px var(--ok)}
.status{font-size:12.5px;color:var(--mut);margin-top:4px}
.exp{background:#fff0f0;color:#9b1c21;border-radius:12px;padding:9px 12px;font-size:14px;margin-top:6px}[data-theme=dark] .exp{background:#3b1518;color:#ffb0b3}
.ans{display:flex;gap:8px;align-items:center;flex-wrap:wrap;background:var(--bg);border-radius:14px;padding:10px 12px;margin-top:10px}
.ans .inp{width:170px;font:700 17px Consolas,monospace;background:var(--card)}
.fb{border-radius:12px;padding:10px 14px;font-weight:700;display:none;margin-top:8px}
.fb.show{display:block}.fb.good{background:var(--okl);color:var(--ok)}.fb.bad{background:var(--errl);color:var(--err)}
.nx{height:5px;background:rgba(22,163,106,.25);border-radius:9px;margin-top:8px;overflow:hidden}.nx i{display:block;height:100%;background:var(--ok);width:0;transition:width 2.2s linear}
.card.solved{box-shadow:0 0 0 3px var(--ok),var(--sh)}
.hcard{background:#fff8dc;border:1.5px solid #ffd98a;border-radius:14px;padding:10px 14px;margin-top:8px;color:#4a3500;animation:pop .3s}
[data-theme=dark] .hcard{background:#3a2e12;border-color:#6b5420;color:#ffe6a8}
.hcard .hn2{display:inline-block;background:#f0a400;color:#fff;border-radius:999px;padding:0 9px;margin-right:6px;font-size:12.5px;font-weight:800}
.hcard pre{background:var(--code);color:var(--cink);border-radius:10px;padding:8px 10px;margin:8px 0 4px;font-size:13px;overflow:auto}
code.i{background:var(--bg);border-radius:5px;padding:0 4px;font-size:.92em}
@keyframes pop{from{transform:translateY(8px);opacity:0}to{transform:none;opacity:1}}
/* общие подсказки */
.ghg{margin:14px 0 6px;display:flex;align-items:center;gap:8px;font-size:18px;font-weight:900}.ghg i{width:16px;height:16px;border-radius:5px;display:inline-block}
.ghs{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:12px}
.ghc{background:var(--sc);border-radius:8px 8px 18px 8px;border-top:6px solid var(--se);padding:12px 14px;color:#1d2640;box-shadow:0 8px 18px rgba(40,40,80,.1)}
.ghc b.t{display:block;margin-bottom:4px}
.ghc pre{background:#0f1424;color:#e7ecff;border-radius:10px;padding:8px 10px;margin:8px 0 6px;font-size:12.8px;overflow:auto;white-space:pre}
.ghc .btn{background:#fff}
/* консоль */
.con{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:12px}
.conlog{background:var(--code);color:#e7ecff;border-radius:14px;padding:12px;font:14px/1.5 Consolas,monospace;overflow:auto;white-space:pre-wrap;word-break:break-all;display:flex;flex-direction:column}
.conlog .cmd{color:#82aaff}.conlog .res{color:#c3e88d}.conlog .err{color:#ff9a9a}.conlog .pr{color:#e7ecff}.conside{overflow:auto;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px}.conside textarea{display:block;width:100%;min-height:112px;resize:vertical;background:var(--code);color:#e7ecff;border:1px solid var(--line);border-radius:8px;padding:8px;font:13px/1.45 Consolas,monospace;margin:8px 0}.conside .help{font-size:12px;color:var(--mut);margin:7px 0 12px}.ru-error{display:block;color:#ffd98a;font:13px/1.45 system-ui,sans-serif;padding-top:3px}
.conin{display:flex;gap:6px;align-items:flex-start;margin-top:auto;padding-top:8px}
.conin span{color:#82aaff;font-weight:800;padding-top:6px}
.conin textarea{flex:1;background:#151c33;border:1px solid #2a3150;border-radius:8px;color:#fff;font:14px/1.5 Consolas,monospace;padding:6px 8px;resize:none;outline:none}
.chips{display:flex;flex-wrap:wrap;gap:5px}
.chips button{border:0;background:var(--bg);color:var(--ink);border-radius:8px;padding:4px 8px;font:12.5px Consolas,monospace}
.chips button:hover{background:#e6eaff}
/* пошаговый мини-питон */
.stp{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px}
.stpv{overflow:auto;display:flex;flex-direction:column;gap:8px}
.vtab{width:100%;border-collapse:collapse;font:14px Consolas,monospace}
.vtab td{border-bottom:1px solid var(--line);padding:5px 6px;vertical-align:top}.vtab td:first-child{color:var(--pri);font-weight:800;width:70px}
.vtab tr.ch td{background:#fff3c4}[data-theme=dark] .vtab tr.ch td{background:#3a3010}
.cells{display:flex;flex-wrap:wrap;gap:2px}
.cells span{display:inline-flex;flex-direction:column;align-items:center;min-width:22px;background:#eef1ff;border-radius:5px;padding:1px 3px;font-weight:800}
.cells span small{font-size:9px;color:var(--mut);font-weight:600}
[data-theme=dark] .cells span{background:#232a4a}
/* конструктор */
.cgrid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:14px;flex:1;min-height:0}
.cl{display:flex;align-items:center;gap:6px;margin:4px 0;font:15px/1 Consolas,monospace}
.cl .code{flex:1;background:var(--code);color:var(--cink);border-radius:8px;padding:8px 10px;white-space:pre;min-height:36px;display:flex;align-items:center}
.cl.bad .code{box-shadow:0 0 0 2.5px var(--err)}.cl.good .code{box-shadow:0 0 0 2.5px var(--ok)}
.cl .ind{color:#3c4670}
.cl button{border:0;border-radius:8px;padding:6px 9px;background:var(--bg);color:var(--ink);font-weight:800}
.cl .slot{flex:1;border:2px dashed var(--line);border-radius:8px;padding:8px 10px;color:var(--mut);background:transparent;text-align:left;font:15px Consolas,monospace;white-space:pre}
.cl .num{width:24px;color:var(--mut);text-align:right;font-size:12px}
.lvl3{display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap}
.cdone{color:var(--ok);font-weight:800}
.tbl{width:100%;border-collapse:collapse;font-size:14px}.tbl td,.tbl th{padding:7px 8px;border-bottom:1px solid var(--line);text-align:left}
.tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}.tabs button{border:0;padding:9px 14px;border-radius:10px;background:var(--bg);color:var(--ink);font-weight:800}.tabs button.on{background:var(--pri);color:#fff}
.fld{display:flex;flex-direction:column;gap:4px;margin-bottom:10px;max-width:460px}.fld span{font-size:13px;color:var(--mut);font-weight:700}
.flag{display:inline-flex;align-items:center;gap:4px;margin:3px 5px 3px 0;padding:5px 9px;border-radius:9px;background:var(--bg);font:700 13px Consolas,monospace;cursor:pointer;border:1.5px solid transparent;user-select:none}
.flag.on{border-color:var(--pri);background:#e6eaff;color:#1d2640}
.home{max-width:1100px;margin:16px auto;padding:0 16px;display:grid;grid-template-columns:1fr 1fr;gap:16px}
.hmc{background:var(--card);border-radius:22px;box-shadow:var(--sh);padding:22px;cursor:pointer;border:0;text-align:left;color:var(--ink)}
.hmc:hover{box-shadow:0 0 0 2px var(--pri),var(--sh)}
.hmc h2{margin:6px 0}.hmc .big{font-size:40px}
.pb{height:9px;background:var(--bg);border-radius:9px;overflow:hidden;margin-top:10px}.pb i{display:block;height:100%;background:linear-gradient(90deg,var(--ok),#5ad19b)}
.stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin:12px 0}
.stat{background:var(--bg);border-radius:14px;padding:12px}.stat b{font-size:24px;display:block}.stat span{font-size:13px;color:var(--mut)}
@media (max-width:980px){.lay{grid-template-columns:1fr;padding:8px}.side{position:static;max-height:none}.home{grid-template-columns:1fr}.con,.stp,.cgrid{grid-template-columns:1fr}}

.vhint{color:var(--mut);font-size:13px}
.home2{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:18px;max-width:1300px;margin:18px auto;padding:0 16px}
.hcol{display:flex;flex-direction:column;gap:10px}
.bline{display:flex;align-items:center;gap:12px;border:0;background:var(--card);color:var(--ink);border-radius:16px;padding:12px 14px;box-shadow:var(--sh);text-align:left}
.bline:hover{box-shadow:0 0 0 2px var(--pri) inset,var(--sh)}
.bline .bn{flex:0 0 38px;height:38px;border-radius:12px;display:grid;place-items:center;font-weight:900;color:#fff;background:linear-gradient(135deg,var(--pri),var(--pri2))}
.bline .bt{flex:1;display:flex;flex-direction:column}.bline .bt small{color:var(--mut);font-size:12.5px;line-height:1.35}
.bline .bp{flex:0 0 90px;text-align:right;font-size:13px}.bline .bp i{display:block;height:6px;background:var(--bg);border-radius:6px;overflow:hidden;margin-top:4px}.bline .bp em{display:block;height:100%;background:var(--ok)}
.hwc{border:2px solid #ffb46b !important}
.filt{display:flex;gap:4px;flex-wrap:wrap}
.filt button{border:0;border-radius:999px;padding:5px 10px;font-weight:800;font-size:12.5px;background:var(--bg);color:var(--ink)}
.filt button.on{background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff}
.sec.cur{box-shadow:0 0 0 2px var(--pri) inset;border-radius:12px}
.sech.sb{width:100%;border:0;background:transparent;color:var(--ink);display:flex;gap:6px;align-items:center;text-align:left;cursor:pointer;padding:6px 4px;font-weight:800;font-size:13.5px}
.sech.sb small{margin-left:auto;color:var(--mut)}
.bid{font:800 11px Consolas,monospace;background:var(--bg);border-radius:6px;padding:2px 5px;color:var(--pri)}
.hwbtn{border:0;background:transparent;color:var(--mut);font-weight:700;font-size:12.5px;padding:2px 4px;cursor:pointer;text-align:left}
.hwbox{display:flex;flex-direction:column;gap:4px;padding:4px 0 6px 6px;border-left:2px dashed var(--line);margin-left:6px}
.hwg{display:flex;flex-wrap:wrap;gap:4px;align-items:center}.hwg>span{font-size:11.5px;color:var(--mut);margin-right:2px}
.it.hwt{font-weight:600;opacity:.92}
sup.fh{color:#b25e00;font-weight:900;font-size:9px;margin-left:1px}sup.ff{color:#e0a000;font-size:9px}
.it.fill{background:#ffe2cc;color:#b04e10}.it.mark{background:#e3e8ff;color:#3b4fd8}
.cond{white-space:pre-wrap;line-height:1.55;font-size:16px;margin-top:8px}
.cond .q{font-weight:700}.cnum{color:var(--pri)}
.trn{font-size:13px;color:var(--mut)}
.flags{display:inline-flex;gap:4px}
.tag.k{background:#e6efff;color:#2759d6}.hwtag{background:#fff0e0!important;color:#b25e00!important}
.analogs{margin-top:12px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;font-size:14px}
.th2 code.big,.big{font-size:15px;font-weight:800;background:var(--code);color:#e7ecff;padding:2px 8px;border-radius:7px;word-break:break-all}
.thsec{margin:10px 0}
.warnbox{background:#fff0e0;color:#8a4a00;border-radius:10px;padding:8px 12px}[data-theme=dark] .warnbox{background:#3a2a10;color:#ffcf8a}
ul.tree{list-style:none;margin:4px 0 0;padding-left:16px;border-left:2px solid var(--line)}
ul.tree li{margin:5px 0;font-size:14px}
ul.tree code{background:var(--bg);border-radius:6px;padding:1px 6px;font-weight:800;white-space:pre-wrap;word-break:break-all}
ul.tree code.gc{color:#fff}
.g1{background:#4f6bff!important}.g2{background:#e5484d!important}.g3{background:#13a37a!important}.g4{background:#f08c00!important}.g5{background:#7b5cff!important}.g6{background:#0aa5c2!important}
table.ln,table.bth{border-collapse:collapse;width:100%;font-size:14px}
table.ln td,table.bth td{border-bottom:1px solid var(--line);padding:5px 8px;vertical-align:top}
table.ln td:first-child{width:46%}table.ln code,table.bth code{white-space:pre-wrap;word-break:break-all;font-weight:700}
table.bth td:first-child{width:32%}
.exgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px}
.excard{background:var(--bg);border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:5px}
.exl{font-size:11px;font-weight:800;color:var(--mut);text-transform:uppercase;letter-spacing:.5px}
.ext{margin:0;font:16px/1.6 Consolas,monospace;white-space:pre-wrap;word-break:break-all;background:var(--card);border-radius:8px;padding:6px 8px}
code.exp2{font:700 15px Consolas,monospace;color:var(--pri2);word-break:break-all}
.exr{font-size:12.5px;background:var(--code);color:#c3e88d;border-radius:8px;padding:6px 8px;word-break:break-all}
.exc{font-size:13.5px}
.excard .btn{align-self:flex-start}
mark.m0,.dhl .m0{background:#ffe27a;color:#1d2640;border-radius:3px}mark.m1,.dhl .m1{background:#9fe6c4;color:#1d2640;border-radius:3px}
.dhl .mf{background:#ffc46b!important;border-radius:0}
.nl{color:var(--mut);font-size:.8em}
.tgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px}
.tcard{border:1.5px solid var(--line);background:var(--card);color:var(--ink);border-radius:12px;padding:10px;text-align:left;display:flex;flex-direction:column;gap:4px;font-size:13.5px}
.tcard span{color:var(--mut);font-size:12.5px;line-height:1.35}
.tcard:hover{border-color:var(--pri)}.tcard.ok,.tcard.err{border-color:#7bd3a7}.tcard.hint,.tcard.fill{border-color:#ffd666}
details.hwd summary{cursor:pointer}.hwgrp{margin-top:10px}
/* отладчик */
.dmode{font-size:12.5px;font-weight:800;background:#e3f6ec;color:#0f7a4d;border-radius:999px;padding:4px 10px}
.dtop{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:4px 0 6px}
.pbox{flex:1;min-width:320px;display:flex;align-items:center;background:var(--code);border-radius:12px;padding:6px 10px;font:18px Consolas,monospace}
.pbox .pre{color:#c3e88d;white-space:pre}
.pbox input{flex:1;min-width:120px;background:transparent;border:0;outline:none;color:#ffe27a;font:700 19px Consolas,monospace}
.dflags{display:inline-flex;gap:4px}
.dgrid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:14px;min-height:0}
.dleft,.dright{min-width:0;display:flex;flex-direction:column;gap:6px}
.dlab{font-weight:800;font-size:13.5px;margin-top:4px}
#dS{width:100%;border:1.5px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font:16px Consolas,monospace;padding:8px;resize:vertical}
.dhl{margin:0;background:var(--card);border:1.5px dashed var(--line);border-radius:10px;padding:10px;font:18px/1.9 Consolas,monospace;white-space:pre-wrap;word-break:break-all;min-height:48px}
.dhl .gu{text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:4px}
.dhl .zw{color:#e5484d;font-weight:900;margin:0 -2px}
.dlist{max-height:34vh;overflow:auto}
table.dt{font-size:13px;margin:4px 0}table.dt tr[data-k]{cursor:pointer}table.dt tr.on td{background:#fff1c7}[data-theme=dark] table.dt tr.on td{background:#3a3010}
.dtabs{margin-bottom:6px}.dtab{overflow:auto;max-height:66vh}
.ginfo{background:var(--bg);border-radius:10px;padding:8px 10px;margin:8px 0;font-size:14px}
.fcard{background:var(--bg);border-radius:12px;padding:10px;margin-bottom:8px}
.fcall{font:800 14.5px Consolas,monospace;color:var(--pri)}
.fres{margin:6px 0;background:var(--code);color:#c3e88d;border-radius:8px;padding:6px 8px;font:13px Consolas,monospace;white-space:pre-wrap;word-break:break-all;max-height:140px;overflow:auto}
.fd{font-size:13.5px}
ol.steps2{padding-left:22px;font-size:14px}ol.steps2 li{padding:3px 4px;border-radius:6px;cursor:pointer}ol.steps2 li:hover,ol.steps2 li.on{background:#fff1c7}[data-theme=dark] ol.steps2 li:hover,[data-theme=dark] ol.steps2 li.on{background:#3a3010}
pre.caret{margin:6px 0 0;font:15px Consolas,monospace;color:inherit;background:transparent}
.cheat{display:flex;flex-direction:column;gap:10px}
.chg b{display:block;margin-bottom:4px}
.chl{display:flex;flex-wrap:wrap;gap:6px}
.chb{border:0;background:var(--bg);color:var(--ink);border-radius:10px;padding:5px 9px;display:flex;flex-direction:column;align-items:flex-start;font-size:12px;text-align:left}
.chb code{font:800 14px Consolas,monospace;color:var(--pri2)}
button.chb:hover{box-shadow:0 0 0 1.5px var(--pri) inset}
@media (max-width:980px){.home2,.dgrid{grid-template-columns:1fr}}

/* поле без отступов: курсор совпадает с буквами */
.hb{padding:0!important;margin-left:0!important}
.tag.nrx{background:#fde8e8;color:#9b1c1c;border-color:#f5c2c2}
[data-theme=dark] .tag.nrx{background:#4a1d1d;color:#ffb4b4}
.tag.dd{letter-spacing:-1px;color:#d08a00}
/* 19.11 дополнения */
.foldbar{display:flex;gap:4px;margin:8px 0 2px;flex-wrap:wrap}
.foldbar button{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;padding:3px 8px;font-weight:700;font-size:12px;cursor:pointer}
.foldbar button:hover{border-color:var(--pri)}
.sechw{display:flex;align-items:center;gap:2px}
.fo{border:0;background:transparent;color:var(--mut);cursor:pointer;font-size:12px;padding:2px 3px;width:20px}
.sec.folded .sech.sb{opacity:.75}
.sec.here>.sechw .sech{color:var(--pri)}
.zst{color:#e0a000;font-size:11px;margin-right:2px}
.it.zs{box-shadow:inset 0 -2px 0 #f0b400}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:9px;overflow:hidden;margin-right:8px}
.seg button{border:0;background:var(--card);color:var(--mut);font:700 12.5px Consolas,monospace;padding:5px 9px;cursor:pointer}
.seg button.on{background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff}
.altv{display:flex;gap:10px;align-items:flex-start;padding:8px 10px;border:1.5px solid var(--line);border-radius:10px;margin-top:6px;cursor:pointer;background:var(--card)}
.altv.on{border-color:var(--pri);background:color-mix(in srgb,var(--pri) 8%,var(--card))}
.altv input{margin-top:4px;width:17px;height:17px;flex:none}
.altc{display:flex;flex-direction:column;gap:3px;min-width:0}
.altc code{white-space:pre-wrap;word-break:break-all;font-size:13px}
.altc em{font-style:normal;font-size:12.5px;font-weight:700}.altc em.ok{color:#14945f}.altc em.bad{color:#d0453c}
td.lnn{color:var(--mut);font:12px Consolas,monospace;text-align:right;width:22px}
.ideanote{margin-top:8px;padding:8px 10px;border-radius:9px;background:color-mix(in srgb,#ffb000 14%,transparent)}
.autonx{margin-top:8px;font-weight:700}
table.fng th{text-align:left;font-size:12.5px;color:var(--mut)}
table.fng td{vertical-align:top}
details.fnd{border:1px solid var(--line);border-radius:10px;margin:6px 0;padding:6px 10px;background:var(--card)}
details.fnd summary{cursor:pointer;display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
details.fnd summary span{color:var(--mut);font-size:13px}
details.fnd p{margin:6px 0}
details.fnd pre{background:var(--bg);border-radius:8px;padding:8px 10px;margin:4px 0;white-space:pre-wrap}
