<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Python · ОГЭ №16 — тестовик</title>
<style>:root{--bg:#f4f6fb;--card:#fff;--ink:#1d2640;--mut:#6b7491;--line:#e3e7f1;--pri:#4f6bff;--pri2:#7b5cff;--ok:#16a36a;--okl:#dff6ea;--warn:#f0a400;--warnl:#fff2cc;--bad:#e5484d;--badl:#ffe3e3;--sol:#f07a2a;--soll:#ffe8d6;--sh:0 6px 24px rgba(30,40,80,.08);--r:16px}
[data-theme=dark]{--bg:#12151f;--card:#1b2030;--ink:#e8ecf7;--mut:#9aa3bd;--line:#2b3247;--okl:#173a2b;--warnl:#3d3214;--badl:#43191c;--soll:#45281a;--sh:0 6px 24px rgba(0,0,0,.35)}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:'Nunito','Segoe UI',Roboto,Arial,sans-serif;font-size:16px}
button{font:inherit;cursor:pointer}
input,select{font:inherit}
.sq{white-space:nowrap}.sq .rd{font-size:1.05em}.sq .ov{border-top:1.5px solid currentColor;padding:0 1px;margin-left:1px}
.fr{display:inline-flex;flex-direction:column;vertical-align:middle;text-align:center;margin:0 2px;line-height:1.15;font-size:.92em}
.fr .nu{border-bottom:1.5px solid currentColor;padding:0 3px}.fr .de{padding:0 3px}
sup,sub{font-size:.7em}
.btn{border:0;border-radius:12px;padding:10px 16px;background:var(--line);color:var(--ink);font-weight:700;display:inline-flex;align-items:center;gap:6px;transition:.15s;white-space:nowrap}
.btn:hover{filter:brightness(.96);transform:translateY(-1px)}
.btn.pri{background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;box-shadow:0 4px 14px rgba(79,107,255,.35)}
.btn.ok{background:var(--ok);color:#fff}.btn.ghost{background:transparent;border:1.5px solid var(--line)}
.btn.sm{padding:7px 11px;font-size:14px;border-radius:10px}
.btn:disabled{opacity:.45;pointer-events:none}
/* login */
.login{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 15% 20%,#dfe6ff 0,transparent 40%),radial-gradient(circle at 85% 80%,#ffe1ec 0,transparent 40%),var(--bg)}
[data-theme=dark] .login{background:var(--bg)}
.lcard{background:var(--card);border-radius:24px;box-shadow:var(--sh);padding:32px;max-width:460px;width:100%;text-align:center}
.lcard h1{margin:6px 0 2px;font-size:26px}.lcard .sub{color:var(--mut);margin-bottom:22px}
.logo{font-size:44px;line-height:1}
.lcard input{width:100%;padding:14px 16px;border-radius:14px;border:2px solid var(--line);background:var(--bg);color:var(--ink);font-size:18px;text-align:center;margin-bottom:12px}
.lcard input:focus{outline:none;border-color:var(--pri)}
.prof{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:14px 0}
.prof button{border:1.5px solid var(--line);background:var(--bg);color:var(--ink);border-radius:999px;padding:8px 14px;font-weight:700}
.prof button small{color:var(--mut);font-weight:600}
.lfoot{margin-top:18px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
/* layout */
.top{position:sticky;top:0;z-index:20;background:var(--card);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;padding:10px 16px;flex-wrap:wrap}
.top .ttl{font-weight:800;font-size:17px;display:flex;align-items:center;gap:8px}
.top .who{background:var(--bg);border-radius:999px;padding:6px 12px;font-weight:700}
.pbar{flex:1;min-width:120px;height:10px;background:var(--line);border-radius:99px;overflow:hidden;position:relative}
.pbar i{position:absolute;inset:0 auto 0 0;background:linear-gradient(90deg,var(--ok),#5ad19b);border-radius:99px}
.ptxt{font-weight:800;font-size:14px;color:var(--mut)}
.tbtns{display:flex;gap:6px;flex-wrap:wrap}
.wrap{display:grid;grid-template-columns:290px 1fr;gap:18px;padding:18px;max-width:1300px;margin:0 auto}
.side{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);padding:12px;align-self:start;position:sticky;top:76px;max-height:calc(100vh - 96px);overflow:auto}
.tp{border-radius:12px;padding:8px 8px 10px;margin-bottom:6px}
.tp.cur{background:var(--bg)}
.tph{display:flex;align-items:center;gap:8px;font-weight:800;font-size:14px;cursor:pointer}
.tph .ic{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;font-size:12px;flex:none}
.tph .done{margin-left:auto;font-size:12px;color:var(--mut)}
.tp.fin .tph .ic{background:var(--ok)}
.mini{height:5px;background:var(--line);border-radius:9px;margin:7px 0 7px 38px;overflow:hidden}.mini i{display:block;height:100%;background:var(--ok)}
.chips{display:flex;flex-wrap:wrap;gap:5px;margin-left:38px}
.chip{width:34px;height:30px;border-radius:9px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);font-size:13px;font-weight:800;display:grid;place-items:center;position:relative}
.chip.ok{background:var(--ok);border-color:var(--ok);color:#fff}
.chip.err{background:#7bd3a7;border-color:#7bd3a7;color:#08321f}
.chip.hint{background:#ffd666;border-color:#ffd666;color:#4a3500}
.chip.sol{background:#ffb27a;border-color:#ffb27a;color:#4a2000}
.chip.skip{border-style:dashed;border-color:var(--mut)}
.chip.cur{outline:3px solid var(--pri);outline-offset:1px}
.chip.an::after{content:'';position:absolute;top:2px;right:3px;width:5px;height:5px;border-radius:50%;background:var(--pri2)}
.legend{font-size:12px;color:var(--mut);display:flex;flex-wrap:wrap;gap:8px;margin:8px 4px 2px}
.legend span{display:inline-flex;align-items:center;gap:4px}.legend b{width:12px;height:12px;border-radius:4px;display:inline-block}
.main{min-width:0}
.card{background:var(--card);border-radius:22px;box-shadow:var(--sh);padding:22px 24px;position:relative;overflow:hidden}
.card.pop{animation:pop .35s ease}
@keyframes pop{from{transform:translateY(12px);opacity:0}to{transform:none;opacity:1}}
.chead{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.num{font-size:15px;font-weight:800;color:var(--mut)}
.badge{font-size:12px;font-weight:800;padding:4px 10px;border-radius:999px;background:#e8ecff;color:#3b4fd8;letter-spacing:.3px}
.badge.an{background:#f1e8ff;color:#7343d6}.badge.nf{background:#fff0e0;color:#b25e00}
.badge.tpc{background:var(--bg);color:var(--mut)}
.qtext{font-size:20px;line-height:1.55;font-weight:600;margin:4px 0 12px}
.figbox{background:#fff;border-radius:16px;border:1px solid #edf0f7;display:flex;justify-content:center;padding:6px;margin-bottom:16px}
.figbox svg{width:100%;max-width:520px;max-height:330px;height:auto}
.ans{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.ans label{font-weight:800}
.ans input{width:180px;padding:12px 14px;border-radius:14px;border:2.5px solid var(--line);font-size:22px;font-weight:800;text-align:center;background:var(--bg);color:var(--ink)}
.ans input:focus{outline:none;border-color:var(--pri)}
.ans input.bad{border-color:var(--bad);animation:shake .4s}
.ans input.good{border-color:var(--ok);background:var(--okl)}
@keyframes shake{20%,60%{transform:translateX(-7px)}40%,80%{transform:translateX(7px)}}
.fb{margin-top:12px;padding:12px 14px;border-radius:14px;font-weight:700;display:none}
.fb.show{display:block}.fb.bad{background:var(--badl);color:var(--bad)}.fb.good{background:var(--okl);color:var(--ok)}
.fb .nx{height:5px;background:rgba(22,163,106,.25);border-radius:9px;margin-top:8px;overflow:hidden}.fb .nx i{display:block;height:100%;background:var(--ok);width:0;transition:width .9s linear}
.help{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;padding-top:14px;border-top:1px dashed var(--line);align-items:center}
.help .note{font-size:12.5px;color:var(--mut);margin-left:auto}
.hintzone{margin-top:14px}
.hz-t{font-weight:800;margin:10px 0 8px;display:flex;align-items:center;gap:8px}
.steps{counter-reset:s;display:flex;flex-direction:column;gap:8px}
.step{background:var(--bg);border-left:4px solid var(--pri);border-radius:10px;padding:10px 12px;line-height:1.6;animation:pop .3s}
.step b.k{color:var(--pri);margin-right:6px}
.tnote{font-size:13px;color:var(--mut);background:var(--warnl);border-radius:10px;padding:8px 10px;margin-top:10px}
/* stickers */
.stks{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:16px;padding:6px 2px 4px}
.stk{background:var(--sc);border-radius:6px 6px 18px 6px;padding:14px 14px 12px;color:#1d2640;box-shadow:0 8px 18px rgba(40,40,80,.13),inset 0 -3px 0 rgba(0,0,0,.04);transform:rotate(var(--rot));position:relative;border-top:6px solid var(--se);transition:.2s}
.stk:hover{transform:rotate(0) scale(1.02)}
.stk-pin{position:absolute;top:-11px;left:50%;width:16px;height:16px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fff 0,var(--se) 45%,#0003 100%);transform:translateX(-50%)}
.stk-t{font-weight:900;font-size:15px;margin-bottom:6px}
.stk-b{display:flex;flex-direction:column;gap:8px;align-items:stretch}
.stk-x{flex:1;font-size:14px;line-height:1.55}
.stk-f{display:flex;justify-content:center;background:#ffffff8c;border-radius:10px;padding:4px}.stk-f svg{width:200px;max-height:150px;height:auto;display:block}
.tt{border-collapse:collapse;margin-top:6px;font-size:13px}.tt td,.tt th{border:1px solid #0002;padding:3px 6px;text-align:center}.tt th{background:#fff8}
.memo h2{margin:22px 0 10px;display:flex;align-items:center;gap:10px}
.memo h2 i{width:18px;height:18px;border-radius:5px;display:inline-block}
/* modal */
.mbg{position:fixed;inset:0;background:rgba(15,20,40,.45);z-index:50;display:grid;place-items:center;padding:16px}
.mdl{background:var(--card);border-radius:20px;max-width:760px;width:100%;max-height:92vh;overflow:auto;padding:22px;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.mdl.wide{max-width:1150px}
.mdl h2{margin-top:0}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin:12px 0}
.stat{background:var(--bg);border-radius:14px;padding:12px}.stat b{font-size:26px;display:block}.stat span{font-size:13px;color:var(--mut)}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#1d2640;color:#fff;padding:12px 18px;border-radius:14px;font-weight:700;z-index:60;box-shadow:var(--sh);animation:pop .3s}
.fld{display:flex;flex-direction:column;gap:4px;margin-bottom:10px}.fld span{font-size:13px;color:var(--mut);font-weight:700}
.fld input,.fld select{padding:10px 12px;border-radius:10px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink)}
.tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}.tabs button{border:0;padding:9px 14px;border-radius:10px;background:var(--bg);color:var(--ink);font-weight:800}.tabs button.on{background:var(--pri);color:#fff}
.pgrid{display:grid;grid-template-columns:1fr 300px;gap:16px}
.plist{max-height:60vh;overflow:auto;border:1px solid var(--line);border-radius:12px;padding:8px}
.plist .pt{font-weight:800;margin:8px 0 4px;display:flex;align-items:center;gap:6px}
.plist label{display:inline-flex;align-items:center;gap:4px;font-size:13.5px;margin:3px 8px 3px 0;padding:3px 7px;border-radius:8px;background:var(--bg)}
.opts label{display:flex;gap:8px;align-items:center;padding:5px 0;font-weight:600}
table.st{width:100%;border-collapse:collapse;font-size:14px}table.st td,table.st th{padding:7px 8px;border-bottom:1px solid var(--line);text-align:left}
.done-card{text-align:center;padding:40px 24px}.done-card .big{font-size:64px}
.conf{position:absolute;pointer-events:none;font-size:22px;animation:fly 1.2s ease-out forwards}
@keyframes fly{to{transform:translate(var(--dx),var(--dy)) rotate(260deg);opacity:0}}
#printArea{display:none}
@media (max-width:860px){
  .wrap{grid-template-columns:1fr;padding:10px}
  .side{position:static;max-height:none}
  .qtext{font-size:18px}.card{padding:16px}
  .pgrid{grid-template-columns:1fr}
  .top .ttl span{display:none}
  .help .note{margin-left:0}
}
/* печать */
@media print{
  body.printing>*:not(#printArea){display:none!important}
  body.printing #printArea{display:block!important}
  body{background:#fff!important;color:#000}
  @page{size:A4;margin:12mm}
}
#printArea{font-family:'Segoe UI',Arial,sans-serif;color:#111;background:#fff}
.pr-head{display:flex;justify-content:space-between;border-bottom:2px solid #333;padding-bottom:6px;margin-bottom:10px;font-size:13px}
.pr-title{font-size:18px;font-weight:800;margin:0 0 6px}
.pr-grid{columns:var(--cols,1);column-gap:10mm}
.pr-task{break-inside:avoid;border-bottom:1px dashed #bbb;padding:8px 0 10px;font-size:13.5px;line-height:1.45}
.pr-n{font-weight:800}.pr-k{font-size:11px;color:#555;border:1px solid #999;border-radius:6px;padding:0 5px;margin-left:6px}
.pr-fig{text-align:center;margin:4px 0}.pr-fig svg{width:auto;max-width:62%;max-height:150px}
.pr-cols2 .pr-fig svg{max-width:95%;max-height:140px}
.pr-line{margin-top:6px}
.pr-ans{margin-top:4px;font-weight:700;color:#0a6b3d}
.pr-sol{margin-top:4px;font-size:12.5px;color:#222}.pr-sol ol{margin:2px 0;padding-left:18px}
.pr-key{break-before:page}.pr-key table{border-collapse:collapse;width:100%}.pr-key td{border:1px solid #888;padding:4px;text-align:center;font-size:12.5px}.pr-key td b{display:block;font-size:11px;color:#555}
.pr-memo{break-before:page}.pr-memo .stks{grid-template-columns:repeat(3,1fr);gap:8px}.pr-memo .stk{transform:none;box-shadow:none;border:1px solid #0002;border-top:5px solid var(--se);-webkit-print-color-adjust:exact;print-color-adjust:exact;break-inside:avoid;padding:8px}
.pr-memo .stk-x{font-size:11.5px}.pr-memo .stk-f svg{width:150px;max-height:110px}.pr-memo .stk-pin{display:none}
.prev{background:#fff;color:#111;padding:14px;border-radius:12px;border:1px solid var(--line);max-height:65vh;overflow:auto}
@media (max-width:860px){.main{order:-1}}

.lvl{color:#f0a400;font-size:15px;letter-spacing:1px}
.calcout{font-size:22px;font-weight:800;color:var(--pri);min-width:90px}.calcout.bad{color:var(--mut)}
.ans input.calcin{width:260px;text-align:left}
.keys{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;align-items:center}.key{border:1.5px solid var(--line);background:var(--bg);color:var(--ink);border-radius:10px;min-width:42px;padding:7px 10px;font-weight:800;font-size:16px}
.khint{font-size:12.5px;color:var(--mut);margin-left:4px}
.redo{background:var(--warnl);border-radius:12px;padding:10px 12px;margin-bottom:8px;font-size:14px}
.flagg .pt{font-weight:800;margin:10px 0 4px;display:flex;align-items:center;gap:8px}
.flag{display:inline-flex;align-items:center;gap:4px;margin:3px 6px 3px 0;padding:5px 9px;border-radius:9px;background:var(--bg);font-size:14px;cursor:pointer;border:1.5px solid transparent;user-select:none}
.flag.on{border-color:#e5484d;background:#ffe9e9;color:#1d2640}.flag .fl{opacity:.25}.flag.on .fl{opacity:1}
.switch{display:flex;align-items:center;gap:10px;font-weight:700;padding:12px;border-radius:12px;background:var(--bg);margin:10px 0;cursor:pointer}
.switch input{width:22px;height:22px}

.modeb{font-size:12px;font-weight:800;padding:5px 10px;border-radius:999px;background:#e3f6ec;color:#0f7a4d;white-space:nowrap}
.modeb.home{background:#fff0e0;color:#b25e00}
.mdl.full{max-width:min(1320px,97vw);width:97vw;max-height:96vh;padding:16px}
.modesel{display:flex;gap:8px;margin-bottom:6px;flex-wrap:wrap}
.modesel button{flex:1;min-width:200px;border:2px solid var(--line);background:var(--bg);color:var(--ink);border-radius:14px;padding:10px 12px;text-align:left;display:flex;flex-direction:column;gap:3px}
.modesel button small{color:var(--mut);font-weight:600}
.modesel button.on{border-color:var(--pri);background:#eef1ff}
[data-theme=dark] .modesel button.on{background:#232a45}
/* сцены */
.scwrap{display:grid;grid-template-columns:230px 1fr;gap:14px}
.sclist{display:flex;flex-direction:column;gap:6px;max-height:88vh;overflow:auto}
.sclist button{border:0;text-align:left;padding:9px 10px;border-radius:10px;background:var(--bg);color:var(--ink);font-weight:700;font-size:14px}
.sclist button.on{background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff}
.schint{color:var(--mut);font-size:14.5px;max-width:760px}
.scgrid{display:grid;grid-template-columns:1fr 310px;gap:14px;margin-top:10px}
.scstage{background:#fff;border:1px solid #edf0f7;border-radius:16px;touch-action:none;user-select:none}
.scstage svg{width:100%;height:auto;display:block;max-height:74vh}
.hd{cursor:grab}.hd:hover{fill-opacity:.6}
.scinfo{display:flex;flex-direction:column;gap:6px}
.srow{display:flex;justify-content:space-between;gap:8px;background:var(--bg);border-radius:10px;padding:8px 10px;font-size:14px;border-left:5px solid var(--line);align-items:center}
.srow b{white-space:nowrap;text-align:right}
.srow.val{border-color:#e5484d}.srow.aux{border-color:#7b5cff}.srow.aux2{border-color:#13a37a}.srow.arc{border-color:#f08c00}
.snote{font-size:13px;color:var(--mut);padding:4px 2px;line-height:1.45}
.scst{display:flex;flex-direction:column;gap:6px;margin-top:10px;align-items:flex-start}.scst .btn{white-space:normal;text-align:left}
.scgal{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.scard{border:1.5px solid var(--line);background:var(--bg);color:var(--ink);border-radius:14px;padding:12px;text-align:left;display:flex;flex-direction:column;gap:6px}
.scard span{font-size:13.5px;color:var(--mut)}.scard small{font-size:12px;color:var(--pri);font-weight:700}
.scard:hover{border-color:var(--pri)}
.stkpop{position:fixed;right:20px;bottom:20px;z-index:70;width:330px;background:var(--card);padding:14px;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.3)}
/* памятка */
.stk-no{display:inline-block;background:#ffffffb0;border-radius:6px;padding:0 6px;margin-right:6px;font-size:12.5px;border:1px solid #0002}
.stk-l{margin-top:8px;font-size:12px;display:flex;flex-wrap:wrap;gap:4px;align-items:center;color:#4a5170}
.stk-l .tl{border:0;background:#fff;border-radius:6px;padding:2px 6px;font-weight:800;font-size:12px;cursor:pointer;color:#1d2640}
.stk-l .tl.off{opacity:.45}
.stk.flash{animation:flash 1.3s ease}
@keyframes flash{0%,60%{box-shadow:0 0 0 6px var(--pri)}100%{box-shadow:0 8px 18px rgba(40,40,80,.13)}}
.toc{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
.toc button{border:1.5px solid var(--line);background:var(--bg);color:var(--ink);border-radius:999px;padding:5px 10px;font-weight:700;font-size:13px}
.toc button:hover{border-color:var(--pri)}
/* доска */
.bwrap{display:flex;flex-direction:column;gap:10px;height:90vh}
.btool{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.bq{font-size:20px;font-weight:600;line-height:1.5;background:var(--bg);border-radius:12px;padding:8px 12px}
.bstage{position:relative;flex:1;background:#fff;border-radius:16px;border:1px solid #edf0f7;overflow:hidden;min-height:300px}
.bstage .bfig{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:14px}
.bstage .bfig svg{width:100%;height:100%}
.bstage canvas{position:absolute;inset:0;width:100%;height:100%;touch-action:none;cursor:crosshair}
.pcol{width:28px;height:28px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1.5px var(--line);cursor:pointer}.pcol.on{box-shadow:0 0 0 3px var(--pri)}
.store{background:var(--bg);border-radius:12px;padding:10px 12px;margin:10px 0;font-size:14px}
.store i{display:block;height:8px;border-radius:9px;background:var(--line);margin-top:6px;overflow:hidden}.store i b{display:block;height:100%;background:var(--warn)}
.figbox svg{max-height:340px}
@media (max-width:860px){.scwrap{grid-template-columns:1fr}.sclist{flex-direction:row;overflow:auto;max-height:none}.sclist button{white-space:nowrap}.scgrid{grid-template-columns:1fr}.top .modeb{display:none}}
[hidden]{display:none!important}

/* ===== тестовик: дополнения к стилю «Окружности» ===== */
.stars{color:#f0a400;font-size:12px;letter-spacing:1px;margin-left:2px}
.tp .chips{display:none}.tp.open .chips{display:flex}.tp.open .tph .car{transform:rotate(90deg)}
.tph .car{font-size:11px;color:var(--mut);transition:.15s;margin-left:4px}
.chip.bad{background:var(--badl);border-color:var(--bad);color:var(--bad)}
.chip.hw::before{content:'';position:absolute;top:-4px;left:-4px;width:9px;height:9px;border-radius:50%;background:#e5484d;border:2px solid var(--card)}
.chip.fx{box-shadow:inset 0 -3px 0 #16a36a}
.filt{display:flex;gap:4px;background:var(--bg);border-radius:12px;padding:4px;margin-bottom:10px}
.filt button{flex:1;white-space:nowrap;border:0;background:transparent;color:var(--ink);border-radius:9px;padding:7px 4px;font-weight:800;font-size:13px}
.filt button.on{background:var(--card);box-shadow:0 2px 8px rgba(30,40,80,.12);color:var(--pri)}
.filt button:disabled{opacity:.4}
.sdesc{color:var(--mut);font-size:14px;margin:-4px 0 12px}
.qtext code,.fb code,.step code,.stk code,.mdl code,.hz code{font-family:Consolas,'Cascadia Mono','Courier New',monospace;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:1px 5px;font-size:.92em;font-weight:700;white-space:pre-wrap}
.fb code{background:#ffffffa8;color:inherit}
.qtext i{color:var(--mut);font-weight:600;font-size:16px}
.pcode{background:#0f1a2e;color:#e6edf7;border-radius:14px;padding:12px 14px 12px 0;margin:0 0 12px;font:15px/1.55 Consolas,'Cascadia Mono','Courier New',monospace;overflow:auto;counter-reset:ln}
.pcode .l{display:block;padding-left:48px;position:relative;white-space:pre;min-height:1.55em}
.pcode .l::before{counter-increment:ln;content:counter(ln);position:absolute;left:0;width:34px;text-align:right;color:#56657f;font-size:13px}
.pcode .l.hl{background:#ff4d4d22}
.pcode .k{color:#ff9ac1;font-weight:700}.pcode .f{color:#7cc7ff}.pcode .n{color:#ffd479}.pcode .s{color:#9be59b}.pcode .c{color:#7d8aa3;font-style:italic}.pcode .u{background:#f0a400;color:#1d2640;border-radius:4px;padding:0 3px;font-weight:800}
.ptitle{font-size:12px;font-weight:800;color:var(--mut);text-transform:uppercase;letter-spacing:.6px;margin:2px 0 5px;display:flex;align-items:center;gap:6px}
.inbox{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 14px}
.inbox span{font:700 15px Consolas,monospace;background:var(--bg);border:1.5px solid var(--line);border-radius:8px;padding:3px 10px}
.cons{background:#16181d;color:#d7dbe3;border-radius:14px;padding:12px 14px;margin:0 0 14px;font:14px/1.5 Consolas,'Cascadia Mono',monospace;white-space:pre-wrap;overflow:auto;border-left:5px solid var(--bad)}
.cons .er{color:#ff7a7a;font-weight:700}
.olist{display:flex;flex-direction:column;gap:9px;margin:4px 0 6px}
.opt{display:flex;align-items:flex-start;gap:12px;text-align:left;border:2px solid var(--line);background:var(--card);color:var(--ink);border-radius:14px;padding:11px 14px;font-weight:600;font-size:17px;transition:.12s;line-height:1.45}
.opt:not(:disabled):hover{border-color:var(--pri)}
.opt .bl{flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:var(--bg);font-weight:900;font-size:14px;color:var(--mut);border:2px solid var(--line)}
.opt.multi .bl{border-radius:8px}
.opt .tx{padding-top:3px;min-width:0}
.opt .tx pre{margin:0;font:600 16px/1.5 Consolas,'Cascadia Mono','Courier New',monospace;white-space:pre-wrap}
.opt.sel{border-color:var(--pri);background:#eef1ff}.opt.sel .bl{background:var(--pri);color:#fff;border-color:var(--pri)}
[data-theme=dark] .opt.sel{background:#232a45}
.opt.good{border-color:var(--ok);background:var(--okl)}.opt.good .bl{background:var(--ok);color:#fff;border-color:var(--ok)}
.opt.bad{border-color:var(--bad);background:var(--badl);animation:shake .4s}.opt.bad .bl{background:var(--bad);color:#fff;border-color:var(--bad)}
.opt.miss{border-style:dashed;border-color:var(--ok)}
.opt:disabled{cursor:default}
.mtag{font-size:12px;font-weight:800;padding:4px 10px;border-radius:999px;background:#fff0e0;color:#b25e00}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;align-items:center}
.fb .ex{font-weight:600;color:var(--ink);margin-top:6px;line-height:1.55}
.fb.good .ex{color:#0d5c3c}[data-theme=dark] .fb.good .ex{color:#bff0d8}
.fb.bad .ex{color:#7a1f22}[data-theme=dark] .fb.bad .ex{color:#ffd0d0}
.fb .pcode{margin-top:10px;margin-bottom:0}
.hz{background:var(--warnl);border-radius:14px;padding:12px 14px;margin-top:12px;line-height:1.55;animation:pop .3s}
.memolink{border:0;background:#ffe9a8;color:#5a4300;border-radius:999px;padding:6px 12px;font-weight:800;font-size:13px}
[data-theme=dark] .memolink{background:#4a3c14;color:#ffe08a}
.nav2{display:flex;gap:6px;margin-left:auto}
/* стикеры ошибок */
.estk{background:var(--sc);border-radius:6px 6px 18px 6px;padding:14px 14px 12px;color:#1d2640;box-shadow:0 8px 18px rgba(40,40,80,.13);transform:rotate(var(--rot));position:relative;border-top:6px solid var(--se);transition:.2s}
.estk:hover{transform:rotate(0) scale(1.02)}
.estk h3{margin:0 0 6px;font-size:16px}
.estk .msg{font:700 12.5px/1.4 Consolas,monospace;background:#16181d;color:#ff9b9b;border-radius:8px;padding:6px 8px;margin-bottom:8px;word-break:break-word}
.estk p{margin:4px 0;font-size:14px;line-height:1.5}
.estk .bg{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px}
.estk .bg div{border-radius:8px;padding:6px 8px;font:12.5px/1.45 Consolas,monospace;white-space:pre;overflow:auto;background:#ffffffb5}
.estk .bg b{display:block;font-family:'Nunito',sans-serif;font-size:11px;letter-spacing:.4px;text-transform:uppercase;margin-bottom:2px}
.estk .bg .no b{color:#c0272d}.estk .bg .yes b{color:#0f7a4d}
.estk.flash{animation:flash 1.3s ease}
.ework{background:var(--bg);border-radius:14px;padding:12px 14px;margin:6px 0 16px;line-height:1.6}
.ework ol{margin:4px 0;padding-left:22px}
/* контрольная */
.tsel label{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:10px;background:var(--bg);margin:4px 0;font-weight:700;font-size:14.5px}
.tsel label small{margin-left:auto;color:var(--mut)}
.tbadge{font-size:12px;font-weight:800;padding:5px 10px;border-radius:999px;background:#ffe3e3;color:#c0272d}
.secbar{display:flex;height:9px;border-radius:9px;overflow:hidden;background:var(--line);min-width:120px}
.secbar i{display:block;height:100%}
table.st td .secbar{margin-top:3px}
.hwrow{display:flex;align-items:center;gap:8px;margin:12px 0 4px;font-weight:800}
.hwrow small{color:var(--mut);font-weight:600}
.hwchips{display:flex;flex-wrap:wrap;gap:5px}
.hwchips .flag{min-width:40px;justify-content:center}
.sectab td:first-child{font-weight:700}
@media (max-width:860px){.estk .bg{grid-template-columns:1fr}.opt{font-size:16px}.pcode{font-size:14px}}
.auto-next{font-size:13px!important;opacity:.88;margin-top:7px!important}.conf{font-size:12px!important;pointer-events:none}[data-theme=dark] .fb.good{background:#103b2b!important;color:#f0fff6!important;border:1px solid #42c98a!important}[data-theme=dark] .fb.good .ex{color:#ecfff4!important}[data-theme=dark] .fb.good code{background:#e7f7ed!important;color:#123322!important}[data-theme=dark] .opt.good{background:#0e4931!important;color:#f0fff6!important;border-color:#35d18a!important}[data-theme=dark] .opt.good .tx,[data-theme=dark] .opt.good .bl{color:#f0fff6!important}[data-theme=dark] .fb.bad{background:#4a171c!important;color:#fff1f1!important;border:1px solid #ff6874!important}[data-theme=dark] .fb.bad .ex{color:#fff1f1!important}.theory-card{margin-top:12px;padding:16px 18px;border-radius:14px;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-size:17px;line-height:1.55}body.side-off .side{display:none}body.side-off .wrap{grid-template-columns:1fr;max-width:1100px}.badge.xtra{background:#fff2cc;color:#8a6400}.xtp{border:1.5px dashed #f0a400}</style></head>
<body><div id="app"></div>
<script id="saved-state" type="application/json">{"v":2,"teacher":{"name":"","email":"","tg":"","pin":"31415"},"hw":["inp01","inp02","inp03","inp04","inp05","inp06","inp07","inp08","inp09","inp10","inp11","inp12","mod01","mod02","mod03","mod04","mod05","mod06","mod07","mod08","mod09","mod10","mod11","mod12","mod13","mod14","mod15","mod16","mod17","mod18","mod19","cmp01","cmp02","cmp03","cmp04","cmp05","cmp06","cmp07","cmp08","cmp09","cmp10","cmp11","cmp12","cmp13","cmp14","cmp15","cmp16","cmp17","cmp18","cmp19","cmp20","log01","log02","log03","log04","log05","log06","log07","log08","log09","log10","log11","log12","log13","log14","log15","log16","log17","log18","log19","log20","log21","mm01","mm02","mm03","mm04","mm05","mm06","mm07","mm08","mm09","mm10","mm11","for01","for02","for03","for04","for05","for06","for07","for08","for09","for10","for11","for13","whl01","whl02","whl03","whl04","whl05","whl06","whl07","whl08","whl09","whl10"],"hwTitle":"ДЗ 1","students":{"впва":{"name":"впва","created":1794855583671,"updated":1794899044919,"q":{"inp01":{"st":"ok","tries":1,"ms":24660,"at":1794898910036,"wrongNow":0,"usedHintNow":false},"inp02":{"st":"ok","tries":1,"at":1794898917724,"wrongNow":0,"usedHintNow":false,"ms":6966},"inp03":{"st":"ok","tries":1,"at":1794898924868,"wrongNow":0,"usedHintNow":false,"ms":7935},"inp04":{"st":"ok","tries":1,"at":1794898931591,"wrongNow":0,"usedHintNow":false,"ms":9461},"inp05":{"st":"ok","tries":1,"at":1794898949493,"wrongNow":0,"usedHintNow":false,"ms":15925},"inp06":{"st":"ok","tries":1,"at":1794898958923,"wrongNow":0,"usedHintNow":false,"ms":7998},"inp07":{"st":"ok","tries":1,"at":1794898978574,"wrongNow":0,"usedHintNow":false,"ms":19613},"inp08":{"st":"ok","tries":1,"at":1794899004581,"wrongNow":0,"usedHintNow":false,"ms":26605},"inp09":{"st":"ok","tries":1,"at":1794899035530,"wrongNow":0,"usedHintNow":false,"ms":30350},"inp10":{"st":"ok","tries":1,"at":1794899044918,"wrongNow":0,"usedHintNow":false,"ms":9402},"inp11":{"st":"","tries":0,"ms":151226}},"tests":[],"cur":"inp11"}},"last":"впва","theme":"dark","updated":1794899270371,"hwAt":1794899268255}</script>
<script id="bank" type="application/json">{"secs": [{"id": "inp", "title": "Ввод чисел: input() и int()", "stars": 1, "desc": "Как программа получает числа и где стоит чтение.", "n": 4}, {"id": "mod", "title": "Остаток % и деление //", "stars": 1, "desc": "Кратность, последняя цифра, цифры числа, последняя цифра в 7-ричной и 9-ричной системе.", "n": 13}, {"id": "cmp", "title": "Сравнения в условии", "stars": 1, "desc": "==, !=, <, <=, «не выше», «не менее», диапазон значений.", "n": 13}, {"id": "log", "title": "Составные условия: and, or", "stars": 2, "desc": "Несколько требований к числу одновременно или «хотя бы одно».", "n": 7}, {"id": "acc", "title": "Счётчик, сумма, произведение", "stars": 2, "desc": "Начальные значения и обновления: kol += 1, s += a, pr *= a.", "n": 7}, {"id": "mm", "title": "Максимум и минимум", "stars": 2, "desc": "Начальные значения ±10**10 и обновление через max() / min().", "n": 4}, {"id": "for", "title": "Цикл for и range", "stars": 2, "desc": "Сколько раз повторится цикл, отрезок [a; b].", "n": 4}, {"id": "whl", "title": "Цикл while: ввод до нуля", "stars": 2, "desc": "Первое чтение до цикла, следующее — в конце тела; 0 не обрабатывается.", "n": 3}, {"id": "out", "title": "Вывод ответа", "stars": 2, "desc": "Одна строка или несколько, YES / NO, проверка kol > 0 перед делением.", "n": 7}, {"id": "cond", "title": "Условие отбора в задачах", "stars": 3, "desc": "Что поставить вместо УСЛОВИЕ в типовой программе.", "n": 14}, {"id": "prep", "title": "Заготовка: начальные значения", "stars": 3, "desc": "Какие переменные и с какими значениями создать до цикла.", "n": 10}, {"id": "run", "title": "Сообщения об ошибках", "stars": 3, "desc": "Python показал сообщение об ошибке — узнай его и пойми, что оно означает.", "n": 13}, {"id": "bug", "title": "Логические ошибки: работает, но неверно", "stars": 3, "desc": "Программа запускается без сообщений, но ответ не тот. Найди причину.", "n": 9}, {"id": "trace", "title": "Что выведет программа?", "stars": 4, "desc": "Выполни программу «в уме»: выпиши переменные и меняй их на каждом шаге.", "n": 25}], "bank": [{"sec": "inp", "prompt": "Что делает строка `a = int(input())`?", "options": ["читает строку с клавиатуры и превращает её в целое число", "читает строку и оставляет её текстом", "читает число и сразу печатает его", "создаёт случайное целое число"], "correct": [0], "explain": "`input()` читает одну строку ввода как текст, `int(...)` превращает этот текст в целое число, `a = ...` сохраняет результат в переменной `a`.", "hint": "Разбери строку изнутри наружу: сначала input(), потом int(), потом присваивание.", "id": "inp01", "sk": "in_int"}, {"sec": "inp", "prompt": "Пользователь ввёл `25`. Что окажется в переменной после `a = input()` (без int)?", "options": ["ничего — будет ошибка", "строка '25' — это текст, а не число", "целое число 25", "дробное число 25.0"], "correct": [1], "explain": "`input()` всегда возвращает строку. Чтобы получить число, её нужно обернуть в `int()`.", "memo": "type_str", "id": "inp02", "sk": "in_int"}, {"sec": "inp", "prompt": "Где должна стоять строка `a = int(input())` в задаче «сначала N, потом N чисел»?", "options": ["в самом начале, вместо n = int(input())", "после цикла", "перед циклом, один раз", "внутри цикла for, с отступом"], "correct": [3], "explain": "Каждое из N чисел нужно прочитать и проверить, поэтому чтение стоит в теле цикла.", "hint": "Сколько раз нужно прочитать очередное число?", "id": "inp06", "sk": "in_loop"}, {"sec": "inp", "prompt": "Программа начинается так. Сколько чисел она прочитает **внутри цикла**, если первым введено число 5?", "options": ["5", "4", "6", "1"], "correct": [0], "explain": "`range(n)` повторяет тело цикла n раз, на каждом шаге одно `input()`. При n = 5 — пять чисел.", "code": "n = int(input())\nfor i in range(n):\n    a = int(input())", "mono": 1, "id": "inp04", "sk": "in_loop"}, {"sec": "mod", "prompt": "Чему равно значение выражения `157 % 10`?", "options": ["7", "57", "15", "1"], "correct": [0], "explain": "`%` — остаток от деления. 157 = 15·10 + **7**, значит остаток 7. Остаток от деления на 10 — последняя цифра числа.", "mono": 1, "id": "mod01", "sk": "m_last"}, {"sec": "mod", "prompt": "Чему равно значение выражения `157 // 10`?", "options": ["1", "15.7", "7", "15"], "correct": [3], "explain": "`//` — целочисленное деление: дробная часть отбрасывается. 157 // 10 = 15 (число без последней цифры).", "mono": 1, "id": "mod02", "sk": "m_div"}, {"sec": "mod", "prompt": "Чему равно значение выражения `24 % 6`?", "options": ["4", "1", "0", "6"], "correct": [2], "explain": "24 делится на 6 нацело, остаток 0. Поэтому проверка кратности: `a % 6 == 0`.", "mono": 1, "id": "mod05", "sk": "m_kr"}, {"sec": "mod", "prompt": "Чему равно значение выражения `7 // 2`?", "options": ["4", "3.5", "1", "3"], "correct": [3], "explain": "`//` отбрасывает дробную часть: 7 // 2 = 3.", "mono": 1, "id": "mod09", "sk": "m_div"}, {"sec": "mod", "prompt": "Чему равно значение выражения `10 / 2`?", "options": ["5.5", "0", "5", "5.0"], "correct": [3], "explain": "Деление `/` в Python всегда даёт дробное число: 10 / 2 = **5.0**. Поэтому среднее печатается как 5.0, а не 5.", "mono": 1, "id": "mod10", "sk": "m_div"}, {"sec": "mod", "prompt": "Какое выражение даёт **последнюю цифру** числа `a`?", "options": ["a // 10", "a % 10", "a / 10", "a % 7"], "correct": [1], "explain": "Последняя (десятичная) цифра — остаток от деления на 10.", "mono": 1, "id": "mod13", "sk": "m_last"}, {"sec": "mod", "prompt": "Что проверяет условие `a % 10 == 0`?", "options": ["число меньше 10", "число оканчивается на 0 (кратно 10)", "число однозначное", "число равно 10"], "correct": [1], "explain": "Остаток от деления на 10 равен нулю, когда последняя цифра — 0.", "id": "mod18", "sk": "m_last"}, {"sec": "mod", "prompt": "Чем отличается проверка «**кратно 7**» от «**оканчивается на 7**»?", "options": ["это одно и то же: a % 7 == 0", "кратно 7: a // 7 == 0", "кратно 7: a % 10 == 7; оканчивается на 7: a % 7 == 0", "кратно 7: a % 7 == 0; оканчивается на 7: a % 10 == 7"], "correct": [3], "explain": "Кратность — остаток от деления на 7 равен нулю (14, 21, 28…). Окончание на 7 — последняя цифра 7 (17, 27, 107…). Например, 14 кратно 7, но оканчивается на 4.", "memo": "wrong_mod", "id": "mod19", "sk": "m_kr"}, {"sec": "mod", "prompt": "Какое выражение даёт **цифру десятков двузначного** числа `a`?", "options": ["a // 100", "a % 10", "a / 10", "a // 10"], "correct": [3], "explain": "У двузначного числа цифра десятков — результат целочисленного деления на 10: 72 // 10 = 7.", "mono": 1, "id": "mod16", "sk": "m_dig"}, {"sec": "mod", "prompt": "Какое выражение даёт **первую цифру трёхзначного** числа `a`?", "options": ["a // 10", "a // 100", "a % 100", "a % 10"], "correct": [1], "explain": "Деление на 100 нацело «отрезает» две последние цифры: 365 // 100 = 3.", "mono": 1, "id": "mod15", "sk": "m_dig"}, {"sec": "mod", "prompt": "Чему равно значение выражения `157 // 10 % 10`?", "options": ["7", "5", "15", "1"], "correct": [1], "explain": "Сначала 157 // 10 = 15, затем 15 % 10 = 5 — средняя цифра (десятки).", "mono": 1, "id": "mod04", "sk": "m_dig"}, {"sec": "mod", "prompt": "Как найти **последнюю цифру** числа `a` в системе счисления с основанием **7**?", "options": ["a % 10 % 7", "a % 7", "a // 7", "a % 10"], "correct": [1], "explain": "Последняя цифра числа в системе с основанием 7 — остаток от деления на 7: `a % 7`.", "memo": "wrong_mod", "mono": 1, "id": "mod14", "sk": "m_base"}, {"sec": "mod", "id": "mod20", "prompt": "Как найти **последнюю цифру** числа `a` в системе счисления с основанием **9**?", "options": ["a % 10 % 9", "a % 9", "a // 9", "a % 10"], "correct": [1], "explain": "Последняя цифра числа в системе с основанием 9 — остаток от деления на 9: `a % 9`.", "mono": 1, "sk": "m_base"}, {"sec": "cmp", "prompt": "Как в Python проверить, что `a` **равно** 10?", "options": ["a := 10", "a === 10", "a == 10", "a = 10"], "correct": [2], "explain": "Два знака `==` — сравнение. Один знак `=` — присваивание, внутри if он вызывает SyntaxError.", "memo": "eq", "mono": 1, "id": "cmp01", "sk": "c_sign"}, {"sec": "cmp", "prompt": "Как записать условие «`a` **не равно** нулю»?", "options": ["a <> 0", "a =! 0", "not a = 0", "a != 0"], "correct": [3], "explain": "Неравенство в Python: `!=`. Запись `=!` — синтаксическая ошибка, `<>` в Python 3 не работает.", "mono": 1, "id": "cmp02", "sk": "c_sign"}, {"sec": "cmp", "prompt": "Число чётное.", "options": ["a % 2 != 0", "a % 2 == 0", "a % 2 == 1", "a // 2 == 0"], "correct": [1], "explain": "Чётное число делится на 2 без остатка. Поэтому остаток должен быть равен нулю.", "mono": 1, "id": "cmp19", "sk": "c_kr"}, {"sec": "cmp", "prompt": "Число **не кратно 5**.", "options": ["a // 5 == 0", "a % 10 == 5", "a % 5 == 0", "a % 5 != 0"], "correct": [3], "explain": "«Не кратно 5» означает, что остаток от деления на 5 не равен нулю: `!= 0`.", "mono": 1, "id": "cmp20", "sk": "c_kr"}, {"sec": "cmp", "prompt": "Число **положительное**.", "options": ["a > 0", "a != 0", "a >= 0", "a < 0"], "correct": [0], "explain": "Положительные числа — строго больше нуля: `a > 0`. Ноль не положительный и не отрицательный — он равен нулю.", "mono": 1, "id": "cmp08", "sk": "c_sign"}, {"sec": "cmp", "prompt": "Скорость **не выше 30** км/ч. Какое условие?", "options": ["a > 30", "a < 30", "a <= 30", "a >= 30"], "correct": [2], "explain": "«Не выше 30» — значит 30 и меньше: `a <= 30`. Скорость ровно 30 подходит.", "mono": 1, "id": "cmp03", "sk": "c_word"}, {"sec": "cmp", "prompt": "Скорость **меньше 30** км/ч. Какое условие?", "options": ["a < 29", "a > 30", "a < 30", "a <= 30"], "correct": [2], "explain": "«Меньше» — строгое неравенство, 30 не подходит. Вариант `a < 29` отсечёт число 29.", "mono": 1, "id": "cmp04", "sk": "c_word"}, {"sec": "cmp", "prompt": "В задаче: «если **не менее двух** автомобилей…». Какое условие для счётчика `kol2`?", "options": ["kol2 >= 2", "kol2 == 2", "kol2 < 2", "kol2 > 2"], "correct": [0], "explain": "«Не менее двух» = «два или больше»: `kol2 >= 2`.", "mono": 1, "id": "cmp10", "sk": "c_word"}, {"sec": "cmp", "prompt": "В задаче: «если **хотя бы один** участник…». Какое условие для счётчика `kol2`?", "options": ["kol2 == 1", "kol2 >= 2", "kol2 > 0", "kol2 < 1"], "correct": [2], "explain": "«Хотя бы один» = «один или больше»: `kol2 > 0` (или `kol2 >= 1`).", "mono": 1, "id": "cmp11", "sk": "c_word"}, {"sec": "cmp", "prompt": "Число оканчивается цифрой **5 в обычной десятичной записи**.", "options": ["a % 7 == 5", "a % 5 == 5", "a % 10 == 5", "a // 10 == 5"], "correct": [2], "explain": "Последняя десятичная цифра — остаток от деления на 10. Проверка `a % 5 == 0` проверяет кратность 5, но не отличает числа, оканчивающиеся на 0 и на 5.", "mono": 1, "id": "cmp14", "sk": "c_kr"}, {"sec": "cmp", "prompt": "Число **трёхзначное**. Какое условие верное?", "options": ["100 < a < 999", "100 <= a <= 999", "a >= 100 or a <= 999", "a < 1000"], "correct": [1], "explain": "Трёхзначные числа — от 100 до 999 включительно: `100 <= a <= 999`. Строгие знаки потеряют 100 и 999, а с `or` подойдёт любое число.", "mono": 1, "id": "cmp05", "sk": "c_range"}, {"sec": "cmp", "prompt": "Число **двузначное**. Какое условие верное?", "options": ["10 < a < 99", "a < 100", "a >= 10", "10 <= a <= 99"], "correct": [3], "explain": "Двузначные числа — от 10 до 99 включительно: `10 <= a <= 99`.", "mono": 1, "id": "cmp06", "sk": "c_range"}, {"sec": "cmp", "prompt": "Ученик написал `if 10 <= a >= 99:` для двузначных. Что не так?", "options": ["нужно 10 < a < 99", "нельзя писать два сравнения подряд", "всё верно", "второй знак должен быть <=: 10 <= a <= 99"], "correct": [3], "explain": "`10 <= a >= 99` означает «a ≥ 10 и a ≥ 99», то есть a ≥ 99. Нужно `10 <= a <= 99`.", "id": "cmp13", "sk": "c_range"}, {"sec": "log", "prompt": "Какое слово соединяет два требования, которые должны выполняться **оба сразу**?", "options": ["else", "or", "and", "not"], "correct": [2], "explain": "`and` — «и»: условие истинно, только если истинны обе части. `or` — «или»: достаточно одной.", "mono": 1, "id": "log01", "sk": "l_word"}, {"sec": "log", "prompt": "Число должно делиться на 4 **или** на 9. Подходит ли число 36?", "options": ["нет — 36 не делится на 9", "нет — оно делится сразу на оба", "да — для or достаточно одного признака, а здесь выполнены оба", "да, но только если написать and"], "correct": [2], "explain": "`or` истинно, когда выполнена хотя бы одна часть (или обе).", "id": "log02", "sk": "l_word"}, {"sec": "log", "prompt": "Ученик хотел: «чётное и больше 10». Что не так?", "options": ["после and нужно снова написать a: a % 2 == 0 and a > 10", "всё правильно", "нужно > 10 записать первым", "нужно or вместо and"], "correct": [0], "explain": "Каждая часть условия — полное сравнение. `and > 10` Python не понимает: `SyntaxError: invalid syntax`.", "code": "if a % 2 == 0 and > 10:", "memo": "else", "id": "log07", "sk": "l_syn"}, {"sec": "log", "prompt": "Число **чётное и кратно 5**. Какое условие верное?", "options": ["a % 2 == 0 or a % 5 == 0", "a % 2 != 0 and a % 5 == 0", "a % 2 == 0 and a % 5 == 0", "a % 10 == 5"], "correct": [2], "explain": "Оба требования должны выполняться сразу, поэтому `and`: `a % 2 == 0 and a % 5 == 0`. С `or` подойдут, например, 4 и 15.", "mono": 1, "id": "log03", "sk": "l_cond"}, {"sec": "log", "prompt": "Число **двузначное и оканчивается на 5**.", "options": ["a % 10 == 5", "10 <= a <= 99 and a % 5 == 0", "10 <= a <= 99 and a % 10 == 5", "10 <= a <= 99 or a % 10 == 5"], "correct": [2], "explain": "Нужны оба требования одновременно. Кратность 5 пропустит и 20, 30… — у них последняя цифра 0.", "mono": 1, "id": "log09", "sk": "l_cond"}, {"sec": "log", "prompt": "Сколько чисел из `12, 15, 30, 9` удовлетворяют условию `a % 3 == 0 and a % 5 != 0`?", "options": ["2", "3", "4", "1"], "correct": [0], "explain": "12 (кратно 3, не кратно 5) — да; 15 — кратно 5, нет; 30 — кратно 5, нет; 9 — да. Итого 2.", "mono": 1, "id": "log10", "sk": "l_cond"}, {"sec": "log", "prompt": "Число должно быть **кратно 5** и в записи по основанию 7 **оканчиваться цифрой 5**. Что поставить вместо `УСЛОВИЕ`?", "options": ["a % 5 == 5 and a % 7 == 0", "a % 5 == 0 and a % 7 == 5", "a % 5 == 0 or a % 7 == 5", "a % 10 == 5 and a % 7 == 5"], "correct": [1], "explain": "Кратность 5 проверяется остатком `a % 5 == 0`. Последняя цифра записи по основанию 7 равна остатку `a % 7`, поэтому нужно `a % 7 == 5`. Оба требования соединяются через `and`.", "mono": 1, "id": "log11", "sk": "l_cond"}, {"sec": "acc", "prompt": "Какое начальное значение у **счётчика** `kol`?", "options": ["kol = 0", "kol = 1", "kol = a", "kol = -10**10"], "correct": [0], "explain": "Пока ни одного подходящего числа не найдено, количество равно нулю.", "mono": 1, "id": "acc01", "sk": "a_init"}, {"sec": "acc", "prompt": "Какое начальное значение у **произведения** `pr`?", "options": ["pr = 1", "pr = -1", "pr = 10**10", "pr = 0"], "correct": [0], "explain": "Единица не меняет произведение: 1·a = a. Если начать с нуля, всё произведение будет 0.", "memo": "start_val", "mono": 1, "id": "acc02", "sk": "a_init"}, {"sec": "acc", "prompt": "Что означает запись `s += a`?", "options": ["s = s + a — прибавить a к сумме", "сравнить s и a", "s = s + 1", "s = a — запомнить число"], "correct": [0], "explain": "`+=` — сокращённая запись: к старому значению прибавляется новое.", "id": "acc03", "sk": "a_upd"}, {"sec": "acc", "prompt": "Чем отличается `kol += 1` от `s += a`?", "options": ["kol складывает числа, s считает их", "kol считает, СКОЛЬКО чисел подошло; s складывает САМИ числа", "kol += 1 работает только в while", "ничем"], "correct": [1], "explain": "Счётчик каждый раз увеличивается на 1, сумматор — на величину числа.", "id": "acc04", "sk": "a_upd"}, {"sec": "acc", "prompt": "Где должна стоять строка `kol += 1`, чтобы считались только числа, кратные 4?", "options": ["на одном уровне с if (4 пробела)", "с отступом под if (8 пробелов)", "перед if", "без отступа после цикла"], "correct": [1], "explain": "Действие выполняется только для подходящих чисел, когда оно вложено в if — сдвинуто глубже, чем сам if. На уровне if оно выполнится для всех чисел.", "code": "for i in range(n):\n    a = int(input())\n    if a % 4 == 0:\n        kol += 1", "memo": "outside_if", "id": "acc08", "sk": "a_upd"}, {"sec": "acc", "prompt": "Для **среднего арифметического** подходящих чисел нужны переменные…", "options": ["только сумма s", "только kol", "maxi и mini", "сумма s и количество kol"], "correct": [3], "explain": "Среднее = сумма / количество. Обе величины накапливаем в цикле.", "id": "acc11", "sk": "a_task"}, {"sec": "acc", "prompt": "В задаче «найти **длину последовательности**» (ввод до 0). Где стоит `dlina += 1`?", "options": ["под if", "после цикла", "в цикле, но НЕ под if — считаются все числа", "перед циклом"], "correct": [2], "explain": "Длина — количество всех введённых чисел (кроме завершающего 0), проверка не нужна.", "id": "acc12", "sk": "a_task"}, {"sec": "mm", "prompt": "Какое начальное значение берут для **максимума** `maxi`?", "options": ["maxi = 10**10", "maxi = 1", "maxi = 0", "maxi = -10**10 (очень маленькое число)"], "correct": [3], "explain": "Первое же подходящее число должно оказаться больше начального значения. Очень маленькое число гарантирует это даже для отрицательных данных.", "memo": "start_val", "id": "mm01", "sk": "mm"}, {"sec": "mm", "prompt": "Какое начальное значение берут для **минимума** `mini`?", "options": ["mini = 0", "mini = 10**10 (очень большое число)", "mini = -10**10", "mini = 1"], "correct": [1], "explain": "Любое число из данных меньше 10**10, поэтому первое подходящее сразу станет минимумом. С mini = 0 минимум натуральных чисел так и останется 0.", "memo": "start_val", "id": "mm02", "sk": "mm"}, {"sec": "mm", "prompt": "Какие строки правильно обновляют максимум? Отметь все.", "options": ["maxi = min(maxi, a)", "if a < maxi:\n    maxi = a", "maxi = max(maxi, a)", "maxi += a", "if a > maxi:\n    maxi = a"], "correct": [2, 4], "explain": "Функция `max` возвращает большее из двух чисел. То же делает проверка «если новое больше — запомни его».", "mono": 1, "id": "mm03", "sk": "mm"}, {"sec": "mm", "prompt": "Как в конце узнать, что **не нашлось ни одного** подходящего числа для минимума?", "options": ["if mini == 0:", "if mini == 10**10: — значение не изменилось", "if kol == 10**10:", "if mini < 0:"], "correct": [1], "explain": "Если минимум остался равен начальному 10**10, ни одно число его не обновило: выводим NO. Удобно писать и наоборот: `if mini < 10**10: print(mini) else: print('NO')`.", "id": "mm09", "sk": "mm"}, {"sec": "for", "prompt": "Сколько раз выполнится тело цикла `for i in range(5):`?", "options": ["4", "6", "0", "5"], "correct": [3], "explain": "`range(5)` даёт числа 0, 1, 2, 3, 4 — пять повторений.", "mono": 1, "id": "for01", "sk": "f"}, {"sec": "for", "prompt": "Сколько раз выполнится тело цикла `for i in range(10, 20):`?", "options": ["11", "20", "10", "9"], "correct": [2], "explain": "От 10 до 19 включительно — правая граница НЕ входит: 20 − 10 = 10 повторений.", "mono": 1, "id": "for02", "sk": "f"}, {"sec": "for", "prompt": "Как перебрать **все числа отрезка [a; b]**, включая оба конца?", "options": ["for x in range(a + 1, b):", "for x in range(a, b):", "for x in range(a, b + 1):", "for x in range(b):"], "correct": [2], "explain": "Правая граница range не включается, поэтому пишут b + 1.", "memo": "range_b", "mono": 1, "id": "for05", "sk": "f"}, {"sec": "for", "prompt": "Сколько чисел на отрезке [a; b]?", "options": ["b - a", "b - a + 1", "b + a", "b - a - 1"], "correct": [1], "explain": "Например, на [3; 5] три числа: 5 − 3 + 1 = 3.", "mono": 1, "id": "for07", "sk": "f"}, {"sec": "whl", "prompt": "Почему перед `while a != 0:` уже стоит `a = int(input())`?", "options": ["это необязательно", "так быстрее", "чтобы пропустить первое число", "условие цикла проверяет a, значит a должна быть известна заранее"], "correct": [3], "explain": "В момент первой проверки `a != 0` переменная должна существовать — иначе NameError.", "id": "whl01", "sk": "w"}, {"sec": "whl", "prompt": "Где в теле while стоит строка, читающая **следующее** число?", "options": ["после цикла", "первой строкой тела цикла", "последней строкой тела цикла, с отступом как у if", "внутри if"], "correct": [2], "explain": "Сначала обрабатываем текущее число, потом читаем следующее и возвращаемся к проверке `a != 0`.", "id": "whl03", "sk": "w"}, {"sec": "whl", "prompt": "В цикле забыли читать следующее число. Что произойдёт при вводе `4, 6, 0`?", "options": ["выведет 1", "программа «зависнет»: a всегда 4, цикл бесконечный", "EOFError", "выведет 2"], "correct": [1], "explain": "a не меняется, условие `a != 0` всегда истинно — бесконечный цикл. Сообщения об ошибке не будет, программа просто не закончится.", "code": "kol = 0\na = int(input())\nwhile a != 0:\n    if a % 2 == 0:\n        kol += 1\nprint(kol)", "memo": "loop", "id": "whl04", "sk": "w"}, {"sec": "out", "prompt": "Требуется вывести сначала `maxi`, затем `mini`, каждое значение на новой строке.", "options": ["print(maxi, mini)", "print(maxi - mini)", "print(mini)\nprint(maxi)", "print(maxi)\nprint(mini)"], "correct": [3], "explain": "Две отдельные команды `print()` дают два результата на отдельных строках и сохраняют нужный порядок: сначала максимум, затем минимум.", "mono": 1, "id": "out17", "sk": "o_fmt"}, {"sec": "out", "prompt": "Требуется вывести два результата: сначала количество `kol`, потом сумму `s`, **через пробел**, но одной командой `print`.", "options": ["print(kol, s)", "print(kol)\nprint(s)", "print(kol + s)", "print(s, kol)"], "correct": [0], "explain": "Одна команда `print(kol, s)` выводит оба значения в заданном порядке через пробел.", "mono": 1, "id": "out23", "sk": "o_fmt"}, {"sec": "out", "prompt": "По условию нужно вывести **YES**. Какие варианты засчитает автопроверка?", "options": ["print('Yes')", "print('YES.')", "print(YES)", "print(\"YES\")", "print('YES')"], "correct": [3, 4], "explain": "Кавычки могут быть одинарными или двойными, но текст должен совпасть буква в букву. `print(YES)` без кавычек — NameError.", "memo": "format", "mono": 1, "id": "ans06", "sk": "o_exact"}, {"sec": "out", "prompt": "По условию нужно вывести число без пояснений. Ученик написал `print('Ответ:', kol)`. Засчитает ли автопроверка?", "options": ["только в while-задачах", "да, число же есть", "нет — вывод должен совпадать посимвольно: только число", "да, если kol верный"], "correct": [2], "explain": "Проверяющая программа сравнивает вывод целиком. Лишний текст = неверный ответ.", "memo": "format", "id": "out07", "sk": "o_exact"}, {"sec": "out", "prompt": "Где должен стоять `else`?", "options": ["ровно под своим if, без отступа относительно if", "в той же строке, что и if", "после всех print", "с отступом под print"], "correct": [0], "explain": "if и else — пара, они начинаются с одной позиции. Тело каждого сдвинуто на 4 пробела.", "code": "if kol > 0:\n    print(kol)\nelse:\n    print('NO')", "memo": "else", "id": "ans10", "sk": "o_no"}, {"sec": "out", "prompt": "Если подходящих чисел нет (`kol == 0`), нужно вывести `NO`; иначе — среднее `s / kol`. Какой фрагмент вывода верен?", "options": ["if kol > 0:\n    print('NO')\nelse:\n    print(s / kol)", "if kol == 0:\n    print(s / kol)\nelse:\n    print('NO')", "print(s / kol)\nif kol == 0:\n    print('NO')", "if kol > 0:\n    print(s / kol)\nelse:\n    print('NO')"], "correct": [3], "explain": "Сначала проверяем, что количество положительное, и только тогда делим. Иначе выводим строку `NO`. Так не возникает деления на ноль.", "mono": 1, "id": "out15", "sk": "o_no"}, {"sec": "out", "prompt": "Зачем перед `print(s / kol)` проверяют `if kol > 0:`?", "options": ["если подходящих чисел нет, kol = 0, и деление вызовет ZeroDivisionError", "чтобы не печатать отрицательные числа", "чтобы ответ был целым", "это требование синтаксиса"], "correct": [0], "explain": "На ноль делить нельзя. Если подходящих чисел нет, по условию выводят NO.", "memo": "zero", "id": "ans01", "sk": "o_no"}, {"sec": "cond", "prompt": "Задача (FOR): **Количество чисел, кратных 4**.\nВ последовательности натуральных чисел определить количество чисел, кратных 4.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["a % 4 != 0", "a % 4 == 0", "a // 4 == 0", "a % 4 == 1", "a % 10 == 4"], "correct": [1], "explain": "Нужное условие: `a % 4 == 0`.", "code": "n = int(input())\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if УСЛОВИЕ:\n        kol += 1\nprint(kol)", "mono": 1, "task": 3, "id": "cond01", "sk": "cd_simple"}, {"sec": "cond", "prompt": "Задача (FOR): **Количество чисел, оканчивающихся на 3**.\nВ последовательности натуральных чисел определить количество чисел, оканчивающихся на 3.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["a % 7 == 3", "a % 10 == 3", "a % 10 != 3", "a % 3 == 0", "a // 10 == 3"], "correct": [1], "explain": "Нужное условие: `a % 10 == 3`.", "code": "n = int(input())\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if УСЛОВИЕ:\n        kol += 1\nprint(kol)", "mono": 1, "task": 5, "id": "cond02", "sk": "cd_simple"}, {"sec": "cond", "prompt": "Задача (FOR): **Викторина: максимум правильных ответов и нулевой результат**.\nУчастники ответили на 20 вопросов. Найти наибольшее количество правильных ответов.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["a != 0", "a == 0", "a = 0"], "correct": [1], "explain": "Нужное условие: `a == 0`.", "code": "n = int(input())\nmaxi = -10**10\nkol2 = 0\nfor i in range(n):\n    a = int(input())\n    maxi = max(maxi, a)\n    if УСЛОВИЕ:\n        kol2 += 1\nprint(maxi)\nif kol2 > 0:\n    print('YES')\nelse:\n    print('NO')", "mono": 1, "task": 12, "id": "cond09", "sk": "cd_simple"}, {"sec": "cond", "prompt": "Задача (FOR): **Контрольная: число неудовлетворительных оценок и отличник**.\nКаждый ученик решал 10 примеров. Неудовлетворительная оценка — если решено меньше половины примеров. Найти количество таких оценок.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["a <= 5", "a < 5", "a >= 5", "a < 4", "a != 5"], "correct": [1], "explain": "Нужное условие: `a < 5`.", "code": "n = int(input())\nkol = 0\nkol2 = 0\nfor i in range(n):\n    a = int(input())\n    if УСЛОВИЕ:\n        kol += 1\n    if a == 10:\n        kol2 += 1\nprint(kol)\nif kol2 > 0:\n    print('YES')\nelse:\n    print('NO')", "mono": 1, "task": 16, "id": "cond12", "sk": "cd_simple"}, {"sec": "cond", "prompt": "Задача (ОТРЕЗКИ): **Количество нечётных чисел на отрезке [a; b]**.\nПо двум натуральным числам a и b подсчитать количество нечётных натуральных чисел на отрезке [a; b], включая оба конца.\n\nЧто поставить вместо `УСЛОВИЕ`?\n\n*Верных вариантов несколько — отметь все.*", "options": ["a % 2 != 0", "a % 2 == 0", "a % 2 == 1"], "correct": [0, 2], "explain": "Нужное условие: `a % 2 != 0`. Равносильная запись: `a % 2 == 1`.", "code": "a = int(input())\nb = int(input())\nkol = 0\nfor a in range(a, b + 1):\n    if УСЛОВИЕ:\n        kol += 1\nprint(kol)", "mono": 1, "task": 32, "id": "cond16", "sk": "cd_simple"}, {"sec": "cond", "prompt": "Задача (WHILE): **Количество трёхзначных чисел, кратных 4**.\nВ последовательности натуральных чисел определить количество трёхзначных чисел, кратных 4.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["100 <= a <= 999 and a % 10 == 0", "100 <= a <= 999 and a % 4 == 0", "a % 4 == 0", "100 < a <= 999 and a % 4 == 0", "100 <= a <= 999"], "correct": [1], "explain": "Нужное условие: `100 <= a <= 999 and a % 4 == 0`.", "code": "kol = 0\na = int(input())\nwhile a != 0:\n    if УСЛОВИЕ:\n        kol += 1\n    a = int(input())\nprint(kol)", "mono": 1, "task": 9, "id": "cond18", "sk": "cd_comp"}, {"sec": "cond", "prompt": "Задача (WHILE): **Сумма чисел, кратных 4 или 9**.\nВ последовательности целых чисел вычислить сумму всех чисел, которые кратны 4 или 9.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["a % 10 == 0 or a % 9 == 0", "a % 4 == 0 or a % 9 != 0", "a % 9 == 0", "a % 4 != 0 or a % 9 == 0", "a % 4 == 0 or a % 9 == 0"], "correct": [4], "explain": "Нужное условие: `a % 4 == 0 or a % 9 == 0`.", "code": "s = 0\na = int(input())\nwhile a != 0:\n    if УСЛОВИЕ:\n        s += a\n    a = int(input())\nprint(s)", "mono": 1, "task": 23, "id": "cond20", "sk": "cd_comp"}, {"sec": "cond", "prompt": "Задача (WHILE): **Сумма чисел, кратных 6 и оканчивающихся на 4**.\nВ последовательности натуральных чисел определить сумму чисел, кратных 6 и оканчивающихся на 4.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["a % 6 == 0 and a % 10 == 4", "a % 10 == 4", "a % 6 == 0", "a % 6 == 0 and a % 7 == 4", "a % 6 != 0 and a % 10 == 4"], "correct": [0], "explain": "Нужное условие: `a % 6 == 0 and a % 10 == 4`.", "code": "s = 0\na = int(input())\nwhile a != 0:\n    if УСЛОВИЕ:\n        s += a\n    a = int(input())\nprint(s)", "mono": 1, "task": 7, "id": "cond21", "sk": "cd_comp"}, {"sec": "cond", "prompt": "Задача (WHILE): **Длина последовательности и количество нечётных чисел, кратных 3**.\nОпределить длину последовательности и количество нечётных чисел, кратных 3.\n\nЧто поставить вместо `УСЛОВИЕ`?\n\n*Верных вариантов несколько — отметь все.*", "options": ["a % 3 == 0 and a % 2 != 0", "a % 3 != 0 and a % 2 != 0", "a % 3 == 0", "a % 3 == 0 and a % 2 == 0", "a % 3 == 0 and a % 2 == 1"], "correct": [0, 4], "explain": "Нужное условие: `a % 3 == 0 and a % 2 != 0`. Равносильная запись: `a % 3 == 0 and a % 2 == 1`.", "code": "dlina = 0\nkol = 0\na = int(input())\nwhile a != 0:\n    dlina += 1\n    if УСЛОВИЕ:\n        kol += 1\n    a = int(input())\nprint(dlina, kol)", "mono": 1, "task": 24, "id": "cond23", "sk": "cd_comp"}, {"sec": "cond", "prompt": "Задача (ХАРД): **Среднее чисел, кратных 3, но не кратных 9 (или NO)**.\nНайти среднее арифметическое чисел, которые делятся на 3, но не делятся на 9. Если таких чисел нет, вывести NO.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["a % 3 == 0 or a % 9 != 0", "a % 3 == 0 and a % 9 == 0", "a % 3 == 0 and a % 9 != 0", "a % 9 != 0", "a % 3 != 0 and a % 9 != 0"], "correct": [2], "explain": "Нужное условие: `a % 3 == 0 and a % 9 != 0`.", "code": "s = 0\nkol = 0\na = int(input())\nwhile a != 0:\n    if УСЛОВИЕ:\n        s += a\n        kol += 1\n    a = int(input())\nif kol > 0:\n    print(round(s / kol, 1))\nelse:\n    print('NO')", "mono": 1, "task": 108, "id": "cond30", "sk": "cd_comp"}, {"sec": "cond", "prompt": "Задача (FOR): **Среднее чисел, оканчивающихся на 5 в системе счисления по основанию 7**.\nНайти среднее арифметическое десятичных чисел, запись которых в системе счисления с основанием 7 оканчивается цифрой 5. Если таких элементов нет, вывести NO.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["a // 7 == 5", "a % 7 != 5", "a % 5 == 7", "a % 10 == 5", "a % 7 == 5"], "correct": [4], "explain": "Нужное условие: `a % 7 == 5`.", "code": "n = int(input())\ns = 0\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if УСЛОВИЕ:\n        s += a\n        kol += 1\nif kol > 0:\n    print(s / kol)\nelse:\n    print('NO')", "mono": 1, "task": 20, "id": "cond14", "sk": "cd_base"}, {"sec": "cond", "prompt": "Задача (FOR): **Среднее чисел с нечётной последней цифрой в записи по основанию 7**.\nНайти среднее арифметическое десятичных чисел, запись которых в системе счисления с основанием 7 оканчивается нечётной цифрой. Если таких элементов нет, вывести NO.\n\nЧто поставить вместо `УСЛОВИЕ`?\n\n*Верных вариантов несколько — отметь все.*", "options": ["a % 7 % 2 != 0", "a % 7 % 2 == 0", "a % 7 % 2 == 1", "a % 10 % 2 != 0"], "correct": [0, 2], "explain": "Нужное условие: `a % 7 % 2 != 0`. Равносильная запись: `a % 7 % 2 == 1`.", "code": "n = int(input())\ns = 0\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if УСЛОВИЕ:\n        s += a\n        kol += 1\nif kol > 0:\n    print(round(s / kol, 1))\nelse:\n    print('NO')", "mono": 1, "task": 18, "id": "cond13", "sk": "cd_base"}, {"sec": "cond", "prompt": "Задача (ХАРД): **Двузначные числа с убывающими цифрами: количество и сумма**.\nНайти количество и сумму двузначных чисел, у которых цифра десятков больше цифры единиц.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["10 <= a <= 99", "10 <= a <= 99 and a // 10 > a % 10", "10 <= a <= 99 and a // 10 > a % 7", "a // 10 > a % 10", "10 <= a <= 99 or a // 10 > a % 10"], "correct": [1], "explain": "Нужное условие: `10 <= a <= 99 and a // 10 > a % 10`.", "code": "kol = 0\ns = 0\na = int(input())\nwhile a != 0:\n    if УСЛОВИЕ:\n        kol += 1\n        s += a\n    a = int(input())\nprint(kol)\nprint(s)", "mono": 1, "task": 107, "id": "cond29", "sk": "cd_dig"}, {"sec": "cond", "prompt": "Задача (ХАРД): **Наименьшее трёхзначное число с одинаковыми первой и последней цифрами**.\nВ последовательности натуральных чисел найти наименьшее трёхзначное число, у которого первая цифра равна последней. Если таких чисел нет, вывести NO.\n\nЧто поставить вместо `УСЛОВИЕ`?", "options": ["100 <= a <= 999 or a // 100 == a % 10", "100 <= a <= 999 and a // 100 == a % 7", "100 <= a <= 999 and a // 10 == a % 10", "100 <= a < 999 and a // 100 == a % 10", "100 <= a <= 999 and a // 100 == a % 10"], "correct": [4], "explain": "Нужное условие: `100 <= a <= 999 and a // 100 == a % 10`.", "code": "n = int(input())\nmini = 10**10\nfor i in range(n):\n    a = int(input())\n    if УСЛОВИЕ:\n        mini = min(mini, a)\nif mini < 10**10:\n    print(mini)\nelse:\n    print('NO')", "mono": 1, "task": 112, "id": "cond32", "sk": "cd_dig"}, {"sec": "prep", "prompt": "Задача (FOR): **Количество чисел, кратных 4**.\nВ последовательности натуральных чисел определить количество чисел, кратных 4.\n\nКакие строки нужно написать **перед циклом**? Отметь все нужные — без лишних и без неверных.", "options": ["kol = 1", "kol2 = 0", "pr = 1", "kol = 0"], "correct": [3], "explain": "Нужно: `kol = 0`. Лишние переменные не нужны.", "hint": "Подумай, какие величины просит найти задача: количество, сумму, произведение, максимум, минимум, длину…", "after": "n = int(input())\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if a % 4 == 0:\n        kol += 1\nprint(kol)", "mono": 1, "task": 3, "id": "prep01", "sk": "p_one"}, {"sec": "prep", "prompt": "Задача (FOR): **Сумма чисел, кратных 6**.\nВ последовательности натуральных чисел определить сумму чисел, кратных 6.\n\nКакие строки нужно написать **перед циклом**? Отметь все нужные — без лишних и без неверных.", "options": ["maxi = -10**10", "s = 1", "kol2 = 0", "s = 0"], "correct": [3], "explain": "Нужно: `s = 0`. Лишние переменные не нужны.", "hint": "Подумай, какие величины просит найти задача: количество, сумму, произведение, максимум, минимум, длину…", "after": "n = int(input())\ns = 0\nfor i in range(n):\n    a = int(input())\n    if a % 6 == 0:\n        s += a\nprint(s)", "mono": 1, "task": 2, "id": "prep03", "sk": "p_one"}, {"sec": "prep", "prompt": "Задача (FOR): **Максимальное число, кратное 5**.\nВ последовательности натуральных чисел определить максимальное число, кратное 5.\n\nКакие строки нужно написать **перед циклом**? Отметь все нужные — без лишних и без неверных.", "options": ["maxi = 0", "s = 0", "mini = 10**10", "maxi = -10**10"], "correct": [3], "explain": "Нужно: `maxi = -10**10`. Максимум — с очень маленького числа. Лишние переменные не нужны.", "hint": "Подумай, какие величины просит найти задача: количество, сумму, произведение, максимум, минимум, длину…", "after": "n = int(input())\nmaxi = -10**10\nfor i in range(n):\n    a = int(input())\n    if a % 5 == 0:\n        maxi = max(maxi, a)\nprint(maxi)", "mono": 1, "task": 1, "id": "prep05", "sk": "p_one"}, {"sec": "prep", "prompt": "Задача (FOR): **Минимальное чётное число**.\nВ последовательности натуральных чисел определить минимальное чётное число.\n\nКакие строки нужно написать **перед циклом**? Отметь все нужные — без лишних и без неверных.", "options": ["mini = -10**10", "pr = 1", "s = 0", "mini = 10**10"], "correct": [3], "explain": "Нужно: `mini = 10**10`. Минимум — с очень большого. Лишние переменные не нужны.", "hint": "Подумай, какие величины просит найти задача: количество, сумму, произведение, максимум, минимум, длину…", "after": "n = int(input())\nmini = 10**10\nfor i in range(n):\n    a = int(input())\n    if a % 2 == 0:\n        mini = min(mini, a)\nprint(mini)", "mono": 1, "task": 8, "id": "prep07", "sk": "p_one"}, {"sec": "prep", "prompt": "Задача (FOR): **Температура: среднее положительных значений и их количество**.\nПо дневным температурам найти среднюю температуру тех дней, когда она была выше 0 °C, и количество таких дней.\n\nКакие строки нужно написать **перед циклом**? Отметь все нужные — без лишних и без неверных.", "options": ["s = 1", "kol = 1", "kol = 0", "mini = 10**10", "s = 0", "maxi = -10**10"], "correct": [2, 4], "explain": "Нужно: `kol = 0`, `s = 0`. Лишние переменные не нужны.", "hint": "Подумай, какие величины просит найти задача: количество, сумму, произведение, максимум, минимум, длину…", "after": "n = int(input())\nkol = 0\ns = 0\nfor i in range(n):\n    a = int(input())\n    if a > 0:\n        kol += 1\n        s += a\nprint(s / kol)\nprint(kol)", "mono": 1, "task": 11, "id": "prep09", "sk": "p_many"}, {"sec": "prep", "prompt": "Задача (WHILE): **Длина последовательности и количество нечётных чисел, кратных 3**.\nОпределить длину последовательности и количество нечётных чисел, кратных 3.\n\nКакие строки нужно написать **перед циклом**? Отметь все нужные — без лишних и без неверных.", "options": ["kol = 1", "dlina = 1", "maxi = -10**10", "mini = 10**10", "kol = 0", "dlina = 0"], "correct": [4, 5], "explain": "Нужно: `dlina = 0`, `kol = 0`. Лишние переменные не нужны.", "hint": "Подумай, какие величины просит найти задача: количество, сумму, произведение, максимум, минимум, длину…", "after": "dlina = 0\nkol = 0\na = int(input())\nwhile a != 0:\n    dlina += 1\n    if a % 3 == 0 and a % 2 != 0:\n        kol += 1\n    a = int(input())\nprint(dlina, kol)", "mono": 1, "task": 24, "id": "prep26", "sk": "p_many"}, {"sec": "prep", "prompt": "Задача (FOR): **Викторина: максимум правильных ответов и нулевой результат**.\nУчастники ответили на 20 вопросов. Найти наибольшее количество правильных ответов.\n\nКакие строки нужно написать **перед циклом**? Отметь все нужные — без лишних и без неверных.", "options": ["kol = 0", "maxi = -10**10", "kol2 = 0", "s = 0", "maxi = 10**10", "kol2 = 1"], "correct": [1, 2], "explain": "Нужно: `maxi = -10**10`, `kol2 = 0`. Максимум — с очень маленького числа. Лишние переменные не нужны.", "hint": "Подумай, какие величины просит найти задача: количество, сумму, произведение, максимум, минимум, длину…", "after": "n = int(input())\nmaxi = -10**10\nkol2 = 0\nfor i in range(n):\n    a = int(input())\n    maxi = max(maxi, a)\n    if a == 0:\n        kol2 += 1\nprint(maxi)\nif kol2 > 0:\n    print('YES')\nelse:\n    print('NO')", "mono": 1, "task": 12, "id": "prep10", "sk": "p_many"}, {"sec": "prep", "prompt": "Задача (ХАРД): **Произведение чисел, оканчивающихся на 2 в семеричной записи**.\nВ последовательности натуральных чисел найти произведение чисел, запись которых в системе счисления с основанием 7 оканчивается цифрой 2. Если таких чисел нет, вывести NO.\n\nКакие строки нужно написать **перед циклом**? Отметь все нужные — без лишних и без неверных.", "options": ["kol = 0", "maxi = -10**10", "pr = 0", "s = 0", "kol = 1", "pr = 1"], "correct": [0, 5], "explain": "Нужно: `pr = 1`, `kol = 0`. Произведение начинают с 1. Лишние переменные не нужны.", "hint": "Подумай, какие величины просит найти задача: количество, сумму, произведение, максимум, минимум, длину…", "after": "n = int(input())\npr = 1\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if a % 7 == 2:\n        pr *= a\n        kol += 1\nif kol > 0:\n    print(pr)\nelse:\n    print('NO')", "mono": 1, "task": 106, "id": "prep39", "sk": "p_many"}, {"sec": "prep", "prompt": "Задача (ХАРД): **Сумма положительных и произведение отрицательных**.\nДана последовательность целых чисел, заканчивающаяся числом 0. Найти сумму положительных чисел и произведение отрицательных.\n\nКакие строки нужно написать **перед циклом**? Отметь все нужные — без лишних и без неверных.", "options": ["kol = 0", "maxi = -10**10", "pr = 0", "s = 0", "pr = 1", "s = 1"], "correct": [3, 4], "explain": "Нужно: `s = 0`, `pr = 1`. Произведение начинают с 1. Лишние переменные не нужны.", "hint": "Подумай, какие величины просит найти задача: количество, сумму, произведение, максимум, минимум, длину…", "after": "s = 0\npr = 1\na = int(input())\nwhile a != 0:\n    if a > 0:\n        s += a\n    if a < 0:\n        pr *= a\n    a = int(input())\nprint(s)\nprint(pr)", "mono": 1, "task": 110, "id": "prep43", "sk": "p_many"}, {"sec": "prep", "prompt": "Задача (FOR): **Скорости: разность максимума и минимума, количество до 30 км/ч**.\nКамера фиксирует скорости N автомобилей. Найти:\n\nКакие строки нужно написать **перед циклом**? Отметь все нужные — без лишних и без неверных.", "options": ["mini = -10**10", "maxi = -10**10", "kol = 1", "mini = 10**10", "kol = 0", "maxi = 10**10"], "correct": [1, 3, 4], "explain": "Нужно: `kol = 0`, `maxi = -10**10`, `mini = 10**10`. Максимум — с очень маленького числа. Минимум — с очень большого. Лишние переменные не нужны.", "hint": "Подумай, какие величины просит найти задача: количество, сумму, произведение, максимум, минимум, длину…", "after": "n = int(input())\nkol = 0\nmaxi = -10**10\nmini = 10**10\nfor i in range(n):\n    a = int(input())\n    maxi = max(maxi, a)\n    mini = min(mini, a)\n    if a <= 30:\n        kol += 1\nprint(maxi - mini)\nprint(kol)", "mono": 1, "task": 10, "id": "prep08", "sk": "p_many"}, {"sec": "run", "id": "run28", "prompt": "Python показал это сообщение. Что оно означает?", "code": "n = int(input())\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if a % 4 == 0\n        kol += 1\nprint(kol)", "console": "  File \"main.py\", line 5\n    if a % 4 == 0\n                 ^\nSyntaxError: expected ':'", "options": ["в строке 5 не создана переменная a", "в строке 5 лишний отступ", "в строке 5 после условия if не хватает двоеточия", "программа ждёт ввода числа"], "correct": [2], "explain": "`expected ':'` — Python ждал двоеточие. После `if`, `for`, `while`, `else` в конце строки обязательно ставится `:`.", "memo": "colon", "sk": "r_syn"}, {"sec": "run", "id": "run29", "prompt": "Python показал это сообщение. Что оно означает?", "code": "a = int(input())\nif a % 2 = 0:\n    print('YES')", "console": "  File \"main.py\", line 2\n    if a % 2 = 0:\n       ^^^^^\nSyntaxError: cannot assign to expression here. Maybe you meant '==' instead of '='?", "options": ["не хватает двоеточия", "в условии стоит «=» (присваивание), а для сравнения нужно «==»", "в условии нельзя использовать %", "переменная a не создана"], "correct": [1], "explain": "Python даже подсказывает: `Maybe you meant '=='`. Сравнение пишется двумя знаками: `a % 2 == 0`.", "memo": "eq", "sk": "r_syn"}, {"sec": "run", "id": "run30", "prompt": "Python показал это сообщение. Что оно означает?", "code": "a = int(input()\nprint(a)", "console": "  File \"main.py\", line 1\n    a = int(input()\n           ^\nSyntaxError: '(' was never closed", "options": ["в строке 2 не хватает двоеточия", "print нужно писать без скобок", "input нужно писать с большой буквы", "в строке 1 не закрыта скобка: нужно a = int(input())"], "correct": [3], "explain": "`'(' was never closed` — открытая скобка так и не закрылась. Сколько `(`, столько и `)`.", "memo": "paren", "sk": "r_syn"}, {"sec": "run", "id": "run31", "prompt": "Python показал это сообщение. Что оно означает?", "code": "print('NO)", "console": "  File \"main.py\", line 1\n    print('NO)\n          ^\nSyntaxError: unterminated string literal (detected at line 1)", "options": ["NO не создано как переменная", "не закрыта кавычка: нужно print('NO')", "не хватает двоеточия", "print пишется с большой буквы"], "correct": [1], "explain": "`unterminated string literal` — текст в кавычках не закончен: закрывающей кавычки нет.", "memo": "quote", "sk": "r_syn"}, {"sec": "run", "prompt": "Python показал это сообщение. Что оно означает?", "options": ["сдвинуть print(a) на 4 пробела вправо", "добавить скобки вокруг a > 0", "убрать двоеточие после if", "написать Print вместо print"], "correct": [0], "explain": "После `if …:` нужен блок с отступом. print без отступа — блок пустой.", "code": "a = int(input())\nif a > 0:\nprint(a)", "memo": "indent_block", "console": "  File \"main.py\", line 3\n    print(a)\n    ^^^^^\nIndentationError: expected an indented block after 'if' statement on line 2", "id": "run05", "sk": "r_ind"}, {"sec": "run", "prompt": "Python показал это сообщение. Что оно означает?", "options": ["строка 3: нет двоеточия", "строка 4: kol не создан", "строка 5: print внутри цикла", "строка 2: лишний отступ перед kol = 0"], "correct": [3], "explain": "Перед строкой 2 нет заголовка с двоеточием, значит отступ там лишний.", "code": "n = int(input())\n  kol = 0\nfor i in range(n):\n    kol += 1\nprint(kol)", "memo": "unexpected", "console": "  File \"main.py\", line 2\n    kol = 0\nIndentationError: unexpected indent", "id": "run06", "sk": "r_ind"}, {"sec": "run", "prompt": "Python показал это сообщение. Что оно означает?", "options": ["поставить print(kol) внутрь цикла", "перед циклом добавить kol = 0", "заменить kol += 1 на kol = 1", "добавить двоеточие после print"], "correct": [1], "explain": "kol += 1 значит «возьми старое kol и прибавь 1», а старого kol нет. Начальное значение задают до цикла.", "code": "n = int(input())\nfor i in range(n):\n    a = int(input())\n    if a % 4 == 0:\n        kol += 1\nprint(kol)", "memo": "name_init", "console": "Traceback (most recent call last):\n  File \"main.py\", line 5, in <module>\n    kol += 1\n    ^^^\nNameError: name 'kol' is not defined", "inp": "2\n4\n8", "id": "run09", "sk": "r_name"}, {"sec": "run", "prompt": "Python показал это сообщение. Что оно означает?", "options": ["не хватает двоеточия", "print пишется с маленькой буквы", "нельзя печатать a", "нужно print(a) взять в кавычки"], "correct": [1], "explain": "Python различает регистр букв. Он даже подсказывает: Did you mean: 'print'?", "code": "a = int(input())\nPrint(a)", "memo": "name_typo", "console": "Traceback (most recent call last):\n  File \"main.py\", line 2, in <module>\n    Print(a)\n    ^^^^^\nNameError: name 'Print' is not defined. Did you mean: 'print'?", "inp": "5", "id": "run10", "sk": "r_name"}, {"sec": "run", "prompt": "Python показал это сообщение. Что оно означает?", "options": ["print('NO') — слово в кавычках", "print(no)", "print(NO:)", "NO = 0 перед if"], "correct": [0], "explain": "Без кавычек слово считается именем переменной.", "code": "kol = 0\nif kol > 0:\n    print(kol)\nelse:\n    print(NO)", "memo": "name_str", "console": "Traceback (most recent call last):\n  File \"main.py\", line 5, in <module>\n    print(NO)\n          ^^\nNameError: name 'NO' is not defined", "id": "run12", "sk": "r_name"}, {"sec": "run", "prompt": "Имена на экране выглядят одинаково, но Python пишет, что переменной нет. Почему?", "options": ["нужно писать KOL", "во второй строке буква «о» русская — для Python это другое имя", "kol — зарезервированное слово", "нельзя писать kol += 1 после kol = 0"], "correct": [1], "explain": "Кириллическая «о» и латинская «o» выглядят одинаково, но это разные символы. Набирай код в английской раскладке.", "code": "kol = 0\nkоl += 1\nprint(kol)", "memo": "name_typo", "console": "Traceback (most recent call last):\n  File \"main.py\", line 2, in <module>\n    kоl += 1\n    ^^^\nNameError: name 'kоl' is not defined", "id": "run11", "sk": "r_name"}, {"sec": "run", "prompt": "Python показал это сообщение. Что оно означает?", "options": ["if int(a % 4) == 0:", "if a % 4 == \"0\":", "a = input(int())", "a = int(input())"], "correct": [3], "explain": "input() вернул строку '16'. Для текста `%` означает форматирование строки, отсюда странное сообщение. Нужно сразу превратить ввод в число.", "code": "a = input()\nif a % 4 == 0:\n    print(a)", "memo": "type_str", "mono": 1, "console": "Traceback (most recent call last):\n  File \"main.py\", line 2, in <module>\n    if a % 4 == 0:\n       ~~^~~\nTypeError: not all arguments converted during string formatting", "inp": "16", "id": "run13", "sk": "r_type"}, {"sec": "run", "prompt": "Python показал это сообщение. Что оно означает?", "options": ["числа ввели через запятую в одной строке, а нужно каждое — с новой строки", "нельзя читать числа в цикле", "нужно n = input()", "нет двоеточия после for"], "correct": [0], "explain": "int() получил строку «3, 5, 7» и не смог её превратить в одно число.", "code": "n = int(input())\nfor i in range(n):\n    a = int(input())", "memo": "value", "console": "Traceback (most recent call last):\n  File \"main.py\", line 1, in <module>\n    n = int(input())\nValueError: invalid literal for int() with base 10: '3, 5, 7'", "inp": "3, 5, 7", "id": "run16", "sk": "r_type"}, {"sec": "run", "prompt": "Python показал это сообщение. Что оно означает?", "options": ["поменять условие на a % 8 != 0", "добавить проверку: if kol > 0: print(s / kol) else: print('NO')", "заменить / на //", "начать с kol = 1"], "correct": [1], "explain": "Кратных 8 не оказалось, kol = 0 → деление на ноль. Начать с kol = 1 нельзя — среднее станет неверным.", "code": "s = 0\nkol = 0\na = int(input())\nwhile a != 0:\n    if a % 8 == 0:\n        s += a\n        kol += 1\n    a = int(input())\nprint(s / kol)", "memo": "zero", "console": "Traceback (most recent call last):\n  File \"main.py\", line 9, in <module>\n    print(s / kol)\n          ~~^~~~~\nZeroDivisionError: division by zero", "inp": "5\n7\n0", "id": "run17", "sk": "r_type"}, {"sec": "bug", "prompt": "Задача: **средняя температура дней, когда она выше 0, и количество таких дней**.\nНа вводе `4, -5, 12, -2, 8` программа вывела `5.0 / 4`, а правильный ответ `10.0 / 2`. В чём ошибка?", "options": ["нужно //", "нужно s += 1", "kol += 1 стоит вне if — считаются все дни, а не только тёплые", "нужно a >= 0"], "correct": [2], "explain": "И сумма, и количество должны считаться только для подходящих чисел.", "code": "n = int(input())\nkol = 0\ns = 0\nfor i in range(n):\n    a = int(input())\n    kol += 1\n    if a > 0:\n        s += a\nprint(s / kol)\nprint(kol)", "inp": "4\n-5\n12\n-2\n8", "memo": "outside_if", "after": "n = int(input())\nkol = 0\ns = 0\nfor i in range(n):\n    a = int(input())\n    if a > 0:\n        kol += 1\n        s += a\nprint(s / kol)\nprint(kol)", "id": "bug12", "sk": "b"}, {"sec": "bug", "prompt": "Задача: **длина последовательности и количество нечётных чисел, кратных 3 (ввод до 0)**.\nНа вводе `4, 6, 15, 180, 0` программа вывела `1 1`, а правильный ответ `4 1`. В чём ошибка?", "options": ["не хватает dlina = 1", "нужно or вместо and", "dlina += 1 попал под if, а длину нужно считать для всех чисел", "print должен выводить на двух строках"], "correct": [2], "explain": "Длина последовательности — количество ВСЕХ чисел, без проверки.", "code": "dlina = 0\nkol = 0\na = int(input())\nwhile a != 0:\n    if a % 3 == 0 and a % 2 != 0:\n        dlina += 1\n        kol += 1\n    a = int(input())\nprint(dlina, kol)", "inp": "4\n6\n15\n180\n0", "memo": "outside_if", "after": "dlina = 0\nkol = 0\na = int(input())\nwhile a != 0:\n    dlina += 1\n    if a % 3 == 0 and a % 2 != 0:\n        kol += 1\n    a = int(input())\nprint(dlina, kol)", "id": "bug02", "sk": "b"}, {"sec": "bug", "prompt": "Задача: **скорости: если хотя бы два автомобиля ехали не быстрее 40 — YES**.\nНа вводе `3, 40, 35, 90` программа вывела `NO`, а правильный ответ `YES`. В чём ошибка?", "options": ["нужно kol2 = 1 в начале", "«не быстрее 40» — это a <= 40, а написано строгое a < 40", "нужно kol2 > 2", "YES и NO перепутаны"], "correct": [1], "explain": "Граница включается: 40 км/ч — тоже «не быстрее 40».", "code": "n = int(input())\nkol2 = 0\nfor i in range(n):\n    a = int(input())\n    if a < 40:\n        kol2 += 1\nif kol2 >= 2:\n    print('YES')\nelse:\n    print('NO')", "inp": "3\n40\n35\n90", "after": "n = int(input())\nkol2 = 0\nfor i in range(n):\n    a = int(input())\n    if a <= 40:\n        kol2 += 1\nif kol2 >= 2:\n    print('YES')\nelse:\n    print('NO')", "id": "bug09", "sk": "b"}, {"sec": "bug", "prompt": "Задача: **если хотя бы один участник набрал 0 — YES**.\nНа вводе `3, 0, 5, 0` программа вывела `NO`, а правильный ответ `YES`. В чём ошибка?", "options": ["kol2 нужно начинать с 1", "нужно a != 0", "«хотя бы один» — это kol2 > 0; условие kol2 == 1 ломается, когда нулей два", "надо выводить kol2"], "correct": [2], "explain": "Хотя бы один = один ИЛИ больше.", "code": "n = int(input())\nkol2 = 0\nfor i in range(n):\n    a = int(input())\n    if a == 0:\n        kol2 += 1\nif kol2 == 1:\n    print('YES')\nelse:\n    print('NO')", "inp": "3\n0\n5\n0", "after": "n = int(input())\nkol2 = 0\nfor i in range(n):\n    a = int(input())\n    if a == 0:\n        kol2 += 1\nif kol2 > 0:\n    print('YES')\nelse:\n    print('NO')", "id": "bug10", "sk": "b"}, {"sec": "bug", "prompt": "Задача: **сумма чисел, кратных 4 или 9 (ввод до 0, числа могут быть отрицательными)**.\nНа вводе `-16, 93, 90, 36, 0` программа вывела `36`, а правильный ответ `110`. В чём ошибка?", "options": ["нужно a % 4 != 0", "while a > 0", "«или» — это or; с and подходят только числа, кратные сразу 4 и 9 (то есть 36)", "s = 1 в начале"], "correct": [2], "explain": "Слово «или» в условии задачи — `or`.", "code": "s = 0\na = int(input())\nwhile a != 0:\n    if a % 4 == 0 and a % 9 == 0:\n        s += a\n    a = int(input())\nprint(s)", "inp": "-16\n93\n90\n36\n0", "after": "s = 0\na = int(input())\nwhile a != 0:\n    if a % 4 == 0 or a % 9 == 0:\n        s += a\n    a = int(input())\nprint(s)", "id": "bug13", "sk": "b"}, {"sec": "bug", "prompt": "Задача: **количество нечётных чисел на отрезке [a; b]**.\nНа вводе `1, 10` программа вывела `10`, а правильный ответ `5`. В чём ошибка?", "options": ["нужно range(a, b)", "в условии проверяется a (левый конец), а не текущее число x", "нечётность проверяется как a % 2 == 0", "kol нужно увеличивать на x"], "correct": [1], "explain": "Переменная цикла — x. Проверять нужно её; a не меняется, поэтому посчитались все числа.", "code": "a = int(input())\nb = int(input())\nkol = 0\nfor x in range(a, b + 1):\n    if a % 2 != 0:\n        kol += 1\nprint(kol)", "inp": "1\n10", "after": "a = int(input())\nb = int(input())\nkol = 0\nfor x in range(a, b + 1):\n    if x % 2 != 0:\n        kol += 1\nprint(kol)", "id": "bug03", "sk": "b"}, {"sec": "bug", "prompt": "Задача: **среднее чисел, запись которых в семеричной системе оканчивается нечётной цифрой**.\nНа вводе `6, 12, 15, 10, 71, 50, 11` программа вывела `32.3`, а правильный ответ `31.6`. В чём ошибка?", "options": ["проверяется последняя десятичная цифра (a % 10), а нужна семеричная (a % 7)", "kol должен начинаться с 1", "нужно округлять до целого", "неверно стоит else"], "correct": [0], "explain": "Последняя цифра записи по основанию 7 — это `a % 7`.", "code": "n = int(input())\ns = 0\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if a % 10 % 2 != 0:\n        s += a\n        kol += 1\nif kol > 0:\n    print(round(s / kol, 1))\nelse:\n    print('NO')", "inp": "6\n12\n15\n10\n71\n50\n11", "memo": "wrong_mod", "after": "n = int(input())\ns = 0\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if a % 7 % 2 != 0:\n        s += a\n        kol += 1\nif kol > 0:\n    print(round(s / kol, 1))\nelse:\n    print('NO')", "id": "bug01", "sk": "b"}, {"sec": "bug", "prompt": "Задача: **количество и сумма двузначных чисел, у которых цифра десятков больше цифры единиц**.\nНа вводе `21, 12, 90, 5, 0` программа вывела `1 / 12`, а правильный ответ `2 / 111`. В чём ошибка?", "options": ["нужно 10 < a < 99", "сумма должна быть s += 1", "нужно or вместо and", "цифры перепутаны: a % 10 — единицы, a // 10 — десятки; нужно a // 10 > a % 10"], "correct": [3], "explain": "Десятки: `a // 10`, единицы: `a % 10`.", "code": "kol = 0\ns = 0\na = int(input())\nwhile a != 0:\n    if 10 <= a <= 99 and a % 10 > a // 10:\n        kol += 1\n        s += a\n    a = int(input())\nprint(kol)\nprint(s)", "inp": "21\n12\n90\n5\n0", "memo": "wrong_mod", "after": "kol = 0\ns = 0\na = int(input())\nwhile a != 0:\n    if 10 <= a <= 99 and a // 10 > a % 10:\n        kol += 1\n        s += a\n    a = int(input())\nprint(kol)\nprint(s)", "id": "bug07", "sk": "b"}, {"sec": "bug", "prompt": "Задача: **наименьшее трёхзначное число, у которого первая цифра равна последней (или NO)**.\nНа вводе `4, 121, 303, 20, 2002` программа вывела `20`, а правильный ответ `121`. В чём ошибка?", "options": ["нужно max вместо min", "нет проверки «трёхзначное»: у числа 20 тоже 20 // 100 == 20 % 10 (оба 0)", "первая цифра — a // 10", "mini нужно начинать с 0"], "correct": [1], "explain": "Если по условию число трёхзначное, это обязательно проверять: `100 <= a <= 999`.", "code": "n = int(input())\nmini = 10**10\nfor i in range(n):\n    a = int(input())\n    if a // 100 == a % 10:\n        mini = min(mini, a)\nif mini < 10**10:\n    print(mini)\nelse:\n    print('NO')", "inp": "4\n121\n303\n20\n2002", "after": "n = int(input())\nmini = 10**10\nfor i in range(n):\n    a = int(input())\n    if 100 <= a <= 999 and a // 100 == a % 10:\n        mini = min(mini, a)\nif mini < 10**10:\n    print(mini)\nelse:\n    print('NO')", "id": "bug08", "sk": "b"}, {"sec": "trace", "prompt": "Что выведет `print(dlina, kol)`, если dlina = 3, kol = 1?", "options": ["3\n1", "3 1", "31", "3,1"], "correct": [1], "explain": "Несколько значений через запятую печатаются в одну строку через пробел.", "mono": 1, "id": "out02", "sk": "t_print"}, {"sec": "trace", "prompt": "Что выведет `print(s / kol)`, если s = 16, kol = 2?", "options": ["8.0", "8.00", "8", "16/2"], "correct": [0], "explain": "Деление `/` всегда даёт дробное число, поэтому 8.0.", "mono": 1, "id": "out03", "sk": "t_print"}, {"sec": "trace", "prompt": "Что выведет `print(round(4.56, 1))`?", "options": ["4.5", "4.56", "5", "4.6"], "correct": [3], "explain": "`round(x, 1)` округляет до одного знака после точки: 4.56 → 4.6.", "mono": 1, "id": "out04", "sk": "t_print"}, {"sec": "trace", "prompt": "Для среднего ученик использовал `//`. Что выведет программа?", "options": ["6.0", "6.5", "6", "7"], "correct": [2], "explain": "`//` — целочисленное деление, дробная часть теряется. Для среднего нужно `/`.", "code": "s = 13\nkol = 2\nprint(s // kol)", "mono": 1, "id": "ans09", "sk": "t_print"}, {"sec": "trace", "prompt": "Задача (FOR): **Количество чисел, кратных 4**.\nЧто выведет программа при вводе `3, 16, 26, 24`?", "options": ["3", "1", "2", "40"], "correct": [2], "explain": "Правильный вывод: `2`. Перед циклом создай kol = 0 — счётчик подходящих чисел.", "hint": "1) Перед циклом создай kol = 0 — счётчик подходящих чисел.\n2) Внутри цикла проверяй кратность 4: остаток от деления на 4 равен нулю.\n3) Только внутри if увеличивай kol на 1. Сумма, произведение, максимум и минимум здесь не нужны.\n4) В конце выведи kol одной командой print().", "code": "n = int(input())\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if a % 4 == 0:\n        kol += 1\nprint(kol)", "inp": "3\n16\n26\n24", "mono": 1, "task": 3, "id": "trace01", "sk": "t_ok"}, {"sec": "trace", "prompt": "Задача (FOR): **Сумма чисел, кратных 6**.\nЧто выведет программа при вводе `3, 12, 25, 6`?", "options": ["19", "18", "2", "25"], "correct": [1], "explain": "Правильный вывод: `18`. Перед циклом создай s = 0 — накопитель суммы.", "hint": "1) Перед циклом создай s = 0 — накопитель суммы.\n2) Внутри цикла проверь, делится ли a на 6 без остатка.\n3) Только для подходящего числа прибавляй a к s. Счётчик kol не нужен.\n4) В конце выведи s.", "code": "n = int(input())\ns = 0\nfor i in range(n):\n    a = int(input())\n    if a % 6 == 0:\n        s += a\nprint(s)", "inp": "3\n12\n25\n6", "mono": 1, "task": 2, "id": "trace03", "sk": "t_ok"}, {"sec": "trace", "prompt": "Задача (FOR): **Максимальное число, кратное 5**.\nЧто выведет программа при вводе `3, 10, 25, 12`?", "options": ["24", "26", "25", "12"], "correct": [2], "explain": "Правильный вывод: `25`. До цикла задай maxi заведомо маленьким числом, например -10**10.", "hint": "1) До цикла задай maxi заведомо маленьким числом, например -10**10.\n2) Для каждого a проверь делимость на 5.\n3) Внутри if обновляй максимум: maxi = max(maxi, a). Счётчик и сумму не меняй.\n4) В конце выведи maxi.", "code": "n = int(input())\nmaxi = -10**10\nfor i in range(n):\n    a = int(input())\n    if a % 5 == 0:\n        maxi = max(maxi, a)\nprint(maxi)", "inp": "3\n10\n25\n12", "mono": 1, "task": 1, "id": "trace05", "sk": "t_ok"}, {"sec": "trace", "prompt": "Ученик прочитал число **до** цикла. Что выведет программа при вводе `4, 6, 1, 3, 5` (каждое на новой строке)?", "options": ["1", "4", "5", "0"], "correct": [1], "explain": "Прочитано только одно число 6, и цикл 4 раза проверил одно и то же: результат 4. Чтение нужно перенести внутрь цикла.", "code": "n = int(input())\na = int(input())\nkol = 0\nfor i in range(n):\n    if a % 2 == 0:\n        kol += 1\nprint(kol)", "inp": "4\n6\n1\n3\n5", "mono": 1, "id": "inp07", "sk": "t_bug"}, {"sec": "trace", "prompt": "`kol = 0` попал внутрь цикла. Что выведет программа при вводе `3, 2, 4, 7`?", "options": ["2", "0", "1", "3"], "correct": [1], "explain": "На каждом шаге счётчик обнуляется. Последнее число 7 нечётное, поэтому kol = 0. Начальное значение задают до цикла.", "code": "n = int(input())\nfor i in range(n):\n    kol = 0\n    a = int(input())\n    if a % 2 == 0:\n        kol += 1\nprint(kol)", "inp": "3\n2\n4\n7", "memo": "init_in_loop", "mono": 1, "id": "acc07", "sk": "t_bug"}, {"sec": "trace", "prompt": "Вместо `s += a` написали `s = a`. Что выведет программа при вводе `3, 12, 25, 6`?", "options": ["6", "43", "18", "0"], "correct": [0], "explain": "`s = a` не складывает, а заменяет: в s остаётся последнее подходящее число (6). Нужно `s += a` → 18.", "code": "n = int(input())\ns = 0\nfor i in range(n):\n    a = int(input())\n    if a % 6 == 0:\n        s = a\nprint(s)", "inp": "3\n12\n25\n6", "mono": 1, "id": "acc10", "sk": "t_bug"}, {"sec": "trace", "prompt": "Что выведет программа при вводе `3, 2, 9, 10`?", "options": ["1", "18", "180", "0"], "correct": [3], "explain": "Подходят 2 и 9 (остаток 2 при делении на 7), но начальное `pr = 0`, а 0·2·9 = 0. Нужно `pr = 1`, тогда ответ 18.", "code": "n = int(input())\npr = 0\nfor i in range(n):\n    a = int(input())\n    if a % 7 == 2:\n        pr *= a\nprint(pr)", "inp": "3\n2\n9\n10", "memo": "start_val", "mono": 1, "id": "acc05", "sk": "t_bug"}, {"sec": "trace", "prompt": "Опечатка: `=+` вместо `+=`. Что выведет программа при вводе `4, 8, 12, 5, 16`?", "options": ["0", "4", "3", "1"], "correct": [3], "explain": "`kol =+ 1` — это `kol = +1`: в kol просто кладётся 1. Подошло три числа, но ответ всегда 1.", "code": "n = int(input())\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if a % 4 == 0:\n        kol =+ 1\nprint(kol)", "inp": "4\n8\n12\n5\n16", "memo": "plus_eq", "mono": 1, "id": "acc06", "sk": "t_bug"}, {"sec": "trace", "prompt": "Начальное значение `maxi = 0`. Что выведет программа при вводе `3, -5, -2, -8`?", "options": ["0", "-2", "-8", "-5"], "correct": [0], "explain": "Все числа отрицательные и меньше 0, поэтому maxi так и остаётся 0 — такого числа даже нет во вводе! Нужно `maxi = -10**10`, тогда ответ −2.", "code": "n = int(input())\nmaxi = 0\nfor i in range(n):\n    a = int(input())\n    maxi = max(maxi, a)\nprint(maxi)", "inp": "3\n-5\n-2\n-8", "memo": "start_val", "mono": 1, "id": "mm05", "sk": "t_bug"}, {"sec": "trace", "prompt": "Что выведет программа, если среди чисел `12, 7, 4` нет кратных 5 (N = 3)?", "options": ["NO", "0", "12", "-10000000000"], "correct": [3], "explain": "maxi ни разу не обновился и остался равен начальному −10**10. Поэтому в задачах, где подходящих чисел может не быть, перед выводом проверяют это отдельно.", "code": "n = int(input())\nmaxi = -10**10\nfor i in range(n):\n    a = int(input())\n    if a % 5 == 0:\n        maxi = max(maxi, a)\nprint(maxi)", "inp": "3\n12\n7\n4", "mono": 1, "id": "mm08", "sk": "t_bug"}, {"sec": "trace", "prompt": "Ученик забыл `+ 1`. Что выведет программа при вводе `10, 20` (нужно количество чётных на [10; 20])?", "options": ["11", "5", "6", "10"], "correct": [1], "explain": "Число 20 не проверилось, и ответ получился 5 вместо 6.", "code": "a = int(input())\nb = int(input())\nkol = 0\nfor x in range(a, b):\n    if x % 2 == 0:\n        kol += 1\nprint(kol)", "inp": "10\n20", "memo": "range_b", "mono": 1, "id": "for06", "sk": "t_bug"}, {"sec": "trace", "prompt": "`print` оказался внутри цикла. Что выведет программа при вводе `3, 13, 23, 24`?", "options": ["1\n2\n2", "2", "0\n1\n2", "1\n2"], "correct": [0], "explain": "print с отступом выполняется на каждом шаге цикла — печатаются промежуточные значения 1, 2, 2. Итоговый print пишут без отступа.", "code": "n = int(input())\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if a % 10 == 3:\n        kol += 1\n    print(kol)", "inp": "3\n13\n23\n24", "memo": "print_in_loop", "mono": 1, "id": "for08", "sk": "t_bug"}, {"sec": "trace", "prompt": "Чтение следующего числа поставили **в начало** тела цикла. Что выведет программа при вводе `4, 6, 5, 0` (кратные 3)?", "options": ["1", "0", "2", "3"], "correct": [2], "explain": "Первое число 4 «перезаписалось» до проверки, зато завершающий 0 проверился (0 % 3 == 0) и посчитался: вышло 2 вместо 1. Чтение следующего числа — в КОНЦЕ тела.", "code": "kol = 0\na = int(input())\nwhile a != 0:\n    a = int(input())\n    if a % 3 == 0:\n        kol += 1\nprint(kol)", "inp": "4\n6\n5\n0", "mono": 1, "id": "whl09", "sk": "t_bug"}, {"sec": "trace", "prompt": "Задача (ОТРЕЗКИ): **Количество чётных чисел на отрезке [a; b]**.\nЧто выведет программа при вводе `10, 20`?", "options": ["6", "90", "5", "7"], "correct": [0], "explain": "Правильный вывод: `6`. Введи границы отрезка: start и finish.", "hint": "1) Введи границы отрезка: start и finish.\n2) kol = 0 создай перед циклом.\n3) Перебирай все числа от start до finish включительно: range(start, finish + 1).\n4) Если a % 2 == 0, увеличь kol на 1. В конце выведи kol.", "code": "a = int(input())\nb = int(input())\nkol = 0\nfor a in range(a, b + 1):\n    if a % 2 == 0:\n        kol += 1\nprint(kol)", "inp": "10\n20", "mono": 1, "task": 22, "id": "trace20", "sk": "t_ok"}, {"sec": "trace", "prompt": "Задача (WHILE): **Сумма чисел, кратных 4 или 9**.\nЧто выведет программа при вводе `-16, 93, 90, 0`?", "options": ["0", "74", "183", "2"], "correct": [1], "explain": "Правильный вывод: `74`. До цикла создай s = 0.", "hint": "1) До цикла создай s = 0.\n2) Вводи числа, пока не встретится 0.\n3) Для каждого числа проверяй кратность 4 ИЛИ кратность 9: используй or. Если подходит хотя бы одно условие, добавь число к s один раз.\n4) После цикла выведи s.", "code": "s = 0\na = int(input())\nwhile a != 0:\n    if a % 4 == 0 or a % 9 == 0:\n        s += a\n    a = int(input())\nprint(s)", "inp": "-16\n93\n90\n0", "mono": 1, "task": 23, "id": "trace26", "sk": "t_ok"}, {"sec": "trace", "prompt": "Задача (WHILE): **Длина последовательности и количество нечётных чисел, кратных 3**.\nЧто выведет программа при вводе `4, 6, 15, 180, 0`?", "options": ["4 1", "205 1", "4 3", "4 15"], "correct": [0], "explain": "Правильный вывод: `4 1`. dlina = 0 — счётчик длины. Увеличивай его на каждом проходе while, потому что любое ненулевое число входит в последовательность.", "hint": "1) dlina = 0 — счётчик длины. Увеличивай его на каждом проходе while, потому что любое ненулевое число входит в последовательность.\n2) kol = 0 — второй счётчик. Увеличивай его только для нечётных чисел, кратных 3: a % 2 != 0 and a % 3 == 0.\n3) Сначала прочитай a до начала цикла; в конце каждой итерации обязательно прочитай следующее число. Сам 0 не учитывай.\n4) Выведи оба результата одной строкой в формате «число, число», например: print(dlina, kol).", "code": "dlina = 0\nkol = 0\na = int(input())\nwhile a != 0:\n    dlina += 1\n    if a % 3 == 0 and a % 2 != 0:\n        kol += 1\n    a = int(input())\nprint(dlina, kol)", "inp": "4\n6\n15\n180\n0", "mono": 1, "task": 24, "id": "trace29", "sk": "t_ok"}, {"sec": "trace", "prompt": "Задача (FOR): **Температура: среднее положительных значений и их количество**.\nЧто выведет программа при вводе `4, -5, 12, -2, 8`?", "options": ["1.0\n2", "10.0\n2", "1.0\n20", "10.5\n2"], "correct": [1], "explain": "Правильный вывод: `10.0 / 2`. s = 0 и kol = 0 создай перед циклом.", "hint": "1) s = 0 и kol = 0 создай перед циклом.\n2) Положительные температуры отбирай условием a > 0. Только для них увеличивай s на a и kol на 1.\n3) Среднее вычисляется как s / kol. В этом задании гарантирован хотя бы один положительный день.\n4) Выведи среднее, затем количество положительных дней — двумя командами print().", "code": "n = int(input())\nkol = 0\ns = 0\nfor i in range(n):\n    a = int(input())\n    if a > 0:\n        kol += 1\n        s += a\nprint(s / kol)\nprint(kol)", "inp": "4\n-5\n12\n-2\n8", "mono": 1, "task": 11, "id": "trace09", "sk": "t_ok"}, {"sec": "trace", "prompt": "Задача (FOR): **Скорости: разность максимума и минимума, количество до 30 км/ч**.\nЧто выведет программа при вводе `4, 74, 69, 63, 96`?", "options": ["96\n0", "33\n0", "32\n0", "34\n0"], "correct": [1], "explain": "Правильный вывод: `33 / 0`. Здесь нужны три независимых действия.", "hint": "Здесь нужны три независимых действия.\n1) maxi и mini обновляй для КАЖДОЙ скорости — вне условия отбора.\n2) kol = 0 создай до цикла; увеличивай kol только если скорость не выше 30.\n3) В конце выведи два результата: сначала maxi - mini, затем kol. Для этого задания они печатаются отдельными строками.", "code": "n = int(input())\nkol = 0\nmaxi = -10**10\nmini = 10**10\nfor i in range(n):\n    a = int(input())\n    maxi = max(maxi, a)\n    mini = min(mini, a)\n    if a <= 30:\n        kol += 1\nprint(maxi - mini)\nprint(kol)", "inp": "4\n74\n69\n63\n96", "mono": 1, "task": 10, "id": "trace08", "sk": "t_ok"}, {"sec": "trace", "prompt": "Задача (FOR): **Скорости: максимум и проверка скорости ниже 30**.\nЧто выведет программа при вводе `4, 74, 69, 63, 66`?", "options": ["74\nYES", "74\nNO", "73\nNO", "75\nNO"], "correct": [1], "explain": "Правильный вывод: `74 / NO`. maxi = -10**10 обновляй для каждой скорости автомобиля — до условия.", "hint": "1) maxi = -10**10 обновляй для каждой скорости автомобиля — до условия.\n2) Создай kol2 = 0. Если скорость строго меньше 30, увеличь kol2 на 1. Скорость 30 не подходит.\n3) Сначала выведи maxi. Затем проверь kol2 > 0: это означает, что хотя бы одна медленная машина была.\n4) Максимум и второй счётчик обновляются независимо друг от друга.", "code": "n = int(input())\nmaxi = -10**10\nkol2 = 0\nfor i in range(n):\n    a = int(input())\n    maxi = max(maxi, a)\n    if a < 30:\n        kol2 += 1\nprint(maxi)\nif kol2 > 0:\n    print('YES')\nelse:\n    print('NO')", "inp": "4\n74\n69\n63\n66", "mono": 1, "task": 13, "id": "trace12", "sk": "t_ok"}, {"sec": "trace", "prompt": "Что выведет программа при вводе `1, 15`?", "options": ["0 0", "4 30", "NO", "5 45"], "correct": [1], "explain": "Кратные 3, но не 5, на [1; 15]: 3, 6, 9, 12 → 4 числа, сумма 30, одна строка через пробел.", "code": "a = int(input())\nb = int(input())\nkol = 0\ns = 0\nfor a in range(a, b + 1):\n    if a % 3 == 0 and a % 5 != 0:\n        kol += 1\n        s += a\nif kol > 0:\n    print(kol, s)\nelse:\n    print('NO')", "inp": "1\n15", "mono": 1, "id": "ans11", "sk": "t_ok"}, {"sec": "trace", "prompt": "Задача (ХАРД): **Произведение чисел, оканчивающихся на 2 в семеричной записи**.\nЧто выведет программа при вводе `3, 2, 9, 10`?", "options": ["2", "0", "10", "18"], "correct": [3], "explain": "Правильный вывод: `18`. Последняя цифра в 7-ричной записи — это остаток a % 7.", "hint": "Последняя цифра в 7-ричной записи — это остаток a % 7.\n1) Произведение начинается с pr = 1.\n2) Чтобы понять, были ли подходящие числа, заведи счётчик kol.\n3) Вывод с условием: если kol > 0 — печатай pr, иначе NO.", "code": "n = int(input())\npr = 1\nkol = 0\nfor i in range(n):\n    a = int(input())\n    if a % 7 == 2:\n        pr *= a\n        kol += 1\nif kol > 0:\n    print(pr)\nelse:\n    print('NO')", "inp": "3\n2\n9\n10", "mono": 1, "task": 106, "id": "trace44", "sk": "t_ok"}], "memo": {"colon": {"t": "Нет двоеточия", "msg": "SyntaxError: expected ':'", "why": "После if, elif, else, for и while обязательно ставится двоеточие. Python ждал «:» в конце строки.", "fix": "Допиши двоеточие в конце строки-заголовка.", "bad": "if a % 2 == 0\n    kol += 1", "good": "if a % 2 == 0:\n    kol += 1", "c": "#fff1a8", "e": "#e0b400", "g": "run"}, "eq": {"t": "«=» вместо «==»", "msg": "SyntaxError: cannot assign to expression here. Maybe you meant '==' instead of '='?", "why": "Один знак = — это присваивание («положи в переменную»). Для сравнения нужно два знака: ==.", "fix": "В условиях сравнивай через ==, != , <, >, <=, >=.", "bad": "if a % 2 = 0:", "good": "if a % 2 == 0:", "c": "#fff1a8", "e": "#e0b400", "g": "run"}, "paren": {"t": "Не закрыта скобка", "msg": "SyntaxError: '(' was never closed", "why": "Каждой открывающей скобке нужна закрывающая. В int(input()) их две пары.", "fix": "Посчитай скобки: сколько «(», столько и «)». Ошибка часто показывается на строке ниже.", "bad": "a = int(input()", "good": "a = int(input())", "c": "#fff1a8", "e": "#e0b400", "g": "run"}, "quote": {"t": "Не закрыта кавычка", "msg": "SyntaxError: unterminated string literal", "why": "Текст (строка) должен начинаться и заканчиваться одинаковыми кавычками.", "fix": "Закрой кавычку: print('NO'). Не смешивай ' и \".", "bad": "print('NO)", "good": "print('NO')", "c": "#fff1a8", "e": "#e0b400", "g": "run"}, "print_paren": {"t": "print без скобок", "msg": "SyntaxError: Missing parentheses in call to 'print'", "why": "В Python 3 print — функция, значение передаётся в круглых скобках.", "fix": "Пиши print(kol), а не print kol.", "bad": "print kol", "good": "print(kol)", "c": "#fff1a8", "e": "#e0b400", "g": "run"}, "else": {"t": "else не на своём месте", "msg": "SyntaxError: invalid syntax", "why": "else должен стоять ровно под своим if (с тем же отступом) и сразу после блока if. «else if» в Python не бывает — пишут elif.", "fix": "Выровняй else по if; вместо «else if» пиши «elif».", "bad": "if a > 0:\n    print(1)\n    else:\n    print(2)", "good": "if a > 0:\n    print(1)\nelse:\n    print(2)", "c": "#fff1a8", "e": "#e0b400", "g": "run"}, "indent_block": {"t": "Нет отступа внутри блока", "msg": "IndentationError: expected an indented block after 'if' statement", "why": "После строки с двоеточием Python ждёт тело блока — строки, сдвинутые вправо (обычно на 4 пробела).", "fix": "Сдвинь строки тела цикла / условия на 4 пробела (клавиша Tab в редакторе).", "bad": "for i in range(n):\na = int(input())", "good": "for i in range(n):\n    a = int(input())", "c": "#cfe6ff", "e": "#3b82f6", "g": "run"}, "unexpected": {"t": "Лишний отступ", "msg": "IndentationError: unexpected indent", "why": "Строка сдвинута вправо, хотя перед ней нет заголовка с двоеточием. Отступы в Python — часть программы.", "fix": "Убери лишние пробелы в начале строки.", "bad": "n = int(input())\n  kol = 0", "good": "n = int(input())\nkol = 0", "c": "#cfe6ff", "e": "#3b82f6", "g": "run"}, "unindent": {"t": "Отступы «не совпадают»", "msg": "IndentationError: unindent does not match any outer indentation level", "why": "Строка сдвинута на число пробелов, которого нет ни у одного внешнего блока (например, 2 вместо 0 или 4).", "fix": "Используй ровно 4 пробела на уровень. Выровняй строку по нужному блоку.", "bad": "if a > 0:\n    print(1)\n  print(2)", "good": "if a > 0:\n    print(1)\nprint(2)", "c": "#cfe6ff", "e": "#3b82f6", "g": "run"}, "tab": {"t": "Табы и пробелы вперемешку", "msg": "TabError: inconsistent use of tabs and spaces in indentation", "why": "Часть строк сдвинута табуляцией, часть — пробелами. Часто бывает после копирования кода из интернета или другого файла.", "fix": "Перенабери отступы одинаково (в IDLE: Format → Untabify Region).", "bad": null, "good": null, "c": "#cfe6ff", "e": "#3b82f6", "g": "run"}, "name_init": {"t": "Переменная не создана", "msg": "NameError: name 'kol' is not defined", "why": "Нельзя увеличивать переменную, которой ещё нет: kol += 1 значит kol = kol + 1, а старого kol нет.", "fix": "Перед циклом создай переменную: kol = 0, s = 0, pr = 1, maxi = -10**10 …", "bad": "for i in range(n):\n    kol += 1", "good": "kol = 0\nfor i in range(n):\n    kol += 1", "c": "#ffd6e4", "e": "#e5487a", "g": "run"}, "name_typo": {"t": "Опечатка в имени", "msg": "NameError: name 'Print' is not defined. Did you mean: 'print'?", "why": "Python различает большие и маленькие буквы: Print, Kol и kol — разные имена. Ещё коварнее русская «о» или «а» в имени — на вид буквы одинаковые!", "fix": "Сверь имя с тем, как переменная создана. Пиши имена латиницей в одной раскладке.", "bad": "Print(kol)", "good": "print(kol)", "c": "#ffd6e4", "e": "#e5487a", "g": "run"}, "name_str": {"t": "Текст без кавычек", "msg": "NameError: name 'NO' is not defined", "why": "Слово без кавычек Python считает именем переменной. Чтобы вывести слово, его берут в кавычки.", "fix": "print('NO'), print('YES').", "bad": "print(NO)", "good": "print('NO')", "c": "#ffd6e4", "e": "#e5487a", "g": "run"}, "type_str": {"t": "Забыли int() при вводе", "msg": "TypeError: not all arguments converted during string formatting", "why": "input() возвращает текст (строку). Со строкой нельзя считать остаток, складывать с числом и сравнивать с числом. Сообщения бывают разные: «not all arguments converted…», «unsupported operand type(s) for +=: 'int' and 'str'», «'>' not supported between instances of 'str' and 'int'».", "fix": "Читай число так: a = int(input()).", "bad": "a = input()\nif a % 4 == 0:", "good": "a = int(input())\nif a % 4 == 0:", "c": "#e6dcff", "e": "#7b5cff", "g": "run"}, "call": {"t": "Имя функции занято числом", "msg": "TypeError: 'int' object is not callable", "why": "Переменную назвали max (или min, sum, print…) — и встроенная функция «пропала»: теперь max — число, его нельзя вызвать.", "fix": "Называй переменные maxi, mini, s — не max, min, sum.", "bad": "max = -10**10\nmax = max(max, a)", "good": "maxi = -10**10\nmaxi = max(maxi, a)", "c": "#e6dcff", "e": "#7b5cff", "g": "run"}, "value": {"t": "Неверный ввод для int()", "msg": "ValueError: invalid literal for int() with base 10: '3 5'", "why": "int() умеет превращать в число только строку с одним целым числом. Два числа в одной строке, дробь «2.5», пустая строка — ошибка.", "fix": "Вводи каждое число на отдельной строке. Проверь, что в данных нет лишних пробелов и дробей.", "bad": null, "good": null, "c": "#e6dcff", "e": "#7b5cff", "g": "run"}, "zero": {"t": "Деление на ноль", "msg": "ZeroDivisionError: division by zero", "why": "Среднее считают как s / kol. Если подходящих чисел не было, kol = 0 — делить нельзя.", "fix": "Перед делением проверь: if kol > 0: … else: print('NO').", "bad": "print(s / kol)", "good": "if kol > 0:\n    print(s / kol)\nelse:\n    print('NO')", "c": "#ffe0c7", "e": "#f07a2a", "g": "run"}, "eof": {"t": "Данные закончились", "msg": "EOFError: EOF when reading a line", "why": "Программа вызывает input() больше раз, чем строк во входных данных: лишнее чтение, забыли завершающий 0, неверное N.", "fix": "Сверь число вызовов input() с вводом: 1 (для N) + N чисел; в while — до нуля включительно.", "bad": null, "good": null, "c": "#ffe0c7", "e": "#f07a2a", "g": "run"}, "loop": {"t": "Программа «зависла»", "msg": "Сообщения нет — программа не заканчивается", "why": "Бесконечный цикл: в while забыли прочитать следующее число в конце тела цикла, поэтому a никогда не становится 0.", "fix": "Последней строкой тела while должно быть a = int(input()) — с тем же отступом, что и if.", "bad": "a = int(input())\nwhile a != 0:\n    if a % 2 == 0:\n        kol += 1", "good": "a = int(input())\nwhile a != 0:\n    if a % 2 == 0:\n        kol += 1\n    a = int(input())", "c": "#ffe0c7", "e": "#f07a2a", "g": "run"}, "print_in_loop": {"t": "print внутри цикла", "msg": "Ошибки нет, но ответов много", "why": "print с отступом попал в тело цикла и печатает промежуточные значения на каждом шаге.", "fix": "Итоговый print пиши без отступа — после цикла.", "bad": "for i in range(n):\n    ...\n    print(kol)", "good": "for i in range(n):\n    ...\nprint(kol)", "c": "#d7f5e3", "e": "#16a36a", "g": "logic"}, "init_in_loop": {"t": "Обнуление внутри цикла", "msg": "Ошибки нет, но счётчик «забывает»", "why": "kol = 0 внутри цикла выполняется на каждом шаге и стирает всё, что насчитали раньше.", "fix": "Начальные значения задаются ДО цикла.", "bad": "for i in range(n):\n    kol = 0\n    ...", "good": "kol = 0\nfor i in range(n):\n    ...", "c": "#d7f5e3", "e": "#16a36a", "g": "logic"}, "outside_if": {"t": "Действие не под if", "msg": "Ошибки нет, но считаются все числа", "why": "kol += 1 стоит с тем же отступом, что и if, — значит, выполняется всегда, а не только для подходящих чисел.", "fix": "Действие для подходящих чисел сдвигается на 4 пробела глубже, чем if.", "bad": "if a % 4 == 0:\n    pass\nkol += 1", "good": "if a % 4 == 0:\n    kol += 1", "c": "#d7f5e3", "e": "#16a36a", "g": "logic"}, "start_val": {"t": "Неверное начальное значение", "msg": "Ошибки нет, но ответ 0 или странный", "why": "pr = 0 → произведение всегда 0. maxi = 0 → не найдём максимум среди отрицательных. mini = 0 → минимум всегда 0. maxi = -10^10 → ^ в Python не степень, получится -4!", "fix": "pr = 1, maxi = -10**10, mini = 10**10 (степень — две звёздочки **).", "bad": "pr = 0\nmini = 0\nmaxi = -10^10", "good": "pr = 1\nmini = 10**10\nmaxi = -10**10", "c": "#d7f5e3", "e": "#16a36a", "g": "logic"}, "plus_eq": {"t": "=+ вместо +=", "msg": "Ошибки нет, но счётчик всегда 1", "why": "kol =+ 1 читается как kol = +1, то есть «положи в kol единицу». Это не увеличение!", "fix": "Увеличение: kol += 1 (сначала +, потом =).", "bad": "kol =+ 1", "good": "kol += 1", "c": "#d7f5e3", "e": "#16a36a", "g": "logic"}, "range_b": {"t": "Отрезок без правого конца", "msg": "Ошибки нет, но не хватает числа b", "why": "range(a, b) перебирает числа от a до b−1. Правый конец не включается.", "fix": "Для отрезка [a; b] пиши range(a, b + 1).", "bad": "for x in range(a, b):", "good": "for x in range(a, b + 1):", "c": "#d7f5e3", "e": "#16a36a", "g": "logic"}, "wrong_mod": {"t": "Перепутали % и //, 10 и 7", "msg": "Ошибки нет, но отбор не те числа", "why": "a % 10 — последняя десятичная цифра; a % 7 — последняя цифра в семеричной записи; a // 10 — число без последней цифры; a / 2 — обычное деление с дробью.", "fix": "Кратность k: a % k == 0. Последняя цифра: a % 10. Семеричная цифра: a % 7.", "bad": null, "good": null, "c": "#d7f5e3", "e": "#16a36a", "g": "logic"}, "format": {"t": "Лишний текст в выводе", "msg": "Ошибки нет, но проверка «не засчитывает»", "why": "Автопроверка сравнивает вывод символ в символ. «Ответ: 5», «Yes» вместо «YES», лишняя запятая — неверно.", "fix": "Выводи ровно то, что требует условие: print(kol), print('YES').", "bad": "print('Ответ:', kol)", "good": "print(kol)", "c": "#d7f5e3", "e": "#16a36a", "g": "logic"}}}</script>
<script>
'use strict';
const APPNAME='Python · ОГЭ №16 — тестовик';
const LSKEY='oge16_python_testovik_v2';
const DEFAULT_PIN='31415';
const SOURCE='<!DOCTYPE html>\n'+document.documentElement.outerHTML;
const DATA=JSON.parse(document.getElementById('bank').textContent);
const SECS=DATA.secs, BANK=DATA.bank, MEMO=DATA.memo;
const Q=Object.fromEntries(BANK.map(q=>[q.id,q]));
const SEC=Object.fromEntries(SECS.map(s=>[s.id,s]));
const questionOrder=q=>Number(q.task??(q.id.match(/\d+$/)||[0])[0]);
const ORDER=SECS.flatMap(sc=>BANK.filter(q=>q.sec===sc.id).slice().sort((a,b)=>questionOrder(a)-questionOrder(b)||a.id.localeCompare(b.id,"en",{numeric:true})).map(q=>q.id));
const NUM=Object.fromEntries(ORDER.map((id,i)=>[id,i+1]));
const SEC_HINT={
 inp:'input() всегда возвращает текст. Чтобы получить число, его оборачивают в int(). Каждое число — отдельная строка ввода.',
 mod:'a % k — остаток от деления на k (0 означает «делится нацело»). a % 10 — последняя цифра, a // 10 — число без последней цифры, a % 7 — последняя цифра в семеричной записи.',
 cmp:'== сравнивает, = присваивает. «Не больше» — <=, «меньше» — <, «не менее» — >=. Двойное неравенство: 10 <= a <= 99.',
 log:'and — должны выполняться ОБА требования; or — достаточно ОДНОГО; not — «не». Каждую часть пиши полностью: a % 4 == 0 or a % 9 == 0.',
 acc:'Счётчик: kol = 0 и kol += 1. Сумма: s = 0 и s += a. Произведение: pr = 1 и pr *= a. Начальные значения — до цикла.',
 mm:'maxi = -10**10, mini = 10**10 (очень маленькое и очень большое). Обновление: maxi = max(maxi, a), mini = min(mini, a).',
 for:'range(n) — n повторений (0…n−1). range(a, b + 1) — все числа от a до b включительно. Тело цикла — строки с отступом.',
 whl:'Первое число читаем до цикла, следующее — последней строкой тела цикла. Стоп-сигнал 0 не обрабатывается.',
 out:'print(x, y) — через пробел в одну строку; два print — две строки. Текст — в кавычках, переменные — без. / всегда даёт дробь.',
 ans:'Перед делением на kol проверь kol > 0. Слова YES/NO — в кавычках и строго как в условии. else стоит под своим if.',
 run:'Читай ПОСЛЕДНЮЮ строку сообщения: тип ошибки и пояснение. Номер строки — в «line N». Иногда ошибка на строку выше.',
 cond:'Разбери условие задачи на части: кратность (% k == 0), последняя цифра (% 10), семеричная цифра (% 7), диапазон (10 <= a <= 99). Соедини and / or.',
 prep:'Какие величины просит задача? Количество → kol = 0, сумма → s = 0, произведение → pr = 1, максимум → maxi = -10**10, минимум → mini = 10**10.',
 bug:'Сравни программу с условием задачи построчно: начальные значения, условие отбора, отступы, что именно выводится.',
 trace:'Выполни программу на бумаге: выпиши переменные и меняй их на каждом шаге цикла.',
 hard:'Нарисуй таблицу: шаг, a, значения переменных после шага.'};
const $=s=>document.querySelector(s);
const $$=s=>[...document.querySelectorAll(s)];
const app=()=>document.getElementById('app');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function md(s){return esc(s).replace(/`([^`]+)`/g,'<code>$1</code>').replace(/\*\*(.+?)\*\*/g,'<b>$1</b>').replace(/\*(.+?)\*/g,'<i>$1</i>').replace(/\n/g,'<br>');}
function plain(s){return String(s||'').replace(/`/g,'').replace(/\*\*/g,'').replace(/\*/g,'');}
const KW=new Set(['if','elif','else','for','while','in','and','or','not','break','pass','True','False']);
const FN=new Set(['print','int','input','range','max','min','round','Print','Int','str']);
function hl(line){
 return line.replace(/('[^']*'?|"[^"]*"?|#.*$|[A-Za-zА-Яа-яЁё_][\wА-Яа-яЁё]*|\d+)|([^'"#A-Za-zА-Яа-яЁё_\d]+)/g,(m,t,o)=>{
  if(o!==undefined)return esc(o);
  if(t[0]==="'"||t[0]==='"')return `<span class="s">${esc(t)}</span>`;
  if(t[0]==='#')return `<span class="c">${esc(t)}</span>`;
  if(/^\d/.test(t))return `<span class="n">${t}</span>`;
  if(t==='УСЛОВИЕ')return `<span class="u">${t}</span>`;
  if(KW.has(t))return `<span class="k">${t}</span>`;
  if(FN.has(t))return `<span class="f">${t}</span>`;
  return esc(t);});}
function codeHTML(code,hlLine){return `<pre class="pcode">${code.split('\n').map((l,i)=>`<span class="l${hlLine===i+1?' hl':''}">${hl(l)||' '}</span>`).join('')}</pre>`;}
function consHTML(t){const L=t.split('\n');return `<pre class="cons">${L.map((l,i)=>i===L.length-1?`<span class="er">${esc(l)}</span>`:esc(l)).join('\n')}</pre>`;}
function letter(i){return String.fromCharCode(65+i);}

/* ===== данные ===== */
function blankDB(){return {v:2,teacher:{name:'',email:'',tg:'',pin:DEFAULT_PIN},hw:[],hwTitle:'',students:{},last:'',theme:'light',updated:0};}
function parseEmbedded(){try{const t=document.getElementById('saved-state').textContent.trim();return t&&t!=='{}'?JSON.parse(t):null;}catch(e){return null;}}
function mergeInto(base,d){if(!d)return;if(d.teacher)base.teacher=Object.assign(base.teacher,d.teacher);
 if((d.hwAt||0)>=(base.hwAt||0)&&Array.isArray(d.hw)){base.hw=d.hw.filter(id=>Q[id]);base.hwTitle=d.hwTitle||'';base.hwAt=d.hwAt||0;}
 for(const [n,s] of Object.entries(d.students||{})){const o=base.students[n];if(!o||(s.updated||0)>=(o.updated||0))base.students[n]=s;}
 if(d.last)base.last=d.last;if(d.theme)base.theme=d.theme;base.updated=Math.max(base.updated||0,d.updated||0);}
function loadDB(){const b=blankDB();mergeInto(b,parseEmbedded());try{const l=localStorage.getItem(LSKEY);if(l)mergeInto(b,JSON.parse(l));}catch(e){}
 for(const s of Object.values(b.students)){s.q=s.q||{};s.tests=s.tests||[];}return b;}
let DB=loadDB();
function persist(){DB.updated=Date.now();try{localStorage.setItem(LSKEY,JSON.stringify(DB));}catch(e){toast('⚠ Память браузера переполнена — сохрани файл');}}
const cur={name:'',id:null,list:'all',open:null,view:'q',test:null,sel:new Set(),done:false,t0:0};
function stu(){return DB.students[cur.name];}
function rec(id){const s=stu();return s.q[id]||(s.q[id]={st:'',tries:0});}
const solved=r=>r&&['ok','err','hint','sol'].includes(r.st);
const problem=r=>!!r&&!r.fx&&((r.usedHint&&solved(r))||(r.wrong||0)>=2);
function listIds(){const s=stu();if(cur.list==='hw')return ORDER.filter(id=>DB.hw.includes(id));if(cur.list==='redo')return ORDER.filter(id=>(!cur.redoSec||Q[id].sec===cur.redoSec)&&problem(s.q[id]));return ORDER;}
function counts(ids){const s=stu();ids=ids||listIds();let c={total:ids.length,done:0,ok:0,err:0,hint:0,sol:0,bad:0,wrong:0,ms:0};
 for(const id of ids){const r=s.q[id];if(!r)continue;if(solved(r))c.done++;if(r.st)c[r.st]++;c.wrong+=r.wrong||0;c.ms+=r.ms||0;}return c;}
function stamp(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function fmtDate(v){return v?new Date(v).toLocaleString('ru-RU',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}):'—';}
function fmtT(ms){const m=Math.round((ms||0)/60000);return m<60?m+' мин':Math.floor(m/60)+' ч '+(m%60)+' мин';}
function download(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},4000);}
function toast(t){const d=document.createElement('div');d.className='toast';d.textContent=t;document.body.appendChild(d);setTimeout(()=>d.remove(),2600);}
function modal(html,cls=''){closeModal();const m=document.createElement('div');m.className='mbg';m.id='mbg';m.innerHTML=`<div class="mdl ${cls}">${html}</div>`;m.onclick=e=>{if(e.target===m)closeModal();};document.body.appendChild(m);return m;}
function closeModal(){const m=document.getElementById('mbg');if(m)m.remove();}
function confirmBox(text,ok){modal(`<h2>Подтверждение</h2><p>${text}</p><div class="row"><button class="btn pri" id="cYes">Да</button><button class="btn" id="cNo">Отмена</button></div>`);$('#cYes').onclick=()=>{closeModal();ok();};$('#cNo').onclick=closeModal;}
function applyTheme(){document.documentElement.dataset.theme=DB.theme==='dark'?'dark':'light';}
function tick(){if(cur.t0&&cur.id&&cur.name){const r=rec(cur.id);r.ms=(r.ms||0)+Math.min(Date.now()-cur.t0,10*60000);}cur.t0=Date.now();}
function saveApp(){tick();persist();const json=JSON.stringify(DB).replace(/</g,'\\u003c');const open='<script id="saved-state" type="application/json">';const i=SOURCE.indexOf(open);
 const st=i+open.length,j=SOURCE.indexOf('</'+'script>',st);const out=SOURCE.slice(0,st)+json+SOURCE.slice(j);
 download(new Blob([out],{type:'text/html'}),'Тестовик_Python_ОГЭ16'+(cur.name?'_'+cur.name.replace(/[^\wА-Яа-яЁё-]+/g,'_'):'')+'_'+stamp()+'.html');toast('💾 Файл с прогрессом сохранён');}

/* ===== вход ===== */
function viewLogin(){tick();cur.name='';cur.id=null;cur.test=null;
 const profs=Object.values(DB.students).sort((a,b)=>(b.updated||0)-(a.updated||0));
 app().innerHTML=`<div class="login"><div class="lcard"><div class="logo">🐍</div><h1>Python · ОГЭ №16</h1><div class="sub">Тестовик к заданию 16: ввод, условия, циклы, вывод и сообщения об ошибках</div>
 <form id="lf"><input id="nm" placeholder="Введи своё имя" autocomplete="off" maxlength="40" value="${esc(DB.last||'')}"><button class="btn pri" style="width:100%;justify-content:center;padding:14px;font-size:18px">Начать ➜</button></form>
 ${profs.length?`<div class="prof">${profs.map(p=>{const k=ORDER.filter(id=>solved(p.q[id])).length;return `<button data-n="${esc(p.name)}">👤 ${esc(p.name)} <small>${k}/${ORDER.length}</small></button>`;}).join('')}</div>`:''}
 ${DB.hw.length?`<div class="tnote">📌 Задано домашнее задание: ${esc(DB.hwTitle||'')} — ${DB.hw.length} вопр.</div>`:''}
 <div class="lfoot"><button class="btn ghost sm" id="th">${DB.theme==='dark'?'☀️ Светлая':'🌙 Тёмная'} тема</button><button class="btn ghost sm" id="mm">📌 Памятка ошибок</button><button class="btn ghost sm" id="tch">🎓 Учителю</button></div></div></div>`;
 $('#lf').onsubmit=e=>{e.preventDefault();const v=$('#nm').value.trim().replace(/\s+/g,' ');if(!v){$('#nm').focus();return;}enter(v);};
 $$('.prof button').forEach(b=>b.onclick=()=>enter(b.dataset.n));
 $('#th').onclick=()=>{DB.theme=DB.theme==='dark'?'light':'dark';applyTheme();persist();viewLogin();};
 $('#tch').onclick=askPin;$('#mm').onclick=()=>viewMemo();}
function enter(name){if(!DB.students[name])DB.students[name]={name,created:Date.now(),updated:Date.now(),q:{},tests:[]};
 cur.name=name;DB.last=name;persist();cur.list=DB.hw.length&&DB.hw.some(id=>!solved(stu().q[id]))?'hw':'all';
 const L=listIds();cur.id=stu().cur&&L.includes(stu().cur)?stu().cur:(L.find(id=>!solved(stu().q[id]))||L[0]);openQ(cur.id);}

/* ===== каркас ===== */
function topbar(){const c=counts(ORDER);
 return `<div class="top"><div class="ttl">🐍 <span>${APPNAME}</span></div>${cur.test?'<span class="tbadge">🎯 Контрольная</span>':''}<div class="who">👤 ${esc(cur.name)}</div>
 <div class="pbar"><i style="width:${c.done/c.total*100}%"></i></div><div class="ptxt">${c.done}/${c.total}</div>
 <div class="tbtns"><button class="btn sm ghost" id="bSide" title="Свернуть / развернуть меню">☰ Меню</button><button class="btn sm" id="bMemo">📌 Памятка ошибок</button><button class="btn sm" id="bTest">🎯 Контрольная</button><button class="btn sm" id="bSave" title="Сохранить приложение с прогрессом в файл">💾 Сохранить</button><button class="btn sm pri" id="bRep">📄 Отчёт учителю</button><button class="btn sm ghost" id="bTh" title="Тема">${DB.theme==='dark'?'☀️':'🌙'}</button><button class="btn sm ghost" id="bOut" title="Сменить ученика">🚪 Выйти</button></div></div>`;}
function bindTop(){const bs=$('#bSide');if(bs)bs.onclick=()=>{DB.sideOff=!DB.sideOff;persist();applySide();};applySide();$('#bMemo').onclick=()=>viewMemo();$('#bSave').onclick=saveApp;$('#bRep').onclick=()=>{tick();reportDialog(cur.name);};
 $('#bTh').onclick=e=>{DB.theme=DB.theme==='dark'?'light':'dark';applyTheme();persist();e.currentTarget.textContent=DB.theme==='dark'?'☀️':'🌙';};
 $('#bOut').onclick=()=>{if(cur.test&&cur.test.ans.length){confirmBox('Контрольная не закончена. Выйти? Результат сохранится как досрочно завершённый.',()=>{finishTest(true);viewLogin();});return;}viewLogin();};
 $('#bTest').onclick=()=>{if(cur.test){toast('Сначала закончи текущую контрольную');return;}testDialog();};}
function sidebar(){const s=stu();
 if(cur.test){const T=cur.test;return `<aside class="side"><div class="redo">🎯 <b>${esc(T.title)}</b><br>Вопрос ${Math.min(T.i+1,T.ids.length)} из ${T.ids.length}. Подсказки отключены.</div>
  <div class="chips" style="margin-left:0">${T.ids.map((id,i)=>{const a=T.ans[i];return `<span class="chip ${a?(a.ok?'ok':'bad'):''} ${i===T.i?'cur':''}">${i+1}</span>`;}).join('')}</div>
  <div class="row" style="margin-top:12px"><button class="btn sm" id="tStop">⏹ Завершить</button></div></aside>`;}
 const L=listIds();const hwN=DB.hw.length,redoN=ORDER.filter(id=>problem(s.q[id])).length;
 const filt=`<div class="filt"><button data-l="all" class="${cur.list==='all'?'on':''}">Все</button><button data-l="hw" class="${cur.list==='hw'?'on':''}" ${hwN?'':'disabled'}>📌 ДЗ ${hwN?hwN:''}</button><button data-l="redo" class="${cur.list==='redo'?'on':''}" ${redoN||cur.list==='redo'?'':'disabled'}>🔁 Ошибки${redoN?' '+redoN:''}</button></div>`;
 const hwSet=new Set(DB.hw);
 const groups=SECS.map((sc,si)=>{const ids=L.filter(id=>Q[id].sec===sc.id);if(!ids.length)return '';const d=ids.filter(id=>solved(s.q[id])).length;
  const isCur=cur.id&&Q[cur.id].sec===sc.id;const open=cur.open===sc.id||(cur.open==null&&isCur);
  return `<div class="tp ${isCur?'cur':''} ${d===ids.length?'fin':''} ${open?'open':''}"><div class="tph" data-tp="${sc.id}"><span class="ic">${si+1}</span><span>${esc(sc.title)}<span class="stars">${'★'.repeat(sc.stars)}</span></span><span class="done">${d}/${ids.length}<span class="car">▶</span></span></div>
   <div class="mini"><i style="width:${d/ids.length*100}%"></i></div>
   <div class="chips">${ids.map(id=>{const r=s.q[id];const n=NUM[id];return `<button class="chip ${r&&r.st?r.st:''} ${r&&r.fx?'fx':''} ${hwSet.has(id)&&cur.list!=='hw'?'hw':''} ${id===cur.id?'cur':''}" data-id="${id}" title="${esc(sc.title)} · ${n}">${n}</button>`;}).join('')}</div></div>`;}).join('');
 return `<aside class="side">${filt}${cur.list==='hw'?`<div class="redo">📌 <b>Домашнее задание</b>${DB.hwTitle?': '+esc(DB.hwTitle):''}<br>${counts().done} из ${L.length} выполнено</div>`:''}${cur.list==='redo'?'<div class="redo">🔁 <b>Работа над ошибками</b><br>Вопросы, где были ошибки, подсказка или показанный ответ. Реши их сам с первой попытки — и они уйдут из списка.</div>':''}${groups||'<p class="sdesc">Список пуст.</p>'}
 <div class="legend"><span><b style="background:var(--ok)"></b>сам</span><span><b style="background:#7bd3a7"></b>после ошибки</span><span><b style="background:#ffd666"></b>подсказка</span><span><b style="background:#ffb27a"></b>ответ</span><span><b style="background:var(--badl);border:1.5px solid var(--bad)"></b>пока неверно</span></div></aside>`;}
function bindSide(){if(cur.test){const b=$('#tStop');if(b)b.onclick=()=>confirmBox('Завершить контрольную досрочно?',()=>finishTest(true));return;}
 $$('.filt button').forEach(b=>b.onclick=()=>{cur.list=b.dataset.l;cur.redoSec=null;cur.open=null;const L=listIds();if(!L.length){cur.list='all';toast('Список пуст');}const L2=listIds();openQ(L2.includes(cur.id)?cur.id:(L2.find(id=>!solved(stu().q[id]))||L2[0]));});
 $$('.tph').forEach(h=>h.onclick=()=>{const id=h.dataset.tp;cur.open=(cur.open===id||(cur.open==null&&cur.id&&Q[cur.id].sec===id))?'':id;$('.side').outerHTML=sidebar();bindSide();});
 $$('.chip[data-id]').forEach(c=>c.onclick=()=>openQ(c.dataset.id));}

/* ===== вопрос ===== */
function openQ(id,keep){clearAutoAdvance();tick();if(!id){viewDone();return;}cur.view='q';cur.id=id;if(!keep)cur.open=null;cur.sel=new Set();cur.done=false;cur.showHint=false;
 const s=stu();s.cur=id;const q=Q[id],r=s.q[id];const sc=SEC[q.sec];const L=listIds();const pos=L.indexOf(id);
 const multi=q.correct.length>1;const already=solved(r);
 app().innerHTML=topbar()+`<div class="wrap">${sidebar()}<main class="main"><div class="card pop" id="card">
 <div class="chead"><span class="num">Задача №${NUM[id]} · ${esc(sc.title)}</span><span class="badge">${'★'.repeat(sc.stars)} уровень ${sc.stars}</span>${multi?'<span class="mtag">☑ несколько ответов</span>':''}${DB.hw.includes(id)?'<span class="badge nf">📌 ДЗ</span>':''}${extraOf(id)?`<span class="badge xtra">➕ дополнительный к №${NUM[extraOf(id).src]}</span>`:''}
 <div class="nav2"><button class="btn sm ghost" id="pv" ${pos>0?'':'disabled'}>◀</button><button class="btn sm ghost" id="nx" ${pos<L.length-1?'':'disabled'}>▶</button></div></div>
 ${pos===0||Q[L[pos-1]]?.sec!==q.sec?`<div class="sdesc">${esc(sc.desc)}</div>`:''}
 <div class="qtext">${md(q.prompt)}</div>
 ${q.code?`<div class="ptitle">🐍 Программа</div>${codeHTML(q.code,q.console?errLine(q.console):0)}`:''}
 ${q.inp!=null&&q.inp!==''?`<div class="ptitle">⌨ Ввод (каждое число — на новой строке)</div><div class="inbox">${q.inp.split('\n').map(x=>`<span>${esc(x)}</span>`).join('')}</div>`:''}
 ${q.console?`<div class="ptitle">⚠ Сообщение Python</div>${consHTML(q.console)}`:''}
 <div class="ptitle">${multi?'Отметь все верные варианты':'Выбери один вариант'}</div>
 <div class="olist">${q.options.map((o,i)=>`<button class="opt ${multi?'multi':''}" data-i="${i}"><span class="bl">${letter(i)}</span><span class="tx">${q.mono?`<pre>${esc(o)}</pre>`:md(o)}</span></button>`).join('')}</div>
 <div class="actions"><button class="btn pri" id="chk" disabled>Проверить</button><button class="btn ok" id="go" hidden>Дальше ➜</button>${already?'<span class="note" style="color:var(--mut);font-size:14px">✔ уже пройден — можно решить ещё раз</span>':''}</div>
 <div class="fb" id="fb"></div><div id="hz"></div>
 <div class="help"><button class="btn sm" id="finSec" title="Перейти к работе над ошибками этого раздела">🏁 Завершить раздел</button><button class="btn sm" id="hint">💡 Подсказка</button><button class="btn sm" id="theory">📘 Теория</button><button class="btn sm" id="sol">👁 Показать ответ</button>${q.memo?`<button class="memolink" id="ml">📌 Памятка: ${esc(MEMO[q.memo].t)}</button>`:''}<span class="note">${r&&r.tries?`Попыток: ${r.tries}`:''}</span></div>
 </div></main></div>`;
 bindTop();bindSide();
 $$('.opt').forEach(b=>b.onclick=()=>choose(+b.dataset.i));
 $('#chk').onclick=check;$('#go').onclick=goNext;
 $('#pv').onclick=()=>openQ(L[pos-1]);$('#nx').onclick=()=>openQ(L[pos+1]);
 $('#hint').onclick=showHint;$('#theory').onclick=showTheory;$('#sol').onclick=()=>confirmBox('Показать правильный ответ? Вопрос будет отмечен оранжевым и попадёт в «Работу над ошибками».',showAnswer);
 const ml=$('#ml');if(ml)ml.onclick=()=>showSticker(q.memo);
 $('#finSec').onclick=()=>finishSection(q.sec);
 scrollSide();
 persist();}
function errLine(cons){const m=[...cons.matchAll(/main\.py", line (\d+)/g)];return m.length?+m[m.length-1][1]:0;}
function choose(i){if(cur.done)return;const q=cur.view==='test'?Q[cur.test.ids[cur.test.i]]:Q[cur.id];const multi=q.correct.length>1;
 $$('.opt.bad').forEach(b=>b.classList.remove('bad'));
 if(!multi)cur.sel.clear();if(cur.sel.has(i))cur.sel.delete(i);else cur.sel.add(i);
 $$('.opt').forEach(b=>b.classList.toggle('sel',cur.sel.has(+b.dataset.i)));$('#chk').disabled=!cur.sel.size;$('#fb').className='fb';
 if(cur.view==='test'){if(!multi&&q.correct.length===1&&cur.sel.has(i)&&q.correct[0]===i)$('#chk').click();}else if(!multi&&cur.sel.has(i))check();}
function isRight(q,sel){const a=[...sel].sort((x,y)=>x-y);return a.length===q.correct.length&&a.every((v,k)=>v===q.correct[k]);}
function clearAutoAdvance(){clearTimeout(window.__ogeAdvanceTimer);window.__ogeAdvanceTimer=null;}
function scheduleAutoAdvance(){clearAutoAdvance();const fb=$('#fb');if(fb)fb.insertAdjacentHTML('beforeend','<div class="ex auto-next" role="status">✨ Переход к следующему вопросу через 4 секунды…</div>');window.__ogeAdvanceTimer=setTimeout(()=>{const go=$('#go');if(go&&!go.hidden)go.click();},4200);}
function explainHTML(q){return `<div class="ex">${md(q.explain)}</div>${q.after?`<div class="ptitle" style="margin-top:10px">✅ Верное решение</div>${codeHTML(q.after)}`:''}`;}
function check(){if(cur.done||!cur.sel.size)return;const q=Q[cur.id],r=rec(cur.id);const ok=isRight(q,cur.sel);r.tries=(r.tries||0)+1;r.at=Date.now();
 const fb=$('#fb');
 if(ok){cur.done=true;
  if(!solved(r)||r.st==='bad')r.st=r.usedHint?'hint':((r.wrong||0)>0?'err':'ok');
  if(cur.list==='redo'&&!(r.wrongNow>0)&&!r.usedHintNow){r.fx=true;r.inRedo=false;}
  markExtraDone(cur.id);
  r.wrongNow=0;r.usedHintNow=false;
  $$('.opt').forEach(b=>{const i=+b.dataset.i;b.disabled=true;b.classList.remove('sel');if(q.correct.includes(i))b.classList.add('good');});
  fb.className='fb show good';fb.innerHTML=`🎉 Верно!`+explainHTML(q);
  $('#chk').hidden=true;$('#go').hidden=false;confetti(true);stu().updated=Date.now();persist();refreshSide();$('#go').focus();scheduleAutoAdvance();}
 else{r.wrong=(r.wrong||0)+1;r.wrongNow=(r.wrongNow||0)+1;if(!solved(r))r.st='bad';r.fx=false;r.lastBad=[...cur.sel];
  const multi=q.correct.length>1;
  $$('.opt').forEach(b=>{const i=+b.dataset.i;if(cur.sel.has(i)&&!q.correct.includes(i))b.classList.add('bad');});
  const wrongSel=[...cur.sel].filter(i=>!q.correct.includes(i)).length;
  let msg='Пока неверно. Подумай ещё раз.';
  if(multi){msg=wrongSel?'Среди отмеченных есть неверные варианты (они подсвечены).':'Отмеченные варианты верные, но выбраны не все.';}
  let xid=null;
  fb.className='fb show bad';fb.innerHTML=`✗ ${msg}${xid?`<div class="ex">➕ Две ошибки — после этого вопроса будет дополнительный похожий вопрос №${NUM[xid]}.</div>`:''}${r.wrongNow>=2&&!cur.showHint?'<div class="ex">Попробуй подсказку 💡 — она поможет разобраться.</div>':''}`;
  stu().updated=Date.now();persist();refreshSide();
  $('.help .note').textContent=`Попыток: ${r.tries}`;}}
function refreshSide(){const sd=$('.side');const st=sd?sd.scrollTop:0;if(sd){sd.outerHTML=sidebar();bindSide();const n=$('.side');if(n)n.scrollTop=st;}const t=$('.top');if(t){const c=counts(ORDER);t.querySelector('.pbar i').style.width=(c.done/c.total*100)+'%';t.querySelector('.ptxt').textContent=c.done+'/'+c.total;}}
function theoryFor(q){if(q.theory)return {title:'Теория к заданию',text:q.theory};const z=(q.prompt+' '+(q.code||'')+' '+(q.explain||'')).toLowerCase();
 if(/перв(?:ая|ую) цифр[ау]?|цифра десятков/.test(z)&&/двузнач/.test(z))return {title:'Первая цифра двузначного числа',text:'У двузначного числа цифра десятков — это целая часть после деления на 10. Например: 47 // 10 = 4. В Python оператор // выполняет деление нацело и отбрасывает остаток.'};
 if(/первая цифра|цифра сотен/.test(z)&&/тр[её]хзнач/.test(z))return {title:'Первая цифра трёхзначного числа',text:'Чтобы получить цифру сотен, раздели число на 100 нацело: 583 // 100 = 5. Оператор // отбрасывает остаток.'};
 if(/последн.{0,20}цифр/.test(z)&&/основани|семерич/.test(z))return {title:'Последняя цифра в системе счисления',text:'Последняя цифра числа в системе с основанием b — остаток от деления на b. Для семеричной записи это a % 7.'};
 if(/последн.{0,20}цифр/.test(z))return {title:'Последняя цифра числа',text:'Последняя десятичная цифра — остаток от деления на 10: 257 % 10 = 7. Оператор % возвращает остаток.'};
 if(/%/.test(q.code||'')||/остаток/.test(z))return {title:'Остаток от деления: %',text:'Оператор % возвращает остаток. Например, a % 2 == 0 проверяет чётность, а a % 10 находит последнюю цифру.'};
 if(/\/\//.test(q.code||'')||/целочисленн/.test(z))return {title:'Деление нацело: //',text:'Оператор // делит нацело, отбрасывая дробную часть. Например, 47 // 10 = 4 — цифра десятков двузначного числа.'};
 if(/range\(/.test(q.code||'')||/range\(/.test(z))return {title:'Цикл и range()',text:'range(n) повторяет тело цикла n раз: значения счётчика идут от 0 до n − 1. Чтобы включить правую границу b, используют range(a, b + 1).'};
 if(/максимум|минимум|max\(|min\(/.test(z))return {title:'Максимум и минимум',text:'Для максимума сравнивай очередное число с текущим: maxi = max(maxi, a). Для минимума — mini = min(mini, a). Начальное значение выбирают за пределами возможных данных.'};
 if(/сумм|произвед|сч[её]тчик/.test(z))return {title:'Накопители в цикле',text:'Количество начинают с 0 и увеличивают на 1; сумму — с 0 и прибавляют число; произведение — с 1 и умножают на число.'};
 return {title:'Главная идея задания',text:q.hint||SEC_HINT[q.sec]||'Разбери условие на шаги и проверь, что делает каждая операция в коде.'};}
function showTheory(){const t=theoryFor(Q[cur.id]);modal('<div class="row" style="justify-content:space-between"><h2 style="margin:0">📘 '+esc(t.title)+'</h2><button class="btn" id="theoryClose">✕ Закрыть</button></div><div class="theory-card">'+esc(t.text)+'</div>','wide');$('#theoryClose').onclick=closeModal;}
function showHint(){const q=Q[cur.id],r=rec(cur.id);if(!cur.done){r.usedHint=true;r.usedHintNow=true;if(r.st==='bad'||!r.st)r.st=r.st||'';}cur.showHint=true;
 const m=q.memo?MEMO[q.memo]:null;
 $('#hz').innerHTML=`<div class="hz">💡 ${md(q.hint||SEC_HINT[q.sec]||'')}${m?`<div style="margin-top:8px">📌 <b>${esc(m.t)}.</b> ${esc(m.why)} <i>Как исправить:</i> ${esc(m.fix)}</div>`:''}</div>`;persist();}
function showAnswer(){const q=Q[cur.id],r=rec(cur.id);cur.done=true;if(!solved(r)||r.st==='bad')r.st='sol';else if(cur.list==='redo'){r.st='sol';r.fx=false;}r.wrongNow=0;r.at=Date.now();
 $$('.opt').forEach(b=>{const i=+b.dataset.i;b.disabled=true;b.classList.remove('sel','bad');if(q.correct.includes(i))b.classList.add('good');});
 const fb=$('#fb');fb.className='fb show good';fb.innerHTML=`👁 Правильный ответ: <b>${q.correct.map(letter).join(', ')}</b>`+explainHTML(q);
 $('#chk').hidden=true;$('#go').hidden=false;stu().updated=Date.now();persist();refreshSide();}
function goNext(){clearAutoAdvance();const L=listIds();const pos=L.indexOf(cur.id);const nxt=pos>=0?L[pos+1]:null;
 if(cur.list==='redo'&&cur.redoSec){if(nxt){openQ(nxt);return;}viewSecDone(cur.redoSec);return;}
 if(cur.list==='all'&&(!nxt||Q[nxt].sec!==Q[cur.id].sec)){finishSection(Q[cur.id].sec);return;}
 if(!nxt){viewDone();return;}openQ(nxt);}
/* ---- дополнительные вопросы после двух ошибок ---- */
function extras(){const s=stu();s.extra=s.extra||[];return s.extra;}
function pendingExtra(){return extras().find(x=>!x.done);}
function extraOf(id){return extras().find(x=>x.id===id&&!x.done)||null;}
function assignExtra(src){if(extraOf(src))return null;const X=extras();if(X.some(x=>x.src===src&&!x.done))return null;
 const q=Q[src];const taken=new Set(X.filter(x=>!x.done).map(x=>x.id));const s=stu();
 let c=BANK.filter(b=>b.id!==src&&b.sk===q.sk&&!taken.has(b.id));if(!c.length)c=BANK.filter(b=>b.id!==src&&b.sec===q.sec&&!taken.has(b.id));if(!c.length)return null;
 const fresh=c.filter(b=>!solved(s.q[b.id]));const pool=fresh.length?fresh:c;const pick=pool[Math.floor(Math.random()*pool.length)];
 X.push({id:pick.id,src,done:false,at:Date.now()});persist();return pick.id;}
function markExtraDone(id){const x=extraOf(id);if(x){x.done=true;x.doneAt=Date.now();persist();}}
function extraBlock(){if(cur.test)return '';const X=extras();if(!X.length)return '';const s=stu();
 return `<div class="tp xtp"><div class="tph"><span class="ic" style="background:#f0a400">➕</span><span>Дополнительные вопросы</span><span class="done">${X.filter(x=>x.done).length}/${X.length}</span></div>
 <div class="chips">${X.map(x=>`<button class="chip ${x.done?'ok':''} ${x.id===cur.id?'cur':''}" data-id="${x.id}" title="Похожий вопрос к №${NUM[x.src]}">${NUM[x.id]}</button>`).join('')}</div></div>`;}
/* ---- раздел: завершение и работа над ошибками ---- */
function secProblems(sec){const s=stu();return ORDER.filter(id=>Q[id].sec===sec&&problem(s.q[id]));}
function finishSection(sec){tick();const P=secProblems(sec);if(!P.length){viewSecDone(sec);return;}
 cur.list='redo';cur.redoSec=sec;toast('🔁 Работа над ошибками раздела: '+P.length+' вопр.');openQ(P[0]);}
function nextSec(sec){const i=SECS.findIndex(x=>x.id===sec);return SECS[i+1]||null;}
function viewSecDone(sec){tick();cur.view='done';const sc=SEC[sec];const P=secProblems(sec);const nx=nextSec(sec);const s=stu();
 const ids=ORDER.filter(id=>Q[id].sec===sec);const c=countsFor(s,ids);
 app().innerHTML=topbar()+`<div class="wrap">${sidebar()}<main class="main"><div class="card done-card pop" id="card"><div class="big">${P.length?'📚':'🏁'}</div>
 <h1>${P.length?'Остались вопросы для повторения':'Раздел завершён!'}</h1><p style="font-size:18px">${esc(sc.title)}: пройдено ${c.done} из ${c.total}${c.ok?`, сам с первой попытки — ${c.ok}`:''}.</p>
 <div class="row" style="justify-content:center">${P.length?`<button class="btn" id="sR">🔁 Повторить ошибки (${P.length})</button>`:''}${nx?`<button class="btn pri" id="sN">➜ Следующий раздел: ${esc(nx.title)}</button>`:'<button class="btn pri" id="sD">🏆 Итоги</button>'}</div></div></main></div>`;
 bindTop();bindSide();
 const r=$('#sR');if(r)r.onclick=()=>finishSection(sec);
 const n=$('#sN');if(n)n.onclick=()=>{cur.list='all';cur.redoSec=null;cur.open=null;const L=ORDER.filter(id=>Q[id].sec===nx.id);openQ(L.find(id=>!solved(s.q[id]))||L[0]);};
 const d=$('#sD');if(d)d.onclick=()=>{cur.list='all';cur.redoSec=null;viewDone();};
 if(!P.length)confetti();}
function applySide(){document.body.classList.toggle('side-off',!!DB.sideOff);const b=$('#bSide');if(b)b.textContent=DB.sideOff?'☰ Показать меню':'☰ Скрыть меню';}
function scrollSide(){const sd=$('.side');if(!sd)return;const tp=sd.querySelector('.tp.cur');const ch=sd.querySelector('.chip.cur');
 if(tp){const top=tp.offsetTop-sd.offsetTop-8;if(top<sd.scrollTop||top>sd.scrollTop+sd.clientHeight-80)sd.scrollTop=Math.max(0,top);}
 if(ch){const r=ch.getBoundingClientRect(),R=sd.getBoundingClientRect();if(r.bottom>R.bottom||r.top<R.top)sd.scrollTop+=r.top-R.top-sd.clientHeight/2;}
 if(window.innerWidth<=860){}}
function confetti(small=false){const card=$('#card');if(!card)return;const em=small?['✨','✦','·']:['🎉','⭐','✨','💚','🐍','✅'];const count=small?6:14;
 for(let i=0;i<count;i++){const s=document.createElement('span');s.className='conf';s.textContent=em[i%em.length];s.style.left='50%';s.style.top='58%';s.style.setProperty('--dx',(Math.random()*(small?150:500)-(small?75:250))+'px');s.style.setProperty('--dy',(-Math.random()*(small?100:260)-(small?20:40))+'px');card.appendChild(s);setTimeout(()=>s.remove(),small?900:1300);}}
function statTiles(name){const s=DB.students[name];const c=countsFor(s,ORDER);
 return [['✅',c.done+' из '+c.total,'пройдено'],['🎯',c.ok,'сам с 1-й попытки'],['🔁',c.err,'после ошибок'],['💡',c.hint,'с подсказкой'],['👁',c.sol,'показан ответ'],['❌',c.wrong,'неверных ответов'],['⏱',fmtT(c.ms),'время работы']]
  .map(a=>`<div class="stat"><b>${a[0]} ${a[1]}</b><span>${a[2]}</span></div>`).join('');}
function countsFor(s,ids){let c={total:ids.length,done:0,ok:0,err:0,hint:0,sol:0,bad:0,wrong:0,ms:0};for(const id of ids){const r=s.q[id];if(!r)continue;if(solved(r))c.done++;if(r.st)c[r.st]++;c.wrong+=r.wrong||0;c.ms+=r.ms||0;}return c;}
function viewDone(){tick();cur.view='done';const L=listIds();
 const title=cur.list==='hw'?'Домашнее задание выполнено!':cur.list==='redo'?'Работа над ошибками завершена!':'Все вопросы пройдены!';
 app().innerHTML=topbar()+`<div class="wrap">${sidebar()}<main class="main"><div class="card done-card pop" id="card"><div class="big">🏆</div><h1>${title}</h1>
 <div class="stats" style="max-width:760px;margin:16px auto">${statTiles(cur.name)}</div>
 <p>Сформируй отчёт и отправь его учителю. Не забудь сохранить файл с прогрессом.</p>
 <div class="row" style="justify-content:center"><button class="btn pri" id="dR">📄 Отчёт учителю</button><button class="btn" id="dS">💾 Сохранить прогресс</button>${ORDER.some(id=>problem(stu().q[id]))?'<button class="btn" id="dE">🔁 Работа над ошибками</button>':''}<button class="btn" id="dT">🎯 Контрольная</button></div></div></main></div>`;
 bindTop();bindSide();$('#dR').onclick=()=>reportDialog(cur.name);$('#dS').onclick=saveApp;$('#dT').onclick=testDialog;
 const e=$('#dE');if(e)e.onclick=()=>{cur.list='redo';const L2=listIds();openQ(L2[0]);};confetti();}

/* ===== памятка ===== */
const ROT=[-1.6,1.2,-.8,1.7,-1.2,.9];
function stickerHTML(k,i){const m=MEMO[k];return `<div class="estk" id="stk-${k}" style="--sc:${m.c};--se:${m.e};--rot:${ROT[i%ROT.length]}deg"><div class="stk-pin"></div><h3>${esc(m.t)}</h3><div class="msg">${esc(m.msg)}</div><p>${esc(m.why)}</p><p><b>Как исправить:</b> ${esc(m.fix)}</p>${m.bad?`<div class="bg"><div class="no"><b>✗ Было</b>${esc(m.bad)}</div><div class="yes"><b>✓ Стало</b>${esc(m.good)}</div></div>`:''}</div>`;}
function memoBody(){const keys=Object.keys(MEMO);const run=keys.filter(k=>MEMO[k].g==='run'),lg=keys.filter(k=>MEMO[k].g==='logic');
 return `<div class="ework"><b>Как читать сообщение об ошибке</b><ol><li>Смотри на <b>последнюю строку</b>: там тип ошибки (SyntaxError, NameError…) и пояснение.</li><li>Найди номер строки: <code>line 5</code>. Посмотри эту строку и строку <b>над ней</b> (незакрытая скобка «ломает» следующую строку).</li><li><b>SyntaxError</b> и <b>IndentationError</b> находятся до запуска — программа даже не попросит ввод. Остальные ошибки появляются во время работы.</li><li>Исправил — запусти снова: ошибки показываются по одной.</li></ol></div>
 <div class="toc">${keys.map(k=>`<button data-toc="${k}">${esc(MEMO[k].t)}</button>`).join('')}</div>
 <div class="memo"><h2><i style="background:#e5487a"></i>Python сообщает об ошибке</h2><div class="stks">${run.map(stickerHTML).join('')}</div>
 <h2><i style="background:#16a36a"></i>Ошибки без сообщения: программа работает, но ответ неверный</h2><div class="stks">${lg.map(stickerHTML).join('')}</div></div>`;}
function viewMemo(focus){modal(`<div class="row" style="justify-content:space-between"><h2 style="margin:0">📌 Памятка: типичные ошибки в программах</h2><button class="btn" id="mClose">✕ Закрыть</button></div>${memoBody()}`,'full');
 $('#mClose').onclick=closeModal;$$('[data-toc]').forEach(b=>b.onclick=()=>flash(b.dataset.toc));if(focus)setTimeout(()=>flash(focus),80);}
function flash(k){const e=document.getElementById('stk-'+k);if(!e)return;e.scrollIntoView({behavior:'smooth',block:'center'});e.classList.remove('flash');void e.offsetWidth;e.classList.add('flash');}
function showSticker(k){const m=MEMO[k];if(!m)return;modal('<div class="row" style="justify-content:space-between"><h2 style="margin:0">📌 '+esc(m.t)+'</h2><button class="btn" id="memoClose">✕ Закрыть</button></div>'+stickerHTML(k,0),'wide');$('#memoClose').onclick=closeModal;}

/* ===== контрольная ===== */
function testDialog(){tick();const s=stu();
 modal(`<h2>🎯 Контрольная</h2><p class="sdesc">Случайные вопросы из выбранных разделов. Подсказок и показа ответа нет; после каждого ответа — разбор. Результат попадёт в отчёт учителю.</p>
 <div class="tsel">${SECS.map(sc=>`<label><input type="checkbox" value="${sc.id}" ${sc.stars<=3?'checked':''}> ${esc(sc.title)} <span class="stars">${'★'.repeat(sc.stars)}</span><small>${sc.n}</small></label>`).join('')}</div>
 <div class="row" style="margin:12px 0"><button class="btn sm" id="tAll">Все</button><button class="btn sm" id="tNone">Ни одного</button>${DB.hw.length?'<button class="btn sm" id="tHw">📌 Только ДЗ</button>':''}
 <label class="fld" style="margin:0 0 0 auto;flex-direction:row;align-items:center;gap:8px"><span>Вопросов</span><select id="tN"><option>10</option><option selected>20</option><option>30</option><option value="999">все</option></select></label></div>
 <div class="row"><button class="btn pri" id="tGo">Начать ➜</button><button class="btn" id="tX">Отмена</button></div>`);
 $('#tX').onclick=closeModal;$('#tAll').onclick=()=>$$('.tsel input').forEach(c=>c.checked=true);$('#tNone').onclick=()=>$$('.tsel input').forEach(c=>c.checked=false);
 let hwOnly=false;const th=$('#tHw');if(th)th.onclick=()=>{hwOnly=true;go();};
 const go=()=>{let pool;let title;if(hwOnly){pool=DB.hw.slice();title='Контрольная по ДЗ';}else{const S=$$('.tsel input:checked').map(c=>c.value);if(!S.length){toast('Выбери хотя бы один раздел');return;}pool=BANK.filter(q=>S.includes(q.sec)).map(q=>q.id);title=S.length===SECS.length?'Контрольная: все разделы':'Контрольная: '+S.map(x=>SEC[x].title).slice(0,3).join(', ')+(S.length>3?'…':'');}
  for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];}
  const n=Math.min(+$('#tN').value,pool.length);let ids=pool.slice(0,n);ids.sort((a,b)=>ORDER.indexOf(a)-ORDER.indexOf(b));
  cur.test={title,ids,i:0,ans:[],startedAt:Date.now()};closeModal();testQ();};
 $('#tGo').onclick=go;}
function testQ(){clearAutoAdvance();const T=cur.test;if(T.i>=T.ids.length){finishTest();return;}const id=T.ids[T.i],q=Q[id];cur.sel=new Set();cur.done=false;cur.view='test';T.t0=Date.now();
 const multi=q.correct.length>1;
 app().innerHTML=topbar()+`<div class="wrap">${sidebar()}<main class="main"><div class="card pop" id="card">
 <div class="chead"><span class="num">Контрольная · вопрос ${T.i+1} из ${T.ids.length}</span><span class="badge tpc">${esc(SEC[q.sec].title)}</span>${multi?'<span class="mtag">☑ несколько ответов</span>':''}</div>
 <div class="qtext">${md(q.prompt)}</div>
 ${q.code?`<div class="ptitle">🐍 Программа</div>${codeHTML(q.code,q.console?errLine(q.console):0)}`:''}
 ${q.inp?`<div class="ptitle">⌨ Ввод</div><div class="inbox">${q.inp.split('\n').map(x=>`<span>${esc(x)}</span>`).join('')}</div>`:''}
 ${q.console?`<div class="ptitle">⚠ Сообщение Python</div>${consHTML(q.console)}`:''}
 <div class="ptitle">${multi?'Отметь все верные варианты':'Выбери один вариант'}</div>
 <div class="olist">${q.options.map((o,i)=>`<button class="opt ${multi?'multi':''}" data-i="${i}"><span class="bl">${letter(i)}</span><span class="tx">${q.mono?`<pre>${esc(o)}</pre>`:md(o)}</span></button>`).join('')}</div>
 <div class="actions"><button class="btn pri" id="chk" disabled>Ответить</button><button class="btn ok" id="go" hidden>${T.i===T.ids.length-1?'Результат ➜':'Дальше ➜'}</button></div><div class="fb" id="fb"></div>
 </div></main></div>`;
 bindTop();bindSide();
 $$('.opt').forEach(b=>b.onclick=()=>choose(+b.dataset.i));
 $('#chk').onclick=()=>{if(!cur.sel.size||cur.done)return;cur.done=true;const ok=isRight(q,cur.sel);T.ans.push({id,sel:[...cur.sel],ok,ms:Date.now()-T.t0});
  $$('.opt').forEach(b=>{const i=+b.dataset.i;b.disabled=true;b.classList.remove('sel');if(q.correct.includes(i))b.classList.add(cur.sel.has(i)?'good':'miss');else if(cur.sel.has(i))b.classList.add('bad');});
  const fb=$('#fb');fb.className='fb show '+(ok?'good':'bad');fb.innerHTML=(ok?'✔ Верно!':'✗ Неверно. Правильно: <b>'+q.correct.map(letter).join(', ')+'</b>')+explainHTML(q);
  $('#chk').hidden=true;$('#go').hidden=false;$('.side').outerHTML=sidebar();bindSide();if(ok){confetti(true);scheduleAutoAdvance();}};
 $('#go').onclick=()=>{clearAutoAdvance();T.i++;testQ();};}
function finishTest(early){const T=cur.test;if(!T)return;const s=stu();const ok=T.ans.filter(a=>a.ok).length;
 const res={title:T.title,startedAt:T.startedAt,finishedAt:Date.now(),total:T.ids.length,ids:T.ids,ans:T.ans,score:ok,early:!!early};
 if(T.ans.length){s.tests.push(res);if(s.tests.length>50)s.tests=s.tests.slice(-50);}
 for(const a of T.ans)if(!a.ok){const r=rec(a.id);r.wrong=(r.wrong||0)+1;if(!solved(r))r.st='bad';else if(r.fx)r.fx=false;r.inRedo=true;}
 s.updated=Date.now();persist();cur.test=null;
 const p=T.ans.length?Math.round(ok/T.ans.length*100):0;const mark=p>=85?5:p>=65?4:p>=45?3:2;
 const wrong=T.ans.filter(a=>!a.ok);
 app().innerHTML=topbar()+`<div class="wrap">${sidebar()}<main class="main"><div class="card done-card pop" id="card"><div class="big">${p>=85?'🏆':p>=65?'👍':'📚'}</div><h1>${ok} из ${T.ans.length}${early?` <small style="font-size:16px;color:var(--mut)">(из ${T.total}, досрочно)</small>`:''}</h1>
 <p style="font-size:18px">Верно: <b>${p}%</b> · ориентировочная отметка: <b>${mark}</b></p>
 ${wrong.length?`<div style="text-align:left;max-width:760px;margin:12px auto"><h3>Вопросы с ошибками — они добавлены в «Работу над ошибками»</h3>${wrong.map(a=>`<div class="redo"><b>${esc(SEC[Q[a.id].sec].title)}</b> · ${md(Q[a.id].prompt.split('\n')[0])}<br><small>Правильно: ${Q[a.id].correct.map(i=>esc(Q[a.id].options[i]).replace(/\n/g,' ⏎ ')).join(' | ')}</small></div>`).join('')}</div>`:''}
 <div class="row" style="justify-content:center"><button class="btn pri" id="dR">📄 Отчёт учителю</button><button class="btn" id="dS">💾 Сохранить</button>${wrong.length?'<button class="btn" id="dE">🔁 Работа над ошибками</button>':''}<button class="btn" id="dB">⬅ К вопросам</button></div></div></main></div>`;
 bindTop();bindSide();$('#dR').onclick=()=>reportDialog(cur.name);$('#dS').onclick=saveApp;$('#dB').onclick=()=>openQ(cur.id||ORDER[0]);
 const e=$('#dE');if(e)e.onclick=()=>{cur.list='redo';openQ(listIds()[0]);};if(p>=65)confetti();}

/* ===== учитель ===== */
function askPin(){modal(`<h2>🎓 Раздел учителя</h2><form id="pf" class="row"><input class="fld" style="padding:12px;border-radius:12px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink);font-size:18px" id="pin" type="password" inputmode="numeric" placeholder="PIN-код"><button class="btn pri">Войти</button><button type="button" class="btn" id="pX">Отмена</button></form><p id="pE" style="color:var(--bad);font-weight:700"></p>`);
 $('#pX').onclick=closeModal;$('#pin').focus();$('#pf').onsubmit=e=>{e.preventDefault();if($('#pin').value===(DB.teacher.pin||DEFAULT_PIN)){closeModal();viewTeacher('st');}else $('#pE').textContent='Неверный PIN-код.';};}
function secBar(s,ids){const c=countsFor(s,ids),t=ids.length||1;return `<div class="secbar" title="сам ${c.ok} · после ошибок ${c.err} · подсказка ${c.hint} · ответ ${c.sol} · неверно ${c.bad}"><i style="width:${c.ok/t*100}%;background:var(--ok)"></i><i style="width:${c.err/t*100}%;background:#7bd3a7"></i><i style="width:${c.hint/t*100}%;background:#ffd666"></i><i style="width:${c.sol/t*100}%;background:#ffb27a"></i><i style="width:${c.bad/t*100}%;background:var(--bad)"></i></div>`;}
function viewTeacher(tab){const names=Object.keys(DB.students).sort((a,b)=>(DB.students[b].updated||0)-(DB.students[a].updated||0));
 const tabs=`<div class="tabs"><button data-tab="st" class="${tab==='st'?'on':''}">👥 Ученики</button><button data-tab="hw" class="${tab==='hw'?'on':''}">📌 Домашнее задание</button><button data-tab="set" class="${tab==='set'?'on':''}">⚙ Настройки</button></div>`;
 let body='';
 if(tab==='st'){body=`<div class="row" style="margin-bottom:10px"><button class="btn" id="imp">📥 Загрузить файлы учеников</button><input id="impF" type="file" accept=".html,text/html" multiple hidden><button class="btn" id="tSave">💾 Сохранить приложение</button></div>
  <table class="st"><thead><tr><th>Ученик</th><th>Пройдено</th><th>Сам / ошибки / 💡 / 👁</th><th>ДЗ</th><th>Контрольные</th><th>Активность</th><th></th></tr></thead><tbody>${names.map(n=>{const s=DB.students[n];const c=countsFor(s,ORDER);const h=countsFor(s,DB.hw);const t=s.tests[s.tests.length-1];
   return `<tr><td><b>${esc(n)}</b></td><td>${c.done}/${c.total}${secBar(s,ORDER)}</td><td>${c.ok} / ${c.err} / ${c.hint} / ${c.sol}</td><td>${DB.hw.length?h.done+'/'+DB.hw.length:'—'}</td><td>${s.tests.length?`${s.tests.length} · посл. ${t.score}/${t.ans.length}`:'—'}</td><td>${fmtDate(s.updated)}</td><td><div class="row"><button class="btn sm" data-rep="${esc(n)}">📄</button><button class="btn sm ghost" data-del="${esc(n)}">🗑</button></div></td></tr>`;}).join('')||'<tr><td colspan="7">Пока нет учеников.</td></tr>'}</tbody></table>`;}
 if(tab==='hw'){const hw=new Set(DB.hw);body=`<p class="sdesc">Отметь вопросы флажком 🚩 — они станут домашним заданием. Затем сохрани приложение и отправь файл ученикам: у них откроется вкладка «📌 ДЗ».</p>
  <div class="row"><label class="fld" style="flex:1;margin:0"><span>Название ДЗ</span><input id="hwT" value="${esc(DB.hwTitle||'')}" placeholder="например: Ошибки при запуске + условия"></label></div>
  <div class="row" style="margin:10px 0"><span class="ptxt" id="hwN">Выбрано: ${hw.size}</span><button class="btn sm" id="hwAll">Выбрать все</button><button class="btn sm" id="hwClr">Снять все</button><button class="btn sm" id="hwProb">🔁 Добавить «проблемные» у всех учеников</button></div>
  <div class="flagg">${SECS.map((sc,si)=>{const ids=BANK.filter(q=>q.sec===sc.id).map(q=>q.id);return `<div class="hwrow">${si+1}. ${esc(sc.title)} <span class="stars">${'★'.repeat(sc.stars)}</span><small>${ids.length}</small><button class="btn sm ghost" data-hsec="${sc.id}">весь раздел</button></div><div class="hwchips">${ids.map(id=>`<span class="flag ${hw.has(id)?'on':''}" data-hid="${id}" title="${esc(plain(Q[id].prompt).slice(0,140))}"><span class="fl">🚩</span>${NUM[id]}</span>`).join('')}</div>`;}).join('')}</div>
  <div class="row" style="margin-top:14px"><button class="btn pri" id="hwSave">💾 Сохранить ДЗ в файл приложения</button></div>`;}
 if(tab==='set'){body=`<div class="row" style="align-items:flex-end"><label class="fld"><span>Имя учителя</span><input id="sN" value="${esc(DB.teacher.name)}"></label><label class="fld"><span>E-mail для отчётов</span><input id="sE" type="email" value="${esc(DB.teacher.email)}"></label><label class="fld"><span>Telegram (без @)</span><input id="sT" value="${esc(DB.teacher.tg)}"></label><label class="fld"><span>PIN</span><input id="sP" value="${esc(DB.teacher.pin||DEFAULT_PIN)}"></label></div><button class="btn pri" id="sSave">Сохранить настройки</button>
  <h3 style="margin-top:22px">Банк вопросов</h3><table class="st sectab"><tr><th>Раздел</th><th>Уровень</th><th>Вопросов</th></tr>${SECS.map((sc,i)=>`<tr><td>${i+1}. ${esc(sc.title)}</td><td class="stars">${'★'.repeat(sc.stars)}</td><td>${sc.n}</td></tr>`).join('')}<tr><td><b>Всего</b></td><td></td><td><b>${BANK.length}</b></td></tr></table>`;}
 modal(`<div class="row" style="justify-content:space-between"><h2 style="margin:0">🎓 Учитель</h2><button class="btn" id="tX">✕ Закрыть</button></div>${tabs}${body}`,'full');
 $('#tX').onclick=closeModal;$$('[data-tab]').forEach(b=>b.onclick=()=>viewTeacher(b.dataset.tab));
 if(tab==='st'){$('#imp').onclick=()=>$('#impF').click();$('#impF').onchange=importFiles;$('#tSave').onclick=saveApp;
  $$('[data-rep]').forEach(b=>b.onclick=()=>reportDialog(b.dataset.rep,()=>viewTeacher('st')));
  $$('[data-del]').forEach(b=>b.onclick=()=>{const n=b.dataset.del;confirmBox(`Удалить ученика «${esc(n)}» и все его результаты?`,()=>{delete DB.students[n];persist();viewTeacher('st');});});}
 if(tab==='hw'){const upd=()=>{$('#hwN').textContent='Выбрано: '+DB.hw.length;};const setHw=a=>{DB.hw=ORDER.filter(id=>a.has(id));DB.hwAt=Date.now();persist();};
  $$('[data-hid]').forEach(f=>f.onclick=()=>{const a=new Set(DB.hw);const id=f.dataset.hid;if(a.has(id))a.delete(id);else a.add(id);f.classList.toggle('on');setHw(a);upd();});
  const paint=()=>{const a=new Set(DB.hw);$$('[data-hid]').forEach(f=>f.classList.toggle('on',a.has(f.dataset.hid)));upd();};
  $$('[data-hsec]').forEach(b=>b.onclick=()=>{const a=new Set(DB.hw);const ids=BANK.filter(q=>q.sec===b.dataset.hsec).map(q=>q.id);const all=ids.every(id=>a.has(id));ids.forEach(id=>all?a.delete(id):a.add(id));setHw(a);paint();});
  $('#hwClr').onclick=()=>{setHw(new Set());paint();};$('#hwAll').onclick=()=>{setHw(new Set(ORDER));paint();};
  $('#hwProb').onclick=()=>{const a=new Set(DB.hw);for(const s of Object.values(DB.students))for(const id of ORDER)if(problem(s.q[id]))a.add(id);setHw(a);paint();};
  $('#hwT').oninput=e=>{DB.hwTitle=e.target.value;DB.hwAt=Date.now();persist();};
  $('#hwSave').onclick=saveApp;}
 if(tab==='set'){$('#sSave').onclick=()=>{DB.teacher={name:$('#sN').value.trim(),email:$('#sE').value.trim(),tg:$('#sT').value.trim().replace(/^@/,''),pin:$('#sP').value.trim()||DEFAULT_PIN};persist();toast('Настройки сохранены');};}}
async function importFiles(e){let n=0;for(const f of e.target.files||[]){try{const t=await f.text();const m=t.match(/<script id="saved-state" type="application\/json">([\s\S]*?)<\/script>/);if(!m)continue;const d=JSON.parse(m[1]);
  for(const [nm,s] of Object.entries(d.students||{})){const o=DB.students[nm];if(!o||(s.updated||0)>=(o.updated||0)){s.q=s.q||{};s.tests=s.tests||[];DB.students[nm]=s;n++;}}}catch(err){console.warn(err);}}
 persist();viewTeacher('st');toast('Загружено профилей: '+n);}

/* ===== отчёт ===== */
function reportDialog(name,back){tick();const s=DB.students[name];if(!s)return;
 const rows=SECS.map((sc,i)=>{const ids=BANK.filter(q=>q.sec===sc.id).map(q=>q.id);const c=countsFor(s,ids);return `<tr><td>${i+1}. ${esc(sc.title)}</td><td>${c.done}/${c.total}</td><td style="min-width:140px">${secBar(s,ids)}</td></tr>`;}).join('');
 const tests=s.tests.slice(-5).reverse().map(t=>`<tr><td>${fmtDate(t.finishedAt)}</td><td>${esc(t.title)}</td><td><b>${t.score}/${t.ans.length}</b>${t.early?' (досрочно)':''}</td></tr>`).join('');
 modal(`<h2>📄 Отчёт: ${esc(name)}</h2><div class="stats">${statTiles(name)}</div>
 <table class="st sectab">${rows}</table>${tests?`<h3>Контрольные</h3><table class="st">${tests}</table>`:''}
 <div class="row" style="margin-top:14px"><label class="fld" style="margin:0"><span>Состав PDF</span><select id="rD"><option value="prob">Сводка + вопросы для повторения</option><option value="sum">Только сводка</option></select></label></div>
 <div class="row" style="margin-top:12px"><button class="btn pri" id="rS">📤 Отправить учителю</button><button class="btn" id="rP">📥 Скачать PDF</button><button class="btn" id="rX">Закрыть</button></div><div id="rM" style="margin-top:8px"></div>`,'wide');
 $('#rX').onclick=()=>{closeModal();if(back)back();};
 $('#rP').onclick=async()=>{const f=await makePDF(name,$('#rD').value);download(f,f.name);$('#rM').innerHTML='<p class="tnote">PDF сохранён — прикрепи его к сообщению учителю.</p>';};
 $('#rS').onclick=async()=>{const f=await makePDF(name,$('#rD').value);const c=countsFor(s,ORDER);const txt=`Тестовик Python ОГЭ №16. ${name}: пройдено ${c.done}/${c.total}, сам с 1-й попытки ${c.ok}, ошибок ${c.wrong}.`;
  try{if(navigator.canShare&&navigator.canShare({files:[f]})){await navigator.share({files:[f],title:'Отчёт: '+name,text:txt});return;}}catch(err){if(err&&err.name==='AbortError')return;}
  download(f,f.name);const t=DB.teacher;$('#rM').innerHTML=`<p class="tnote">PDF скачан. Прикрепи его к письму или сообщению.${t.email?` <a href="mailto:${esc(t.email)}?subject=${encodeURIComponent('Отчёт: '+name)}&body=${encodeURIComponent(txt)}">✉ Открыть письмо учителю</a>`:''}${t.tg?` · <a href="https://t.me/${esc(t.tg)}" target="_blank">Telegram @${esc(t.tg)}</a>`:''}</p>`;};}
async function makePDF(name,mode){const s=DB.students[name];const W=1240,H=1754,MX=72,pages=[];let cv,ctx,y;
 const F=(sz,b,m)=>`${b?'bold ':''}${sz}px ${m?'Consolas, "Courier New", monospace':'Arial, sans-serif'}`;
 const np=()=>{cv=document.createElement('canvas');cv.width=W;cv.height=H;ctx=cv.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);pages.push(cv);y=80;};
 const tx=(t,x,yy,sz=22,col='#1d2640',b=false,al='left',m=false)=>{ctx.font=F(sz,b,m);ctx.fillStyle=col;ctx.textAlign=al;ctx.fillText(String(t),x,yy);};
 const wrap=(v,x,yy,mw,sz=20,col='#25334a',b=false,m=false,maxL=99)=>{const lh=Math.round(sz*1.4);ctx.font=F(sz,b,m);let n=0;for(const p of String(v??'').split('\n')){let line='';for(const w of p.split(/\s+/)){const t=line?line+' '+w:w;if(ctx.measureText(t).width>mw&&line){if(n<maxL)tx(line,x,yy,sz,col,b,'left',m);n++;yy+=lh;line=w;}else line=t;}if(n<maxL)tx(line,x,yy,sz,col,b,'left',m);n++;yy+=lh;}return yy;};
 const rr=(x,yy,w,h,r,f)=>{ctx.beginPath();ctx.moveTo(x+r,yy);ctx.arcTo(x+w,yy,x+w,yy+h,r);ctx.arcTo(x+w,yy+h,x,yy+h,r);ctx.arcTo(x,yy+h,x,yy,r);ctx.arcTo(x,yy,x+w,yy,r);ctx.closePath();ctx.fillStyle=f;ctx.fill();};
 np();const g=ctx.createLinearGradient(0,0,W,0);g.addColorStop(0,'#4f6bff');g.addColorStop(1,'#7b5cff');ctx.fillStyle=g;ctx.fillRect(0,0,W,200);
 tx('Отчёт ученика',MX,86,48,'#fff',true);tx('Тестовик Python · ОГЭ информатика №16 — обработка чисел',MX,140,24,'#eef1ff');tx(fmtDate(Date.now()),W-MX,86,20,'#fff',false,'right');
 y=262;tx(name,MX,y,38,'#1d2640',true);y+=50;const c=countsFor(s,ORDER);
 const tiles=[['Пройдено',`${c.done}/${c.total}`,'#e8ecff','#3b4fd8'],['Сам с 1-й попытки',c.ok,'#dff6ea','#13794b'],['После ошибок',c.err,'#e3f6ec','#2e8b62'],['С подсказкой',c.hint,'#fff2cc','#8b6500'],['Показан ответ',c.sol,'#ffe8d6','#b25e00'],['Неверных ответов',c.wrong,'#ffe3e3','#b43d3d']];
 const tw=(W-2*MX-5*14)/6;tiles.forEach((t,i)=>{const x=MX+i*(tw+14);rr(x,y,tw,104,14,t[2]);tx(t[1],x+tw/2,y+52,32,t[3],true,'center');wrap(t[0],x+10,y+82,tw-20,15,'#4a5170');});y+=140;
 tx('Время работы: '+fmtT(c.ms)+(DB.hw.length?`   ·   ДЗ: ${countsFor(s,DB.hw).done}/${DB.hw.length}`:''),MX,y,20,'#4a5170');y+=46;
 tx('Прогресс по разделам',MX,y,28,'#1d2640',true);y+=22;
 SECS.forEach((sc,i)=>{const ids=BANK.filter(q=>q.sec===sc.id).map(q=>q.id);const k=countsFor(s,ids),t=ids.length;y+=36;tx(`${i+1}. ${sc.title}`,MX,y,18,'#2a3350',true);
  let x=MX+520;const bw=480;rr(x,y-16,bw,18,8,'#edf0f5');[[k.ok,'#16a36a'],[k.err,'#7bd3a7'],[k.hint,'#ffd666'],[k.sol,'#ffb27a'],[k.bad,'#e5484d']].forEach(([v,col])=>{if(v){ctx.fillStyle=col;ctx.fillRect(x,y-16,bw*v/t,18);x+=bw*v/t;}});tx(`${k.done}/${t}`,W-MX,y,18,'#1d2640',true,'right');});
 y+=30;[['сам','#16a36a'],['после ошибок','#7bd3a7'],['подсказка','#ffd666'],['ответ','#ffb27a'],['пока неверно','#e5484d']].forEach(([l,col],i)=>{const x=MX+i*200;ctx.fillStyle=col;ctx.fillRect(x,y,16,16);tx(l,x+24,y+14,16,'#4a5170');});y+=50;
 if(s.tests.length){tx('Контрольные',MX,y,28,'#1d2640',true);y+=12;s.tests.slice(-8).reverse().forEach(t=>{y+=32;tx(fmtDate(t.finishedAt),MX,y,18,'#4a5170');tx(t.title.slice(0,60),MX+230,y,18,'#2a3350');tx(`${t.score}/${t.ans.length}${t.early?' (досрочно)':''}`,W-MX,y,18,'#1d2640',true,'right');});y+=30;}
 if(mode==='prob'){const P=ORDER.filter(id=>problem(s.q[id]));np();tx('Вопросы для повторения',MX,y,32,'#1d2640',true);y+=18;
  if(!P.length){y+=40;tx('Проблемных вопросов нет — отличная работа!',MX,y,22,'#13794b',true);}
  const LBL={err:['ПОСЛЕ ОШИБОК','#2e8b62','#e3f6ec'],hint:['С ПОДСКАЗКОЙ','#8b6500','#fff2cc'],sol:['ПОКАЗАН ОТВЕТ','#b25e00','#ffe8d6'],bad:['НЕ РЕШЁН','#b43d3d','#ffe3e3']};
  for(const id of P){const q=Q[id],r=s.q[id];const est=170+(q.code?Math.min(q.code.split('\n').length,8)*22:0);if(y+est>H-90)np();y+=26;const L=LBL[r.st];
   rr(MX,y,W-2*MX,38,9,L[2]);tx(`${SEC[q.sec].title} · №${NUM[id]}`,MX+14,y+26,18,'#1d2640',true);tx(L[0]+(r.wrong?` · ошибок: ${r.wrong}`:''),W-MX-14,y+26,16,L[1],true,'right');y+=64;
   y=wrap(plain(q.prompt).replace(/\n\n/g,'\n'),MX+8,y,W-2*MX-16,18,'#1d2640',true,false,5);
   if(q.code){const cl=q.code.split('\n');cl.slice(0,8).forEach((l,i)=>{tx(l,MX+30,y,16,'#33415e',false,'left',true);y+=21;});if(cl.length>8){tx('…',MX+30,y,16,'#33415e');y+=21;}}
   y=wrap('Правильно: '+q.correct.map(i=>letter(i)+') '+q.options[i].replace(/\n/g,' ⏎ ')).join('   '),MX+8,y+4,W-2*MX-16,17,'#13794b',true,true,3);
   if(r.lastBad&&r.st!=='ok')y=wrap('Был выбран: '+r.lastBad.map(i=>letter(i)+') '+(q.options[i]||'').replace(/\n/g,' ⏎ ')).join('   '),MX+8,y,W-2*MX-16,16,'#b43d3d',false,true,2);
   if(q.memo)y=wrap('Памятка: '+MEMO[q.memo].t+' — '+MEMO[q.memo].fix,MX+8,y,W-2*MX-16,16,'#6b5300',false,false,2);}}
 pages.forEach((p,i)=>{const c2=p.getContext('2d');c2.font='15px Arial';c2.fillStyle='#9099a8';c2.textAlign='center';c2.fillText(`${APPNAME} · ${name} · стр. ${i+1}/${pages.length}`,W/2,H-36);});
 const jp=pages.map(p=>{const b=atob(p.toDataURL('image/jpeg',0.88).split(',')[1]);const u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return u;});
 const blob=pdfFromJpegs(jp,W,H);const fn=`Отчёт_Python16_${name.replace(/[^\wА-Яа-яЁё-]+/g,'_')}_${stamp()}.pdf`;try{return new File([blob],fn,{type:'application/pdf'});}catch(e){blob.name=fn;return blob;}}
function pdfFromJpegs(imgs,w,h){const enc=new TextEncoder(),parts=[];let len=0;const offs=[];const add=x=>{const b=typeof x==='string'?enc.encode(x):x;parts.push(b);len+=b.length;};const PW=595.28,PH=841.89,n=imgs.length;add('%PDF-1.4\n%\xE2\xE3\xCF\xD3\n');const obj=(id,body)=>{offs[id]=len;add(id+' 0 obj\n');body();add('\nendobj\n');};obj(1,()=>add('<< /Type /Catalog /Pages 2 0 R >>'));obj(2,()=>add(`<< /Type /Pages /Count ${n} /Kids [${imgs.map((_,i)=>(3+i*3)+' 0 R').join(' ')}] >>`));imgs.forEach((im,i)=>{const p=3+i*3,c=p+1,x=p+2;obj(p,()=>add(`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${PW} ${PH}] /Resources << /XObject << /Im${i} ${x} 0 R >> >> /Contents ${c} 0 R >>`));const cs=`q ${PW} 0 0 ${PH} 0 0 cm /Im${i} Do Q`;obj(c,()=>add(`<< /Length ${cs.length} >>\nstream\n${cs}\nendstream`));obj(x,()=>{add(`<< /Type /XObject /Subtype /Image /Width ${w} /Height ${h} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${im.length} >>\nstream\n`);add(im);add('\nendstream');});});const total=3+n*3,xref=len;let x=`xref\n0 ${total}\n0000000000 65535 f \n`;for(let i=1;i<total;i++)x+=String(offs[i]).padStart(10,'0')+' 00000 n \n';add(x);add(`trailer\n<< /Size ${total} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`);return new Blob(parts,{type:'application/pdf'});}

document.addEventListener('keydown',e=>{if(document.getElementById('mbg'))return;if(e.target.tagName==='INPUT')return;
 if(e.key==='Enter'){const g=$('#go');if(g&&!g.hidden){g.click();e.preventDefault();return;}const c=$('#chk');if(c&&!c.disabled&&!c.hidden){c.click();e.preventDefault();}}
 const k=e.key.toUpperCase();if(/^[A-F1-6]$/.test(k)&&$('.opt')){const i=/\d/.test(k)?+k-1:k.charCodeAt(0)-65;const b=$$('.opt')[i];if(b&&!b.disabled)b.click();}});
window.addEventListener('beforeunload',()=>{tick();persist();});
applyTheme();viewLogin();

</script></body></html>